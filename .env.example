# vibecoding-bench 配置
# 复制为 .env 并按实际填写

# 必须:本仓库 data 目录的【宿主机绝对路径】
# 例如 Linux:/root/project/vibecoding-bench/data
# orchestrator 在容器内通过 docker.sock 让宿主 daemon 起 worker/sidecar
# 那些子容器挂载 volume 时用的就是这个宿主路径
HOST_BENCH_DATA=/absolute/path/to/vibecoding-bench/data

# WebUI 监听端口
BENCH_PORT=8000

# HTTP Basic Auth(可选,推荐远程部署开启):
#   - 两者都填才生效;留空 = 不鉴权(本地开发)
#   - 浏览器原生密码弹窗,SSE/EventSource 同源自动带凭据
#   - 密码强烈建议用 `openssl rand -base64 24` 生成
# WEBUI_USER=admin
# WEBUI_PASS=

# 远程部署:指定 GHCR 镜像 tag(仅 docker-compose.remote.yml 用)
#   - latest:跟随 GitHub Actions 对 main 的最新成功构建
#   - <git-sha-short>(如 9787fc1):锁定具体提交,可回滚
# VIBEBENCH_TAG=latest

# Claude Code CLI 兜底版本。WebUI「运行」页可保存运行时覆盖值；
# worker 启动时会安装指定版本，并让 usage API User-Agent 跟随该版本。
CLAUDE_CODE_VERSION=2.1.197

# 普通运行 / 批量运行的兜底思考预算。WebUI「运行」页可保存运行时覆盖值，
# 页面覆盖值优先；清空页面覆盖后回退到这里。抓包 run 不受页面覆盖影响。
# 允许值：max / xhigh / high / medium / low。
CLAUDE_CODE_EFFORT_LEVEL=max

# 普通运行 / 批量运行的兜底默认模型。WebUI「运行」页可保存运行时覆盖值，
# 页面覆盖值优先；清空页面覆盖后回退到这里。抓包 run 不受该配置影响。
CLAUDE_DEFAULT_MODEL=opus[1m]

# cc2api 管理 API。两项都填写后，账号页可做单账号同步、绑定和定时养号。
# 本地 cc2api 若与 bench 不在同一 compose 网络，可填写宿主可达地址。
CC2API_BASE_URL=
CC2API_ADMIN_PASSWORD=
CC2API_REQUEST_TIMEOUT_SEC=15

# 养号调度扫描间隔与 cc2api 临时故障重试秒数。
WARMUP_SCHEDULER_TICK_SEC=30
WARMUP_SYNC_RETRY_SEC=900

# run 临近超时时提前注入收尾提示的秒数；0 表示关闭。
TIMEOUT_WRAPUP_SEC=600

# 运行中按新鲜度同步账号 profile / 本地 OAuth credentials 的间隔；0 表示关闭。
OAUTH_CREDENTIAL_SYNC_INTERVAL_SEC=15

# 检测到 401 后等待后台刷新器更新 profile credentials 的最长秒数；0 表示不等待。
OAUTH_401_PROFILE_WAIT_SEC=90

# Claude Code API 连接错误后，若持续无有效进展超过该秒数，则中断 busy TUI 并自动续跑；0 表示关闭。
CLAUDE_API_STALL_WATCHDOG_SEC=400

# 每个 run 最多自动中断续跑次数；0 表示不恢复。
CLAUDE_API_STALL_MAX_RECOVERIES=1

# 发送中断后等待 TUI 回到输入状态的秒数。
CLAUDE_BUSY_INTERRUPT_GRACE_SEC=8

# 可选:覆盖 API 卡死后的自动续跑提示；留空使用 worker 内置中文提示。
# CLAUDE_API_STALL_RECOVERY_PROMPT=

# 磁盘控制:
#   - SAVE_FULL_FLOWS=0:默认只保存轻量 stats.jsonl，不保存完整 MITM .flow
#   - CLEAN_WORKSPACE_DEPS=1:run 结束后清理 workspace 内 node_modules/.venv 等依赖目录
SAVE_FULL_FLOWS=0
CLEAN_WORKSPACE_DEPS=1
