+"""只转换尚未开始响应的调用期HTTP异常。"""
+from .exceptions import HTTPException
+from .problems import problem_response
+
+
+class ProblemMiddleware:
+    """保留已开始响应及迭代期异常，避免二次发送状态头。"""
+    def __init__(self,app):
+        """建立中间件。@param app 原WSGI应用。@return None。
+        """
+        if not callable(app):
+            raise TypeError('需要WSGI应用')
+        self.app=app
+
+    def __call__(self,environ,start_response):
+        """运行应用并转换调用期HTTP异常。@param environ 原环境。
+        @param start_response 原响应函数。@return 原应用流或真实问题JSON响应流。
+        """
+        started=False
+        def begin(status,headers,exc_info=None):
+            nonlocal started
+            result=start_response(status,headers,exc_info) if exc_info is not None else start_response(status,headers)
+            started=True
+            return result
+        try:
+            return self.app(environ,begin)
+        except HTTPException as error:
+            if started:
+                raise
+            identity=environ.get('werkzeug.request_id')
+            extensions={'request_id':identity} if isinstance(identity,str) else None
+            response=problem_response(error,extensions=extensions)
+            return response(environ,start_response)
