+"""使用真实Accept权重选择JSON表示。"""
+import json
+from .exceptions import NotAcceptable
+from .wrappers import Response
+
+
+def json_response(value,request,*,offers=('application/json',),status=200):
+    """协商并编码JSON。@param value JSON数据。@param request 原Request。
+    @param offers 有序JSON媒体类型。@param status 状态。@return 含Vary Accept的真实Response。
+    """
+    offers=tuple(offers)
+    if not offers or any(not isinstance(media,str) or ';' in media or not (media=='application/json' or (media.startswith('application/') and media.endswith('+json'))) for media in offers) or len(set(offers))!=len(offers):
+        raise ValueError('需要唯一JSON媒体类型列表')
+    selected=offers[0] if 'Accept' not in request.headers else request.accept_mimetypes.best_match(offers)
+    if selected is None:
+        raise NotAcceptable()
+    data=json.dumps(value,ensure_ascii=False,allow_nan=False,separators=(',',':')).encode('utf-8')
+    response=Response(data,status=status,content_type=selected)
+    response.vary.add('Accept')
+    return response
