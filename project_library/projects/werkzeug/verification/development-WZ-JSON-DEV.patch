+# 为真实请求流添加有字节预算的严格JSON读取入口
+
+真实请求流最多读取预算加一个字节，媒体类型、编码、重复键和有限数均明确校验。不同失败返回原生HTTP异常，保留false与null语义；独立入口消费流，不改变旧get_json缓存。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/werkzeug/strict_json.py
+++ b/library/src/werkzeug/strict_json.py
@@ -0,0 +1,43 @@
+"""在明确字节预算内读取并严格解释JSON请求。"""
+import json
+from .exceptions import BadRequest,RequestEntityTooLarge,UnsupportedMediaType
+
+
+def _pairs(items):
+    result={}
+    for key,value in items:
+        if key in result:
+            raise ValueError('JSON对象键重复')
+        result[key]=value
+    return result
+
+
+def _constant(value):
+    raise ValueError('JSON不能包含非有限常量')
+
+
+def _float(value):
+    import math
+    result=float(value)
+    if not math.isfinite(result):
+        raise ValueError('JSON数字溢出')
+    return result
+
+
+def read_json(request,*,max_bytes=1048576):
+    """有限读取真实请求流。@param request 原Request。@param max_bytes 正整数字节预算。
+    @return 严格JSON值；消费请求流，不修改旧get_json的缓存或默认行为。
+    """
+    if type(max_bytes) is not int or max_bytes<1:
+        raise ValueError('需要正整数字节预算')
+    if not request.is_json or request.mimetype_params.get('charset','utf-8').lower() not in ('utf-8','utf8'):
+        raise UnsupportedMediaType('需要UTF8 JSON请求')
+    if request.content_length is not None and request.content_length>max_bytes:
+        raise RequestEntityTooLarge()
+    data=request.stream.read(max_bytes+1)
+    if len(data)>max_bytes:
+        raise RequestEntityTooLarge()
+    try:
+        return json.loads(data.decode('utf-8'),object_pairs_hook=_pairs,parse_constant=_constant,parse_float=_float)
+    except (ValueError,UnicodeError) as error:
+        raise BadRequest('无效的严格JSON请求') from error
