+
+    def walk_controlled(self,*,follow_symlinks=False,max_depth=None,exclude=(),stable=False,errors='strict'):
+        """受控深度优先遍历。@param follow_symlinks 是否进入目录链接。
+        @param max_depth 根为0的最大深度。@param exclude 相对路径fnmatch模式。
+        @param stable 是否逐目录按名字排序。@param errors 沿用原错误处理约定。@return Path迭代器。
+        """
+        if type(follow_symlinks) is not bool or type(stable) is not bool or max_depth is not None and (type(max_depth) is not int or max_depth<0):
+            raise ValueError('遍历深度或链接策略无效')
+        patterns=tuple(exclude)
+        if any(not isinstance(pattern,str) for pattern in patterns):
+            raise TypeError('排除模式必须为字符串')
+        error_fn=Handlers._resolve(errors)
+        visited=set()
+        def children(directory,depth):
+            if max_depth is not None and depth>=max_depth:
+                return
+            try:
+                identity=os.stat(directory)
+                marker=(identity.st_dev,identity.st_ino)
+                if marker in visited:
+                    return
+                visited.add(marker)
+                with os.scandir(directory) as scan:
+                    entries=list(scan)
+                if stable:
+                    entries.sort(key=lambda entry:entry.name)
+            except OSError as error:
+                error_fn(f'无法遍历{directory}: {error}')
+                return
+            for entry in entries:
+                child=self._next_class(entry.path)
+                relative=os.path.relpath(child,self).replace(os.sep,'/')
+                if any(fnmatch.fnmatchcase(relative,pattern) for pattern in patterns):
+                    continue
+                yield child
+                try:
+                    descend=entry.is_dir(follow_symlinks=follow_symlinks)
+                except OSError as error:
+                    error_fn(f'无法访问{child}: {error}')
+                    continue
+                if descend:
+                    yield from children(child,depth+1)
+        yield from children(self,0)
 
