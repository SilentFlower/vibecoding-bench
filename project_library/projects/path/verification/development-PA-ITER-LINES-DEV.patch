+    def iter_lines(self,encoding=None,errors='strict',*,retain=True,newline=None):
+        """逐行读取并在关闭生成器时关闭文件。@param encoding 编码。@param errors 解码策略。
+        @param retain 是否保留行结束。@param newline None通用归一化或空串保留原CR/LF。
+        @return 字符串迭代器，不先读取整份文件。
+        """
+        if type(retain) is not bool or newline not in (None,''):
+            raise ValueError('逐行读取保留或换行策略无效')
+        with self.open('r',encoding=encoding,errors=errors,newline=newline) as stream:
+            for line in stream:
+                yield line if retain else line.removesuffix('\n').removesuffix('\r')
