+    if collision not in ('last', 'first', 'error', 'combine'):
+        raise ValueError('未知映射键冲突政策')
+    if collision == 'combine' and not callable(combine):
+        raise TypeError('合并政策必须提供combine函数')
+    rv = factory()
+    origins = {}
+    for key, value in d.items():
