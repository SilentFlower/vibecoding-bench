+"""显式策略的JSON树深合并，不改变可执行Delta语义。"""
+from copy import deepcopy
+from math import isfinite
+from deepdiff import DeepDiff
+
+
+class MergeConflict(ValueError):
+    """携带结构位置，不在错误消息打印来源值。
+
+    :param path: 从根开始的字符串键/数组下标元组。
+    :return: 可检查path的冲突异常。
+    """
+    def __init__(self, path):
+        """保存稳定位置。@return None。"""
+        self.path = tuple(path)
+        super().__init__('JSON合并冲突：%s' % (self.path,))
+
+
+def validate_json_tree(value):
+    """限制为有限JSON树，拒绝循环但允许无循环共享引用。
+
+    :param value: dict/list及JSON标量组成的树。
+    :return: None；不支持类型或循环抛异常。
+    """
+    def visit(item, parents):
+        if item is None or type(item) in (str, bool, int):
+            return
+        if type(item) is float:
+            if not isfinite(item):
+                raise ValueError('JSON树不允许非有限数')
+            return
+        if type(item) not in (dict, list):
+            raise TypeError('只支持JSON树，不合并任意对象')
+        if id(item) in parents:
+            raise ValueError('JSON树不允许循环')
+        parents = parents | {id(item)}
+        if isinstance(item, dict):
+            if any(type(key) is not str for key in item):
+                raise TypeError('JSON对象键必须为文本')
+            children = item.values()
+        else:
+            children = item
+        for child in children:
+            visit(child, parents)
+    visit(value, set())
+
+
+def json_equal(left, right):
+    """用真实DeepDiff保留布尔/数值类型差别。@return bool。"""
+    return not DeepDiff(left, right, threshold_to_diff_deeper=0)
+
+
+def deep_merge(left, right, *, lists='replace', conflicts='right'):
+    """构造独立组合结果，词典递归、列表及叶冲突各有政策。
+
+    :param left: 左JSON树。
+    :param right: 右JSON树。
+    :param lists: replace用右列表，append连接并保留重复项。
+    :param conflicts: 不同叶值或类型冲突的right、left、error策略。
+    :return: 不与输入共享容器的合并树。
+    """
+    if lists not in ('replace', 'append') or conflicts not in ('right', 'left', 'error'):
+        raise ValueError('未知合并策略')
+    validate_json_tree(left)
+    validate_json_tree(right)
+    def combine(a, b, path):
+        if isinstance(a, dict) and isinstance(b, dict):
+            result = {}
+            for key in dict.fromkeys([*a, *b]):
+                if key in a and key in b:
+                    result[key] = combine(a[key], b[key], path + (key,))
+                else:
+                    result[key] = deepcopy(a[key] if key in a else b[key])
+            return result
+        if isinstance(a, list) and isinstance(b, list):
+            return deepcopy(a + b if lists == 'append' else b)
+        if json_equal(a, b):
+            return deepcopy(a)
+        if conflicts == 'error':
+            raise MergeConflict(path)
+        return deepcopy(a if conflicts == 'left' else b)
+    return combine(left, right, ())
