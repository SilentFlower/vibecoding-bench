+            combined = f"{attr_token.attrs['class']} {attrs['class']}"
+            # span既有连续属性语料按规范化class集合输出；链接/单Token仍保留原声明顺序。
+            attrs["class"] = " ".join(dict.fromkeys(combined.split())) if attr_token.type == "span_open" else combined
         _add_attrs(attr_token, attrs, allowed)
