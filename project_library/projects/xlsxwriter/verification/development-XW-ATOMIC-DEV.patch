+# 提供关闭成功后才替换目标文件的原子工作簿上下文
+
+工作簿在同目录临时文件中完整生成并成功关闭后才替换目标。异常时保留旧文件和原始错误，清理临时资产并保留旧权限，不把单文件替换误称为跨文件事务。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/xlsxwriter/atomic.py
+++ b/library/xlsxwriter/atomic.py
@@ -0,0 +1,37 @@
+"""同目录临时生成完整XLSX，成功关闭后才替换目标。"""
+import os
+import stat
+import tempfile
+from contextlib import contextmanager
+from pathlib import Path
+from .workbook import Workbook
+
+
+@contextmanager
+def atomic_workbook(destination,options=None):
+    """原子替换工作簿文件。@param destination 本地目标。@param options 原Workbook选项。
+    @return 上下文产出真实Workbook；失败保留旧文件并清理临时文件。
+    """
+    path=Path(destination)
+    if path.is_symlink() or (path.exists() and not path.is_file()):
+        raise ValueError('目标必须为普通文件路径')
+    mode=stat.S_IMODE(path.stat().st_mode) if path.exists() else None
+    descriptor,name=tempfile.mkstemp(prefix='.'+path.name+'.',suffix='.xlsx',dir=path.parent)
+    os.close(descriptor);book=None;closed=False
+    try:
+        book=Workbook(name,dict(options or {}))
+        yield book
+        book.close();closed=True
+        if mode is not None:
+            os.chmod(name,mode)
+        with open(name,'rb') as stream:
+            os.fsync(stream.fileno())
+        os.replace(name,path)
+    finally:
+        if book is not None and not closed:
+            try:
+                book.close()
+            except Exception:
+                pass
+        if os.path.exists(name):
+            os.unlink(name)
