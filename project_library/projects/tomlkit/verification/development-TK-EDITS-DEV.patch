+# 在格式保留副本上事务式实施配置路径编辑
+
+配置界面一次提交多项路径编辑，在独立副本上依次测试、设置和删除；任何后项失败都不改变原文档。保留未触及格式与注释，区分字面键和数组索引，最终生成的TOML必须能重新解析。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/tomlkit/editing.py
+++ b/library/tomlkit/editing.py
@@ -0,0 +1,45 @@
+"""在副本上实施有序配置编辑，失败不改变原文档。"""
+from collections.abc import Mapping, MutableMapping, MutableSequence
+from copy import deepcopy
+from tomlkit.api import parse, table
+
+
+def apply_edits(document, operations):
+    """原子构造编辑后的文档。@param document TOML文档。@param operations op/path/value记录序列。
+    @return 独立文档；支持set、delete、test，路径字符串键及非负数组索引，set可显式create。
+    """
+    operations = list(operations)
+    working = deepcopy(document)
+    for operation in operations:
+        if not isinstance(operation, Mapping) or operation.get('op') not in ('set','delete','test'):
+            raise ValueError('未知编辑操作')
+        path = operation.get('path')
+        if isinstance(path, (str, bytes)):
+            raise ValueError('路径必须是组件序列')
+        path = tuple(path or ())
+        if not path or any(not isinstance(part, str) and not (type(part) is int and part >= 0) for part in path):
+            raise ValueError('路径组件必须为字符串或非负整数')
+        parent = working
+        for index, part in enumerate(path[:-1]):
+            if isinstance(parent, MutableMapping) and part not in parent and operation.get('create') and operation['op']=='set':
+                if not isinstance(path[index+1], str):
+                    raise ValueError('不能自动创建数组父节点')
+                parent[part] = table()
+            parent = parent[part]
+        last = path[-1]
+        if isinstance(parent, MutableSequence):
+            if type(last) is not int or last >= len(parent):
+                raise IndexError('数组路径越界')
+        elif not isinstance(parent, MutableMapping) or not isinstance(last, str):
+            raise TypeError('路径父节点类型不匹配')
+        if operation['op']=='test':
+            actual=parent[last]
+            actual=actual.unwrap() if hasattr(actual,'unwrap') else actual
+            if type(actual) is not type(operation['value']) or actual != operation['value']:
+                raise ValueError('配置前置值不匹配')
+        elif operation['op']=='delete':
+            del parent[last]
+        else:
+            parent[last]=deepcopy(operation['value'])
+    parse(working.as_string())
+    return working
