+# 按明确数组和冲突策略递归合并配置层
+
+发布配置分层合并需要明确数组是替换、追加还是去重，标量冲突可选拒绝。所有工作在独立副本完成，保留基础文档未触及注释和布局，输入节点不共享，最终文本重新解析通过。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/tomlkit/merging.py
+++ b/library/tomlkit/merging.py
@@ -0,0 +1,36 @@
+"""按显式数组及冲突策略合并配置副本。"""
+from collections.abc import Mapping
+from copy import deepcopy
+from tomlkit.api import parse
+from tomlkit.items import Array, AoT
+
+
+def merge_documents(base, overlay, *, arrays='replace', conflicts='replace'):
+    """递归合并配置。@param base 原文档。@param overlay 覆盖映射。
+    @param arrays replace/append/unique。@param conflicts replace/error。@return 独立可解析文档。
+    """
+    if arrays not in ('replace','append','unique') or conflicts not in ('replace','error'):
+        raise ValueError('未知配置合并策略')
+    if not isinstance(overlay, Mapping):
+        raise TypeError('覆盖层必须是映射')
+    working=deepcopy(base)
+    def combine(target, source):
+        for key, value in source.items():
+            if key not in target:
+                target[key]=deepcopy(value)
+            elif isinstance(target[key],Mapping) and isinstance(value,Mapping):
+                combine(target[key],value)
+            elif isinstance(target[key],(list,Array,AoT)) and isinstance(value,(list,Array,AoT)):
+                if arrays=='replace':
+                    target[key]=deepcopy(value)
+                else:
+                    for item in value:
+                        if arrays=='append' or item not in target[key]:
+                            target[key].append(deepcopy(item))
+            elif conflicts=='error' and target[key] != value:
+                raise ValueError('配置值冲突：'+str(key))
+            else:
+                target[key]=deepcopy(value)
+    combine(working,overlay)
+    parse(working.as_string())
+    return working
