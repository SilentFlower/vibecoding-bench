+    def _resolve_url(self, value, kind):
+        """统一解析实际链接目的地，不触发任何网络访问。
+
+        :param value: HTML中的原目的地，空值保持无目的地。
+        :param kind: link、image、video或poster。
+        :return: 基址解析并由回调一次变换后的字符串，None回调结果表示省略。
+        """
+        from urllib.parse import urljoin
+        if not value:
+            return ''
+        base = self.options.get('base_url')
+        if base is not None and not isinstance(base, str):
+            raise TypeError('base_url必须为字符串或None')
+        resolved = urljoin(base, value) if base and not value.startswith('#') else value
+        transform = self.options.get('url_transform')
+        if transform is not None:
+            if not callable(transform):
+                raise TypeError('url_transform必须可调用')
+            resolved = transform(resolved, kind)
+            if resolved is None:
+                return ''
+            if not isinstance(resolved, str):
+                raise TypeError('url_transform必须返回字符串或None')
+        return resolved
