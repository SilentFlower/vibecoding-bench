+# 为抽象PathLike字段指定不访问文件的文本策略
+
+抽象PathLike文本注解通过真实谓词钩子导出fspath字符串，并用明确工厂读入。支持嵌套JSON和自定义实现；bytes路径及坏工厂明确拒绝，不隐式解码、不访问文件，既有具体Path能力保持。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/cattrs/strategies/pathlike.py
+++ b/library/src/cattrs/strategies/pathlike.py
@@ -0,0 +1,33 @@
+"""抽象文本路径注解的显式双向转换策略，不访问文件。"""
+from os import PathLike, fspath
+from pathlib import Path
+from typing import get_origin
+
+
+def configure_pathlike(converter, *, factory=Path):
+    """为抽象PathLike文本字段绑定显式读入工厂。
+
+    :param converter: 当前真实转换器。
+    :param factory: 接收文本并返回文本PathLike的调用者工厂。
+    :return: 同一转换器，具体Path默认和用户后注册钩子保持。
+    """
+    def supported(target):
+        """只匹配抽象PathLike及其泛型注解。@param target 注解。@return 是否匹配。"""
+        return target is PathLike or get_origin(target) is PathLike
+    def unstructure(value):
+        """严格输出文本路径。@param value PathLike。@return str。"""
+        text = fspath(value)
+        if not isinstance(text, str):
+            raise TypeError('抽象路径策略不解码bytes路径')
+        return text
+    def structure(value, target):
+        """用显式工厂读入文本。@param value 文本。@param target 注解。@return PathLike。"""
+        if not isinstance(value, str):
+            raise TypeError('抽象路径输入必须为文本')
+        result = factory(value)
+        if not isinstance(result, PathLike) or not isinstance(fspath(result), str):
+            raise TypeError('路径工厂必须返回文本PathLike')
+        return result
+    converter.register_unstructure_hook_func(supported, unstructure)
+    converter.register_structure_hook_func(supported, structure)
+    return converter
