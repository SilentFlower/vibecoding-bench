@@ -0,0 +1,5 @@
+# 显式配置双向且严格的base64二进制传输
+
+给单个转换器配置双向base64，覆盖嵌套记录、空载荷及全部字节，可明确选择URL字母表。严格拒绝padding、字符和非ASCII错误，不猜格式、不改其他实例base85默认，后注册用户钩子仍优先。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/cattrs/strategies/base64.py
+++ b/library/src/cattrs/strategies/base64.py
@@ -0,0 +1,24 @@
+"""显式base64策略，不自动猜测输入编码。"""
+from base64 import b64decode, b64encode, urlsafe_b64encode
+from binascii import Error
+
+
+def configure_base64(converter, *, urlsafe=False):
+    """为单个真实转换器注册成对bytes钩子。
+
+    :param converter: 现有转换器。
+    :param urlsafe: 明确选择URL安全字母表，仍要求合法padding。
+    :return: 同一转换器；未配置实例的base85默认不变。
+    """
+    encode = urlsafe_b64encode if urlsafe else b64encode
+    def structure(value, target):
+        """严格读取ASCII base64文本。@param value 文本。@param target 目标。@return bytes。"""
+        if not isinstance(value, str):
+            raise TypeError('base64输入必须为字符串')
+        try:
+            return b64decode(value.encode('ascii'), altchars=b'-_' if urlsafe else None, validate=True)
+        except (Error, UnicodeError, ValueError) as error:
+            raise ValueError('无效base64文本') from error
+    converter.register_structure_hook(bytes, structure)
+    converter.register_unstructure_hook(bytes, lambda value: encode(value).decode('ascii'))
+    return converter
--- a/library/tests/test_development_cattrs_o03_dev.py
+++ b/library/tests/test_development_cattrs_o03_dev.py
@@ -0,0 +1,31 @@
+"""base64策略应双向且严格，不影响其他预配置实例。"""
+from dataclasses import dataclass
+import pytest
+from cattrs.preconf.json import make_converter
+
+def test_standard_and_nested_roundtrip():
+    """嵌套bytes真实JSON往返。@return None。"""
+    from cattrs.strategies.base64 import configure_base64
+    @dataclass
+    class Packet:
+        """二进制载荷。"""
+        payload: bytes
+    converter = configure_base64(make_converter())
+    assert converter.unstructure(b'hello') == 'aGVsbG8='
+    assert converter.loads(converter.dumps(Packet(b'\x00\xff')), Packet) == Packet(b'\x00\xff')
+
+def test_invalid_padding_and_characters():
+    """坏padding、非ASCII和非法字符拒绝。@return None。"""
+    from cattrs.strategies.base64 import configure_base64
+    converter = configure_base64(make_converter())
+    for value in ['aGVsbG8', '!!!!', '中文']:
+        with pytest.raises(ValueError): converter.structure(value, bytes)
+    assert converter.structure('', bytes) == b''
+
+def test_urlsafe_and_default_isolation():
+    """显式URL字母表和未配置实例默认可区分。@return None。"""
+    from cattrs.strategies.base64 import configure_base64
+    converter = configure_base64(make_converter(), urlsafe=True)
+    assert converter.unstructure(b'\xfb\xff') == '-_8='
+    assert converter.structure('-_8=', bytes) == b'\xfb\xff'
+    assert make_converter().unstructure(b'hello') != 'aGVsbG8='
