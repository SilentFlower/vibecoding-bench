            "version": 1,
            "rubric": "verification/AG-C02.rubric.json",
            "semantic": true,
            "native": "verification/AG-C02.native.json"
          },
          "branches": []
        }
      ]
    },
    {
      "id": "AG-S03",
      "title": "维表匹配取证与准入",
      "goal": "按真实连接语义检查一对一关系和数量守恒",
      "default_entry": "normal",
      "entries": [
        {
          "id": "normal",
          "task_ids": [
            "AG-D01",
            "AG-P01"
          ]
        },
        {
          "id": "diagnose_only",
          "task_ids": [
            "AG-D01"
          ]
        },
        {
          "id": "unavailable",
          "task_ids": [
            "AG-D01"
          ],
          "materials": [
            "disclosure/unavailable.md"
          ]
        }
      ],
      "tasks": [
        {
          "id": "AG-D01",
          "kind": "diagnose",
          "goal": "先取左右表和匹配参数再解释报表放大",
          "prompt": "Investigate the supplied enrichment symptom. Request sufficient actual rows, join arguments and expected key cardinality before choosing a cause. Diagnose disclosed evidence only or close with an evidence plan if unavailable. Do not change code/data.",
          "requires": [],
          "materials": [
            "materials/join-symptom.md"
          ],
          "allowed_paths": [],
          "outcomes": [
            "diagnosed_no_code_change",
            "insufficient_information"
          ],
          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/AG-D01.rubric.json",
            "semantic": true
          },
          "branches": [
            {
              "id": "join-evidence",
              "when": "The actual tables/cardinalities and join arguments have not been supplied or declared unavailable, and the answer reasonably requests sufficient evidence.",
              "materials": [
                "disclosure/join.md"
              ]
            }
          ]
        },
        {
          "id": "AG-P01",
          "kind": "plan",
          "goal": "规划一对一维表准入和连接后守恒检查",
          "prompt": "Plan the complete one-approved-dimension-match requirement with existing APIs. Explain duplicate/missing controls, require_match limits and post-join count/quantity checks. Do not implement or invent transactions/unique constraints.",
          "requires": [],
          "materials": [
            "materials/join-policy.md",
            "materials/dimension-controls.md"
          ],
          "allowed_paths": [],
          "outcomes": [
            "planned_without_library_change"
          ],
          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/AG-P01.rubric.json",
            "semantic": true,
            "native": "verification/AG-P01.native.json"
          },
          "branches": []
        }
      ]
    },
