          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/AG-C01.rubric.json",
            "semantic": true,
            "native": "verification/AG-C01.native.json"
          },
          "branches": []
        },
        {
          "id": "AG-U02",
          "kind": "understand",
          "goal": "解释有限推断样本的后续转换和内存边界",
          "prompt": "Trace both complete sampling reproductions and full inference. State actual failure/source consumption and whether the inference limit guarantees streaming or whole-file schema compatibility. Do not edit files.",
          "requires": [],
          "materials": [
            "materials/sampling.md"
          ],
          "allowed_paths": [],
          "outcomes": [
            "explained"
          ],
          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/AG-U02.rubric.json",
            "semantic": true,
            "native": "verification/AG-U02.native.json"
          },
          "branches": []
        }
      ]
    },
    {
