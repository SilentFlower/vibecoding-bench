    {
      "id": "AG-S01",
      "title": "编号与导入schema",
      "goal": "按业务含义决定类型、空值和推断样本",
      "default_entry": "normal",
      "entries": [
        {
          "id": "normal",
          "task_ids": [
            "AG-U01",
            "AG-C01",
            "AG-U02"
          ]
        }
      ],
      "tasks": [
        {
          "id": "AG-U01",
          "kind": "understand",
          "goal": "追踪编号和空值在推断后的真实类型",
          "prompt": "Trace the supplied CSV under default type inference. Report exact first-row identifier, amount and note values/types and explain why this may violate the business meaning. Do not modify files.",
          "requires": [],
          "materials": [
            "materials/input.csv",
            "materials/types.md"
          ],
          "allowed_paths": [],
          "outcomes": [
            "explained"
