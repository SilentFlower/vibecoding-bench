          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/AG-U01.rubric.json",
            "semantic": true,
            "native": "verification/AG-U01.native.json"
          },
          "branches": []
        },
        {
          "id": "AG-C01",
          "kind": "consult",
          "goal": "用已有列类型保留外部编号和字面NA",
          "prompt": "Recommend the supplied exact-ID/literal-note import policy with current APIs while keeping amount numeric. Give preservation controls and distinguish absent None from literal null tokens. No implementation is authorized.",
          "requires": [],
          "materials": [
            "materials/input.csv",
            "materials/types.md"
          ],
          "allowed_paths": [],
          "outcomes": [
            "advice_no_code_change"
