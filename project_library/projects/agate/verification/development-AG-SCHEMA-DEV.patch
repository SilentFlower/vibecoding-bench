+"""显式表级数据约束验证，不重写导入或隐式修改业务数据。"""
+from collections.abc import Mapping
+
+from agate.table import Table
+
+
+class SchemaValidationError(ValueError):
+    """严格校验错误。@param errors 不包含业务值的结构化错误列表。"""
+
+    def __init__(self, errors):
+        """保存独立错误副本。@param errors 错误列表。@return None。"""
+        self.errors = tuple(dict(error) for error in errors)
+        super().__init__('表格数据不符合显式约束')
+
+
+class Schema:
+    """表级显式约束。@param columns 列名到nullable/unique/min/max/choices的映射。"""
+
+    def __init__(self, columns):
+        """校验并复制配置。@param columns 有限约束映射。@return None。"""
+        if not isinstance(columns, Mapping):
+            raise TypeError('schema必须是列约束映射')
+        self._columns = {}
+        for name, rules in columns.items():
+            if not isinstance(name, str) or not isinstance(rules, Mapping):
+                raise TypeError('列名和约束类型不合法')
+            if set(rules) - {'nullable', 'unique', 'min', 'max', 'choices'}:
+                raise ValueError('包含未知约束')
+            copy = dict(rules)
+            for field in ('nullable', 'unique'):
+                if field in copy and type(copy[field]) is not bool:
+                    raise TypeError('开关约束必须是布尔值')
+            if 'choices' in copy:
+                if not isinstance(copy['choices'], (list, tuple, set, frozenset)):
+                    raise TypeError('枚举约束必须是有限集合或序列')
+                copy['choices'] = tuple(copy['choices'])
+            if any(field in copy and copy[field] is None for field in ('min', 'max')):
+                raise TypeError('边界不能是None')
+            if 'min' in copy and 'max' in copy and copy['min'] > copy['max']:
+                raise ValueError('最小边界不能大于最大边界')
+            self._columns[name] = copy
+
+    def validate(self, table, *, strict=False, max_errors=None):
+        """只读校验实际表。@param table Table。@param strict 是否抛结构化异常。
+        @param max_errors 正整数错误上限或None。@return 不含实际值的row/column/code列表。
+        """
+        if not isinstance(table, Table) or type(strict) is not bool:
+            raise TypeError('表和严格模式类型不合法')
+        if max_errors is not None and (type(max_errors) is not int or max_errors < 1):
+            raise ValueError('错误上限必须是正整数')
+        for name in self._columns:
+            if name not in table.column_names:
+                raise KeyError(name)
+        errors, seen = [], {name: [] for name in self._columns}
+        stop = False
+        for index, row in enumerate(table.rows):
+            for name, rules in self._columns.items():
+                value = row[name]
+                codes = []
+                if value is None:
+                    if not rules.get('nullable', True):
+                        codes.append('null')
+                else:
+                    if rules.get('unique'):
+                        if any(value == previous for previous in seen[name]):
+                            codes.append('unique')
+                        seen[name].append(value)
+                    if 'min' in rules and value < rules['min']:
+                        codes.append('min')
+                    if 'max' in rules and value > rules['max']:
+                        codes.append('max')
+                    if 'choices' in rules and value not in rules['choices']:
+                        codes.append('choice')
+                for code in codes:
+                    errors.append({'row': index, 'column': name, 'code': code})
+                    if max_errors is not None and len(errors) >= max_errors:
+                        stop = True
+                        break
+                if stop:
+                    break
+            if stop:
+                break
+        if strict and errors:
+            raise SchemaValidationError(errors)
+        return errors
