+    def resize(self,maxsize):
+        """按原淘汰策略调整容量。@param maxsize 非负实数，允许正无穷。
+        @return 仅因容量收缩而淘汰的(key,value)元组；正常过期清理单独发生。
+        """
+        import math
+        if type(maxsize) not in (int,float) or math.isnan(maxsize) or maxsize<0:
+            raise ValueError('容量必须为非负实数')
+        expire=getattr(self,'expire',None)
+        if callable(expire):
+            expire()
+        removed=[]
+        while self.__currsize>maxsize:
+            removed.append(self.popitem())
+        self.__maxsize=maxsize
+        return tuple(removed)
 
