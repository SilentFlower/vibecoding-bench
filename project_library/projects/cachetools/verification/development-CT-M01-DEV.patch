+class KeywordReceiverRegressionTests(unittest.TestCase):
+    """验证类入口关键字receiver与既有调用等价。"""
+
+    def test_keyword_receiver_and_cache_info(self):
+        """相同业务键保持一次求值及后续命中。@return None。"""
+        class Catalog:
+            """保存独立业务缓存。"""
+            def __init__(self):
+                """初始化缓存。@return None。"""
+                self.cache = Cache(8)
+
+            @cachedmethod(lambda obj: obj.cache, info=True)
+            def get(self, value):
+                """返回业务输入。@param value 输入。@return 输入。"""
+                return value
+
+        catalog = Catalog()
+        self.assertEqual(catalog.get(value=3), 3)
+        self.assertEqual(Catalog.get(catalog, value=3), 3)
+        self.assertEqual(Catalog.get(self=catalog, value=3), 3)
+        self.assertEqual(catalog.get.cache_info().misses, 1)
+        self.assertEqual(catalog.get.cache_info().hits, 2)
+
+    def test_nonstandard_receiver_name(self):
+        """关键字绑定读取真实receiver名，不硬编码self。@return None。"""
+        class Catalog:
+            """采用自定义receiver参数名。"""
+            def __init__(self):
+                """创建缓存。@return None。"""
+                self.cache = {}
+
+            @cachedmethod(lambda obj: obj.cache)
+            def get(owner, value):
+                """返回实际参数。@param owner 实例。@param value 输入。@return 输入。"""
+                return value
+
+        catalog = Catalog()
+        self.assertEqual(Catalog.get(owner=catalog, value=7), 7)
