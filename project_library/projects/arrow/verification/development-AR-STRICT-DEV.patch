+        if type(normalize_whitespace) is not bool or type(exact_width) is not bool:
+            raise TypeError('严格解析开关必须是布尔值')
+        formats = [fmt] if isinstance(fmt, str) else fmt
+        if not isinstance(formats, list) or not formats or any(not isinstance(item, str) for item in formats):
+            raise TypeError('格式必须是字符串或非空字符串列表')
+        text = re.sub(r"\s+", " ", datetime_string) if normalize_whitespace else datetime_string
+        for candidate in formats:
+            try:
+                tokens, pattern = self._generate_pattern_re(candidate)
+                match = pattern.fullmatch(text)
+                if match is None or not tokens:
