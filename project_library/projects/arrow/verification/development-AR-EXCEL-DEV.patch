+    def to_excel(self, *, date_system):
+        """以本地墙钟转换Excel序号。@param date_system 字符串1900或1904。@return Decimal序号。
+        """
+        if date_system not in ('1900','1904'):
+            raise ValueError('必须明确选择1900或1904日期系统')
+        value = self._datetime.replace(tzinfo=None)
+        origin = dt_datetime(1899,12,31) if date_system == '1900' else dt_datetime(1904,1,1)
+        delta = value - origin
+        micros = (delta.days * 86400 + delta.seconds) * 1000000 + delta.microseconds
+        if date_system == '1900' and value >= dt_datetime(1900,3,1):
+            micros += 86400000000
+        with localcontext() as context:
+            context.prec = 50
+            return Decimal(micros) / Decimal(86400000000)
 
