+            micros = int((value * Decimal(86400000000)).to_integral_value(rounding=ROUND_HALF_EVEN))
+        day = micros // 86400000000
+        if date_system == '1900' and day == 60:
+            raise ValueError('微秒舍入落入不存在的1900-02-29')
+        if date_system == '1900' and day > 60:
+            micros -= 86400000000
+        origin = dt_datetime(1899,12,31) if date_system == '1900' else dt_datetime(1904,1,1)
+        value = origin + timedelta(microseconds=micros)
+        return cls.fromdatetime(value, tzinfo=tzinfo)
