+"""完整序列化后以原子替换发布单个订阅文件。"""
+import hashlib
+import os
+import stat
+import tempfile
+from dataclasses import dataclass
+from pathlib import Path
+from .json_feed import json_feed_str
+
+
+@dataclass(frozen=True)
+class FeedArtifact:
+    """已成功发布的订阅格式、字节数和内容摘要。"""
+    format: str
+    size: int
+    sha256: str
+
+
+def write_feed(feed,destination,*,format='atom',pretty=False):
+    """发布单订阅文件。@param feed 原订阅。@param destination 本地普通文件。
+    @param format atom/rss/json。@param pretty 是否格式化。@return 成功替换后的FeedArtifact。
+    """
+    if format not in ('atom','rss','json'):
+        raise ValueError('不支持的订阅格式')
+    if format=='json':
+        data=json_feed_str(feed,pretty=pretty)
+    else:
+        data=(feed.atom_str if format=='atom' else feed.rss_str)(pretty=pretty,encoding='UTF-8')
+    if not isinstance(data,bytes):
+        raise TypeError('订阅序列化必须返回字节')
+    destination=Path(destination)
+    if destination.is_symlink() or (destination.exists() and not destination.is_file()):
+        raise ValueError('目标必须为普通文件路径')
+    mode=stat.S_IMODE(destination.stat().st_mode) if destination.exists() else None
+    descriptor,name=tempfile.mkstemp(prefix='.'+destination.name+'.',dir=destination.parent)
+    try:
+        with os.fdopen(descriptor,'wb') as stream:
+            descriptor=None;stream.write(data);stream.flush();os.fsync(stream.fileno())
+        if mode is not None:
+            os.chmod(name,mode)
+        os.replace(name,destination)
+        return FeedArtifact(format,len(data),hashlib.sha256(data).hexdigest())
+    finally:
+        if descriptor is not None:
+            os.close(descriptor)
+        if os.path.exists(name):
+            os.unlink(name)
