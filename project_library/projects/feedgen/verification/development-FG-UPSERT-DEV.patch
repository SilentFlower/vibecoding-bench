+# 按永久ID批量更新订阅条目并保持已有位置
+
+按永久ID维护订阅，已有条目在原位置替换，新条目按输入顺序追加。完整验证后才提交，保留无关条目对象和订阅元数据，不凭标题猜测同一内容。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/feedgen/upsert.py
+++ b/library/feedgen/upsert.py
@@ -0,0 +1,38 @@
+"""以永久条目ID维护已有订阅，不打乱更新位置。"""
+from dataclasses import dataclass
+from .entry import FeedEntry
+from .feed import FeedGenerator
+
+
+@dataclass(frozen=True)
+class UpsertResult:
+    """成功替换及新增的条目数量。"""
+    added: int
+    updated: int
+
+
+def upsert_entries(feed,entries):
+    """批量按ID更新。@param feed 真实FeedGenerator。@param entries FeedEntry迭代器。
+    @return UpsertResult；输入验证失败不修改原条目列表或原条目。
+    """
+    if not isinstance(feed,FeedGenerator):
+        raise TypeError('需要FeedGenerator')
+    existing=list(feed.entry());incoming=list(entries)
+    def identities(items):
+        result=[]
+        for item in items:
+            if not isinstance(item,FeedEntry) or not isinstance(item.id(),str) or not item.id():
+                raise ValueError('每个条目必须有非空文本ID')
+            if item.id() in result:
+                raise ValueError('同一批条目ID重复')
+            result.append(item.id())
+        return result
+    old_ids=identities(existing);identities(incoming)
+    positions={identity:index for index,identity in enumerate(old_ids)};added=0;updated=0
+    for item in incoming:
+        if item.id() in positions:
+            existing[positions[item.id()]]=item;updated+=1
+        else:
+            positions[item.id()]=len(existing);existing.append(item);added+=1
+    feed.entry(existing,replace=True)
+    return UpsertResult(added,updated)
