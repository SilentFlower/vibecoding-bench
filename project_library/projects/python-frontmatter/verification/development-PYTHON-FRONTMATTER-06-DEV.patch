+# 文档编辑通过严格解析和原子替换避免半写及版本冲突
+
+路线06：完整文档安全编辑API，先严格解析、按真实格式与编码转换，再同目录临时文件fsync后原子替换；版本摘要和转换期间源变化明确冲突，符号链接拒绝。替换前失败保留原文并清理临时文件，权限与属主保留。乐观检查不宣称能锁住不合作进程，复用先前解析结果和二进制流能力。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/frontmatter/atomic.py
+++ b/library/frontmatter/atomic.py
@@ -0,0 +1,52 @@
+"""同目录原子替换式文档编辑，失败前不破坏源文件。"""
+import hashlib
+import io
+import os
+import stat
+import tempfile
+from pathlib import Path
+from frontmatter import Post, dumps, load
+from frontmatter.parsing import parse_result
+
+
+class UpdateConflict(ValueError):
+    """输入版本或提交前源文件已变化，拒绝覆盖。"""
+
+
+def atomic_update(path, transform, encoding='utf-8', expected_sha256=None):
+    """严格读取后以同目录临时文件提交完整新文档。@param path 已有普通文件。@param transform 返回Post的转换。@param encoding 编码。@param expected_sha256 可选原字节摘要。@return 提交的Post。"""
+    target = Path(path)
+    before = target.lstat()
+    if not stat.S_ISREG(before.st_mode):
+        raise ValueError('只允许已有普通文件，不跟随符号链接')
+    raw = target.read_bytes()
+    digest = hashlib.sha256(raw).hexdigest()
+    if expected_sha256 is not None and expected_sha256 != digest:
+        raise UpdateConflict('文档版本已经变化')
+    parse_result(raw, encoding=encoding, strict=True)
+    post = load(io.BytesIO(raw), encoding=encoding)
+    updated = transform(post)
+    if not isinstance(updated, Post):
+        raise TypeError('转换必须返回Post')
+    payload = dumps(updated).encode(encoding)
+    temporary = None
+    try:
+        descriptor, temporary = tempfile.mkstemp(prefix='.'+target.name+'.', suffix='.tmp', dir=target.parent)
+        with os.fdopen(descriptor, 'wb') as output:
+            os.fchmod(output.fileno(), stat.S_IMODE(before.st_mode))
+            owned = os.fstat(output.fileno())
+            if (owned.st_uid, owned.st_gid) != (before.st_uid, before.st_gid):
+                os.fchown(output.fileno(), before.st_uid, before.st_gid)
+            output.write(payload)
+            output.flush()
+            os.fsync(output.fileno())
+        now = target.lstat()
+        # 这是乐观并发检查；不承诺锁住不合作外部进程在检查后的写入。
+        if not stat.S_ISREG(now.st_mode) or (now.st_dev, now.st_ino, now.st_mtime_ns, now.st_size) != (before.st_dev, before.st_ino, before.st_mtime_ns, before.st_size) or hashlib.sha256(target.read_bytes()).hexdigest() != digest:
+            raise UpdateConflict('提交前源文档已经变化')
+        os.replace(temporary, target)
+        temporary = None
+        return updated
+    finally:
+        if temporary is not None:
+            os.unlink(temporary)
