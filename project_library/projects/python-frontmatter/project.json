              "materials": [
                "disclosure/request-evidence.md"
              ]
            }
          ]
        },
        {
          "id": "FM-FX-01",
          "kind": "modify",
          "goal": "修复合法保留键元数据的读取冲突并保持兼容",
          "prompt": "请修复这个读取问题。文档里的 content 是业务摘要字段，要和正文分别保留；handler 也可能是业务字段。现有 Post 构造方式和普通文档用法要继续兼容，请加必要回归验证。\n完整复现：import frontmatter；text = \"---\\ncontent: 备用摘要\\n---\\n正文\"；frontmatter.loads(text) 报 TypeError: Post.__init__() got multiple values for argument 'content'。\n允许修改 library/frontmatter、相关 tests 与说明；不改变 Post.to_dict 的既有扁平输出合同，不顺带扩展格式保真或深合并。",
          "requires": [],
          "materials": [],
          "allowed_paths": [
            "library/frontmatter",
            "library/tests",
            "library/README.md",
            "library/docs",
            "app/tmp"
          ],
          "outcomes": [
            "implemented"
          ],
          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/FM-FX-01.rubric.json",
            "native": "verification/repair.native.json"
          },
          "branches": []
        }
      ]
    },
