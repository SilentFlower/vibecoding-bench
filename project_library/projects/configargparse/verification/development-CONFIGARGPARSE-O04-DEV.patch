+    def discover_config_files(self):
+        """只发现默认源，不打开文件、不调用provider、不运行参数动作。
+
+        :return: 保留声明和匹配顺序的字典列表；路径含exists，provider只标记索引。
+        """
+        discovered = []
+        for index, entry in enumerate(self._default_config_files):
+            if isinstance(entry, (str, bytes, os.PathLike)):
+                pattern = os.path.expanduser(os.fsdecode(os.fspath(entry)))
+                matches = glob.glob(pattern)
+                for path in matches:
+                    discovered.append({'kind': 'path', 'index': index, 'path': path, 'exists': True})
+                if not matches:
+                    discovered.append({'kind': 'path', 'index': index, 'path': pattern, 'exists': False})
