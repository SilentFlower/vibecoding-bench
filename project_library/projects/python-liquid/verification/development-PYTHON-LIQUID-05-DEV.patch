+"""离线模板源码包，只存JSON源码及可核验摘要，不反序列化Python对象。"""
+import hashlib
+import json
+from collections.abc import Mapping
+from dataclasses import dataclass
+from types import MappingProxyType
+from .environment import Environment
+from .builtin.loaders.dict_loader import DictLoader
+
+def _canonical(value):return json.dumps(value,ensure_ascii=False,sort_keys=True,separators=(',',':')).encode('utf-8')
+
+@dataclass(frozen=True)
+class TemplateBundle:
+    """验证后的独立源码快照。@param templates 只读源码。@param entries 根入口元组。@param digest 完整源码/入口摘要。"""
+    templates:object
+    entries:tuple
+    digest:str
+    def environment(self,**options):
+        """在新环境加载完整包。@param options 调用方显式语言/插件选项，不接受替换loader。@return Environment。"""
+        if 'loader' in options:raise ValueError('bundle环境不能替换loader')
+        return Environment(loader=DictLoader(dict(self.templates)),**options)
+
+def make_bundle(templates,entries):
+    """生成规范JSON。@param templates 显式全部根/依赖源码Mapping。@param entries 根名称序列。@return str，动态依赖须调用方补齐，不声称自动闭包。"""
+    if not isinstance(templates,Mapping):raise TypeError('需要源码映射')
+    sources=dict(templates);roots=list(entries)
+    if any(not isinstance(name,str) or not name or not isinstance(source,str) for name,source in sources.items()):raise TypeError('名称/源码必须为str')
+    if not roots or any(not isinstance(name,str) or name not in sources for name in roots) or len(set(roots))!=len(roots):raise ValueError('入口不存在或重复')
+    payload={'schema':1,'templates':sources,'entries':roots}
+    return _canonical({**payload,'digest':hashlib.sha256(_canonical(payload)).hexdigest()}).decode('utf-8')
+
+def load_bundle(text):
+    """校验完整包合同与每字节内容摘要。@param text str规范JSON。@return TemplateBundle，不执行模板或插件。"""
+    def unique(pairs):
+        result={}
+        for key,value in pairs:
+            if key in result:raise ValueError('包中重复JSON键')
+            result[key]=value
+        return result
+    value=json.loads(text,object_pairs_hook=unique)
+    if not isinstance(value,dict) or set(value)!={'schema','templates','entries','digest'} or type(value['schema']) is not int or value['schema']!=1:raise ValueError('包schema无效')
+    if not isinstance(value['entries'],list):raise ValueError('入口须为JSON数组')
+    expected=json.loads(make_bundle(value['templates'],value['entries']))
+    if value['digest']!=expected['digest']:raise ValueError('源码包摘要不符')
+    return TemplateBundle(MappingProxyType(dict(value['templates'])),tuple(value['entries']),value['digest'])
