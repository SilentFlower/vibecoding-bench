+# 按业务记录身份独立渲染报告并隔离失败与上下文
+
+路线16：每记录(id,Mapping)用独立真实RenderContext，有序同步/异步拉取，Liquid失败可记录或fail-fast；取消/普通用户异常传播，提前关闭不执行后项，明确串行不冒称并发。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/liquid/record_rendering.py
+++ b/library/liquid/record_rendering.py
@@ -0,0 +1,43 @@
+"""有序独立上下文的本地报告批次，同步/异步逐条拉取。"""
+from collections.abc import Mapping
+from dataclasses import dataclass
+from .template import BoundTemplate
+from .exceptions import LiquidError
+
+@dataclass(frozen=True)
+class RenderedRecord:
+    """批次记录结果。@param record_id 原身份。@param status rendered/failed。@param output 成功输出或None。@param error 错误类型或None。"""
+    record_id:object
+    status:str
+    output:str|None
+    error:str|None
+
+def _record(item,seen):
+    if not isinstance(item,tuple) or len(item)!=2 or not isinstance(item[1],Mapping):raise TypeError('每条需要(id,Mapping)')
+    identity,data=item
+    if identity in seen:raise ValueError('重复记录id')
+    seen.add(identity);return identity,data
+
+def render_records(template,records,*,continue_on_error=True):
+    """拉取式批次渲染。@param template 真实模板。@param records (id,Mapping)惰性序列。@param continue_on_error 是否保留Liquid错误继续。@return 有序RenderedRecord迭代器；用户普通异常传播。"""
+    if not isinstance(template,BoundTemplate):raise TypeError('需要真实BoundTemplate')
+    seen=set()
+    for item in records:
+        identity,data=_record(item,seen)
+        try:output=template.render(data)
+        except LiquidError as error:
+            if not continue_on_error:raise
+            yield RenderedRecord(identity,'failed',None,type(error).__name__)
+        else:yield RenderedRecord(identity,'rendered',output,None)
+
+async def render_records_async(template,records,*,continue_on_error=True):
+    """异步逐条拉取，不预建无界任务。@param template 模板。@param records 普通惰性序列。@param continue_on_error Liquid失败策略。@return 异步RenderedRecord迭代器，取消/提前关闭不启动后项。"""
+    if not isinstance(template,BoundTemplate):raise TypeError('需要真实BoundTemplate')
+    seen=set()
+    for item in records:
+        identity,data=_record(item,seen)
+        try:output=await template.render_async(data)
+        except LiquidError as error:
+            if not continue_on_error:raise
+            yield RenderedRecord(identity,'failed',None,type(error).__name__)
+        else:yield RenderedRecord(identity,'rendered',output,None)
--- a/library/tests/test_development_python_liquid_04_dev.py
