+"""声明式上下文预检，只读JSON式值，不渲染或调用属性getter。"""
+from collections.abc import Mapping
+from dataclasses import dataclass
+
+@dataclass(frozen=True)
+class ContextField:
+    """明确字段合同。@param path str/int路径。@param expected_type 一个真实类型。@param required 是否必填。@param nullable 是否可None。"""
+    path:tuple
+    expected_type:type
+    required:bool=True
+    nullable:bool=False
+
+@dataclass(frozen=True)
+class ContextProblem:
+    """上下文问题。@param path 原声明路径。@param code missing/type。@param message 说明，不输出业务值。"""
+    path:tuple
+    code:str
+    message:str
+
+class ContextSchema:
+    """调用方明确类型合同，不猜动态路径/过滤器类型。@param fields 不重复路径的ContextField序列。"""
+    def __init__(self,fields):
+        self.fields=tuple(fields);seen=set()
+        for field in self.fields:
+            if not isinstance(field,ContextField) or not field.path or not isinstance(field.path,tuple) or any(type(part) not in (str,int) or isinstance(part,int) and part<0 for part in field.path) or not isinstance(field.expected_type,type):raise TypeError('字段合同无效')
+            if field.path in seen:raise ValueError('重复字段路径')
+            seen.add(field.path)
+
+def validate_context(data,schema):
+    """聚合声明字段的缺失和类型错误。@param data 只读Mapping。@param schema ContextSchema。@return 按合同顺序的不可变ContextProblem序列；额外字段不猜为错误。"""
+    if not isinstance(data,Mapping) or not isinstance(schema,ContextSchema):raise TypeError('需要映射与ContextSchema')
+    problems=[]
+    for field in schema.fields:
+        value=data;missing=False
+        for part in field.path:
+            if type(part) is str and isinstance(value,Mapping) and part in value:value=value[part]
+            elif type(part) is int and isinstance(value,(list,tuple)) and part<len(value):value=value[part]
+            else:missing=True;break
+        if missing:
+            if field.required:problems.append(ContextProblem(field.path,'missing','缺少声明字段'))
+            continue
+        if value is None and field.nullable:continue
+        if not isinstance(value,field.expected_type) or field.expected_type is int and type(value) is bool:
+            problems.append(ContextProblem(field.path,'type','字段类型不符'))
+    return tuple(problems)
