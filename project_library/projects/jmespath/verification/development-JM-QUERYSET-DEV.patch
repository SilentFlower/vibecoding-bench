+++ b/library/jmespath/queries.py
@@ -0,0 +1,55 @@
+"""一组命名查询的独立编译与标准错误结果。"""
+from collections.abc import Mapping
+from dataclasses import dataclass
+from .bound import BoundExpression
+from .exceptions import JMESPathError
+
+
+@dataclass(frozen=True)
+class QueryResult:
+    """单条查询结果，只保存值及错误文本，不保留异常／回溯对象。"""
+    status: str
+    value: object=None
+    error_type: object=None
+    error: object=None
+    phase: str='complete'
+
+
+class QuerySet:
+    """命名查询一次编译，在多份输入上重复求值。"""
+    def __init__(self,queries,*,options=None,errors='raise'):
+        """编译查询集。@param queries 非空字符串名到表达式的映射。
+        @param options 绑定选项。@param errors raise或collect。@return None。
+        """
+        if not isinstance(queries,Mapping) or errors not in ('raise','collect'):
+            raise ValueError('需要命名查询映射和明确错误策略')
+        entries=list(queries.items())
+        if any(not isinstance(name,str) or not name for name,expression in entries):
+            raise ValueError('查询名称必须为非空字符串')
+        self._queries=[];self._errors=errors
+        for name,expression in entries:
+            try:
+                compiled=BoundExpression(expression,options)
+            except JMESPathError as error:
+                if errors=='raise':
+                    raise
+                compiled=QueryResult('error',error_type=type(error).__name__,error=str(error),phase='compile')
+            self._queries.append((name,compiled))
+
+    def search(self,data):
+        """对同一输入执行查询。@param data JSON输入。@return 保序名称到QueryResult映射。
+        """
+        results={}
+        for name,compiled in self._queries:
+            if isinstance(compiled,QueryResult):
+                results[name]=compiled
+                continue
+            try:
+                value=compiled.search(data)
+            except JMESPathError as error:
+                if self._errors=='raise':
+                    raise
+                results[name]=QueryResult('error',error_type=type(error).__name__,error=str(error),phase='evaluate')
+            else:
+                results[name]=QueryResult('passed',value=value)
+        return results
