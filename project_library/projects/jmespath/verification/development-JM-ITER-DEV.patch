+# 一次编译后惰性查询文档流并可逐条收集标准错误
+
+查询大量JSON文档只编译一次并逐条返回，不预取、不缓存整流。可沿用统一结果格式逐条收集查询错误，语法问题在读取首条前失败，数据源异常原样传播，停止消费后不再读取。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/jmespath/streaming.py
+++ b/library/jmespath/streaming.py
@@ -0,0 +1,23 @@
+"""在一次编译后逐条求值输入文档，不预读或缓存全流。"""
+from .bound import BoundExpression
+from .exceptions import JMESPathError
+from .queries import QueryResult
+
+
+def iter_search(expression,documents,*,options=None,errors='raise'):
+    """惰性查询文档。@param expression 查询文本。@param documents 一次性文档流。
+    @param options 绑定求值选项。@param errors raise返回原值，collect返回(index,QueryResult)。
+    @return 结果迭代器；语法错误在读取首份文档前抛出，源异常不当作查询错误吞掉。
+    """
+    if errors not in ('raise','collect'):
+        raise ValueError('未知流查询错误策略')
+    compiled=BoundExpression(expression,options)
+    for index,document in enumerate(documents):
+        try:
+            value=compiled.search(document)
+        except JMESPathError as error:
+            if errors=='raise':
+                raise
+            yield index,QueryResult('error',error_type=type(error).__name__,error=str(error),phase='evaluate')
+        else:
+            yield (index,QueryResult('passed',value=value)) if errors=='collect' else value
