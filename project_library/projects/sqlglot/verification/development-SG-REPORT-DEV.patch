+"""组合物理表映射、值绑定和结果边界生成可执行报表查询。"""
+from dataclasses import dataclass
+from .report_inspection import query_copy,inspect_tables
+from .report_remap import remap_tables
+from .report_binding import bind_parameters,parameter_names
+from .report_bounds import bounded_query
+
+
+@dataclass(frozen=True)
+class PreparedReport:
+    """准备完成的SQL及实际物理表、输出字段与原参数名。"""
+    sql: str
+    tables: tuple
+    output_columns: tuple
+    parameters: tuple
+
+
+def prepare_report(query,*,values=None,tables=None,max_rows=None,offset=0,read=None,write=None):
+    """准备单个报表查询，不连接数据库。@param query 原单查询。
+    @param values 命名普通值。@param tables 可选精确物理表映射。@param max_rows 可选最终行数上限。
+    @param offset 有界结果偏移。@param read 输入方言。@param write 输出方言。
+    @return PreparedReport；保留原输入语法树。
+    """
+    tree=query_copy(query,read);names=parameter_names(tree)
+    if tables is not None:
+        tree=remap_tables(tree,tables,require_all=True)
+    tree=bind_parameters(tree,{} if values is None else values)
+    columns=tuple(expression.alias_or_name or expression.sql(dialect=write or read) for expression in tree.selects)
+    if max_rows is not None:
+        tree=bounded_query(tree,max_rows,offset=offset)
+    elif offset:
+        raise ValueError('结果偏移必须同时声明行数边界')
+    elif type(offset) is not int:
+        raise ValueError('偏移必须为整数')
+    return PreparedReport(tree.sql(dialect=write or read),inspect_tables(tree),columns,names)
