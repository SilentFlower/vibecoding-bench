+"""通过真实作用域分辨物理命名表和CTE引用。"""
+from dataclasses import dataclass
+from . import exp,parse
+from .optimizer.scope import Scope,traverse_scope
+
+
+@dataclass(frozen=True)
+class TableReference:
+    """一个物理命名表出现位置；限定名保留原大小写和引用标记。"""
+    catalog: str
+    database: str
+    name: str
+    alias: str
+    quoted: tuple
+    scope: int
+
+
+def query_copy(query,dialect=None):
+    """解析单个查询或复制真实AST。@param query SQL文本或Query。
+    @param dialect 输入方言。@return 独立Query，拒绝空输入、多语句及非查询。
+    """
+    if isinstance(query,str):
+        statements=[item for item in parse(query,read=dialect) if item is not None]
+        if len(statements)!=1:
+            raise ValueError('只接受一个SQL查询')
+        query=statements[0]
+    if not isinstance(query,exp.Query):
+        raise ValueError('需要查询语法树')
+    return query.copy()
+
+
+def physical_nodes(query):
+    """枚举实际命名表节点。@param query 独立Query。@return 作用域序号、别名和Table列表。
+    CTE别名和表函数不属于物理命名表，SEMI/ANTI连接右表仍计入。
+    """
+    result=[]
+    for index,scope in enumerate(traverse_scope(query)):
+        for table in scope.tables:
+            if isinstance(scope.sources.get(table.alias_or_name),Scope):
+                continue
+            if not isinstance(table.this,exp.Identifier) or any(not isinstance(part,exp.Identifier) for part in table.parts):
+                continue
+            result.append((index,table.alias_or_name,table))
+    return result
+
+
+def inspect_tables(query,*,dialect=None):
+    """识别所有物理表出现位置。@param query 文本或Query。@param dialect 输入方言。
+    @return TableReference元组，按实际作用域遍历与表出现顺序，不合并自连接。
+    """
+    tree=query_copy(query,dialect)
+    return tuple(TableReference(table.catalog,table.db,table.name,alias,
+        tuple(bool(table.args.get(key) is not None and table.args[key].args.get('quoted')) for key in ('catalog','db','this')),index)
+        for index,alias,table in physical_nodes(tree))
