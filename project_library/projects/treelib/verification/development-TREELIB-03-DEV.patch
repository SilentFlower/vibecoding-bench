+"""版本化扁平树快照，完整保存折叠后代与同名节点。"""
+import copy
+from .tree import Tree
+
+
+def snapshot(tree):
+    """导出完整节点关系，不使用展示剪枝。@param tree 健康Tree。@return schema1可序列化快照。"""
+    records=[];seen=set()
+    pending=[tree.root] if tree.root is not None else []
+    while pending:
+        identity=pending.pop()
+        if identity in seen or identity not in tree.nodes:raise ValueError('树含环或缺失子节点')
+        seen.add(identity);node=tree[identity]
+        children=list(node.successors(tree.identifier))
+        records.append({'id':identity,'tag':node.tag,'parent':node.predecessor(tree.identifier),'children':children,'expanded':node.expanded,'data':copy.deepcopy(node.data)})
+        pending.extend(reversed(children))
+    if len(seen)!=len(tree):raise ValueError('树含不可达节点')
+    return {'schema':1,'root':tree.root,'nodes':records}
+
+
+def restore(document,tree_class=Tree,**tree_kwargs):
+    """验证全量记录后恢复独立树。@param document 快照。@param tree_class 显式类。@param tree_kwargs 构造参数。@return 新树。"""
+    if not isinstance(document,dict) or set(document)!={'schema','root','nodes'} or type(document['schema']) is not int or document['schema']!=1:raise ValueError('未知快照合同')
+    rows=document['nodes']
+    if not isinstance(rows,list):raise ValueError('节点必须是列表')
+    records={}
+    for row in rows:
+        if not isinstance(row,dict) or set(row)!={'id','tag','parent','children','expanded','data'} or type(row['expanded']) is not bool or not isinstance(row['children'],list):raise ValueError('节点记录形状错误')
+        identity=row['id']
+        if not isinstance(identity,str) or not identity or identity in records:raise ValueError('节点标识无效或重复')
+        records[identity]=copy.deepcopy(row)
+    root=document['root']
+    if not rows:
+        if root is not None:raise ValueError('空树不能有根')
+        return tree_class(**tree_kwargs)
+    if root not in records or records[root]['parent'] is not None:raise ValueError('根不合法')
+    visited=set();order=[];pending=[root]
+    while pending:
+        identity=pending.pop()
+        if identity in visited or identity not in records:raise ValueError('重复、环或缺失节点')
+        visited.add(identity);order.append(identity);row=records[identity]
+        for child in row['children']:
+            if not isinstance(child,str) or child not in records or records[child]['parent']!=identity:raise ValueError('父子关系不一致')
+        pending.extend(reversed(row['children']))
+    if len(visited)!=len(records):raise ValueError('快照有不可达节点')
+    tree=tree_class(**tree_kwargs)
+    if len(tree):raise ValueError('构造器必须创建空树')
+    for identity in order:
+        row=records[identity]
+        tree.create_node(row['tag'],identity,parent=row['parent'],data=row['data'])
+        tree[identity].expanded=row['expanded']
+    return tree
