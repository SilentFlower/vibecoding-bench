+    def from_map(cls, child_parent_dict, id_func=None, data_func=None, **tree_kwargs):
+        """完整验证映射再构造同类树。@param child_parent_dict 全量父映射。@param id_func 标识转换。@param data_func 数据转换。@param tree_kwargs 显式构造参数。@return 同类完整树。"""
+        records=dict(child_parent_dict)
+        roots=[key for key,parent in records.items() if parent is None]
+        if len(roots)!=1:raise ValueError('映射必须恰好一个根')
+        children={key:[] for key in records}
+        for key,parent in records.items():
+            if parent is not None:
+                if parent not in records:raise ValueError('缺失父节点: '+repr(key))
+                children[parent].append(key)
+        order=[];pending=[roots[0]]
+        while pending:
+            key=pending.pop()
+            order.append(key);pending.extend(reversed(children[key]))
+        if len(order)!=len(records):raise ValueError('映射含与根断开的环: '+repr([key for key in records if key not in set(order)]))
+        identify=id_func or (lambda key:key)
+        payload=data_func or (lambda key:None)
+        identifiers={key:identify(key) for key in order}
+        if any(value is None for value in identifiers.values()):raise ValueError('转换后标识不能为None')
+        try:unique=set(identifiers.values())
+        except TypeError as error:raise ValueError('转换后标识不可哈希') from error
+        if len(unique)!=len(identifiers):raise ValueError('转换后标识重复')
+        data={key:payload(key) for key in order}
+        tree=cls(**tree_kwargs)
+        if tree.size():raise ValueError('构造器必须返回空树')
+        for key in order:
+            parent=records[key]
+            tree.create_node(key,identifiers[key],parent=identifiers[parent] if parent is not None else None,data=data[key])
