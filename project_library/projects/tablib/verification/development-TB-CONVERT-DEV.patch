+# 按列执行业务类型转换并保留可定位单元格错误
+
+按真实列顺序进行业务类型转换，转换器拿到独立单元格副本。错误定位到行和表头，收集模式保留失败单元格原值并继续，其余异常不能被静默吞掉。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/tablib/conversion.py
+++ b/library/src/tablib/conversion.py
@@ -0,0 +1,47 @@
+"""按字段应用业务转换，收集明确单元格错误。"""
+from copy import deepcopy
+from dataclasses import dataclass
+from collections.abc import Mapping
+from .projection import schema,copy_rows
+
+
+@dataclass(frozen=True)
+class CellError:
+    """零基行号、外部列名及业务转换错误摘要。"""
+    row: int
+    column: str
+    error_type: str
+    message: str
+
+
+@dataclass(frozen=True)
+class ConversionResult:
+    """独立结果表与有序单元格错误。"""
+    dataset: object
+    errors: tuple
+
+
+def convert_columns(dataset,converters,*,errors='raise'):
+    """按原列顺序转换。@param dataset 原Dataset。@param converters 列名到可调用转换器。
+    @param errors raise或collect。@return ConversionResult，collect失败单元格保留原值副本。
+    """
+    headers=schema(dataset)
+    if not isinstance(converters,Mapping) or any(name not in headers or not callable(callback) for name,callback in converters.items()) or errors not in ('raise','collect'):
+        raise ValueError('无效列转换合同')
+    rows=[];failures=[]
+    for number,row in enumerate(dataset._data):
+        values=deepcopy(list(row))
+        for position,name in enumerate(headers):
+            if name not in converters:
+                continue
+            try:
+                converted=converters[name](deepcopy(values[position]))
+            except (ValueError,TypeError,OverflowError) as error:
+                failure=CellError(number,name,type(error).__name__,str(error))
+                if errors=='raise':
+                    raise ValueError('行'+str(number)+'列'+name+': '+str(error)) from error
+                failures.append(failure)
+            else:
+                values[position]=converted
+        rows.append((values,row.tags))
+    return ConversionResult(copy_rows(dataset,rows,headers),tuple(failures))
