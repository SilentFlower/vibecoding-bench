+"""实盘库存对账按明确SKU绝对数量生成新账面与差异。"""
+import json
+from pathlib import Path
+from typing import Annotated
+import typer
+from inventory_store import load,save_catalog
+
+def register(app):
+    """注册reconcile命令。@param app 既有应用。@return None。"""
+    @app.command('reconcile')
+    def reconcile(source:Path,counts:Path,output:Annotated[Path,typer.Option('--output')]):
+        """对账完整盘点输入。@param source 原账面。@param counts 明确sku/实盘quantity数组。@param output 新账面。@return None，缺席商品保原量，未知/重复/负量拒绝。"""
+        try:
+            values=load(source);catalog={item['sku']:item for item in values};raw=json.loads(counts.read_text(encoding='utf-8'))
+            if not isinstance(raw,list):raise ValueError('盘点须为数组')
+            seen=set();differences=[]
+            for item in raw:
+                if not isinstance(item,dict) or not isinstance(item.get('sku'),str) or type(item.get('quantity')) is not int or item['quantity']<0:raise ValueError('盘点sku/非负整数quantity无效')
+                sku=item['sku']
+                if sku in seen or sku not in catalog:raise ValueError('盘点sku重复或未知')
+                seen.add(sku);record=catalog[sku];before=record['quantity'];after=item['quantity'];record['quantity']=after
+                if before!=after:differences.append({'sku':sku,'before':before,'after':after,'delta':after-before})
+            save_catalog(output,values,inputs=(source,counts))
+        except (OSError,UnicodeError,ValueError) as error:
+            typer.echo('对账失败：'+str(error),err=True);raise typer.Exit(1) from error
+        typer.echo(json.dumps({'counted':len(seen),'changed':len(differences),'differences':differences},ensure_ascii=False))
