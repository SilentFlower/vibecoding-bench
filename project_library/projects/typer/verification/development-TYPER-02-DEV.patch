+"""商品工作流共享校验与独占原子输出，不改任何输入文件。"""
+import json
+import os
+import tempfile
+from pathlib import Path
+
+def records(value):
+    """校验并复制完整清单。@param value JSON值。@return 按输入顺序的sku/name/quantity字典列表。"""
+    if not isinstance(value,list):raise ValueError('清单必须为对象数组')
+    result=[];seen=set()
+    for item in value:
+        if not isinstance(item,dict):raise ValueError('清单记录必须为对象')
+        if any(not isinstance(item.get(key),str) or not item[key] for key in ('sku','name')):raise ValueError('sku/name须非空字符串')
+        if type(item.get('quantity')) is not int or item['quantity']<0:raise ValueError('quantity须非负整数')
+        if item['sku'] in seen:raise ValueError('sku重复')
+        seen.add(item['sku']);result.append({key:item[key] for key in ('sku','name','quantity')})
+    return result
+
+def load(path):
+    """读取用户JSON，不修改来源。@param path 文件。@return 已校验清单。"""
+    return records(json.loads(Path(path).read_text(encoding='utf-8')))
+
+def save_new(path,text,*,inputs=()):
+    """以同目录临时文件+独占link发布完整输出。@param path 新输出。@param text 完整UTF8内容。@param inputs 所有输入路径。@return None，已有输出/来源同路径/链接拒绝。"""
+    destination=Path(path)
+    if destination.is_symlink() or destination.exists() or any(destination.resolve()==Path(source).resolve() for source in inputs):raise ValueError('拒绝覆盖已有输出或输入')
+    descriptor,temporary=tempfile.mkstemp(prefix='.inventory-',dir=destination.parent)
+    try:
+        with os.fdopen(descriptor,'w',encoding='utf-8',newline='') as target:
+            target.write(text);target.flush();os.fsync(target.fileno())
+        # link不会覆盖检查后由另一个调用方创建的同名文件；发布时已是完整字节。
+        os.link(temporary,destination)
+    finally:Path(temporary).unlink(missing_ok=True)
+
+def save_catalog(path,value,*,inputs=()):
+    """校验全部记录后一次发布新JSON。@param path 输出。@param value 清单。@param inputs 来源。@return None。"""
+    save_new(path,json.dumps(records(value),ensure_ascii=False,indent=2)+'\n',inputs=inputs)
