+"""把供应商CSV清单导入既有商品工具的规范JSON。"""
+import csv
+import json
+import re
+from pathlib import Path
+from typing import Annotated
+import typer
+from inventory_store import records,save_catalog
+
+def register(app):
+    """注册真实import-csv命令。@param app 既有Typer应用。@return None。"""
+    @app.command('import-csv')
+    def import_csv(source:Path,output:Annotated[Path,typer.Option('--output')]):
+        """供应商CSV转规范清单。@param source UTF8/带BOM CSV。@param output 不存在的新JSON。@return None，失败非零且无部分输出。"""
+        try:
+            with source.open(encoding='utf-8-sig',newline='') as stream:
+                reader=csv.DictReader(stream)
+                if reader.fieldnames is None or len(reader.fieldnames)!=3 or set(reader.fieldnames)!={'sku','name','quantity'}:raise ValueError('CSV须且仅须sku/name/quantity三列')
+                values=[]
+                for item in reader:
+                    if set(item)!={'sku','name','quantity'} or any(value is None for value in item.values()) or not re.fullmatch('[0-9]+',item['quantity']):raise ValueError('CSV字段数或quantity无效')
+                    values.append({'sku':item['sku'],'name':item['name'],'quantity':int(item['quantity'])})
+                values=records(values)
+            save_catalog(output,values,inputs=(source,))
+        except (OSError,UnicodeError,ValueError,csv.Error) as error:
+            typer.echo('导入失败：'+str(error),err=True);raise typer.Exit(1) from error
+        typer.echo(json.dumps({'imported':len(values)},ensure_ascii=False))
