+"""可移交补货报告按真实库存阈值筛选并以CSV保真交付。"""
+import csv
+import io
+import json
+from pathlib import Path
+from typing import Annotated
+import typer
+from inventory_store import load,save_new
+
+def register(app):
+    """注册low-stock命令。@param app 既有应用。@return None。"""
+    @app.command('low-stock')
+    def low_stock(source:Path,threshold:Annotated[int,typer.Option('--threshold',min=0)],output:Annotated[Path,typer.Option('--output')]):
+        """生成可移交CSV补货报告。@param source 账面。@param threshold 包含边界的非负阈值。@param output 新CSV。@return None，成功给选择数及数量总和。"""
+        try:
+            values=load(source);selected=sorted((item for item in values if item['quantity']<=threshold),key=lambda item:item['quantity'])
+            buffer=io.StringIO(newline='');writer=csv.DictWriter(buffer,fieldnames=['sku','name','quantity']);writer.writeheader();writer.writerows(selected)
+            save_new(output,buffer.getvalue(),inputs=(source,))
+        except (OSError,UnicodeError,ValueError,csv.Error) as error:
+            typer.echo('报告失败：'+str(error),err=True);raise typer.Exit(1) from error
+        typer.echo(json.dumps({'selected':len(selected),'total_quantity':sum(item['quantity'] for item in selected),'threshold':threshold},ensure_ascii=False))
