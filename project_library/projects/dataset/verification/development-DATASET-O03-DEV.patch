+    def increment(self, column, amount, filters, *, nulls='preserve'):
+        """用单条数据库UPDATE表达式原子增减，不先读后写。
+
+        :param column: 已存在的真实数值列名。
+        :param amount: 有限int、float或Decimal，bool拒绝。
+        :param filters: 显式传入的原生过滤映射，空映射表示有意更新全表。
+        :param nulls: preserve保留NULL，zero把NULL视为零。
+        :return: 数据库报告的影响行数。
+        """
+        from collections.abc import Mapping
+        from decimal import Decimal
+        from math import isfinite
+        from sqlalchemy.types import Float, Integer, Numeric
+        if nulls not in ('preserve', 'zero') or not isinstance(filters, Mapping):
+            raise ValueError('NULL政策或过滤映射无效')
+        if isinstance(amount, bool) or not isinstance(amount, (int, float, Decimal)):
+            raise TypeError('增量必须为数值')
+        if (isinstance(amount, float) and not isfinite(amount)) or (isinstance(amount, Decimal) and not amount.is_finite()):
+            raise ValueError('增量必须有限')
+        if not self.exists:
+            return 0
+        name = self._get_column_name(column)
+        if name not in self.table.c:
+            raise ValueError('数值列不存在')
+        target = self.table.c[name]
+        if not isinstance(target.type, (Integer, Numeric, Float)):
+            raise TypeError('目标列不是数值列')
+        current = func.coalesce(target, 0) if nulls == 'zero' else target
+        result = self.db.executable.execute(self.table.update().where(self._args_to_clause(dict(filters))).values({name: current + amount}))
+        self.db._auto_commit()
+        if not result.supports_sane_rowcount():
+            raise QueryError('数据库不能提供可靠影响行数')
+        return result.rowcount
 
