+    def _write_iter(self, rows, *, keys=None, chunk_size=1000, ensure=None, types=None, atomic=False):
+        """每次最多缓冲一个批次，重用原生批量入口。@return 输入记录数。"""
+        from collections.abc import Mapping
+        from contextlib import nullcontext
+        from itertools import islice
+        if isinstance(chunk_size, bool) or not isinstance(chunk_size, int) or chunk_size < 1:
+            raise ValueError('chunk_size必须为正整数')
+        if not isinstance(atomic, bool):
+            raise TypeError('atomic必须为bool')
+        iterator, count = iter(rows), 0
+        with (self.db if atomic else nullcontext()):
+            while True:
+                chunk = list(islice(iterator, chunk_size))
+                if not chunk:
+                    break
+                if any(not isinstance(row, Mapping) for row in chunk):
+                    raise TypeError('批量输入记录必须为映射')
+                copied = [dict(row) for row in chunk]
+                if keys is None:
+                    self.insert_many(copied, chunk_size=chunk_size, ensure=ensure, types=types)
+                else:
+                    self.update_many(copied, keys, chunk_size=chunk_size, ensure=ensure, types=types)
+                count += len(chunk)
+        return count
+
+    def insert_iter(self, rows, *, chunk_size=1000, ensure=None, types=None, atomic=False):
+        """有界消费一次性插入输入。
+
+        :param rows: 只消费一次的映射记录迭代器。
+        :param chunk_size: 正整数内存批次上限。
+        :param ensure: 原自动schema政策，各新批次可发现新列。
+        :param types: 原显式列类型映射。
+        :param atomic: True时整次DML处于显式Database事务，DDL仍遵守后端限制。
+        :return: 成功消费的输入记录总数。
+        """
+        return self._write_iter(rows, chunk_size=chunk_size, ensure=ensure, types=types, atomic=atomic)
