+"""保留候选身份、方向和稳定并列次序的有界TopK检索。"""
+import heapq
+import math
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Match:
+    """检索结果。@param id 输入身份。@param value 原值。@param score 实际分数。@param index 原顺序。"""
+    id: object
+    value: object
+    score: float
+    index: int
+
+
+def extract(query, choices, scorer, k=5, direction='distance', threshold=None, max_candidates=None):
+    """流式检索最优K项，不合并重复值或身份。@param query 查询。@param choices (id,value)流。@param scorer callable。@param k 结果上限。@param direction 距离/相似度。@param threshold 包含边界的筛选。@param max_candidates 显式预算。@return 稳定Match列表。"""
+    if type(k) is not int or k<0:raise ValueError('k必须是非负整数')
+    if direction not in ('distance','similarity'):raise ValueError('未知方向')
+    if max_candidates is not None and (type(max_candidates) is not int or max_candidates<0):raise ValueError('预算必须是非负整数')
+    if threshold is not None and (isinstance(threshold,bool) or not isinstance(threshold,(int,float)) or not math.isfinite(threshold)):raise ValueError('阈值必须有限')
+    if not k:return []
+    heap=[]
+    for index,record in enumerate(choices):
+        if max_candidates is not None and index>=max_candidates:raise ValueError('候选预算不足，未返回不完整检索')
+        identity,value=record
+        score=scorer(query,value)
+        if isinstance(score,bool) or not isinstance(score,(int,float)) or not math.isfinite(score):raise ValueError('评分必须有限')
+        if threshold is not None and (score>threshold if direction=='distance' else score<threshold):continue
+        # 堆顶保留当前最差项，原输入索引确定并列，不比较业务ID或值。
+        quality=-score if direction=='distance' else score
+        entry=(quality,-index,Match(identity,value,score,index))
+        if len(heap)<k:heapq.heappush(heap,entry)
+        elif entry[:2]>heap[0][:2]:heapq.heapreplace(heap,entry)
+    return [entry[2] for entry in sorted(heap,key=lambda item:(-item[0],-item[1]))]
