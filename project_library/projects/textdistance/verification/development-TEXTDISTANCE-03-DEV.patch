+def words_combinations(f, *texts, direction='distance', max_permutations=10000, truncate=False) -> float:
+    """在明确方向及工作预算内比较单词排列。@param f 真实评分callable。@param texts 文本。@param direction distance/similarity。@param max_permutations 调用预算。@param truncate 是否截到最短词数。@return 最优真实分数。"""
+    import math
+    if direction not in ('distance','similarity'):raise ValueError('未知分数方向')
+    if type(max_permutations) is not int or max_permutations<1:raise ValueError('预算必须为正整数')
+    if type(truncate) is not bool:raise ValueError('truncate必须为bool')
+    if not texts:raise ValueError('至少需要一份文本')
+    # 先去除重复词排列再做笛卡尔积；每份文本的独立生成也由同一预算约束。
+    options=[]
+    for text in texts:
+        words=text.split()
+        if math.factorial(len(words))>max_permutations and len(set(words))==len(words):raise ValueError('排列预算不足')
+        unique=set()
+        def visit(prefix, remaining):
+            """按词频生成唯一排列，避免重复词阶乘放大。@param prefix 前缀。@param remaining 剩余词。@return None。"""
+            if len(unique)>max_permutations:raise ValueError('排列预算不足')
+            if not remaining:unique.add(tuple(prefix));return
+            for word in sorted(set(remaining)):
+                tail=list(remaining);tail.remove(word)
+                visit(prefix+[word],tail)
+        visit([],words);options.append(sorted(unique))
+    total=math.prod(map(len,options))
+    if total>max_permutations:raise ValueError('排列预算不足')
+    best=None
+    for combination in product(*options):
+        count=min(map(len,combination))
+        items=[' '.join(item[:count] if truncate else item) for item in combination]
+        value=f(*items)
+        if isinstance(value,bool) or not isinstance(value,(int,float)) or not math.isfinite(value):raise ValueError('评分必须为有限数字')
+        if best is None or (value<best if direction=='distance' else value>best):best=value
+    return best
 
 
