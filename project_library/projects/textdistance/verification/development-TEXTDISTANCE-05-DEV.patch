+"""带阈值的纯Python单位Levenshtein，不把截断哨兵冒充真实距离。"""
+from .algorithms.edit_based import Levenshtein
+
+
+def bounded_levenshtein(left,right,cutoff,qval=1,test_func=None):
+    """仅在距离不超过cutoff时返回精确值。@param left 源。@param right 目标。@param cutoff 非负整数。@param qval 单位。@param test_func 谓词。@return 精确整数或None表示超过阈值。"""
+    if type(cutoff) is not int or cutoff<0:raise ValueError('阈值必须是非负整数')
+    algorithm=Levenshtein(qval=qval,test_func=test_func,external=False)
+    left,right=algorithm._get_sequences(left,right)
+    if abs(len(left)-len(right))>cutoff:return None
+    # 带外距离必然大于cutoff，稀疏行避免分配完整矩阵。
+    infinity=cutoff+1
+    previous={index:index for index in range(min(len(right),cutoff)+1)}
+    for row,source in enumerate(left,1):
+        current={}
+        for column in range(max(0,row-cutoff),min(len(right),row+cutoff)+1):
+            if column==0:current[0]=row;continue
+            current[column]=min(previous.get(column,infinity)+1,current.get(column-1,infinity)+1,previous.get(column-1,infinity)+(not algorithm.test_func(source,right[column-1])))
+        if not current or min(current.values())>cutoff:return None
+        previous=current
+    result=previous.get(len(right),infinity)
+    return result if result<=cutoff else None
