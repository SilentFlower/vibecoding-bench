-    return selectop(table, field, value, operator.eq, complement=complement)
+def selecteq(table, field, value, complement=False, key=None):
+    """按可选归一化键筛选相等字段。@param table 源表。@param field 字段。@param value 比较值。@param complement 反选。@param key 双侧归一化或None。@return 惰性选择视图。"""
+    if key is None:
+        return selectop(table, field, value, operator.eq, complement=complement)
+    if not callable(key):raise TypeError("key必须可调用或None")
+    expected=key(value)
+    return select(table,field,lambda current:key(current)==expected,complement=complement)
 
 
 Table.selecteq = selecteq
