+def _xml_text(value,attribute=False):
+    """转义数据而非raw模板。@param value 原字段。@param attribute 是否属性上下文。@return XML安全文本。"""
+    from xml.sax.saxutils import escape
+    value=text_type(value)
+    if any(not (character in "\t\n\r" or 0x20<=ord(character)<=0xd7ff or 0xe000<=ord(character)<=0xfffd or 0x10000<=ord(character)<=0x10ffff) for character in value):
+        raise ValueError("XML不允许该字符")
+    return escape(value,{'"':"&quot;","'":"&apos;"} if attribute else {})
+
+
+def _xml_name(value):
+    """验证无命名空间元素/属性名。@param value 名称。@return 原名称。"""
+    import re
+    if not re.fullmatch(r"(?:[^\W\d]|_)[\w.-]*",text_type(value)):
+        raise ValueError("无效XML名称")
+    return value
+
