+# 从真实多后端HTML树导出保留段落列表及pre空白的正文
+
+对应路线15：真实walker按顺序导出段落/br/列表和pre原空白，普通空白折叠、tail不丢；head/script/style略去、hidden/template及alt显式，DOM/etree一致且不改原树。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/html5lib/text.py
+++ b/library/html5lib/text.py
@@ -0,0 +1,70 @@
+"""基于实际后端walker的结构化纯文本导出，不修改DOM或调用网络。"""
+import re
+from .treewalkers import getTreeWalker
+from .constants import namespaces
+
+
+def extract_text(tree, *, treewalker='etree', include_hidden=False, include_images=False):
+    """按真实节点顺序导出段落/列表/换行/pre，保留普通tail。
+
+    :param tree: 原解析树。
+    :param treewalker: 原支持的walker名称。
+    :param include_hidden: 是否保留hidden/template内容，script/style/head始终不作为正文。
+    :param include_images: 是否把明确alt作为图片替代文字。
+    :return: 可读文本；pre内部空白原样，其他HTML空白折叠，不声称清洗。
+    """
+    parts = []
+    stack = []
+    lists = []
+    pre_depth = 0
+    blocks = {'p','div','section','article','blockquote','h1','h2','h3','h4','h5','h6','table','tr','figure','figcaption'}
+    def boundary(count):
+        """只补结构要求的分隔，不重写已输出pre内部空白。@return None。"""
+        if not parts:
+            return
+        trailing = len(''.join(parts)) - len(''.join(parts).rstrip('\n'))
+        if trailing < count:
+            parts.append('\n' * (count - trailing))
+    def characters(value):
+        """普通内容折叠HTML空白，pre保持精确数据。@return None。"""
+        if pre_depth:
+            parts.append(value)
+            return
+        value = re.sub(r'[ \t\r\n\f]+', ' ', value)
+        if not parts or parts[-1].endswith((' ', '\n')):
+            value = value.lstrip(' ')
+        if value:
+            parts.append(value)
+    for token in getTreeWalker(treewalker)(tree):
+        kind = token['type'];name = token.get('name');html = token.get('namespace') in (None,namespaces['html'])
+        if kind in ('StartTag','EmptyTag'):
+            attrs = token['data'];inherited = stack[-1][2] if stack else False
+            hidden = inherited or html and (name in ('head','script','style') or not include_hidden and (name=='template' or (None,'hidden') in attrs))
+            if kind=='StartTag':stack.append((name,html,hidden))
+            if hidden:
+                continue
+            if html:
+                if name in blocks:boundary(2)
+                elif name in ('ul','ol'):boundary(1);lists.append([name,0])
+                elif name=='li':
+                    boundary(1)
+                    if lists:
+                        lists[-1][1]+=1
+                        parts.append((str(lists[-1][1])+'. ') if lists[-1][0]=='ol' else '- ')
+                elif name=='br':boundary(1)
+                elif name=='pre':boundary(2);pre_depth+=1
+                elif name=='img' and include_images:characters(attrs.get((None,'alt'),''))
+        elif kind=='EndTag':
+            record = stack.pop() if stack else (name,html,False)
+            if record[2]:
+                continue
+            if html:
+                if name in blocks:boundary(2)
+                elif name in ('ul','ol'):
+                    if lists:lists.pop()
+                    boundary(1)
+                elif name=='li':boundary(1)
+                elif name=='pre':pre_depth=max(0,pre_depth-1);boundary(2)
+        elif kind in ('Characters','SpaceCharacters') and not (stack and stack[-1][2]):
+            characters(token['data'])
+    return ''.join(parts).strip('\n')
--- a/library/tests/test_development_html5lib_o05_dev.py
+++ b/library/tests/test_development_html5lib_o05_dev.py
@@ -0,0 +1,26 @@
+"""真实walker文本导出保留文档结构及所有普通tail。"""
+import html5lib
+
+def test_paragraphs_breaks_lists_and_entities_follow_reading_order():
+    """段落/列表/br不是简单拼接所有Characters。@return None。"""
+    from html5lib.text import extract_text
+    tree=html5lib.parse('<p>你好 &amp; world<br>next</p><ul><li>one</li><li>two</li></ul><p>after</p>')
+    assert extract_text(tree)=='你好 & world\nnext\n\n- one\n- two\n\nafter'
+
+def test_pre_whitespace_tail_inline_and_nested_order_are_not_lost():
+    """pre的缩进/空行保留，行内之后tail和后续正文仍完整。@return None。"""
+    from html5lib.text import extract_text
+    tree=html5lib.parse('<p>before <b>bold</b> tail</p><pre>  a\n\n b  </pre><p>end</p>')
+    text=extract_text(tree);assert 'before bold tail' in text and '  a\n\n b  ' in text and text.endswith('end')
+
+def test_dom_etree_hidden_templates_scripts_images_and_input_immutability():
+    """两后端结果一致，明确隐藏内容与alt选项真实生效，原树不改。@return None。"""
+    from html5lib.text import extract_text
+    text='<p>A<img alt="Picture" src="x">B</p><div hidden>secret</div><template>placeholder</template><script>not-body</script><p>C</p>'
+    outputs=[]
+    for backend in ['etree','dom']:
+        tree=html5lib.parse(text,treebuilder=backend);before=html5lib.serialize(tree,tree=backend)
+        outputs.append(extract_text(tree,treewalker=backend,include_images=True))
+        assert html5lib.serialize(tree,tree=backend)==before
+        assert 'secret' in extract_text(tree,treewalker=backend,include_hidden=True)
+    assert outputs[0]==outputs[1]=='APictureB\n\nC'
