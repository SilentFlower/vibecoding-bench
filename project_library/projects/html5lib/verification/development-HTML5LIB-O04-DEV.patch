+"""明确的解析诊断策略及树/编码/兼容模式结果，不修改默认parse。"""
+from collections import namedtuple
+from copy import deepcopy
+from .html5parser import HTMLParser
+
+ParseReport = namedtuple('ParseReport', 'tree errors encoding compat_mode truncated')
+
+
+def parse_with_report(source, *, treebuilder='etree', namespaceHTMLElements=True, policy='collect', max_errors=100, **stream_options):
+    """解析真实HTML树并按明确策略暴露恢复诊断。
+
+    :param source: 原HTML输入。
+    :param treebuilder: 原支持的后端名称或类。
+    :param namespaceHTMLElements: 原HTML命名空间开关。
+    :param policy: collect返回诊断、error首个错误抛原ParseError、ignore隐藏诊断。
+    :param max_errors: 报告条目上限，不冒充解析工作预算。
+    :param stream_options: 原parse输入流编码参数。
+    :return: tree/errors/encoding/compat_mode/truncated结果，诊断details与parser内部脱离。
+    """
+    if policy not in ('collect', 'error', 'ignore'):
+        raise ValueError('未知解析诊断政策')
+    if isinstance(max_errors, bool) or not isinstance(max_errors, int) or max_errors < 0:
+        raise ValueError('max_errors必须为非负整数')
+    parser = HTMLParser(tree=treebuilder, strict=policy == 'error', namespaceHTMLElements=namespaceHTMLElements)
+    tree = parser.parse(source, **stream_options)
+    recorded = [] if policy == 'ignore' else [{'position': tuple(position), 'code': code, 'details': deepcopy(details)}
+                 for position, code, details in parser.errors[:max_errors]]
+    return ParseReport(tree, recorded, parser.documentEncoding, parser.compatMode,
+                       policy != 'ignore' and len(parser.errors) > max_errors)
--- a/library/tests/test_development_html5lib_o04_dev.py
