     from markdown import Markdown
 
 
+def _copy_configuration(value,active=None,memo=None):
+    """仅复制配置内建容器并保留回调身份。@param value 值。@param active 活动容器。@param memo 已复制别名。@return 独立配置容器。"""
+    active=set() if active is None else active
+    memo={} if memo is None else memo
+    if type(value) not in (dict,list,tuple,set,frozenset):return value
+    identity=id(value)
+    if identity in active:raise ValueError('配置容器不能含循环引用')
+    if identity in memo:return memo[identity]
+    active.add(identity)
+    try:
+        if type(value) is dict:result={key:_copy_configuration(item,active,memo) for key,item in value.items()}
+        elif type(value) is list:result=[_copy_configuration(item,active,memo) for item in value]
+        elif type(value) is tuple:result=tuple(_copy_configuration(item,active,memo) for item in value)
+        elif type(value) is set:result={_copy_configuration(item,active,memo) for item in value}
+        else:result=frozenset(_copy_configuration(item,active,memo) for item in value)
+        memo[identity]=result
+        return result
+    finally:active.remove(identity)
+
+
 class Extension:
     """ Base class for extensions to subclass. """
 
