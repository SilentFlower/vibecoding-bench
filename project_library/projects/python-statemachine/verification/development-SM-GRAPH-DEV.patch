+"""为平面状态机提供不执行守卫的声明图与候选事件路径。"""
+from collections import deque
+from dataclasses import dataclass
+from .statemachine import StateMachine
+
+
+@dataclass(frozen=True)
+class Edge:
+    """声明事件的一条平面转换边；不表示运行时守卫必定满足。"""
+    source: str
+    target: str
+    event: str
+
+
+class TransitionGraph:
+    """仅支持平面命名事件图，层级／并行／无事件／多目标明确拒绝。"""
+    def __init__(self,machine_class):
+        """捕获声明图。@param machine_class 真实StateMachine子类。@return None。
+        """
+        if not isinstance(machine_class,type) or not issubclass(machine_class,StateMachine):
+            raise TypeError('需要StateMachine类')
+        states=list(machine_class.states_map.values())
+        if any(state.parent is not None or state.states or state.parallel for state in states):
+            raise ValueError('声明路径规划只支持平面状态机')
+        self.nodes=tuple(state.id for state in states);edges=[]
+        for state in states:
+            for transition in state.transitions:
+                if len(transition.targets)>1 or not list(transition.events):
+                    raise ValueError('仅支持命名事件单目标或无目标转换')
+                target=transition.target.id if transition.target is not None else state.id
+                for event in transition.events:
+                    edge=Edge(state.id,target,str(event))
+                    if edge not in edges:
+                        edges.append(edge)
+        self.edges=tuple(edges)
+
+    def shortest_path(self,start,target,*,max_depth=1000):
+        """规划最少事件候选路径。@param start 状态ID。@param target 状态ID。
+        @param max_depth 非负事件深度。@return 事件名元组；无候选路径返回None，不执行机器。
+        """
+        if start not in self.nodes or target not in self.nodes:
+            raise KeyError('状态ID不存在')
+        if type(max_depth) is not int or max_depth<0:
+            raise ValueError('路径预算必须为非负整数')
+        queue=deque([(start,())]);visited={start}
+        while queue:
+            state,path=queue.popleft()
+            if state==target:
+                return path
+            if len(path)>=max_depth:
+                continue
+            for edge in self.edges:
+                if edge.source==state and edge.target not in visited:
+                    visited.add(edge.target);queue.append((edge.target,path+(edge.event,)))
+        return None
