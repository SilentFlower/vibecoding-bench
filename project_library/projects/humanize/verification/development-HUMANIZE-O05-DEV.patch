+"""按显式公历端点计算整年/月与墙钟余量，不改平均月长时长API。"""
+import calendar
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta
+from humanize.i18n import _gettext, _ngettext
+from humanize.time import precisedelta
+
+
+@dataclass(frozen=True)
+class CalendarInterval:
+    """公历月末截断后的独立间隔事实。@return 符号、整年/月和余量。"""
+    sign: int
+    years: int
+    months: int
+    days: int
+    seconds: int
+    microseconds: int
+
+    def text(self):
+        """复用原翻译与precisedelta表达非空单位，负区间加负号。@return str。"""
+        parts = []
+        if self.years:
+            parts.append(_ngettext('%d year', '%d years', self.years) % self.years)
+        if self.months:
+            parts.append(_ngettext('%d month', '%d months', self.months) % self.months)
+        remainder = timedelta(days=self.days, seconds=self.seconds, microseconds=self.microseconds)
+        if remainder:
+            parts.append(precisedelta(remainder))
+        if not parts:
+            return _ngettext('%d day', '%d days', 0) % 0
+        result = parts[0]
+        for part in parts[1:]:
+            result = _gettext('%s and %s') % (result, part)
+        return ('-' if self.sign < 0 else '') + result
+
+
+def calendar_interval(start, end):
+    """计算规范正向公历月锚点，再记录原区间方向。
+
+    :param start: date或datetime，与end必须同类日期/时间域。
+    :param end: 另一端点；aware转入start时区后以墙钟端点计算。
+    :return: CalendarInterval；月末截断始终从较早端点直接计算，不累积漂移。
+    """
+    if not isinstance(start, date) or not isinstance(end, date) or isinstance(start, datetime) != isinstance(end, datetime):
+        raise TypeError('端点必须都是date或都是datetime')
+    if isinstance(start, datetime):
+        aware_start = start.tzinfo is not None and start.utcoffset() is not None
+        aware_end = end.tzinfo is not None and end.utcoffset() is not None
+        if aware_start != aware_end:
+            raise ValueError('不能混用aware与naive端点')
+        if aware_start:
+            end = end.astimezone(start.tzinfo)
+    sign = 0 if start == end else 1 if end > start else -1
+    early, late = (start, end) if sign >= 0 else (end, start)
+    months = (late.year - early.year) * 12 + late.month - early.month
+    def anchor(count):
+        year, month = divmod(early.year * 12 + early.month - 1 + count, 12)
+        month += 1
+        return early.replace(year=year, month=month, day=min(early.day, calendar.monthrange(year, month)[1]))
+    boundary = anchor(months)
+    if boundary > late:
+        months -= 1
+        boundary = anchor(months)
+    remaining = late - boundary
+    years, months = divmod(months, 12)
+    return CalendarInterval(sign, years, months, remaining.days, remaining.seconds, remaining.microseconds)
