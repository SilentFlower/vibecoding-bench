+    if path is None:
+        raise FileNotFoundError("Humanize cannot determinate the default location of the 'locale' folder. You need to pass the path explicitly.")
+    identity = str(Path(path).expanduser().resolve())
+    key = (locale, identity)
+    # 旧应用显式注入的默认目录翻译仍有效，但绝不覆盖另一个显式目录。
+    if default_path and locale in _TRANSLATIONS and not reload:
+        return locale, _TRANSLATIONS[locale]
+    if reload or key not in _CATALOGS:
+        filename = gettext_module.find('humanize', identity, [locale])
+        if filename is None:
+            raise FileNotFoundError('未找到请求的本地Humanize消息目录')
+        with open(filename, 'rb') as stream:
+            translation = gettext_module.GNUTranslations(stream)
+        _CATALOGS[key] = translation
+    return locale, _CATALOGS[key]
