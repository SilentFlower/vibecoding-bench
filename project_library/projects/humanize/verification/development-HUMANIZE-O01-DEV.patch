+def activate(locale, path=None, *, reload=False):
+    """为当前线程激活明确目录身份的真实翻译。
+
+    :param locale: 请求语言，None或英语切回默认。
+    :param path: 可选PathLike目录；相对和绝对同源共享缓存。
+    :param reload: 显式重新读取当前目录，不清空其他来源缓存。
+    :return: 实际gettext翻译对象；加载失败保持先前活动状态。
+    """
+    effective, translation = _load_translation(locale, path, reload=reload)
+    _CURRENT.locale = effective
+    _CURRENT.translation = translation
+    return translation
 
 
