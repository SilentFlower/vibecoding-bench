+def sort_dict_by_keys(mapping, *, key=None, reverse=False):
+    """按键稳定排序并返回新dict。@param mapping 只读映射。@param key 键转换。@param reverse 是否逆序。@return 保留键值对应的新dict。"""
+    from collections.abc import Mapping
+    if not isinstance(mapping,Mapping):raise TypeError('mapping必须为Mapping')
+    if key is not None and not callable(key):raise TypeError('key必须可调用或None')
+    return dict(sorted(mapping.items(),key=(lambda item:key(item[0])) if key is not None else (lambda item:item[0]),reverse=reverse))
+
+
+def sort_dict_by_values(mapping, *, key=None, reverse=False):
+    """按值稳定排序并返回新dict。@param mapping 只读映射。@param key 值转换。@param reverse 是否逆序。@return 保序新dict。"""
+    from collections.abc import Mapping
+    if not isinstance(mapping,Mapping):raise TypeError('mapping必须为Mapping')
+    if key is not None and not callable(key):raise TypeError('key必须可调用或None')
+    return dict(sorted(mapping.items(),key=(lambda item:key(item[1])) if key is not None else (lambda item:item[1]),reverse=reverse))
--- a/library/tests/test_development_pydash_03_dev.py
+++ b/library/tests/test_development_pydash_03_dev.py
@@ -0,0 +1,21 @@
+"""映射排序不修改来源，重复比较值保持输入顺序。"""
+from types import MappingProxyType
+import pydash
+
+def test_key_and_value_sort_preserve_mapping_and_ties():
+    """按客户键与金额排序是两种明确语义。@return None。"""
+    source={'b':2,'a':1,'c':2};snapshot=list(source.items())
+    assert list(pydash.sort_dict_by_keys(source))==['a','b','c']
+    assert list(pydash.sort_dict_by_values(source,reverse=True))==['b','c','a']
+    assert list(source.items())==snapshot
+
+def test_custom_mapping_falsey_key_and_transform():
+    """Falsey函数仍需应用，不以truthiness跳过。@return None。"""
+    class Key:
+        """按字符串长度排序。"""
+        def __bool__(self):return False
+        def __call__(self,value):return len(value)
+    source=MappingProxyType({'long':3,'x':2,'xx':1})
+    assert list(pydash.sort_dict_by_keys(source,key=Key()))==['x','xx','long']
+    assert list(pydash.sort_dict_by_values({1:'BBB',2:'a'},key=str.lower))==[2,1]
+    assert pydash.sort_dict_by_values({})=={}
