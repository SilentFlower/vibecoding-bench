+"""只允许命名字段与固定业务转换的报表模板。"""
+import re
+from string import Formatter
+from .scopes import clone
+from .counted import counted
+from .streams import iter_join
+
+
+class ReportTemplate:
+    """编译时拒绝属性访问、下标、转换符与任意表达式。"""
+    def __init__(self,text):
+        """编译受限模板。@param text 支持转义大括号的模板文本。@return None。
+        """
+        if not isinstance(text,str):
+            raise TypeError('模板必须为文本')
+        self._parts=[]
+        for literal,name,spec,conversion in Formatter().parse(text):
+            if name is not None:
+                if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*',name) or conversion is not None:
+                    raise ValueError('仅允许简单命名字段')
+                if spec not in ('','words','ordinal','article','join') and not re.fullmatch(r'counted\([^{}()]+\)',spec):
+                    raise ValueError('不支持的业务格式')
+            self._parts.append((literal,name,spec))
+        self.fields=tuple(dict.fromkeys(name for _,name,_ in self._parts if name is not None))
+
+    def render(self,target,values):
+        """格式化业务记录。@param target 原引擎。@param values 名称到值映射。
+        @return 完整文本；先检查所有缺失字段且不修改原引擎。
+        """
+        for name in self.fields:
+            if name not in values:
+                raise KeyError(name)
+        working=clone(target);output=[]
+        for literal,name,spec in self._parts:
+            output.append(literal)
+            if name is None:
+                continue
+            value=values[name]
+            if spec.startswith('counted('):
+                rendered=counted(working,spec[8:-1],value)
+            elif spec=='words':
+                rendered=working.number_to_words(value)
+            elif spec=='ordinal':
+                rendered=working.ordinal(value)
+            elif spec=='article':
+                rendered=working.a(value)
+            elif spec=='join':
+                rendered=''.join(iter_join(value))
+            else:
+                rendered=str(value)
+            output.append(rendered)
+        return ''.join(output)
