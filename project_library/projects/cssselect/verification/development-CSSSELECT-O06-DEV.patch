--- a/library/cssselect/editable.py
+++ b/library/cssselect/editable.py
@@ -0,0 +1,32 @@
+"""静态可编辑选择器，区分表单自身状态与内容编辑继承。"""
+from cssselect.xpath import HTMLTranslator
+
+
+class EditableStateTranslator(HTMLTranslator):
+    """依据文档快照实现read-write/read-only互补状态。
+
+    :param xhtml: 沿用HTMLTranslator构造模式。
+    :return: 不模拟脚本或designMode的静态翻译器。
+    """
+    _namespace = "(namespace-uri() = '' or namespace-uri() = 'http://www.w3.org/1999/xhtml')"
+    _type = "translate(@type, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')"
+    _readonly_types = ('hidden', 'range', 'color', 'button', 'submit', 'reset', 'image', 'checkbox', 'radio', 'file')
+
+    def _editable_condition(self):
+        """表单控件先按自身状态，其他节点按最近有效contenteditable继承。@return 谓词。"""
+        excluded = ' or '.join(self._type + " = '" + value + "'" for value in self._readonly_types)
+        text_control = self._namespace + " and (local-name() = 'textarea' or (local-name() = 'input' and not(" + excluded + ')))'
+        form_state = '(' + text_control + ') and not(@readonly) and not(@disabled) and not(' + self._disabled_by_fieldset + ')'
+        lower = "translate(@contenteditable, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')"
+        nearest = 'ancestor-or-self::*[' + self._namespace + ' and @contenteditable and (' + lower + " = '' or " + lower + " = 'true' or " + lower + " = 'plaintext-only' or " + lower + " = 'false')][1]"
+        editable = nearest + '[' + lower + " != 'false']"
+        non_control = "not(" + self._namespace + " and (local-name() = 'input' or local-name() = 'textarea'))"
+        return '(' + form_state + ') or (' + non_control + ' and boolean(' + editable + '))'
+
+    def xpath_read_write_pseudo(self, xpath):
+        """只选择静态可推导为可编辑的节点。@return XPathExpr。"""
+        return xpath.add_condition(self._editable_condition())
+
+    def xpath_read_only_pseudo(self, xpath):
+        """对相同作用域取可编辑状态补集。@return XPathExpr。"""
+        return xpath.add_condition('not(' + self._editable_condition() + ')')
