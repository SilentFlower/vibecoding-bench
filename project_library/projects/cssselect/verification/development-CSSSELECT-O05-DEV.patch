--- a/library/cssselect/formstates.py
+++ b/library/cssselect/formstates.py
@@ -0,0 +1,26 @@
+"""仅依据静态HTML语义确定必填与可选资格。"""
+from cssselect.xpath import HTMLTranslator
+
+
+class FormStateTranslator(HTMLTranslator):
+    """扩展真实HTML翻译，普通enabled/checked等规则保持。
+
+    :param xhtml: 沿用原HTMLTranslator大小写模式。
+    :return: 支持required/optional的静态翻译器。
+    """
+    _form_namespace = "(namespace-uri() = '' or namespace-uri() = 'http://www.w3.org/1999/xhtml')"
+    _normalized_type = "translate(@type, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')"
+    _non_required_types = ('hidden', 'range', 'color', 'button', 'submit', 'reset', 'image')
+
+    def _required_eligible(self):
+        """与控件资格绑定，任意div required不成为表单状态。@return XPath谓词。"""
+        excluded = ' or '.join(self._normalized_type + " = '" + value + "'" for value in self._non_required_types)
+        return self._form_namespace + " and (local-name() = 'select' or local-name() = 'textarea' or (local-name() = 'input' and not(" + excluded + ')))'
+
+    def xpath_required_pseudo(self, xpath):
+        """有资格且声明required，disabled不更改声明状态。@return XPathExpr。"""
+        return xpath.add_condition('(' + self._required_eligible() + ') and @required')
+
+    def xpath_optional_pseudo(self, xpath):
+        """有资格且未声明required，与required仅在资格集合内互补。@return XPathExpr。"""
+        return xpath.add_condition('(' + self._required_eligible() + ') and not(@required)')
