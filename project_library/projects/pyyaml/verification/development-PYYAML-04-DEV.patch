+"""未知标签仅作为惰性数据保留，不执行标签目标。"""
+from dataclasses import dataclass
+from yaml.loader import SafeLoader
+from yaml.dumper import SafeDumper
+from yaml.nodes import ScalarNode,SequenceNode,MappingNode
+
+
+@dataclass
+class TaggedValue:
+    """未知标签数据。@param tag 完整tag。@param kind scalar/sequence/mapping。@param value 原标量文本或安全容器。@return 不执行的值。"""
+    tag: str
+    kind: str
+    value: object
+
+
+class PreservingLoader(SafeLoader):
+    """未知标签保留，其余标签保持SafeLoader构造。"""
+
+
+class PreservingDumper(SafeDumper):
+    """只为TaggedValue显式重建原标签。"""
+
+
+def _construct(loader,node):
+    """为递归容器先注册占位值，保别名身份。"""
+    if isinstance(node,ScalarNode):
+        yield TaggedValue(node.tag,"scalar",node.value)
+    elif isinstance(node,SequenceNode):
+        value=TaggedValue(node.tag,"sequence",[]);yield value
+        value.value.extend(loader.construct_sequence(node))
+    elif isinstance(node,MappingNode):
+        value=TaggedValue(node.tag,"mapping",{});yield value
+        value.value.update(loader.construct_mapping(node))
+    else:raise ValueError("未知节点类型")
+
+
+def _represent(dumper,value):
+    """代表器只输出数据，不导入未知tag。"""
+    if value.kind=="scalar":return dumper.represent_scalar(value.tag,value.value)
+    if value.kind=="sequence":return dumper.represent_sequence(value.tag,value.value)
+    if value.kind=="mapping":return dumper.represent_mapping(value.tag,value.value)
+    raise ValueError("无效TaggedValue.kind")
+
+
+PreservingLoader.add_constructor(None,_construct)
+PreservingDumper.add_representer(TaggedValue,_represent)
+
+
+def load_preserving(stream):
+    """惰性保留未知标签。@param stream YAML输入。@return 安全值或TaggedValue图。"""
+    from yaml import load
+    return load(stream,Loader=PreservingLoader)
+
+
+def dump_preserving(value,**kwargs):
+    """转储惰性标签图。@param value 已构造数据。@param kwargs 标准dump选项。@return YAML。"""
+    from yaml import dump
+    return dump(value,Dumper=PreservingDumper,**kwargs)
