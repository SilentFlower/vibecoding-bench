+"""显式文本输入的安全加载预算，在组合阶段及时拒绝超限。"""
+from yaml.loader import SafeLoader
+from yaml.events import AliasEvent
+from yaml.composer import ComposerError
+from yaml.error import YAMLError
+
+
+class LimitedSafeLoader(SafeLoader):
+    """只处理已解码文本，限制字符、唯一节点、路径深度和别名引用。"""
+    def __init__(self,stream,*,max_chars=None,max_nodes=None,max_depth=None,max_aliases=None):
+        """验证预算并初始化。@param stream str文本。@param max_chars 字符上限。@param max_nodes 非别名节点。@param max_depth 根为1。@param max_aliases 别名引用。@return None。"""
+        if not isinstance(stream,str):raise TypeError("有限加载入口要求str文本")
+        for value in (max_chars,max_nodes,max_depth,max_aliases):
+            if value is not None and (type(value) is not int or value<0):raise ValueError("预算须非负整数或None")
+        if max_chars is not None and len(stream)>max_chars:raise YAMLError("超过文本字符预算")
+        self._max_nodes=max_nodes;self._max_depth=max_depth;self._max_aliases=max_aliases
+        self._nodes_seen=0;self._aliases_seen=0;self._depth_seen=0
+        super().__init__(stream)
+
+    def compose_node(self,parent,index):
+        """每个真实节点/别名入口先校验，finally释放路径深度。"""
+        alias=self.check_event(AliasEvent)
+        if alias:self._aliases_seen+=1
+        else:self._nodes_seen+=1
+        depth=self._depth_seen+1
+        if ((self._max_nodes is not None and self._nodes_seen>self._max_nodes)
+            or (self._max_aliases is not None and self._aliases_seen>self._max_aliases)
+            or (self._max_depth is not None and depth>self._max_depth)):
+            raise ComposerError(None,None,"超过加载预算",self.peek_event().start_mark)
+        self._depth_seen=depth
+        try:return super().compose_node(parent,index)
+        finally:self._depth_seen-=1
+
+
+def load_limited(text,**limits):
+    """按显式预算加载单文档。@param text 已解码YAML。@param limits LimitedSafeLoader预算。@return 安全构造结果。"""
+    loader=LimitedSafeLoader(text,**limits)
+    try:return loader.get_single_data()
+    finally:loader.dispose()
