--- a/library/csvkit/headers.py
+++ b/library/csvkit/headers.py
@@ -0,0 +1,35 @@
+"""按原始精确列名安全重命名，不触碰任何数据字段。"""
+
+
+def rename_columns(names, mapping, *, collision='error'):
+    """返回独立重命名表头，目标冲突有显式政策。
+
+    :param names: 原始完整表头，映射发生在选列之前。
+    :param mapping: 精确原名到非空目标名的字典。
+    :param collision: error或suffix；后者避开全部预留原始目标名。
+    :return: 与输入长度及顺序相同的新表头。
+    """
+    if collision not in ('error', 'suffix') or not isinstance(mapping, dict):
+        raise ValueError('映射或冲突政策无效')
+    for old, new in mapping.items():
+        if not isinstance(old, str) or not isinstance(new, str) or not new:
+            raise ValueError('重命名必须由文本原名指向非空文本')
+        if names.count(old) != 1:
+            raise ValueError('映射源名不存在或不唯一')
+    requested = [mapping.get(name, name) for name in names]
+    if len(set(requested)) == len(requested):
+        return requested
+    if collision == 'error':
+        raise ValueError('重命名产生重复列名')
+    reserved, used, output = set(requested), set(), []
+    for name in requested:
+        candidate, suffix = name, 2
+        if candidate in used:
+            while True:
+                candidate = name + '_' + str(suffix)
+                suffix += 1
+                if candidate not in used and candidate not in reserved:
+                    break
+        output.append(candidate)
+        used.add(candidate)
+    return output
