+"""复用原生RowChecker的有界非CLI清洗结果。"""
+from dataclasses import dataclass
+import agate
+from csvkit.cleanup import RowChecker
+
+
+@dataclass(frozen=True)
+class CleanIssue:
+    """不持有原始行值的清洗问题。@return 行号、类别和原生消息。"""
+    line_number: int
+    code: str
+    message: str
+
+
+@dataclass(frozen=True)
+class CleanResult:
+    """一次完整有界清洗的不可变外层结果。@return 版本、表头、行及错误。"""
+    schema: int
+    header: tuple
+    rows: tuple
+    errors: tuple
+
+
+class CleanLimitError(ValueError):
+    """输入超过调用者明确预算时拒绝伪装成完整结果。"""
+
+
+def clean_rows(reader, *, max_rows=10000, max_errors=1000, **options):
+    """真实清洗reader而不接管流、进程或标准输出。
+
+    :param reader: 带line_num的真实CSV读取器；首行为表头。
+    :param max_rows: 最多数据记录数，去空列也受此完整输入预算约束。
+    :param max_errors: 完成后最多保留的原生问题数。
+    :param options: RowChecker现有检查和修复选项。
+    :return: 完成全部检查后的CleanResult，不返回部分成功。
+    """
+    for name, value in [('max_rows', max_rows), ('max_errors', max_errors)]:
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            raise ValueError(name + '必须为非负整数')
+    if options.get('join_short_rows') and options.get('fill_short_rows'):
+        raise ValueError('拼接与补齐不能同时启用')
+    class BoundedReader:
+        """保留底层物理行号，并限制逻辑记录总量。"""
+        def __init__(self):
+            self.count = -1
+        def __iter__(self):
+            return self
+        @property
+        def line_num(self):
+            return reader.line_num
+        def __next__(self):
+            row = next(reader)
+            self.count += 1
+            if self.count > max_rows:
+                raise CleanLimitError('数据记录超过预算')
+            return list(row)
+    checker = RowChecker(BoundedReader(), **options)
+    rows = tuple(tuple(row) for row in checker.checked_rows())
+    if len(checker.errors) > max_errors:
+        raise CleanLimitError('清洗问题超过预算')
+    errors = tuple(CleanIssue(error.line_number,
+        'length_mismatch' if error.msg.startswith('Expected ') else 'empty_columns', error.msg)
+        for error in checker.errors)
+    return CleanResult(1, tuple(checker.output_column_names), rows, errors)
+
+
+def clean_file(stream, *, reader_options=None, **options):
+    """把调用方文本流接入真实agate.csv.reader，绝不关闭它。
+
+    :param stream: 调用方拥有的文本流。
+    :param reader_options: 真实CSV读取器参数。
+    :param options: clean_rows预算及RowChecker选项。
+    :return: CleanResult，输入IO错误原样传播。
+    """
+    return clean_rows(agate.csv.reader(stream, **(reader_options or {})), **options)
