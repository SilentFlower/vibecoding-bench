+# 把配置测试、插入、替换和删除作为一个副本事务提交
+
+多项配置修改在副本上依次检查、插入、替换和删除，最后一次性交付新对象；后项失败不留下部分修改。列表索引、紧凑删除及根替换语义明确，前置测试区分布尔和整数，传入值也不共享引用。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/dpath/patches.py
+++ b/library/dpath/patches.py
@@ -0,0 +1,60 @@
+"""在副本上应用精确路径的有序配置补丁。"""
+from collections.abc import Mapping
+from copy import deepcopy
+from .exact import get_exact
+
+
+def _same(left,right):
+    if type(left) is not type(right):
+        return False
+    if isinstance(left,dict):
+        return left.keys()==right.keys() and all(_same(value,right[key]) for key,value in left.items())
+    if isinstance(left,list):
+        return len(left)==len(right) and all(_same(a,b) for a,b in zip(left,right))
+    return left==right
+
+
+def apply_edits(root,operations):
+    """事务式生成新配置。@param root 原对象。@param operations add/replace/remove/test记录。
+    @return 新配置；paths是原始键序列，列表add插入、remove紧凑删除，失败不改原对象。
+    """
+    operations=list(operations)
+    working=deepcopy(root)
+    for operation in operations:
+        if not isinstance(operation,Mapping) or operation.get('op') not in ('add','replace','remove','test'):
+            raise ValueError('未知补丁操作')
+        path=operation.get('path')
+        if isinstance(path,(str,bytes)) or path is None:
+            raise TypeError('补丁需要原始路径序列')
+        path=tuple(path);kind=operation['op']
+        if kind=='test':
+            if not _same(get_exact(working,path),operation['value']):
+                raise ValueError('补丁前置值不匹配')
+            continue
+        if not path:
+            if kind=='remove':
+                raise ValueError('不能删除整个根对象')
+            working=deepcopy(operation['value'])
+            continue
+        parent=get_exact(working,path[:-1]);key=path[-1]
+        if isinstance(parent,list):
+            if type(key) is not int:
+                raise TypeError('列表路径需要整数')
+            if key<0 or key>len(parent) or kind!='add' and key==len(parent):
+                raise IndexError(key)
+            if kind=='add':
+                parent.insert(key,deepcopy(operation['value']))
+            elif kind=='remove':
+                parent.pop(key)
+            else:
+                parent[key]=deepcopy(operation['value'])
+        elif isinstance(parent,dict):
+            if kind!='add' and key not in parent:
+                raise KeyError(key)
+            if kind=='remove':
+                del parent[key]
+            else:
+                parent[key]=deepcopy(operation['value'])
+        else:
+            raise TypeError('补丁父节点必须是字典或列表')
+    return working
