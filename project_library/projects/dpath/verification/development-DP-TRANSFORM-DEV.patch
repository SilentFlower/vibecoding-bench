+# 按类型化路径转换原有配置叶子并隔离原对象
+
+数据清理按原快照叶子和类型化路径转换，回调拿到独立值，新生成的内容不再次递归处理。任意后项或循环错误都不修改原配置，根叶子可整体替换，筛选及转换顺序明确。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/dpath/transforming.py
+++ b/library/dpath/transforming.py
@@ -0,0 +1,23 @@
+"""只转换原快照中的现有叶子，不把新生成内容再次递归处理。"""
+from copy import deepcopy
+from .exact import get_exact
+from .walking import walk_paths
+
+
+def transform_existing(root,transform,*,predicate=None):
+    """在独立副本转换现有节点。@param root 原配置。@param transform (path,value)转换器。
+    @param predicate 可选(path,value)筛选器。@return 新配置；异常不修改原对象。
+    """
+    if not callable(transform) or predicate is not None and not callable(predicate):
+        raise TypeError('转换器及筛选器必须可调用')
+    working=deepcopy(root)
+    for path,value in walk_paths(root):
+        if predicate is not None and not predicate(path,deepcopy(value)):
+            continue
+        replacement=transform(path,deepcopy(value))
+        if not path:
+            working=replacement
+        else:
+            parent=get_exact(working,path[:-1])
+            parent[path[-1]]=replacement
+    return working
