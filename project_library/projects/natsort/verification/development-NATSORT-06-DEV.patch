+"""每列独立原生策略及方向的稳定自然排序。"""
+from dataclasses import dataclass
+from natsort import natsort_keygen, ns
+
+
+@dataclass(frozen=True)
+class FieldSortSpec:
+    """单列自然排序合同。@param key 字段提取器。@param alg 原生算法。@param reverse 降序。@param missing None放first或last，error拒绝。"""
+    key: object
+    alg: object=ns.DEFAULT
+    reverse: bool=False
+    missing: str='last'
+
+    def __post_init__(self):
+        """在排序前核对公开策略。@return None。"""
+        if not callable(self.key) or self.missing not in ('first','last','error') or type(self.reverse) is not bool:
+            raise ValueError('字段排序策略不合法')
+
+
+def multisorted(iterable, fields):
+    """按字段优先级稳定排序且不修改原输入。@param iterable 记录。@param fields 非空字段策略。@return 新记录列表。"""
+    fields=tuple(fields)
+    if not fields or any(not isinstance(field,FieldSortSpec) for field in fields):
+        raise ValueError('至少提供一个有效字段策略')
+    result=list(iterable)
+    for field in reversed(fields):
+        present=[];missing=[];natural=natsort_keygen(alg=field.alg)
+        for row in result:
+            value=field.key(row)
+            if value is None:
+                if field.missing=='error':raise ValueError('排序字段缺失')
+                missing.append(row)
+            else:present.append((natural(value),row))
+        present.sort(key=lambda item:item[0],reverse=field.reverse)
+        rows=[row for _,row in present]
+        result=missing+rows if field.missing=='first' else rows+missing
+    return result
