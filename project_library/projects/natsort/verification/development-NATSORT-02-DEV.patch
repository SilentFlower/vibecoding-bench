+"""显式有界自然排序键缓存，不改变默认工厂行为。"""
+from functools import lru_cache
+from natsort import natsort_keygen, ns
+
+
+def cached_natsort_keygen(key=None, alg=ns.DEFAULT, maxsize=128):
+    """创建独立LRU自然键工厂。@param key 输入提取。@param alg 原生算法。@param maxsize 缓存容量。@return 带统计和清理方法的工厂。"""
+    if type(maxsize) is not int or maxsize < 0:
+        raise ValueError('缓存容量必须是非负整数')
+    if maxsize and alg & ns.LOCALE:
+        raise ValueError('全局locale可能变化，请禁用缓存或使用非locale策略')
+    base=natsort_keygen(key=key,alg=alg)
+    @lru_cache(maxsize=maxsize)
+    def cached(kind, value):
+        """按原类型区分相等输入并缓存成功结果。@param kind 类型。@param value 值。@return 原生键。"""
+        return base(value)
+    def generate(value):
+        """不可hash输入直接计算，不使用repr冒充缓存键。@param value 输入。@return 自然键。"""
+        try:
+            hash(value)
+        except TypeError:
+            return base(value)
+        return cached(type(value),value)
+    generate.cache_info=cached.cache_info
+    generate.cache_clear=cached.cache_clear
+    return generate
