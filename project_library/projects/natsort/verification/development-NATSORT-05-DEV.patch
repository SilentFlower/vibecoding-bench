+# 为已有自然有序数据建立等价键范围与排名索引
+
+路线17：对既有自然有序记录建立快照，二分复用自然键查左右界、等价数量和范围；降序、重复键及字段提取正确，乱序输入拒绝而不暗中重排。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/natsort/search.py
+++ b/library/natsort/search.py
@@ -0,0 +1,55 @@
+"""只读自然排序索引，查询复用预计算键而非字典序。"""
+from bisect import bisect_left, bisect_right
+import locale
+from natsort import natsort_keygen, ns
+
+
+class NaturalSortedIndex:
+    """保存已排序记录与原生自然键快照。@param iterable 已排序记录。@param key 提取字段。@param alg 原生策略。@param reverse 原输入降序。"""
+    def __init__(self, iterable, *, key=None, alg=ns.DEFAULT, reverse=False):
+        """建立快照并拒绝乱序，不静默重排。@param iterable 记录。@param key 提取器。@param alg 算法。@param reverse 降序。@return None。"""
+        self._natural=natsort_keygen(alg=alg);self._reverse=bool(reverse)
+        self._items=tuple(iterable)
+        self._keys=tuple(self._natural(key(item) if key else item) for item in self._items)
+        if any((a<b if reverse else a>b) for a,b in zip(self._keys,self._keys[1:])):
+            raise ValueError('输入尚未按自然序排列')
+        self._ascending=self._keys[::-1] if reverse else self._keys
+        self._locale=(locale.setlocale(locale.LC_COLLATE),locale.setlocale(locale.LC_NUMERIC)) if alg & ns.LOCALE else None
+
+    def __len__(self):
+        """返回记录数。@return 数量。"""
+        return len(self._items)
+
+    def __iter__(self):
+        """按输入顺序迭代原记录。@return 迭代器。"""
+        return iter(self._items)
+
+    def _query(self, value):
+        """在原排序上下文中生成查询键。@param value 已提取的查询值。@return 键。"""
+        if self._locale is not None and self._locale!=(locale.setlocale(locale.LC_COLLATE),locale.setlocale(locale.LC_NUMERIC)):
+            raise ValueError('locale已变化，请重建索引')
+        return self._natural(value)
+
+    def rank(self, value, side='left'):
+        """二分查询值在原输入顺序的左右界。@param value 已提取值。@param side left或right。@return 原始位置。"""
+        if side not in ('left','right'):raise ValueError('未知边界')
+        query=self._query(value)
+        if self._reverse:
+            return len(self)- (bisect_right(self._ascending,query) if side=='left' else bisect_left(self._ascending,query))
+        return bisect_left(self._ascending,query) if side=='left' else bisect_right(self._ascending,query)
+
+    def count(self, value):
+        """返回自然键相等的记录数量。@param value 查询值。@return 数量。"""
+        return self.rank(value,'right')-self.rank(value,'left')
+
+    def between(self, start=None, stop=None, *, include_start=True, include_stop=True):
+        """在自然升序上下界中查找，结果仍保持原输入方向。@param start 下界。@param stop 上界。@param include_start 含下界。@param include_stop 含上界。@return 原记录列表。"""
+        if start is not None and stop is not None and self._query(start)>self._query(stop):
+            raise ValueError('范围下界大于上界')
+        if self._reverse:
+            low=0 if stop is None else self.rank(stop,'left' if include_stop else 'right')
+            high=len(self) if start is None else self.rank(start,'right' if include_start else 'left')
+        else:
+            low=0 if start is None else self.rank(start,'left' if include_start else 'right')
+            high=len(self) if stop is None else self.rank(stop,'right' if include_stop else 'left')
+        return list(self._items[low:high])
