+    def compose(self, format, checker, *, mode='all', raises=()):
+        """在当前实例上显式组合已有格式与业务检查，不改其他实例或全局登记。
+
+        :param format: 已在当前实例登记的格式名称。
+        :param checker: 新增业务可调用检查器。
+        :param mode: all顺序全部成立，any顺序任意成立，均短路。
+        :param raises: 业务检查声明的用户输入异常族，其他异常传播。
+        :return: 当前FormatChecker，原checks覆盖语义保持。
+        """
+        if mode not in ('all', 'any'):
+            raise ValueError('组合模式必须为all或any')
+        if not callable(checker):
+            raise TypeError('checker必须可调用')
+        declared = raises if isinstance(raises, tuple) else (raises,)
+        if not all(isinstance(item, type) and issubclass(item, Exception) for item in declared):
+            raise TypeError('raises必须为Exception子类或其tuple')
+        original, original_raises = self.checkers[format]
+        previous = original_raises if isinstance(original_raises, tuple) else (original_raises,)
+        failures = tuple(dict.fromkeys(previous + declared))
+        def composed(instance):
+            """只捕获各检查器声明的输入异常，保留真实cause。@return 组合布尔结果。"""
+            last_cause = None
+            for function, exceptions in ((original, previous), (checker, declared)):
+                try:
+                    valid = bool(function(instance))
+                except exceptions as error:
+                    valid = False
+                    last_cause = error
+                if mode == 'all' and not valid:
+                    if last_cause is not None:
+                        raise last_cause
+                    return False
+                if mode == 'any' and valid:
+                    return True
+            if mode == 'any' and last_cause is not None:
+                raise last_cause
+            return mode == 'all'
+        self.checkers[format] = (composed, failures)
+        return self
 
