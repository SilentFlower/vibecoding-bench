+    :return: 支持except*派生的异常组。
+    """
+    def __new__(cls, errors, *, truncated=False, limit=100):
+        """创建真实ExceptionGroup。@return 异常组。"""
+        result = super().__new__(cls, 'JSON Schema实例验证失败', errors)
+        result.truncated = truncated
+        result.limit = limit
+        return result
+
+    def __init__(self, errors, *, truncated=False, limit=100):
+        """初始化由__new__创建的有界异常组。@return None。"""
+        super().__init__('JSON Schema实例验证失败', errors)
+
+    def derive(self, errors):
+        """except*分组保留收集元数据。@param errors 剩余错误。@return 派生组。"""
+        return type(self)(errors, truncated=self.truncated, limit=self.limit)
