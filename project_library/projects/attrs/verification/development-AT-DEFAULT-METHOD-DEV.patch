+    @classmethod
+    def from_method(cls, method_name):
+        """建立按实例动态派发的默认工厂。@param method_name 明确的实例方法名。@return Factory。
+        """
+        if not isinstance(method_name, str):
+            raise TypeError('默认方法名必须是字符串')
+        if not method_name or not method_name.isidentifier():
+            raise ValueError('默认方法名必须是有效标识符')
+
+        def call(instance):
+            descriptor = None
+            for owner in type(instance).__mro__:
+                if method_name in owner.__dict__:
+                    descriptor = owner.__dict__[method_name]
+                    break
+            if descriptor is None:
+                raise AttributeError(method_name)
+            if isinstance(descriptor, (staticmethod, classmethod, property)) or not hasattr(descriptor, '__get__'):
+                raise TypeError('动态默认值必须引用实例方法')
+            bound = descriptor.__get__(instance, type(instance))
+            if not callable(bound) or getattr(bound, '__self__', None) is not instance:
+                raise TypeError('默认方法必须绑定到当前实例')
+            return bound()
+
+        return cls(call, takes_self=True)
+
