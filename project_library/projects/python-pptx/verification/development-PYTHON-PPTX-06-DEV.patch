+# 多形状按实际边界对齐和等间隙分布且保持层级几何
+
+路线18：同父非旋转形状按整体边界对齐，等间隙分布扣除真实尺寸、保持外边界并用有理数EMU取整；全量校验/失败坐标回滚，ID/Z/尺寸不动，不冒充旋转视觉包围盒。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/src/pptx/layout.py
+++ b/library/src/pptx/layout.py
@@ -0,0 +1,61 @@
+"""同一坐标空间的轴对齐形状排版，单位保持EMU整数。"""
+from fractions import Fraction
+
+
+def _shapes(values):
+    """先核同父、唯一形状、非旋转与完整几何，避免半更新。"""
+    values=tuple(values)
+    if len({id(shape.element) for shape in values})!=len(values):raise ValueError("形状重复")
+    if values and any(shape._parent is not values[0]._parent for shape in values):raise ValueError("形状不在同一坐标空间")
+    if any(shape.rotation!=0 or any(type(int(value)) is not int or value<0 for value in (shape.width,shape.height)) for shape in values):raise ValueError("仅支持非旋转非负尺寸形状")
+    return values
+
+
+def _apply(positions):
+    """失败恢复原坐标，不改宽高/Z顺序。"""
+    before=[(shape,shape.left,shape.top) for shape,_,_ in positions]
+    try:
+        for shape,left,top in positions:shape.left=left;shape.top=top
+    except Exception:
+        for shape,left,top in before:shape.left=left;shape.top=top
+        raise
+
+
+def align_shapes(shapes,mode):
+    """按整体边界对齐。@param shapes 同父轴对齐形状。@param mode left/right/top/bottom/center_x/center_y。@return 输入顺序形状tuple。"""
+    shapes=_shapes(shapes)
+    if mode not in ("left","right","top","bottom","center_x","center_y"):raise ValueError("未知对齐方式")
+    if not shapes:return shapes
+    left=min(shape.left for shape in shapes);right=max(shape.left+shape.width for shape in shapes)
+    top=min(shape.top for shape in shapes);bottom=max(shape.top+shape.height for shape in shapes)
+    positions=[]
+    for shape in shapes:
+        x,y=shape.left,shape.top
+        if mode=="left":x=left
+        elif mode=="right":x=right-shape.width
+        elif mode=="top":y=top
+        elif mode=="bottom":y=bottom-shape.height
+        elif mode=="center_x":x=(left+right-shape.width)//2
+        else:y=(top+bottom-shape.height)//2
+        positions.append((shape,x,y))
+    _apply(positions)
+    return shapes
+
+
+def distribute_shapes(shapes,axis="x"):
+    """保持外侧边界并均分可用间隙。@param shapes 同父轴对齐形状。@param axis x/y。@return 输入顺序tuple，少于3项不动。"""
+    shapes=_shapes(shapes)
+    if axis not in ("x","y"):raise ValueError("未知axis")
+    if len(shapes)<3:return shapes
+    position,size=("left","width") if axis=="x" else ("top","height")
+    ordered=sorted(shapes,key=lambda shape:getattr(shape,position))
+    start=getattr(ordered[0],position);end=getattr(ordered[-1],position)+getattr(ordered[-1],size)
+    gap=Fraction(end-start-sum(getattr(shape,size) for shape in ordered),len(ordered)-1)
+    if gap<0:raise ValueError("可用间隙为负")
+    cursor=Fraction(start);positions=[]
+    for shape in ordered:
+        value=round(cursor)
+        positions.append((shape,value if axis=="x" else shape.left,value if axis=="y" else shape.top))
+        cursor+=getattr(shape,size)+gap
+    _apply(positions)
+    return shapes
