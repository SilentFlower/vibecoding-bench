@@ -0,0 +1,5 @@
+# 批次记录按明确同步边界恢复并保留真实错误与有效交付
+
+路线04：调用方明确记录分隔/引号/转义，边界内可跨行；每条全解析，坏项保原异常与绝对坐标、好项保真实结果，连续错误/EOF不丢范围。fatal和动作错误传播，动作副作用不承诺回滚。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/pyparsing/recovery.py
+++ b/library/pyparsing/recovery.py
@@ -0,0 +1,48 @@
+"""按调用方明确记录边界恢复批次解析，错误记录绝不默默接受。"""
+from dataclasses import dataclass
+from .core import ParserElement
+from .exceptions import ParseException
+
+@dataclass(frozen=True)
+class AcceptedRecord:
+    """成功记录。@param results 真实结果。@param start 开始字符。@param end 结束字符，不含分隔符。"""
+    results:object
+    start:int
+    end:int
+
+@dataclass(frozen=True)
+class RejectedRecord:
+    """失败记录。@param start 开始字符。@param end 结束字符。@param error 原异常。@param offset 绝对失败字符。"""
+    start:int
+    end:int
+    error:object
+    offset:int
+
+@dataclass(frozen=True)
+class RecoveryResult:
+    """批次成功与错误分别有序保留。@param records 成功项。@param errors 失败项。"""
+    records:tuple
+    errors:tuple
+
+def parse_recovering(expression,text,*,separator=';',quote='"',escape='\\'):
+    """恢复有明确边界的记录。@param expression 单条真实语法。@param text 完整文本。@param separator 单字符边界。@param quote 可选单字符引号。@param escape 单字符转义。@return RecoveryResult；fatal/用户动作异常不恢复，动作副作用不回滚。"""
+    if not isinstance(expression,ParserElement) or not isinstance(text,str):raise TypeError('需要语法与str')
+    if not isinstance(separator,str) or len(separator)!=1:raise ValueError('分隔符必须单字符')
+    if quote is not None and (not isinstance(quote,str) or len(quote)!=1 or quote==separator):raise ValueError('引号无效')
+    if not isinstance(escape,str) or len(escape)!=1 or escape in (separator,quote):raise ValueError('转义符无效')
+    bounds=[];start=0;quoted=False;escaped=False
+    for index,char in enumerate(text):
+        if quoted and escaped:escaped=False;continue
+        if quoted and char==escape:escaped=True;continue
+        if quote is not None and char==quote:quoted=not quoted;continue
+        if not quoted and char==separator:bounds.append((start,index));start=index+1
+    if start<len(text):bounds.append((start,len(text)))
+    records=[];errors=[]
+    for start,end in bounds:
+        # 每项保留原片段空白和绝对范围；只忽略纯空记录，错误项不会混入成功项。
+        fragment=text[start:end]
+        if not fragment.strip():continue
+        try:result=expression.copy().parse_with_tabs().parse_string(fragment,parse_all=True)
+        except ParseException as error:errors.append(RejectedRecord(start,end,error,start+error.loc))
+        else:records.append(AcceptedRecord(result,start,end))
+    return RecoveryResult(tuple(records),tuple(errors))
--- a/library/tests/test_development_pyparsing_06_dev.py
+++ b/library/tests/test_development_pyparsing_06_dev.py
@@ -0,0 +1,23 @@
+"""一条坏记录不吞其他有效记录，引号中的分隔符不是同步点。"""
+import unittest
+import pyparsing as pp
+from pyparsing.recovery import parse_recovering
+
+def test_quoted_separator_multiline_record_and_bad_middle_recovery():
+    """真实每记录语法解析，成功/失败坐标都保留。@return None。"""
+    grammar=pp.Word(pp.alphas)+pp.Suppress('=')+pp.QuotedString('"',esc_char='\\',multiline=True)
+    text='a="one;two";bad;\nb="line\nvalue";'
+    value=parse_recovering(grammar,text)
+    assert [x.results.as_list() for x in value.records]==[['a','one;two'],['b','line\nvalue']]
+    assert len(value.errors)==1 and text[value.errors[0].start:value.errors[0].end]=='bad'
+    assert value.errors[0].offset>=value.errors[0].start
+
+def test_consecutive_bad_eof_empty_and_fatal_policy():
+    """连续错误都有记录，未闭合引号不错误切出内部伪记录。@return None。"""
+    grammar=pp.Literal('ok')
+    value=parse_recovering(grammar,';bad;;ok;worse;')
+    assert len(value.records)==1 and len(value.errors)==2
+    assert len(parse_recovering(grammar,'"unclosed;ok').errors)==1
+    def fatal():raise pp.ParseFatalException('x',0,'fatal')
+    with unittest.TestCase().assertRaises(pp.ParseFatalException):parse_recovering(pp.Literal('x').set_parse_action(fatal),'x;ok')
+    assert parse_recovering(grammar,'').records==()
