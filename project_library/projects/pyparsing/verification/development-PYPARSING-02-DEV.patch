+# 明确编码的字节导入同时提供正确字符与原字节坐标
+
+路线07：明确UTF8/UTF8-SIG/ASCII/Latin1字节导入，BOM和多字节/Tab坐标可回溯原字节，原语法不改；解码错误与语法错误分开，其他编码明确拒绝不冒称支持。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/pyparsing/byte_input.py
+++ b/library/pyparsing/byte_input.py
@@ -0,0 +1,33 @@
+"""显式字节导入，保留真实字符/字节坐标而不猜编码。"""
+import codecs
+from dataclasses import dataclass
+from .core import ParserElement
+from .exceptions import ParseBaseException
+
+@dataclass(frozen=True)
+class ByteParseResult:
+    """字节输入解析结果。@param results 真实ParseResults。@param text 解码文本。@param byte_offsets 每字符起点及EOF原始字节位置。"""
+    results:object
+    text:str
+    byte_offsets:tuple[int,...]
+
+class ByteParseError(ValueError):
+    """解析错误附原始字节位置。@param error 原始解析异常。@param byte_offset 原始字节位置。"""
+    def __init__(self,error,byte_offset):
+        super().__init__(str(error));self.error=error;self.byte_offset=byte_offset
+
+def parse_bytes(expression,data,*,encoding,parse_all=False):
+    """显式解码再解析。@param expression 语法。@param data bytes。@param encoding 明确UTF8/UTF8-SIG/ASCII/Latin1。@param parse_all 全消费。@return ByteParseResult；语法错抛ByteParseError，解码错原样传播。"""
+    if not isinstance(expression,ParserElement) or not isinstance(data,bytes):raise TypeError('需要真实语法和bytes')
+    codec=codecs.lookup(encoding).name
+    if codec not in ('utf-8','utf-8-sig','ascii','iso8859-1'):raise ValueError('本接口只支持明确无状态UTF8/ASCII/Latin1编码')
+    text=data.decode(codec,errors='strict');bom=3 if codec=='utf-8-sig' and data.startswith(codecs.BOM_UTF8) else 0
+    encode='utf-8' if codec=='utf-8-sig' else codec
+    offsets=[bom]
+    for character in text:offsets.append(offsets[-1]+len(character.encode(encode)))
+    # 顶层副本禁tab展开，避免把扩展空格loc误当原文本字符坐标；原语法keepTabs不变。
+    parser=expression.copy().parse_with_tabs()
+    try:results=parser.parse_string(text,parse_all=parse_all)
+    except ParseBaseException as error:
+        raise ByteParseError(error,offsets[min(max(error.loc,0),len(text))]) from error
+    return ByteParseResult(results,text,tuple(offsets))
