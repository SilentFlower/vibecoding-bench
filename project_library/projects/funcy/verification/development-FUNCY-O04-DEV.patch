+"""迭代式树事件遍历，保留真实节点与键/下标路径。"""
+from collections.abc import Mapping
+from dataclasses import dataclass
+from funcy.types import is_seqcont
+
+
+@dataclass(frozen=True)
+class WalkEvent:
+    """独立事件元数据，node是输入节点身份而非递归副本。"""
+    event: str
+    path: tuple
+    depth: int
+    node: object
+    pruned: bool
+
+
+class TreeCycleError(ValueError):
+    """携带回到祖先的确切路径。"""
+    def __init__(self, path):
+        """保存循环位置。@return None。"""
+        self.path = path
+        super().__init__('树存在祖先循环：%s' % (path,))
+
+
+def tree_walk(root, *, children=None, follow=None, prune=None, max_depth=None):
+    """惰性生成pre/post事件，不用Python递归栈。
+
+    :param root: 根节点。
+    :param children: 可选node到(key,child)迭代器，默认mapping.items/序列enumerate。
+    :param follow: 明确哪些节点可访问children，默认Mapping或Funcy序列容器。
+    :param prune: 接收pre事件的剪枝谓词，在children调用前执行。
+    :param max_depth: 可选非负最大深度，达到边界仍交付成对事件。
+    :return: WalkEvent迭代器，祖先循环失败，共享无环节点按每个路径遍历。
+    """
+    if max_depth is not None and (isinstance(max_depth, bool) or not isinstance(max_depth, int) or max_depth < 0):
+        raise ValueError('max_depth必须为非负整数')
+    if follow is None:
+        follow = lambda node: isinstance(node, Mapping) or is_seqcont(node)
+    if children is None:
+        children = lambda node: node.items() if isinstance(node, Mapping) else enumerate(node)
+    stack, active = [('enter', root, ())], set()
+    while stack:
+        action, node, path = stack.pop()
+        if action == 'children':
+            iterator = node
+            try:
+                key, child = next(iterator)
+            except StopIteration:
+                continue
+            stack.append(('children', iterator, path))
+            stack.append(('enter', child, path + (key,)))
+            continue
+        if action == 'leave':
+            active.remove(id(node))
+            yield WalkEvent('post', path, len(path), node, False)
+            continue
+        container = bool(follow(node))
+        if container and id(node) in active:
+            raise TreeCycleError(path)
+        event = WalkEvent('pre', path, len(path), node, False)
+        pruned = (max_depth is not None and len(path) >= max_depth) or bool(prune and prune(event))
+        yield WalkEvent('pre', path, len(path), node, pruned)
+        if container and not pruned:
+            active.add(id(node))
+            stack.append(('leave', node, path))
+            stack.append(('children', iter(children(node)), path))
+        else:
+            yield WalkEvent('post', path, len(path), node, pruned)
