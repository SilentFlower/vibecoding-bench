+"""把资源工厂作用域绑定到同步、生成器和异步真实执行期。"""
+import inspect
+from contextlib import asynccontextmanager
+from functools import wraps
+
+
+def wrap_with_factory(factory):
+    """每次调用创建新manager，惰性函数在消费期保持资源。
+
+    :param factory: 无参资源工厂；同步函数要求同步manager，异步允许两种manager。
+    :return: 不改变原wrap_with的独立装饰器。
+    """
+    if not callable(factory):
+        raise TypeError('资源工厂必须可调用')
+    @asynccontextmanager
+    async def async_scope():
+        manager = factory()
+        if hasattr(manager, '__aenter__'):
+            async with manager:
+                yield
+        else:
+            with manager:
+                yield
+    def decorate(function):
+        if inspect.isasyncgenfunction(function):
+            @wraps(function)
+            async def wrapped(*args, **kwargs):
+                async with async_scope():
+                    source = function(*args, **kwargs)
+                    try:
+                        async for value in source:
+                            yield value
+                    finally:
+                        await source.aclose()
+        elif inspect.iscoroutinefunction(function):
+            @wraps(function)
+            async def wrapped(*args, **kwargs):
+                async with async_scope():
+                    return await function(*args, **kwargs)
+        elif inspect.isgeneratorfunction(function):
+            @wraps(function)
+            def wrapped(*args, **kwargs):
+                with factory():
+                    yield from function(*args, **kwargs)
+        else:
+            @wraps(function)
+            def wrapped(*args, **kwargs):
+                with factory():
+                    return function(*args, **kwargs)
+        return wrapped
+    return decorate
