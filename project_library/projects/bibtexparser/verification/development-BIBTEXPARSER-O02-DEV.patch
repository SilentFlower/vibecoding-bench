--- a/library/bibtexparser/validation.py
+++ b/library/bibtexparser/validation.py
@@ -0,0 +1,42 @@
+"""可配置且版本明确的本地书目字段校验。"""
+RULES_V1 = {
+    'article': {'required': ('title', 'journal', 'year'), 'one_of': (('author',),)},
+    'book': {'required': ('title', 'publisher', 'year'), 'one_of': (('author', 'editor'),)},
+}
+
+
+def validate_entries(library, *, rules=None, version='bibtex-v1'):
+    """产生结构化缺字段和未知字段诊断，不更改容错解析。
+
+    :param library: 真实Library。
+    :param rules: 按条目类型配置required/one_of/allowed的映射。
+    :param version: 当前支持bibtex-v1；其他版本明确拒绝。
+    :return: 按条目与规则顺序排列的诊断tuple。
+    """
+    if version != 'bibtex-v1':
+        raise ValueError('不支持的书目规则版本')
+    rules = RULES_V1 if rules is None else rules
+    diagnostics = []
+    for entry in library.entries:
+        rule = rules.get(entry.entry_type.lower())
+        if rule is None:
+            diagnostics.append({'key': entry.key, 'field': None, 'code': 'unknown-type', 'line': entry.start_line})
+            continue
+        fields = entry.fields_dict
+        def present(name):
+            """空值不满足必需字段。@param name 字段。@return 是否有效。"""
+            if name not in fields:
+                return False
+            value = fields[name].value
+            return value is not None and (bool(value.strip()) if isinstance(value, str) else bool(value))
+        for name in rule.get('required', ()):
+            if not present(name):
+                diagnostics.append({'key': entry.key, 'field': name, 'code': 'required', 'line': entry.start_line})
+        for group in rule.get('one_of', ()):
+            if not any(present(name) for name in group):
+                diagnostics.append({'key': entry.key, 'field': tuple(group), 'code': 'one-of', 'line': entry.start_line})
+        if 'allowed' in rule:
+            for field in entry.fields:
+                if field.key not in rule['allowed']:
+                    diagnostics.append({'key': entry.key, 'field': field.key, 'code': 'unknown-field', 'line': field.start_line})
+    return tuple(diagnostics)
