--- a/library/bibtexparser/identifiers.py
+++ b/library/bibtexparser/identifiers.py
@@ -0,0 +1,54 @@
+"""离线规范化DOI和ISBN，未知或校验失败值可追溯保留。"""
+import re
+from bibtexparser.middlewares.middleware import BlockMiddleware
+
+
+def _isbn(value):
+    """验证并去掉ISBN空白连字符。@param value 输入。@return 合法标准文本或None。"""
+    compact = re.sub(r'[\s-]', '', value).upper()
+    if re.fullmatch(r'\d{9}[\dX]', compact):
+        return compact if sum((10 - index) * (10 if digit == 'X' else int(digit)) for index, digit in enumerate(compact)) % 11 == 0 else None
+    if re.fullmatch(r'\d{13}', compact):
+        return compact if sum(int(digit) * (1 if index % 2 == 0 else 3) for index, digit in enumerate(compact)) % 10 == 0 else None
+    return None
+
+
+class NormalizeIdentifiers(BlockMiddleware):
+    """按显式字段集合本地规范化标识符。
+
+    :param fields: doi/isbn中的显式选择。
+    :param strict: 无效标识符是否失败，否则保留并报告。
+    """
+    def __init__(self, *, fields=('doi', 'isbn'), strict=False):
+        """保存政策，不执行任何网络查询。参数见类说明。@return None。"""
+        super().__init__(allow_inplace_modification=False)
+        self.fields = tuple(fields)
+        if any(field not in ('doi', 'isbn') for field in self.fields):
+            raise ValueError('不支持的标识符字段')
+        self.strict = strict
+
+    def transform_entry(self, entry, library):
+        """规范真实Field并记录原文。@param entry 条目。@param library 书目库。@return 条目。"""
+        report = {}
+        for name in self.fields:
+            field = entry.get(name)
+            if field is None:
+                continue
+            original = field.value
+            normalized = None
+            if isinstance(original, str):
+                if name == 'isbn':
+                    normalized = _isbn(original)
+                else:
+                    candidate = re.sub(r'^(?:https?://(?:dx\.)?doi\.org/|doi:\s*)', '', original.strip(), flags=re.IGNORECASE)
+                    if re.fullmatch(r'10\.\d{4,9}/[^\s]+', candidate):
+                        normalized = candidate.lower()
+            if normalized is None:
+                if self.strict:
+                    raise ValueError('无效书目标识符：' + name)
+                report[name] = {'status': 'invalid', 'original': original}
+            else:
+                field.value = normalized
+                report[name] = {'status': 'valid', 'original': original}
+        entry.set_parser_metadata('identifiers', report)
+        return entry
--- a/library/docs/development-bibtexparser-o05-dev.md
