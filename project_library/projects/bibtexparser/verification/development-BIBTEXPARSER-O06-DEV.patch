--- a/library/bibtexparser/diff.py
+++ b/library/bibtexparser/diff.py
@@ -0,0 +1,35 @@
+"""比较真实书目语义，排版和字段排列不计为内容变更。"""
+from copy import deepcopy
+
+
+def diff_libraries(before, after, *, ignore_fields=()):
+    """返回稳定顺序的新增、删除、字段和外围块变化。
+
+    :param before: 修改前Library。
+    :param after: 修改后Library。
+    :param ignore_fields: 显式忽略的字段名，不改变原始书目。
+    :return: 包含entries/strings/comments/failed变化的独立字典。
+    """
+    ignored = {name.lower() for name in ignore_fields}
+    def entry_state(entry):
+        """生成不含排版的真实条目状态。@param entry 条目。@return 状态。"""
+        return {'type': entry.entry_type.lower(), 'fields': {field.key.lower(): deepcopy(field.value) for field in entry.fields if field.key.lower() not in ignored}}
+    left = {entry.key: entry_state(entry) for entry in before.entries}
+    right = {entry.key: entry_state(entry) for entry in after.entries}
+    entries = {'added': [key for key in right if key not in left], 'removed': [key for key in left if key not in right], 'changed': []}
+    for key in left:
+        if key in right and left[key] != right[key]:
+            entries['changed'].append({'key': key, 'before': left[key], 'after': right[key]})
+    def strings(library):
+        """保留宏名与真实值。@param library 书目库。@return 映射。"""
+        return {item.key: deepcopy(item.value) for item in library.strings}
+    def comments(library):
+        """只比较评论内容和类型。@param library 书目库。@return 列表。"""
+        return [(type(item).__name__, item.comment) for item in library.comments]
+    def failed(library):
+        """失败块保持数量和原文，拒绝使用含进程地址的repr。@param library 书目库。@return 列表。"""
+        return [(type(item).__name__, item.raw) for item in library.failed_blocks]
+    return {'entries': entries,
+        'strings': None if strings(before) == strings(after) else {'before': strings(before), 'after': strings(after)},
+        'comments': None if comments(before) == comments(after) else {'before': comments(before), 'after': comments(after)},
+        'failed': None if failed(before) == failed(after) else {'before': failed(before), 'after': failed(after)}}
--- a/library/docs/development-bibtexparser-o06-dev.md
+++ b/library/docs/development-bibtexparser-o06-dev.md
@@ -0,0 +1,5 @@
+# 比较书目内容语义并区分字段和外围块变化
+
+按真实引用键比较条目类型和字段值，排版及字段顺序不算变更，缺字段与None保持区别。稳定记录新增删除修改，并单独比较宏、评论及失败块；可显式忽略字段，报告复制可变值，不修改或合并输入。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/tests/test_development_bibtexparser_o06_dev.py
+++ b/library/tests/test_development_bibtexparser_o06_dev.py
@@ -0,0 +1,28 @@
+"""书目差异比较忽略排版但不丢失真实字段变化。"""
+from bibtexparser import Library
+from bibtexparser.model import Entry, Field
+
+def test_field_order_not_change():
+    """字段排列和类型大小写不构成语义变化。@return None。"""
+    from bibtexparser.diff import diff_libraries
+    one = Library([Entry('ARTICLE', 'x', [Field('title', 'A'), Field('year', '2026')])])
+    two = Library([Entry('article', 'x', [Field('year', '2026'), Field('title', 'A')])])
+    assert diff_libraries(one, two)['entries'] == {'added': [], 'removed': [], 'changed': []}
+
+def test_changes_and_added_removed():
+    """改字段、新增和删除分别定位。@return None。"""
+    from bibtexparser.diff import diff_libraries
+    one = Library([Entry('article', 'x', [Field('title', 'A')]), Entry('book', 'old', [])])
+    two = Library([Entry('article', 'x', [Field('title', 'B')]), Entry('book', 'new', [])])
+    result = diff_libraries(one, two)['entries']
+    assert result['added'] == ['new'] and result['removed'] == ['old']
+    assert result['changed'][0]['key'] == 'x'
+
+def test_ignored_and_nonentry_blocks():
+    """显式忽略字段仍比较宏与注释。@return None。"""
+    from bibtexparser.diff import diff_libraries
+    from bibtexparser.model import String, ExplicitComment
+    one = Library([Entry('article', 'x', [Field('year', '1')]), String('m', 'one'), ExplicitComment('a')])
+    two = Library([Entry('article', 'x', [Field('year', '2')]), String('m', 'two'), ExplicitComment('b')])
+    result = diff_libraries(one, two, ignore_fields=['year'])
+    assert result['entries']['changed'] == [] and result['strings'] is not None and result['comments'] is not None
