--- a/library/bibtexparser/crossref.py
+++ b/library/bibtexparser/crossref.py
@@ -0,0 +1,58 @@
+"""显式解析书目交叉引用，不改变默认解析栈。"""
+from copy import deepcopy
+from bibtexparser.middlewares.middleware import LibraryMiddleware
+
+
+class ResolveCrossrefMiddleware(LibraryMiddleware):
+    """继承父条目的缺失字段并记录真实来源。
+
+    :param missing: error拒绝缺失父项，ignore保留原子项。
+    """
+    def __init__(self, *, missing='error'):
+        """验证政策并固定非原地变换。@param missing 缺父政策。@return None。"""
+        super().__init__(allow_inplace_modification=False)
+        if missing not in ('error', 'ignore'):
+            raise ValueError('未知缺父项政策')
+        self.missing = missing
+
+    def transform(self, library):
+        """按依赖拓扑补齐字段，环和歧义明确失败。
+
+        :param library: 真实Library。
+        :return: 独立Library副本，子项显式字段优先。
+        """
+        if library.failed_blocks:
+            raise ValueError('交叉引用输入包含失败或重复条目')
+        result = deepcopy(library)
+        entries, visited, active = result.entries_dict, set(), set()
+        def resolve(entry):
+            """解析一个真实条目。@param entry 条目。@return None。"""
+            if entry.key in visited:
+                return
+            if entry.key in active:
+                raise ValueError('交叉引用环：' + entry.key)
+            active.add(entry.key)
+            parent_field = entry.get('crossref')
+            if parent_field is not None:
+                parent = entries.get(parent_field.value)
+                if parent is None:
+                    if self.missing == 'error':
+                        raise ValueError('交叉引用父项不存在：' + str(parent_field.value))
+                else:
+                    resolve(parent)
+                    sources = {}
+                    for field in parent.fields:
+                        if field.key == 'crossref':
+                            continue
+                        name = 'booktitle' if field.key == 'title' and entry.entry_type.lower() in ('inproceedings', 'incollection') else field.key
+                        if name not in entry.fields_dict:
+                            inherited = deepcopy(field)
+                            inherited.key = name
+                            entry.set_field(inherited)
+                            sources[name] = parent.key
+                    entry.set_parser_metadata('crossref_sources', sources)
+            active.remove(entry.key)
+            visited.add(entry.key)
+        for entry in result.entries:
+            resolve(entry)
+        return result
