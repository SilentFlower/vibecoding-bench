     def key(self):
         "Function used to extract comparison key from values."
         return self._key
+
+    def refresh_at(self,index):
+        """显式重建已变排序键的一项。@param index 既有位置，支持负索引。@return 原业务对象。"""
+        import operator
+        index=operator.index(index)
+        value=self[index]
+        values=list(self)
+        del values[index]
+        # 在独立索引完成全部比较后提交，失败时保留原缓存和顺序。
+        candidate=type(self)(values,key=self._key)
+        candidate.add(value)
+        self.__dict__.update(candidate.__dict__)
+        return value
 
