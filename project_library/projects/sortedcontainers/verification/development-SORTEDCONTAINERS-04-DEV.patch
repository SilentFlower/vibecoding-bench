+"""四种邻居统一按容器定义的排序顺序查找。"""
+MISSING=object()
+
+
+def neighbor(container,value,kind,default=MISSING):
+    """查询相邻值或映射项。@param container 有序容器。@param value 比较值/键。@param kind floor/ceil/lower/higher。@param default 显式缺项结果。@return 值或(key,value)。"""
+    if kind=="floor":index=container.bisect_right(value)-1
+    elif kind=="lower":index=container.bisect_left(value)-1
+    elif kind=="ceil":index=container.bisect_left(value)
+    else:index=container.bisect_right(value)
+    if index<0 or index>=len(container):
+        if default is not MISSING:return default
+        raise KeyError(value)
+    return container.peekitem(index) if isinstance(container,dict) else container[index]
