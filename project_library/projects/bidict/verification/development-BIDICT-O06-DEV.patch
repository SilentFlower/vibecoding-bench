--- a/library/bidict/readonly.py
+++ b/library/bidict/readonly.py
@@ -0,0 +1,46 @@
+"""保持实时正反关联的只读双向映射代理。"""
+from bidict import BidirectionalMapping, frozenbidict
+
+
+class ReadOnlyBidictProxy(BidirectionalMapping):
+    """共享实时关系但不公开写入入口，不声称深冻结或线程隔离。
+
+    :param mapping: 需要共享的真实双向映射。
+    """
+    __slots__ = ('__mapping', '__inverse')
+
+    def __init__(self, mapping):
+        """创建相互关联的两侧只读代理。@param mapping 源映射。@return None。"""
+        if not isinstance(mapping, BidirectionalMapping):
+            raise TypeError('源对象必须为双向映射')
+        self.__mapping = mapping
+        inverse = object.__new__(type(self))
+        inverse.__mapping = mapping.inverse
+        inverse.__inverse = self
+        self.__inverse = inverse
+
+    def __getitem__(self, key):
+        """读取实时关系。@param key 键。@return 值。"""
+        return self.__mapping[key]
+
+    def __iter__(self):
+        """保持源遍历顺序。@return 键迭代器。"""
+        return iter(self.__mapping)
+
+    def __len__(self):
+        """返回实时关系数。@return 数量。"""
+        return len(self.__mapping)
+
+    @property
+    def inverse(self):
+        """返回成对只读逆向代理。@return 逆向代理。"""
+        return self.__inverse
+
+    @property
+    def inv(self):
+        """保留常见inverse别名。@return 逆向代理。"""
+        return self.__inverse
+
+    def copy(self):
+        """取得当前关系的独立不可变快照。@return frozenbidict。"""
+        return frozenbidict(self.items())
