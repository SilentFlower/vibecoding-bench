--- a/library/bidict/compose.py
+++ b/library/bidict/compose.py
@@ -0,0 +1,24 @@
+"""按共同中间域组合两个真实双向映射。"""
+from bidict import BidirectionalMapping
+
+
+def compose(mapping, other, *, missing='error'):
+    """返回同类型的正向组合，两个输入都不修改。
+
+    :param mapping: A到B双向映射。
+    :param other: B到C双向映射。
+    :param missing: error或ignore中间缺项。
+    :return: 按左侧顺序构造的A到C双向映射。
+    """
+    if not isinstance(mapping, BidirectionalMapping) or not isinstance(other, BidirectionalMapping):
+        raise TypeError('组合两侧必须为双向映射')
+    if missing not in ('error', 'ignore'):
+        raise ValueError('未知中间域缺失政策')
+    items = []
+    for key, value in mapping.items():
+        if value not in other:
+            if missing == 'error':
+                raise KeyError(value)
+        else:
+            items.append((key, other[value]))
+    return type(mapping)(items)
