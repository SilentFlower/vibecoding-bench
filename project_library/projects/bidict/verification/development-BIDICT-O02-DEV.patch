--- a/library/bidict/select.py
+++ b/library/bidict/select.py
@@ -0,0 +1,29 @@
+"""按业务选择条件构造独立双向子映射。"""
+
+
+def select(mapping, *, keys=None, values=None, predicate=None, strict=False):
+    """同时应用显式选择条件，保持源关系相对顺序。
+
+    :param mapping: 真实双向映射。
+    :param keys: 可选键集合，空集合表示不选任何项。
+    :param values: 可选值集合。
+    :param predicate: 可选(key,value)业务谓词。
+    :param strict: 请求的不存在键或值是否失败。
+    :return: 不共享可变backing的同类子映射。
+    """
+    requested_keys = None if keys is None else set(keys)
+    requested_values = None if values is None else set(values)
+    if strict:
+        if requested_keys is not None and not requested_keys <= mapping.keys():
+            raise KeyError('选择键不存在')
+        if requested_values is not None and not requested_values <= mapping.inverse.keys():
+            raise KeyError('选择值不存在')
+    items = []
+    for key, value in mapping.items():
+        if requested_keys is not None and key not in requested_keys:
+            continue
+        if requested_values is not None and value not in requested_values:
+            continue
+        if predicate is None or predicate(key, value):
+            items.append((key, value))
+    return type(mapping)(items)
