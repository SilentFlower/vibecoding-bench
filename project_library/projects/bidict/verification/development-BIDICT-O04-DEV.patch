--- a/library/bidict/relation_patch.py
+++ b/library/bidict/relation_patch.py
@@ -0,0 +1,44 @@
+"""带完整前置条件和顺序的双向关系补丁。"""
+
+
+def relation_diff(before, after):
+    """冻结有序前后关系及显式操作，不执行输入字符串。
+
+    :param before: 修改前双向映射。
+    :param after: 修改后双向映射。
+    :return: schema1的关系补丁，可逆应用。
+    """
+    left, right = tuple(before.items()), tuple(after.items())
+    ldict, rdict = dict(left), dict(right)
+    operations = []
+    for key, value in left:
+        if key not in rdict:
+            operations.append(('remove', key, value))
+        elif value != rdict[key]:
+            operations.append(('reassign', key, value, rdict[key]))
+    operations.extend(('add', key, value) for key, value in right if key not in ldict)
+    return {'schema': 1, 'before': left, 'after': right, 'operations': tuple(operations)}
+
+
+def apply_relation_patch(mapping, patch, *, reverse=False):
+    """验证完整前置关系后一次构造最终唯一状态。
+
+    :param mapping: 当前双向映射，不原地修改。
+    :param patch: relation_diff返回的真实对象补丁。
+    :param reverse: 是否反向恢复原顺序和关系。
+    :return: 同类完整结果，任意失败不改输入。
+    """
+    if not isinstance(patch, dict) or set(patch) != {'schema', 'before', 'after', 'operations'} or patch['schema'] != 1:
+        raise ValueError('不支持的关系补丁')
+    expected = patch['after'] if reverse else patch['before']
+    target = patch['before'] if reverse else patch['after']
+    if tuple(mapping.items()) != tuple(expected):
+        raise ValueError('关系补丁前置条件不匹配')
+    keys, values = set(), set()
+    for key, value in target:
+        if key in keys or value in values:
+            raise ValueError('补丁目标关系不唯一')
+        keys.add(key)
+        values.add(value)
+    # 完整目标验证允许循环换值，不误用逐条putall的即时冲突策略。
+    return type(mapping)(target)
