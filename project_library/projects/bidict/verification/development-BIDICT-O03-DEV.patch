--- a/library/bidict/transform.py
+++ b/library/bidict/transform.py
@@ -0,0 +1,22 @@
+"""对双向关系两侧执行受唯一约束保护的业务转换。"""
+
+
+def transform_items(mapping, *, key_fn=None, value_fn=None):
+    """转换全部关系后验证最终键值唯一性，不发布半成品。
+
+    :param mapping: 真实双向映射。
+    :param key_fn: 每个键调用一次的可选转换。
+    :param value_fn: 每个值调用一次的可选转换。
+    :return: 同类型新关系；重复转换结果报告来源位置。
+    """
+    items, keys, values = [], {}, {}
+    for position, (key, value) in enumerate(mapping.items(), 1):
+        new_key = key if key_fn is None else key_fn(key)
+        new_value = value if value_fn is None else value_fn(value)
+        if new_key in keys:
+            raise ValueError('转换键冲突：第%d和%d项' % (keys[new_key], position))
+        if new_value in values:
+            raise ValueError('转换值冲突：第%d和%d项' % (values[new_value], position))
+        keys[new_key], values[new_value] = position, position
+        items.append((new_key, new_value))
+    return type(mapping)(items)
