+"""按真实函数签名绑定参数的显式规范键缓存，不深hash业务对象。"""
+import inspect
+from collections import OrderedDict,namedtuple
+from functools import wraps
+from threading import RLock
+CacheInfo=namedtuple('CacheInfo','hits misses maxsize currsize')
+
+def canonical_cache(*,maxsize=128,typed=False,key_func=None):
+    """建立规范参数缓存。@param maxsize 容量。@param typed 是否区分直接参数类型。@param key_func 可选BoundArguments到hashable业务键。@return 同步函数/方法装饰器。"""
+    if type(maxsize) is not int or maxsize<0 or key_func is not None and not callable(key_func):raise ValueError('容量或键函数无效')
+    def decorate(function):
+        signature=inspect.signature(function);cache=OrderedDict();lock=RLock();hits=misses=0
+        def make_key(args,kwargs):
+            bound=signature.bind(*args,**kwargs);bound.apply_defaults()
+            if key_func is not None:key=key_func(bound)
+            else:
+                pairs=[]
+                for name,value in bound.arguments.items():
+                    if signature.parameters[name].kind is inspect.Parameter.VAR_KEYWORD:value=tuple(sorted(value.items()))
+                    pairs.append((name,(type(value),value) if typed else value))
+                key=tuple(pairs)
+            hash(key);return key
+        @wraps(function)
+        def invoke(*args,**kwargs):
+            nonlocal hits,misses
+            key=make_key(args,kwargs)
+            with lock:
+                if key in cache:hits+=1;cache.move_to_end(key);return cache[key]
+                misses+=1;value=function(*args,**kwargs)
+                if maxsize:
+                    cache[key]=value
+                    while len(cache)>maxsize:cache.popitem(last=False)
+                return value
+        def cache_info():
+            """查询规范键命中与容量。@return CacheInfo。"""
+            with lock:return CacheInfo(hits,misses,maxsize,len(cache))
+        def cache_clear():
+            """清全缓存和统计。@return None。"""
+            nonlocal hits,misses
+            with lock:cache.clear();hits=misses=0
+        invoke.cache_info=cache_info;invoke.cache_clear=cache_clear
+        return invoke
+    return decorate
