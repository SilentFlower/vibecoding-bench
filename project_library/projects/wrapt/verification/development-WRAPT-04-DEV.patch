+"""按注入单调时钟从计算完成时计TTL的独立缓存。"""
+import math
+import time
+from collections import OrderedDict,namedtuple
+from functools import wraps
+from threading import RLock
+CacheInfo=namedtuple('CacheInfo','hits misses maxsize currsize')
+
+def ttl_cache(ttl,*,maxsize=128,clock=time.monotonic):
+    """创建同步TTL缓存。@param ttl 有限非负秒，零禁缓存。@param maxsize 容量。@param clock 单调时钟。@return 普通函数/方法装饰器；计算在可重入锁内串行。"""
+    if isinstance(ttl,bool) or not isinstance(ttl,(int,float)) or not math.isfinite(ttl) or ttl<0:raise ValueError('ttl无效')
+    if type(maxsize) is not int or maxsize<0 or not callable(clock):raise ValueError('容量/时钟无效')
+    def decorate(function):
+        cache=OrderedDict();lock=RLock();hits=misses=0;last=None
+        def now():
+            nonlocal last
+            value=clock()
+            if isinstance(value,bool) or not isinstance(value,(int,float)) or not math.isfinite(value) or last is not None and value<last:raise ValueError('时钟必须有限且单调不回退')
+            last=value;return value
+        def purge(current):
+            for key,(expires,_) in list(cache.items()):
+                if current>=expires:del cache[key]
+        @wraps(function)
+        def invoke(*args,**kwargs):
+            nonlocal hits,misses
+            key=(args,tuple(sorted(kwargs.items())));hash(key)
+            with lock:
+                current=now();purge(current)
+                if key in cache:hits+=1;cache.move_to_end(key);return cache[key][1]
+                misses+=1;value=function(*args,**kwargs)
+                completed=now()
+                if ttl and maxsize:
+                    cache[key]=(completed+ttl,value)
+                    while len(cache)>maxsize:cache.popitem(last=False)
+                return value
+        def cache_info():
+            """查询时同步清理所有过期条目。@return CacheInfo。"""
+            with lock:purge(now());return CacheInfo(hits,misses,maxsize,len(cache))
+        def cache_clear():
+            """清所有条目和统计，仍保单调时钟界限。@return None。"""
+            nonlocal hits,misses
+            with lock:cache.clear();hits=misses=0
+        invoke.cache_info=cache_info;invoke.cache_clear=cache_clear
+        return invoke
+    return decorate
