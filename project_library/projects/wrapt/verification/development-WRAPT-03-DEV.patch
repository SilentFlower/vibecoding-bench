+"""只缓存成功完成值的按事件循环隔离异步LRU。"""
+import asyncio
+import inspect
+from collections import OrderedDict,namedtuple
+from functools import wraps
+from weakref import WeakKeyDictionary
+CacheInfo=namedtuple('CacheInfo','hits misses maxsize currsize')
+
+def async_lru_cache(*,maxsize=128):
+    """异步结果装饰器。@param maxsize 每loop容量。@return async函数装饰器；并发相同未完成调用允许独立计算。"""
+    if type(maxsize) is not int or maxsize<0:raise ValueError('maxsize须非负整数')
+    def decorate(function):
+        if not inspect.iscoroutinefunction(function):raise TypeError('需要async函数')
+        loops=WeakKeyDictionary()
+        def state():
+            loop=asyncio.get_running_loop()
+            if loop not in loops:loops[loop]={'cache':OrderedDict(),'hits':0,'misses':0,'generation':0}
+            return loops[loop]
+        @wraps(function)
+        async def invoke(*args,**kwargs):
+            current=state();key=(args,tuple(sorted(kwargs.items())));hash(key)
+            if key in current['cache']:
+                current['hits']+=1;current['cache'].move_to_end(key);return current['cache'][key]
+            current['misses']+=1;generation=current['generation']
+            value=await function(*args,**kwargs)
+            # clear期间仍在飞的计算可返回给原调用者，但不能回填被清理的缓存代次。
+            if maxsize and generation==current['generation']:
+                current['cache'][key]=value;current['cache'].move_to_end(key)
+                while len(current['cache'])>maxsize:current['cache'].popitem(last=False)
+            return value
+        def cache_info():
+            """查看当前运行loop统计。@return CacheInfo。"""
+            value=state();return CacheInfo(value['hits'],value['misses'],maxsize,len(value['cache']))
+        def cache_clear():
+            """清理当前loop并撤销在飞回填。@return None。"""
+            value=state();value['generation']+=1;value['cache'].clear();value['hits']=value['misses']=0
+        invoke.cache_info=cache_info;invoke.cache_clear=cache_clear
+        return invoke
+    return decorate
