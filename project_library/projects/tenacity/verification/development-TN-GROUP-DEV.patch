+class retry_if_exception_group(retry_base):
+    """按异常组叶子分类，普通异常按一个叶子处理，不改变异常组结构。"""
+    def __init__(self,predicate,*,mode='all'):
+        """创建策略。@param predicate 叶子异常谓词。@param mode all或any。@return None。
+        """
+        if not callable(predicate) or mode not in ('all','any'):
+            raise ValueError('需要可调用叶子谓词及all/any模式')
+        self.predicate,self.mode=predicate,mode
+
+    def __call__(self,retry_state):
+        """分类真实失败结果。@param retry_state 已设置outcome的状态。@return 是否重试。
+        """
+        if retry_state.outcome is None:
+            raise RuntimeError('分类前必须有尝试结果')
+        if not retry_state.outcome.failed:
+            return False
+        pending=[retry_state.outcome.exception()]
+        while pending:
+            error=pending.pop()
+            if isinstance(error,BaseExceptionGroup):
+                pending.extend(reversed(error.exceptions))
+                continue
+            accepted=bool(self.predicate(error))
+            if self.mode=='all' and not accepted:
+                return False
+            if self.mode=='any' and accepted:
+                return True
+        return self.mode=='all'
+
+
 class retry_any(retry_base):
     """Retries if any of the retries condition is valid."""
 
