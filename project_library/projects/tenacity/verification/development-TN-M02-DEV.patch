+def test_deep_builtin_wait_combine_preserves_groups() -> None:
+    """无递归深树仍保持每层求和分组。@return None。"""
+    rs = tenacity.RetryCallState(tenacity.Retrying(), None, (), {})
+    tree = tenacity.wait_fixed(1)
+    for _ in range(2000):
+        tree = tenacity.wait_combine(tree, tenacity.wait_fixed(1))
+    assert tree(rs) == 2001.0
+    grouped = tenacity.wait_combine(tenacity.wait_combine(tenacity.wait_fixed(1e16), tenacity.wait_fixed(1)), tenacity.wait_fixed(-1e16))
+    assert grouped(rs) == 0.0
