+    def get_path(self, path, default=NO_DEFAULT):
+        """读取字面路径而不触发默认节点或点分解析。
+
+        :param path: 显式str/int段。
+        :param default: 缺键或越界时的可选后备值。
+        :return: 原有值；缺失且无后备时抛KeyError/IndexError。
+        """
+        current = self
+        try:
+            for part in self._path_parts(path):
+                if isinstance(current, Box):
+                    current = dict.__getitem__(current, part)
+                elif isinstance(current, (list, tuple)):
+                    if not isinstance(part, int):
+                        raise TypeError('列表路径段必须为整数')
+                    current = current[part]
+                elif isinstance(current, Mapping):
+                    current = current[part]
+                else:
+                    raise TypeError('路径祖先必须为映射或序列')
+        except (KeyError, IndexError):
+            if default is not NO_DEFAULT:
+                return default
+            raise
+        return current
+
+    def set_path(self, path, value):
+        """只在已存在父结构内赋值，不隐式创建无限节点。
+
+        :param path: 显式路径，列表支持负索引。
+        :param value: 新业务值。
+        :return: None；冻结策略和既有转换规则保持。
+        """
+        parts = self._path_parts(path)
+        parent = self if len(parts) == 1 else self.get_path(parts[:-1])
+        key = parts[-1]
+        if isinstance(parent, Box):
+            if parent._box_config['frozen_box']:
+                raise BoxError('Box is frozen')
+            if parent._box_config['conversion_box'] and parent._box_config['box_duplicates'] != 'ignore' and key not in dict.keys(parent):
+                parent._conversion_checks(key)
+            parent._Box__convert_and_store(key, parent._Box__recast(key, value))
+        elif isinstance(parent, list):
+            if not isinstance(key, int):
+                raise TypeError('列表路径段必须为整数')
+            parent[key] = value
+        elif isinstance(parent, dict):
+            parent[key] = value
+        else:
+            raise TypeError('路径父结构不可赋值')
+
