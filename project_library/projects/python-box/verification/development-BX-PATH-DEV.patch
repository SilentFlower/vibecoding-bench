+    def _path_parts(path):
+        """校验有限显式路径，不把字符串或点分键猜成路径。
+
+        :param path: str/int段组成的非空可迭代路径。
+        :return: 路径tuple。
+        """
+        if isinstance(path, (str, bytes)):
+            raise TypeError('路径必须为分段序列')
