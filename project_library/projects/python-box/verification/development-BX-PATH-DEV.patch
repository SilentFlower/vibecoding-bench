+        """按字面路径删除叶子，缺失和冻结错误明确传播。
+
+        :param path: 显式路径。
+        :return: None。
+        """
+        parts = self._path_parts(path)
+        parent = self if len(parts) == 1 else self.get_path(parts[:-1])
+        key = parts[-1]
+        if isinstance(parent, Box):
+            if parent._box_config['frozen_box']:
+                raise BoxError('Box is frozen')
+            dict.__delitem__(parent, key)
+            parent._box_config['__safe_keys'] = {parent._safe_attr(item): item for item in dict.keys(parent)}
