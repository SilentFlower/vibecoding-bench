+    @staticmethod
+    def iter_jsonl_records(records, **json_kwargs):
+        """逐记录编码任意有限或有界消费的数据流，不整体物化。
+
+        :param records: 可迭代业务记录。
+        :param json_kwargs: 标准json.dumps选项，不允许多行缩进。
+        :return: 每条包含末尾换行的惰性JSON文本迭代器。
+        """
+        from json import dumps
+        if json_kwargs.get('indent') is not None:
+            raise ValueError('JSONL不支持多行缩进')
+        for number, record in enumerate(records, 1):
+            try:
+                encoded = dumps(record, **json_kwargs)
+                if '\n' in encoded or '\r' in encoded:
+                    raise ValueError('JSONL记录必须单行')
+            except (TypeError, ValueError) as error:
+                raise ValueError('JSONL第%d条记录编码失败' % number) from error
+            yield encoded + '\n'
+
+    def iter_jsonl(self, **json_kwargs):
+        """惰性编码当前列表。@param json_kwargs 编码选项。@return 文本迭代器。"""
+        return self.iter_jsonl_records(self, **json_kwargs)
+
+    def write_jsonl(self, destination, *, encoding='utf-8', **json_kwargs):
+        """逐条写入JSONL，调用者持有的流不会被关闭。
+
+        :param destination: 文件路径或可写文本流。
+        :param encoding: 路径模式文件编码。
+        :param json_kwargs: JSON编码选项。
+        :return: 成功写入的记录数；失败可能保留已写前缀，不声称整文件原子性。
+        """
+        owned = not hasattr(destination, 'write')
+        stream = open(destination, 'w', encoding=encoding, newline='') if owned else destination
+        count = 0
+        try:
+            for line in self.iter_jsonl(**json_kwargs):
+                stream.write(line)
+                count += 1
+        finally:
+            if owned:
+                stream.close()
+        return count
+
