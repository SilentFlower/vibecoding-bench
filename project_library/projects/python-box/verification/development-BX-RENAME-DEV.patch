+    def rename_key(self, old, new):
+        """在原位置重命名字面键，失败不改变值、顺序或别名表。
+
+        :param old: 已存在原键。
+        :param new: 不与其他键或安全属性冲突的新键。
+        :return: self；现有子对象保持同一引用。
+        """
+        if self._box_config['frozen_box']:
+            raise BoxError('Box is frozen')
+        if old not in dict.keys(self):
+            raise BoxKeyError(old)
+        hash(new)
+        if old == new:
+            return self
+        if new in dict.keys(self):
+            raise BoxKeyError('目标键已存在')
+        if isinstance(new, str) and new in self._protected_keys:
+            raise BoxKeyError('目标键为保留属性')
+        safe = self._safe_attr(new)
+        if self._box_config['conversion_box']:
+            for key in dict.keys(self):
+                if key != old and self._safe_attr(key) == safe:
+                    raise BoxKeyError('目标安全属性冲突')
+        items = [(new if key == old else key, value) for key, value in dict.items(self)]
+        aliases = {self._safe_attr(key): key for key, value in items}
+        # 验证及别名计算都在发布前完成，不能通过删除再赋值移动键或重建子对象。
+        dict.clear(self)
+        dict.update(self, items)
+        self._box_config['__safe_keys'] = aliases
+        return self
+
