        },
        {
          "id": "PS-UNION-FIX",
          "kind": "modify",
          "goal": "修复库内字典Union分段环境解码并补回归",
          "prompt": "Fix this segmented environment decoding issue for dictionary union values in the library and add regression tests. Valid JSON lists of strings must produce lists, while ordinary strings must remain unchanged. Do not expand the requirements beyond the default behavior.",
          "materials": [
            "materials/union-model.py",
            "materials/union-input.json",
            "materials/union-diagnosis-context.md"
          ],
          "requires": [],
          "max_turns": 4,
          "allowed_paths": [
