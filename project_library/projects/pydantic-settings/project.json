      "tasks": [
        {
          "id": "PS-UNION-DIAG",
          "kind": "diagnose",
          "goal": "定位字典联合值未解码原因并给出不改库的临时办法",
          "prompt": "A product parameter accepts either a string or a list of strings. I passed [] to APP_CONFIG__ITEM, but the result is a string. The example and output are provided here. Determine the cause, identify the relevant code, and give a temporary workaround that does not modify the library.",
          "materials": [
            "materials/union-model.py",
            "materials/union-input.json"
          ],
          "requires": [],
          "max_turns": 4,
          "allowed_paths": [
            "app"
          ],
          "outcomes": [
