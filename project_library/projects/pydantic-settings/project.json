  "scenarios": [
    {
      "id": "PS-S01",
      "title": "商品配置接入",
      "goal": "理解适配边界并得到本地配置示例",
      "default_entry": "default",
      "entries": [
        {
          "id": "default",
          "task_ids": [
            "PS-UNDERSTAND",
            "PS-CONFIGURE"
          ],
          "materials": []
        }
      ],
      "tasks": [
        {
          "id": "PS-UNDERSTAND",
          "kind": "understand",
          "goal": "判断项目用途、适配理由与业务职责边界",
          "prompt": "What does this project do? We have a local product organization script and want to move the tool title and the number of items processed per batch into configuration. Is this project a good fit? What will we still need to handle ourselves when integrating it?",
          "materials": [
            "materials/business-goal.md"
          ],
          "requires": [],
          "max_turns": 4,
          "allowed_paths": [],
          "outcomes": [
            "answered"
          ],
          "evaluation": {
            "version": 2,
            "rubric": "verification/rubrics/PS-UNDERSTAND.json"
          },
          "branches": [
            {
              "id": "PS-UNDERSTAND-BOUNDARY",
              "when": "The answer omits the responsibilities that remain with the business script, and the user needs to confirm whether the library performs product organization for them.",
              "materials": [
                "disclosure/understand-followup.md"
              ],
              "activate_tasks": []
            }
          ]
        },
        {
          "id": "PS-CONFIGURE",
          "kind": "consult",
          "goal": "给出真实可运行的标题／整数数量配置接入示例",
          "prompt": "Then give me a minimal example: the default title is “商品工具” and the quantity is 2; a local .env file can configure them, and runtime environment variables can override them. The quantity must be an integer, and I need to pass the loaded values to the existing business function.",
          "materials": [
            "materials/configure-delivery.md",
            "materials/configure-fixture.py"
          ],
          "requires": [
            {
              "task_id": "PS-UNDERSTAND",
              "artifact": "answer"
            }
          ],
          "max_turns": 4,
          "allowed_paths": [
            "app"
          ],
          "outcomes": [
            "example_delivered"
          ],
          "evaluation": {
            "version": 2,
            "rubric": "verification/rubrics/PS-CONFIGURE.json",
            "native": "verification/native/consult.json"
          }
        }
      ]
    },
    {
      "id": "PS-S02",
      "title": "数量来源优先级",
      "goal": "排除正确来源覆盖行为被误报为BUG",
      "default_entry": "default",
      "entries": [
        {
          "id": "default",
          "task_ids": [
            "PS-PRECEDENCE"
          ],
          "materials": []
        }
      ],
      "tasks": [
        {
          "id": "PS-PRECEDENCE",
          "kind": "diagnose",
          "goal": "以来源优先级解释正确行为并给出最小使用调整",
          "prompt": "The quantity in the configuration file is 2, but the printed value is 5. The example includes the code, file, startup environment, and output. Determine whether this is a library bug and tell me how to use only the quantity from the file. Do not modify the library yet.",
          "materials": [
            "materials/precedence-model.py",
            "materials/precedence-input.json"
          ],
          "requires": [],
          "max_turns": 4,
          "allowed_paths": [
            "app"
          ],
          "outcomes": [
            "no_bug"
          ],
          "evaluation": {
            "version": 2,
            "rubric": "verification/rubrics/PS-PRECEDENCE.json",
            "native": "verification/native/precedence.json"
          },
          "branches": [
            {
              "id": "PS-PRECEDENCE-CONTROL",
              "when": "A control step with the environment variable removed is needed to verify the override relationship.",
              "materials": [
                "disclosure/precedence-control.md"
              ],
              "activate_tasks": []
            }
          ]
        }
      ]
    },
