          ],
          "outcomes": [
            "code_verified"
          ],
          "evaluation": {
            "version": 2,
            "rubric": "verification/rubrics/PS-UNION-FIX.json",
            "native": "verification/native/union-fixed.json"
          }
        }
      ]
