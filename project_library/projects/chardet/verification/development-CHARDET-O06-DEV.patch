--- a/library/chardet/transcode.py
+++ b/library/chardet/transcode.py
@@ -0,0 +1,27 @@
+"""由真实检测或显式源编码驱动的严格本地转码。"""
+from codecs import lookup
+from chardet import detect
+
+
+def transcode_bytes(data, target_encoding, *, source_encoding=None):
+    """完整严格解码并重新编码，不修改输入或静默丢字符。
+
+    :param data: bytes或bytearray。
+    :param target_encoding: 显式目标codec，BOM行为由目标codec明确决定。
+    :param source_encoding: 显式源codec，None使用实际detect标签后验证全文。
+    :return: output字节、源/目标codec及原检测事实；不能把可解码当语义正确保证。
+    """
+    if not isinstance(data, (bytes, bytearray)):
+        raise TypeError('转码输入必须为字节')
+    payload = bytes(data)
+    detected = None
+    if source_encoding is None:
+        detected = dict(detect(payload))
+        source_encoding = detected['encoding']
+        if source_encoding is None:
+            raise ValueError('没有可用源编码，必须显式指定')
+    source, target = lookup(source_encoding), lookup(target_encoding)
+    text = payload.decode(source.name, errors='strict')
+    encoded = text.encode(target.name, errors='strict')
+    return {'output': encoded, 'source_encoding': source.name, 'target_encoding': target.name,
+        'detected': detected, 'validated_source_bytes': len(payload)}
