+def format_duration(delta, *, units=('day', 'hour', 'minute', 'second'), max_parts=None, length='long', locale=None):
+    """格式化固定时长的多个单位。@param delta 非负秒数或timedelta。
+    @param units 严格降序固定单位。@param max_parts 最多非零分量。@param length 单位宽度。
+    @param locale 区域。@return 使用区域化单位和列表规则的时长。
+    """
+    from decimal import Decimal
+    from babel.lists import format_list
+    from babel.units import format_unit
+
+    scales = {'week': 604800, 'day': 86400, 'hour': 3600, 'minute': 60, 'second': 1}
+    units = tuple(units)
+    if not units or any(unit not in scales for unit in units) or any(scales[a] <= scales[b] for a, b in zip(units, units[1:])):
+        raise ValueError('时长单位必须唯一且严格降序')
+    if max_parts is not None and (type(max_parts) is not int or max_parts < 1):
+        raise ValueError('分量上限必须是正整数')
+    if length not in ('long', 'short', 'narrow'):
+        raise ValueError('未知单位宽度')
+    if isinstance(delta, datetime.timedelta):
+        seconds = Decimal(delta.days * 86400 + delta.seconds) + Decimal(delta.microseconds) / 1000000
+    else:
+        seconds = Decimal(str(delta))
+    if not seconds.is_finite() or seconds < 0:
+        raise ValueError('时长必须是非负有限数')
+    rendered = []
+    for index, unit in enumerate(units):
+        if index == len(units) - 1:
+            value = seconds / scales[unit]
+        else:
+            value = seconds // scales[unit]
+            seconds -= value * scales[unit]
+        if value:
+            rendered.append(format_unit(value, 'duration-' + unit, length, locale=locale))
+        if max_parts is not None and len(rendered) == max_parts:
+            break
+    if not rendered:
+        rendered = [format_unit(0, 'duration-' + units[-1], length, locale=locale)]
+    try:
+        return format_list(rendered, style={'long':'unit', 'short':'unit-short', 'narrow':'unit-narrow'}[length], locale=locale)
+    except KeyError:
+        return format_list(rendered, style='standard', locale=locale)
 
 
