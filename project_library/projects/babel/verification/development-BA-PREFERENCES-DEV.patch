+def negotiate_locale_preferences(header, available, *, sep='_', aliases=LOCALE_ALIASES):
+    """按权重协商应用实际可用语言。@param header 有界语言首选项文本。
+    @param available 可用区域标识。@param sep 可用标识分隔符。@param aliases 旧协商别名映射。
+    @return 原available拼写的匹配项或None；q=0明确排除优先于通配符。
+    """
+    import re
+    from decimal import Decimal
+
+    if not isinstance(header, str):
+        raise TypeError('语言首选项必须是字符串')
+    if len(header) > 8192 or header.count(',') >= 100:
+        raise ValueError('语言首选项过长')
+    choices = list(available)
+    normalized = {item.replace(sep, '-').lower(): item for item in choices if item}
+    weighted, excluded = [], []
+    for index, part in enumerate(header.split(',')):
+        if not part.strip():
+            continue
+        match = re.fullmatch(r'\s*(\*|[A-Za-z]{1,8}(?:-[A-Za-z0-9]{1,8})*)\s*(?:;\s*q=(0(?:\.\d{0,3})?|1(?:\.0{0,3})?))?\s*', part)
+        if match is None:
+            raise ValueError('无效语言首选项')
+        language, quality = match.groups()
+        quality = Decimal(quality or '1')
+        language = language.lower()
+        if quality == 0:
+            excluded.append(language)
+        else:
+            weighted.append((-quality, index, language))
+    def denied(candidate):
+        return any(item == '*' or candidate == item or candidate.startswith(item + '-') for item in excluded)
+    allowed = {key: value for key, value in normalized.items() if not denied(key)}
+    for quality, index, language in sorted(weighted):
+        if language == '*':
+            return next(iter(allowed.values()), None)
+        if denied(language):
+            continue
+        match = negotiate_locale([language.replace('-', sep)], allowed.values(), sep=sep, aliases=aliases)
+        if match is not None:
+            return allowed[match.replace(sep, '-').lower()]
+    return None
+
