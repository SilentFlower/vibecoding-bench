+def test_consecutive_bound_callbacks_use_current_mapping():
+    """相同get名字不应覆盖本次业务映射。@return None。"""
+    db = Database(memory=True)
+    table = db["places"].insert({"id": 1, "state": "CA", "country": "US"}, pk="id")
+    table.convert("state", {"CA": "California"}.get)
+    table.convert("country", {"US": "United States"}.get)
+    assert table.get(1) == {"id": 1, "state": "California", "country": "United States"}
+    db.close()
