+def test_convert_does_not_change_public_default_replacement():
+    """内部修复不应改公共注册的默认策略。@return None。"""
+    db = Database(memory=True)
+    db.register_function(lambda value: "old", name="same")
+    db.register_function(lambda value: "new", name="same")
+    assert db.execute("select same('x')").fetchone()[0] == "old"
+    db.register_function(lambda value: "new", name="same", replace=True)
+    assert db.execute("select same('x')").fetchone()[0] == "new"
+    db.close()
