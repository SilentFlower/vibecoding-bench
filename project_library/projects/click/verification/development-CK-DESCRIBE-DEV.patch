+    def describe(self,ctx):
+        """返回含本次真实用法的独立元数据。@param ctx 属于此命令的Context。
+        @return 原to_info_dict字段加usage及command_path，不执行命令或参数回调。
+        """
+        if ctx.command is not self:
+            raise TypeError('上下文不属于当前命令')
+        return {**self.to_info_dict(ctx),'usage':self.get_usage(ctx),'command_path':ctx.command_path}
+
     def __repr__(self) -> str:
         return f"<{self.__class__.__name__} {self.name}>"
 
