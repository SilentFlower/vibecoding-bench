+    def bindings_snapshot(self, *, include_parents=True):
+        """只读取得有效绑定及来源，不触发auto_bind或Provider。
+
+        :param include_parents: 是否包含尚未被当前层覆盖的父层绑定。
+        :return: BindingInfo不可变元组；后续bind不改变旧快照。
+        """
+        if not isinstance(include_parents, bool):
+            raise TypeError('include_parents必须为bool')
+        seen, records, binder, depth = set(), [], self, 0
+        with lock:
+            while binder is not None:
+                for interface, binding in list(binder._bindings.items()):
+                    if interface in seen:
+                        continue
+                    seen.add(interface)
+                    contributions = ()
+                    if isinstance(binding.provider, MultiBinder):
+                        contributions = tuple((type(item.provider), item.scope) for item in binding.provider._multi_bindings)
+                    records.append(BindingInfo(interface, type(binding.provider), binding.scope, depth,
+                        not isinstance(binding, ImplicitBinding), contributions))
+                binder = binder.parent if include_parents else None
+                depth += 1
+        return tuple(records)
 
     def has_binding_for(self, interface: type) -> bool:
         return interface in self._bindings
