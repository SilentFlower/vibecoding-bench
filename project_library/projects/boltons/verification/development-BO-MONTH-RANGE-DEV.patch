+def month_range(start,stop,step=1,*,inclusive=False,month_end='clip'):
+    """按起始日锚点逐月枚举日期。@param start 起始date。@param stop 停止date。
+    @param step 非零整数月步长。@param inclusive 是否包含相等停止日。@param month_end clip/skip/raise。
+    @return 日期迭代器；每月始终使用原始日，不由二月截断后的日继续漂移。
+    """
+    import calendar
+    if type(start) is not date or type(stop) is not date:
+        raise TypeError('月序列仅接受date对象')
+    if type(step) is not int or step==0 or type(inclusive) is not bool or month_end not in ('clip','skip','raise'):
+        raise ValueError('月步长、边界或月底策略无效')
+    cursor=start.year*12+start.month-1
+    boundary=stop.year*12+stop.month-1
+    while cursor<=boundary if step>0 else cursor>=boundary:
+        year,month=divmod(cursor,12);month+=1
+        last=calendar.monthrange(year,month)[1]
+        if start.day>last:
+            if month_end=='raise':
+                raise ValueError('锚点日在目标月份不存在')
+            if month_end=='skip':
+                cursor+=step
+                continue
+        current=date(year,month,min(start.day,last))
+        if (current>stop or current==stop and not inclusive) if step>0 else (current<stop or current==stop and not inclusive):
+            break
+        yield current
+        cursor+=step
+
+
