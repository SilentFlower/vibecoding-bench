+class JSONLWriter:
+    """不拥有输出流的逐行JSON写入器，先序列化一条完整记录再写。"""
+    def __init__(self,stream,*,binary=False,encoding='utf-8',dumps=None):
+        """配置输出。@param stream 调用者流。@param binary 是否写编码bytes。
+        @param encoding 二进制编码。@param dumps 显式序列化器或None。@return None。
+        """
+        if type(binary) is not bool or dumps is not None and not callable(dumps):
+            raise TypeError('无效JSONL写入策略')
+        self.stream,self.binary,self.encoding=stream,binary,encoding
+        self.dumps=json.dumps if dumps is None else dumps
+        self.count=0
+
+    def write(self,value):
+        """写入一条记录。@param value JSON值。@return 写入字符或字节数量。
+        """
+        serialized=self.dumps(value)
+        if not isinstance(serialized,str) or '\n' in serialized or '\r' in serialized:
+            raise ValueError('JSONL序列化器必须返回不含物理换行的文本')
+        # 检查自定义编码器的完整JSON值，拒绝注入多条记录或无效片段。
+        json.loads(serialized)
+        record=serialized+'\n'
+        if self.binary:
+            record=record.encode(self.encoding)
+        written=self.stream.write(record)
+        if written is not None and written!=len(record):
+            raise IOError('JSONL输出发生部分写入')
+        self.count+=1
+        return len(record)
+
+    def write_many(self,values):
+        """逐项写有限或惰性输入。@param values 记录迭代器。@return 此次成功记录数。
+        """
+        count=0
+        for value in values:
+            self.write(value);count+=1
+        return count
+
+    def flush(self):
+        """请求底层流刷新，不关闭它。@return None。
+        """
+        self.stream.flush()
 
 
