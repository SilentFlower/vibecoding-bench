+"""入口点只读发现与显式候选加载，发现阶段绝不导入插件。"""
+import importlib.metadata
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class EntryPointCandidate:
+    """稳定元数据身份。@param group 组。@param name 名。@param value 导入目标。@param distribution 分发名。@param version 版本。"""
+    group: str
+    name: str
+    value: str
+    distribution: str
+    version: str
+
+
+@dataclass(frozen=True)
+class DiscoveryReport:
+    """发现结果与单独元数据错误。@param candidates 候选。@param errors 错误摘要。"""
+    candidates: tuple
+    errors: tuple
+
+
+def _scan(group,name=None):
+    """读取分发及入口字段，不调用ep.load。@param group 组。@param name 可选名字。@return 内部候选、错误。"""
+    if not isinstance(group,str) or not group:raise ValueError('入口组必须非空字符串')
+    records=[];errors=[]
+    for index,distribution in enumerate(importlib.metadata.distributions()):
+        try:
+            dist_name=distribution.metadata['Name'];version=distribution.version
+            if not isinstance(dist_name,str) or not isinstance(version,str):raise ValueError('分发名称或版本缺失')
+            for entry in distribution.entry_points:
+                if entry.group!=group or name is not None and entry.name!=name:continue
+                if not isinstance(entry.name,str) or not isinstance(entry.value,str):raise ValueError('入口点元数据字段无效')
+                candidate=EntryPointCandidate(group,entry.name,entry.value,dist_name,version)
+                records.append((candidate,distribution,entry))
+        except Exception as error:
+            errors.append({'distribution_index':index,'error_type':type(error).__name__})
+    return records,errors
+
+
+def discover_entrypoints(group,name=None):
+    """预览候选元数据，不验证插件行为或执行导入。@param group 组。@param name 名字过滤。@return DiscoveryReport。"""
+    records,errors=_scan(group,name)
+    ordered=sorted((row[0] for row in records),key=lambda row:(row.name,row.distribution,row.version,row.value))
+    return DiscoveryReport(tuple(ordered),tuple(errors))
+
+
+def load_entrypoint(manager,candidate):
+    """重新核对完整元数据身份后只加载所选候选。@param manager 真实管理器。@param candidate 预览候选。@return 实际注册名或None。"""
+    if not isinstance(candidate,EntryPointCandidate):raise TypeError('必须提供发现候选')
+    if manager.has_plugin(candidate.name) or manager.is_blocked(candidate.name):return None
+    records,errors=_scan(candidate.group,candidate.name)
+    matches=[row for row in records if row[0]==candidate]
+    if len(matches)!=1 or errors:raise ValueError('入口元数据变化、重复或不完整，请重新发现')
+    _,distribution,entry=matches[0]
+    return manager.register_entrypoint(entry.load(),candidate.name,distribution)
