+# 冻结缓冲事实并支持连续memoryview生命周期
+
+模型保存不可变字节，防止raw与缓存文字分裂。新增连续buffer入口，非bytes明确复制并报告大小，调用者视图可释放或底层复用而结果不变；不连续和非法缓冲拒绝，实际检测仍由from_bytes完成。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/charset_normalizer/buffers.py
+++ b/library/src/charset_normalizer/buffers.py
@@ -0,0 +1,23 @@
+"""连续缓冲的显式快照入口，不冒称所有codec零复制。"""
+from charset_normalizer import from_bytes
+
+
+def from_buffer(buffer, **options):
+    """检查连续buffer并在调用者改变或释放视图前冻结事实。
+
+    :param buffer: bytes或支持连续buffer协议的对象。
+    :param options: 传给真实from_bytes的检测选项。
+    :return: matches/copied/nbytes，bytes可复用，其他缓冲明确复制。
+    """
+    copied = not isinstance(buffer, bytes)
+    if not copied:
+        payload = buffer
+    else:
+        view = memoryview(buffer)
+        try:
+            if not view.c_contiguous:
+                raise ValueError('仅支持连续缓冲')
+            payload = view.tobytes()
+        finally:
+            view.release()
+    return {'matches': from_bytes(payload, **options), 'copied': copied, 'nbytes': len(payload)}
