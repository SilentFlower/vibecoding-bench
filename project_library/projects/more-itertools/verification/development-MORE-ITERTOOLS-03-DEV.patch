+from collections import deque
+def windowed_time(iterable,key,span):
+    """按事件时间生成闭区间窗口。@param iterable 非降序事件。@param key 时间键。@param span 正时间跨度。@return 每个输入事件结束的窗口tuple。"""
+    if span<=span-span:raise ValueError("span必须为正")
+    window=deque();previous=None;started=False
+    for item in iterable:
+        timestamp=key(item)
+        if started and timestamp<previous:raise ValueError("事件时间倒序")
+        window.append((timestamp,item));previous=timestamp;started=True
+        while window and timestamp-window[0][0]>span:window.popleft()
+        yield tuple(value for _,value in window)
