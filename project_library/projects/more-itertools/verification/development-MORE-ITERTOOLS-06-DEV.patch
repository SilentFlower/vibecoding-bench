+        if not self._strict:return next(self._iterator)
+        if self._failed:raise StopIteration
+        try:value=next(self._iterator)
+        except StopIteration:
+            if self._seen!=self._length:
+                self._failed=True
+                raise ValueError("实际长度少于声明")
+            raise
+        self._seen+=1
+        if self._seen>self._length:
+            self._failed=True
+            raise ValueError("实际长度超过声明")
