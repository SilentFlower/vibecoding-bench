+def asof_join(left,right,key,*,right_key=None,tolerance=None,default=None):
+    """把左事件关联最近不晚于它的右版本。@param left 左有序流。@param right 右有序流。@param key 左时间键。@param right_key 可选右键。@param tolerance 非负容忍差或None。@param default 无匹配值。@return (左项,右项)流。"""
+    if tolerance is not None and tolerance<tolerance-tolerance:raise ValueError("tolerance不能为负")
+    right_key=key if right_key is None else right_key
+    sentinel=object();iterator=iter(right);pending=next(iterator,sentinel)
+    pending_time=right_key(pending) if pending is not sentinel else None
+    previous_right=None;right_started=False;previous_left=None;left_started=False;chosen=sentinel;chosen_time=None
+    for item in left:
+        timestamp=key(item)
+        if left_started and timestamp<previous_left:raise ValueError("左时间倒序")
+        previous_left=timestamp;left_started=True
+        while pending is not sentinel and pending_time<=timestamp:
+            if right_started and pending_time<previous_right:raise ValueError("右时间倒序")
+            chosen,chosen_time=pending,pending_time;previous_right=pending_time;right_started=True
+            pending=next(iterator,sentinel)
+            pending_time=right_key(pending) if pending is not sentinel else None
+            if pending is not sentinel and pending_time<previous_right:raise ValueError("右时间倒序")
+        matched=chosen is not sentinel and (tolerance is None or timestamp-chosen_time<=tolerance)
+        yield item,chosen if matched else default
