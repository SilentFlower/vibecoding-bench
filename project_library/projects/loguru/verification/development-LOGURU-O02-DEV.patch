+    @contextlib.contextmanager
+    def sink_context(self, sink, **options):
+        """只在作用域内拥有本次新增sink，退出按原remove协议关闭。
+
+        :param sink: 真实add支持的sink。
+        :param options: 原add配置。
+        :return: 上下文进入时返回本次handler id。
+        """
+        identifier = self.add(sink, **options)
+        failed = False
+        try:
+            yield identifier
+        except BaseException:
+            failed = True
+            raise
+        finally:
+            with self._core.lock:
+                existed = identifier in self._core.handlers
+            try:
+                if existed:
+                    self.remove(identifier)
+            except ValueError:
+                # 外部提前移除是合法的；关闭回调本身的ValueError不能误当缺失。
+                if existed:
+                    if not failed:
+                        raise
+                    warnings.warn('sink关闭失败，保留作用域原异常', RuntimeWarning)
+            except BaseException:
+                if not failed:
+                    raise
+                warnings.warn('sink关闭失败，保留作用域原异常', RuntimeWarning)
+
