+class RecordName(str):
+    """保留原模块名称的字符串，在显式short:N格式中缩写前缀。
+
+    :param value: 原模块名称字符串。
+    :return: 标准字符串兼容记录，旧宽度/对齐格式仍由str处理。
+    """
+    def __format__(self, spec):
+        """支持short:N和可选|标准字符串格式。@return 格式化名称。"""
+        if not spec.startswith('short:'):
+            return str.__format__(self, spec)
+        count, separator, formatting = spec[6:].partition('|')
+        if not count.isdecimal() or int(count) < 1:
+            raise ValueError('short保留段数必须为正整数')
+        keep = int(count)
+        parts = self.split('.')
+        boundary = max(0, len(parts) - keep)
+        text = '.'.join([part[:1] for part in parts[:boundary]] + parts[boundary:])
+        return format(text, formatting if separator else '')
+
+
