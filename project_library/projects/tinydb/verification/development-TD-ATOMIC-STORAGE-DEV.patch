+"""面向单写者的原子JSON文件存储。"""
+import json
+import os
+import stat
+import tempfile
+from pathlib import Path
+from .storages import Storage
+
+
+class AtomicJSONStorage(Storage):
+    """序列化后通过同目录替换提交，不持有失效的旧文件句柄。"""
+    def __init__(self, path, *, create_dirs=False, encoding='utf-8', **options):
+        """配置存储。@param path 文件。@param create_dirs 是否创建父目录。
+        @param encoding 编码。@param options JSON序列化参数。@return None。
+        """
+        self.path, self.encoding, self.options = Path(path), encoding, options
+        self.closed = False
+        if create_dirs:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+        self._check()
+
+    def _check(self):
+        if self.closed:
+            raise ValueError('存储已经关闭')
+        if self.path.is_symlink():
+            raise ValueError('原子存储不接受符号链接目标')
+
+    def read(self):
+        """读取当前文件。@return 数据映射；不存在或空文件时为None。
+        """
+        self._check()
+        try:
+            text = self.path.read_text(encoding=self.encoding)
+        except FileNotFoundError:
+            return None
+        if not text:
+            return None
+        result = json.loads(text)
+        if not isinstance(result, dict):
+            raise ValueError('数据库根必须是映射')
+        return result
+
+    def write(self, data):
+        """序列化、同步并原子替换。@param data 数据库映射。@return None。
+        """
+        self._check()
+        if not isinstance(data, dict):
+            raise TypeError('数据库根必须是映射')
+        serialized = json.dumps(data, **self.options)
+        mode = stat.S_IMODE(self.path.stat().st_mode) if self.path.exists() else 0o600
+        temporary = None
+        try:
+            with tempfile.NamedTemporaryFile(mode='w', encoding=self.encoding, dir=self.path.parent,
+                                            prefix='.' + self.path.name + '.', delete=False) as stream:
+                temporary = Path(stream.name)
+                stream.write(serialized)
+                stream.flush()
+                os.fchmod(stream.fileno(), mode)
+                os.fsync(stream.fileno())
+            self._check()
+            os.replace(temporary, self.path)
+            temporary = None
+        finally:
+            if temporary is not None:
+                temporary.unlink(missing_ok=True)
+
+    def close(self):
+        """关闭逻辑存储，重复调用允许。@return None。
+        """
+        self.closed = True
