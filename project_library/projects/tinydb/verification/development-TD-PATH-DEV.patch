+    def at_path(self, segments):
+        """追加显式嵌套字段路径。@param segments 非空字符串序列，不解析点号。
+        @return 保留查询子类和缓存语义的新Query，不修改当前对象。
+        """
+        if isinstance(segments, (str, bytes)):
+            raise TypeError('路径必须是字段序列')
+        parts = tuple(segments)
+        if not parts or any(not isinstance(part, str) for part in parts):
+            raise ValueError('路径必须至少包含一个字符串字段')
+        query = type(self)()
+        query._path = self._path + parts
+        query._hash = ('path', query._path) if self.is_cacheable() else None
+        return query
 
