+"""把任意文本分块拼成物理行，再交给真实修复文件流程。"""
+from . import TextFixerConfig,fix_file
+
+
+def fix_chunks(chunks,config=None,*,max_line_length=1000000):
+    """惰性修复任意分块文本。@param chunks Unicode块迭代器。@param config 原修复配置。
+    @param max_line_length 物理行字符上限，含换行。@return 逐物理行修复结果迭代器。
+    """
+    if type(max_line_length) is not int or max_line_length<1:
+        raise ValueError('行字符预算必须为正整数')
+    if config is not None and not isinstance(config,TextFixerConfig):
+        raise TypeError('需要TextFixerConfig')
+    iterator=iter(chunks)
+    def lines():
+        fragments=[];size=0
+        for chunk in iterator:
+            if not isinstance(chunk,str):
+                raise TypeError('分块必须为Unicode文本')
+            start=0
+            while start<len(chunk):
+                end=chunk.find('\n',start)
+                stop=len(chunk) if end<0 else end+1
+                piece=chunk[start:stop]
+                if size+len(piece)>max_line_length:
+                    raise ValueError('物理行超过字符预算')
+                fragments.append(piece);size+=len(piece)
+                if end>=0:
+                    yield ''.join(fragments)
+                    fragments=[];size=0
+                start=stop
+        if fragments:
+            yield ''.join(fragments)
+    return fix_file(lines(),config=config)
