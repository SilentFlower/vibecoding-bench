+"""明确输入编码并以同目录原子替换输出修复文件。"""
+import hashlib
+import os
+import stat
+import tempfile
+from dataclasses import dataclass
+from pathlib import Path
+from .streaming import fix_chunks
+
+
+@dataclass(frozen=True)
+class FileRepairResult:
+    """成功写入后的文本长度与变化摘要。"""
+    input_chars: int
+    output_chars: int
+    changed: bool
+
+
+def fix_file_atomic(source,destination=None,*,encoding='utf-8',config=None,max_line_length=1000000):
+    """修复本地文件并输出UTF8。@param source 输入文件。@param destination 缺省原位替换。
+    @param encoding 明确输入编码。@param config 原修复政策。@param max_line_length 物理行预算。
+    @return 成功替换后的FileRepairResult；解码或修复失败保留原目标。
+    """
+    source=Path(source);destination=source if destination is None else Path(destination)
+    if source.is_symlink() or destination.is_symlink() or not source.is_file() or (destination.exists() and not destination.is_file()):
+        raise ValueError('输入和输出必须为普通文件路径')
+    mode=stat.S_IMODE(destination.stat().st_mode) if destination.exists() else None
+    state={'input':0,'output':0};before=hashlib.sha256();after=hashlib.sha256()
+    descriptor,name=tempfile.mkstemp(prefix='.'+destination.name+'.',dir=destination.parent)
+    try:
+        with open(source,'r',encoding=encoding,errors='strict',newline='') as incoming,os.fdopen(descriptor,'w',encoding='utf-8',newline='') as outgoing:
+            descriptor=None
+            def chunks():
+                while True:
+                    text=incoming.read(65536)
+                    if not text:
+                        return
+                    state['input']+=len(text);before.update(text.encode('utf-8','surrogatepass'))
+                    yield text
+            for text in fix_chunks(chunks(),config,max_line_length=max_line_length):
+                state['output']+=len(text);after.update(text.encode('utf-8','surrogatepass'));outgoing.write(text)
+            outgoing.flush();os.fsync(outgoing.fileno())
+        if mode is not None:
+            os.chmod(name,mode)
+        os.replace(name,destination)
+        return FileRepairResult(state['input'],state['output'],before.digest()!=after.digest())
+    finally:
+        if descriptor is not None:
+            os.close(descriptor)
+        if os.path.exists(name):
+            os.unlink(name)
