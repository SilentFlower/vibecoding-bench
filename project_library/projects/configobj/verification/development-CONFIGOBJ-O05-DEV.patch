         return out
 
 
+    def validate_report(self, validator, *, apply=False):
+        """生成固定形状、可JSON编码且不含配置值的验证报告。
+
+        :param validator: 实际Validator实例。
+        :param apply: False时验证独立克隆；True时沿用原验证转换语义。
+        :return: valid、issues、changed_paths、defaulted_paths和applied。
+        """
+        from copy import deepcopy
+        def raw_leaves(section, path=()):
+            values = {}
+            for key, value in dict.items(section):
+                current = path + (key,)
+                if isinstance(value, Section):
+                    values.update(raw_leaves(value, current))
+                else:
+                    values[current] = deepcopy(value)
+            return values
+        before = raw_leaves(self)
+        target = self if apply else deepcopy(self)
+        result = target.validate(validator, preserve_errors=True)
+        issues = [{'path': levels + ([] if key is None else [key]),
+                   'kind': 'missing_or_invalid' if error is False else type(error).__name__}
+                  for levels, key, error in flatten_errors(target, result)]
+        after = raw_leaves(target)
+        changed = [list(path) for path in sorted(set(before) | set(after))
+                   if path not in before or path not in after or type(before[path]) is not type(after[path]) or before[path] != after[path]]
+        defaults = []
+        def collect(section, path=()):
+            defaults.extend(list(path + (key,)) for key in section.defaults)
+            for key in section.sections:
+                collect(dict.__getitem__(section, key), path + (key,))
+        collect(target)
+        return {'valid': result is True, 'issues': issues, 'changed_paths': changed,
+                'defaulted_paths': sorted(defaults), 'applied': bool(apply)}
+
     def reset(self):
         """Clear ConfigObj instance and restore to 'freshly created' state."""
         self.clear()
--- a/library/tests/test_development_configobj_o05_dev.py
