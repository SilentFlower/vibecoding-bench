+# 深复制仍保留原始插值表达式与配置图
+
+对应路线03：从真实底层存储复制表达式及Section图，保留元数据和共享引用隔离；复制不求值，之后读取仍按复制树重新插值。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/configobj/__init__.py
+++ b/library/src/configobj/__init__.py
@@ -473,6 +473,22 @@
     def __setstate__(self, state):
         dict.update(self, state[0])
         self.__dict__.update(state[1])
+
+    def __deepcopy__(self, memo):
+        """保留原始插值表达式及整个Section图的复制关系。
+
+        :param memo: copy模块的共享引用与循环备忘录。
+        :return: 独立的同类配置或子节。
+        """
+        from copy import deepcopy
+        clone = self.__class__.__new__(self.__class__)
+        memo[id(self)] = clone
+        dict.__init__(clone)
+        # 直接读字典存储；items()/getitem会把插值表达式提前求值。
+        clone.__dict__.update(deepcopy(self.__dict__, memo))
+        for key, value in dict.items(self):
+            dict.__setitem__(clone, deepcopy(key, memo), deepcopy(value, memo))
+        return clone
 
     def __reduce__(self):
         state = (dict(self), self.__dict__)
