--- a/library/cerberus/stream.py
+++ b/library/cerberus/stream.py
@@ -0,0 +1,48 @@
+"""惰性逐条校验真实数据流，使用独立Validator和完整结果。"""
+from copy import deepcopy
+from itertools import islice
+from cerberus import DocumentError, Validator
+from cerberus.result import ValidationResult
+
+
+class ValidationStreamError(ValueError):
+    """显式raise政策的安全序号和完整本次结果。
+
+    :param index: 一起始记录序号。
+    :param result: 失败快照，不在异常消息回显输入。
+    """
+    def __init__(self, index, result):
+        """保存失败事实。参数见类说明。@return None。"""
+        self.index, self.result = index, result
+        super().__init__('第%d条记录校验失败' % index)
+
+
+def iter_validated(records, schema, *, on_error='continue', max_records=None, validator_factory=Validator, validator_options=None):
+    """按需消费记录，每条使用独立schema与验证器状态。
+
+    :param records: 一次性或可重用输入流。
+    :param schema: 实际Cerberus schema。
+    :param on_error: continue、stop或raise。
+    :param max_records: 可选非负消费上限，零不读取输入。
+    :param validator_factory: 显式自定义Validator工厂。
+    :param validator_options: 每条独立复制的构造选项。
+    :return: 包含index及ValidationResult的惰性记录迭代器。
+    """
+    if on_error not in ('continue', 'stop', 'raise'):
+        raise ValueError('未知流错误政策')
+    if max_records is not None and (not isinstance(max_records, int) or isinstance(max_records, bool) or max_records < 0):
+        raise ValueError('记录上限必须为非负整数')
+    if max_records == 0:
+        return
+    source = records if max_records is None else islice(records, max_records)
+    for index, record in enumerate(source, 1):
+        validator = validator_factory(deepcopy(schema), **deepcopy(validator_options or {}))
+        try:
+            result = validator.validate_result(record)
+        except DocumentError:
+            result = ValidationResult(False, None, {'_document': ['输入不是可校验映射']}, True)
+        if not result.valid and on_error == 'raise':
+            raise ValidationStreamError(index, result)
+        yield {'index': index, 'result': result}
+        if not result.valid and on_error == 'stop':
+            return
