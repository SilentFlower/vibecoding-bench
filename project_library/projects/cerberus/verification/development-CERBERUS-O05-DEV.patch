+"""校验完成状态与独立快照，不把Validator实例变成线程安全对象。"""
+from dataclasses import dataclass
+from typing import Any
+
+
+@dataclass(frozen=True)
+class ValidationResult:
+    """单次校验的不可变外壳和深复制内容。
+
+    :param valid: 本次布尔结果。
+    :param document: 本次规范化文档独立快照。
+    :param errors: 当前error_handler输出的独立快照。
+    :param completed: 是否正常完成；异常时不发布假结果。
+    """
+    valid: bool
+    document: Any
+    errors: Any
+    completed: bool = True
