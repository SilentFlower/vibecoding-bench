+    def stream(self, values):
+        """通过当前provider惰性生成NDJSON真实响应，并在关闭时收口源迭代器。
+
+        :param values: 每项为一个JSON文档的Iterable。
+        :return: application/x-ndjson响应；已发出后序列化失败会终止流，不能改HTTP状态。
+        """
+        from ..helpers import stream_with_context
+        from ..ctx import has_request_context
+        iterator = iter(values)
+        closed = False
+        def close_source():
+            """提前关闭和生成器finally可重复调用，但只关闭业务源一次。@return None。"""
+            nonlocal closed
+            if not closed:
+                closed = True
+                close = getattr(iterator, 'close', None)
+                if callable(close):
+                    close()
+        def generate():
+            """每次只消费一项并强制每文档一物理行。@return 字符串迭代器。"""
+            try:
+                for value in iterator:
+                    text = self.dumps(value, separators=(',', ':'), indent=None)
+                    if not isinstance(text, str) or '\n' in text or '\r' in text:
+                        raise ValueError('NDJSON provider必须返回单行字符串')
+                    yield text + '\n'
+            finally:
+                close_source()
+        generated = generate()
+        body = stream_with_context(generated) if has_request_context() else generated
+        response = self._app.response_class(body, mimetype='application/x-ndjson')
+        response.call_on_close(close_source)
+        return response
 
