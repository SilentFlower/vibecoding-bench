+    def get_by_segments(self, node, segments, *, absolute=False):
+        """按字面段定位。@param node 起点。@param segments 有限字符串序列。
+        @param absolute 是否从根开始且首段明确匹配根名。@return 实际节点或relax下的None。
+        """
+        if isinstance(segments, (str, bytes)) or type(absolute) is not bool:
+            raise TypeError('必须提供独立路径段和布尔绝对模式')
+        parts = tuple(segments)
+        if any(not isinstance(part, str) for part in parts):
+            raise TypeError('路径段必须是字符串')
+        if absolute:
+            node = node.root
+            if not parts or not self.__cmp(_getattr(node, self.pathattr), parts[0]):
+                if self.relax:
+                    return None
+                raise ResolverError(node, parts[0] if parts else None, '绝对路径首段必须匹配根节点')
+            parts = parts[1:]
+        for part in parts:
+            node = self.__get(node, part)
+            if node is None:
+                return None
