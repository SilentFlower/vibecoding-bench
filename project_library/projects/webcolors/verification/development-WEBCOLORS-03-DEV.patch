+"""显式保存8位alpha的RGBA模型，不改变旧RGB函数。"""
+import re
+from dataclasses import dataclass
+from ._types import IntegerRGB
+
+
+@dataclass(frozen=True)
+class RGBA:
+    """四个0..255整数字节。@param red 红。@param green 绿。@param blue 蓝。@param alpha 透明度字节。"""
+    red: int
+    green: int
+    blue: int
+    alpha: int = 255
+
+    def __post_init__(self):
+        """拒绝bool、浮点与越界值，避免静默丢透明度。@return None。"""
+        for value in (self.red,self.green,self.blue,self.alpha):
+            if type(value) is not int or not 0 <= value <= 255:
+                raise ValueError('RGBA分量必须是0..255整数')
+
+    def __iter__(self):
+        """按RGBA顺序提供分量。@return 分量迭代器。"""
+        return iter((self.red,self.green,self.blue,self.alpha))
+
+
+def hex_to_rgba(value):
+    """解析精确四位或八位hex。@param value 字面量。@return RGBA。"""
+    if not isinstance(value,str) or re.fullmatch(r'#[0-9a-fA-F]{4}(?:[0-9a-fA-F]{4})?',value) is None:
+        raise ValueError('RGBA十六进制必须是四位或八位')
+    digits=value[1:]
+    if len(digits)==4:digits=''.join(char*2 for char in digits)
+    return RGBA(*(int(digits[index:index+2],16) for index in range(0,8,2)))
+
+
+def rgba_to_hex(value):
+    """无损输出八位小写hex。@param value RGBA或四元组。@return hex。"""
+    color=value if isinstance(value,RGBA) else RGBA(*value)
+    return '#'+''.join(format(channel,'02x') for channel in color)
+
+
+def rgb_to_rgba(value, alpha=255):
+    """显式为RGB添加alpha。@param value 三通道。@param alpha 8位alpha。@return RGBA。"""
+    red,green,blue=value
+    return RGBA(red,green,blue,alpha)
+
+
+def rgba_to_rgb(value):
+    """仅将完全不透明RGBA转RGB。@param value 四通道。@return IntegerRGB。"""
+    color=value if isinstance(value,RGBA) else RGBA(*value)
+    if color.alpha != 255:raise ValueError('透明色需要显式背景，不允许静默丢alpha')
+    return IntegerRGB(color.red,color.green,color.blue)
