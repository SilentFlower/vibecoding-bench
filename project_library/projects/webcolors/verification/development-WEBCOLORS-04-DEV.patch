+"""声明范围的CSS rgb/rgba文本解析与稳定序列化。"""
+import math
+import re
+from .rgba import RGBA
+
+_NUMBER=re.compile(r'[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?',re.ASCII)
+_SPACE=' \t\r\n\f'
+
+
+def _number(token, scale):
+    """完整有限数字转换并按范围裁剪。@param token 文本。@param scale 数值上限。@return 比例。"""
+    percent=token.endswith('%')
+    raw=token[:-1] if percent else token
+    if _NUMBER.fullmatch(raw) is None:raise ValueError('不支持的CSS分量')
+    value=float(raw)
+    if not math.isfinite(value):raise ValueError('分量必须有限')
+    return min(1.0,max(0.0,value/(100 if percent else scale)))
+
+
+def parse_css_rgb(text):
+    """解析声明的逗号或空格斜线语法。@param text rgb/rgba函数。@return 量化到字节的RGBA。"""
+    if not isinstance(text,str):raise ValueError('颜色函数必须为字符串')
+    match=re.fullmatch(r'(rgb|rgba)\((.*)\)',text.strip(_SPACE),re.IGNORECASE|re.DOTALL|re.ASCII)
+    if match is None:raise ValueError('只支持rgb或rgba函数')
+    name,body=match.groups()
+    alpha='1'
+    if ',' in body:
+        if '/' in body:raise ValueError('不能混用逗号与斜线')
+        parts=[part.strip(_SPACE) for part in body.split(',')]
+        expected=4 if name.lower()=='rgba' else 3
+        if len(parts)!=expected:raise ValueError('逗号语法通道数错误')
+        channels=parts[:3]
+        if len(parts)==4:alpha=parts[3]
+        if len({part.endswith('%') for part in channels})!=1:raise ValueError('逗号语法不能混用百分比和数字通道')
+    else:
+        segments=body.split('/')
+        if len(segments)>2:raise ValueError('alpha只能声明一次')
+        channels=re.split(r'[ \t\r\n\f]+',segments[0].strip(_SPACE))
+        if len(channels)!=3:raise ValueError('必须有三个颜色通道')
+        if len(segments)==2:alpha=segments[1].strip(_SPACE)
+    values=[_number(token,255) for token in channels]+[_number(alpha,1)]
+    return RGBA(*(int(math.floor(value*255+0.5)) for value in values))
+
+
+def serialize_css_rgb(value):
+    """输出可往返的现代语法。@param value RGBA或四元组。@return CSS文本。"""
+    color=value if isinstance(value,RGBA) else RGBA(*value)
+    return f'rgb({color.red} {color.green} {color.blue} / {color.alpha/255:.12g})'
