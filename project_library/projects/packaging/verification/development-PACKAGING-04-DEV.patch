+"""离线RECORD清单，解析不会读取磁盘。"""
+import base64
+import binascii
+import csv
+import io
+import re
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class RecordEntry:
+    """不可变RECORD条目。@param path CSV文件路径。@param hash hash字段或None。@param size 大小或None。@return 已验证条目。"""
+    path: str
+    hash: str | None = None
+    size: int | None = None
+
+    def __post_init__(self):
+        """校验三列字段，不解析路径为宿主文件。@return None。"""
+        if not isinstance(self.path,str) or not self.path:raise ValueError("path不能为空")
+        if self.size is not None and (type(self.size) is not int or self.size<0):raise ValueError("size必须为非负整数")
+        if self.hash is not None:
+            if not isinstance(self.hash,str) or self.hash.count("=")!=1:raise ValueError("hash必须为算法=无padding摘要")
+            algorithm,digest=self.hash.split("=")
+            sizes={"sha256":32,"sha384":48,"sha512":64}
+            if algorithm not in sizes or not re.fullmatch(r"[A-Za-z0-9_-]+",digest):raise ValueError("不支持的算法或摘要")
+            try:data=base64.b64decode(digest+"="*(-len(digest)%4),altchars=b"-_",validate=True)
+            except (ValueError,binascii.Error) as error:raise ValueError("无效摘要") from error
+            if len(data)!=sizes[algorithm] or base64.urlsafe_b64encode(data).rstrip(b"=").decode()!=digest:raise ValueError("摘要长度或编码不规范")
+
+
+def parse_record(text):
+    """读取严格三列CSV。@param text RECORD文本。@return 不可变条目tuple，重复路径拒绝。"""
+    if not isinstance(text,str):raise TypeError("text必须为str")
+    rows=[];seen=set()
+    for row in csv.reader(io.StringIO(text,newline=""),strict=True):
+        if len(row)!=3:raise ValueError("RECORD必须为三列")
+        path,digest,size=row
+        if size and not re.fullmatch(r"0|[1-9][0-9]*",size):raise ValueError("无效size")
+        entry=RecordEntry(path,digest or None,int(size) if size else None)
+        if entry.path in seen:raise ValueError("重复path")
+        seen.add(entry.path);rows.append(entry)
+    return tuple(rows)
+
+
+def format_record(entries):
+    """稳定写回CSV。@param entries RecordEntry迭代器。@return 换行为LF的文本。"""
+    output=io.StringIO(newline="");writer=csv.writer(output,lineterminator="\n")
+    seen=set()
+    for entry in entries:
+        if not isinstance(entry,RecordEntry):raise TypeError("需要RecordEntry")
+        if entry.path in seen:raise ValueError("重复path")
+        seen.add(entry.path);writer.writerow((entry.path,entry.hash or "",entry.size if entry.size is not None else ""))
+    return output.getvalue()
