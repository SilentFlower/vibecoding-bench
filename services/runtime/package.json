{
  "name": "cc-runtime-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地运行时适配与请求日志工具",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:tls-verifier": "bun scripts/build-tls-verifier.ts",
    "dev": "bun src/control/cli.ts",
    "start": "bun src/control/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration --timeout 45000",
    "test:native": "bun scripts/test-native.ts",
    "test:tls": "bun scripts/test-tls-verifier.ts",
    "test:ui": "bun scripts/test-ui.ts",
    "test:pool": "bun scripts/test-pool.ts",
    "test:pool:page": "bun scripts/test-pool-page.ts",
    "start:pool": "bun scripts/local-pool.ts",
    "collect:pool-incidents": "bun scripts/collect-pool-incidents.ts"
  },
  "engines": { "bun": ">=1.3.14" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
