# 原生运行时：填写实际的绝对路径，程序必须匹配固定 SHA256。
CCRB_CLAUDE_BINARY=/absolute/path/to/claude.exe
CCRB_CLAUDE_HOME=/absolute/path/to/cc-runtime-bridge/runtime/home
CCRB_CLAUDE_CONFIG_DIR=/absolute/path/to/cc-runtime-bridge/runtime/config

# 凭据由操作者单独提供，测试不会使用真实账号。
# CCRB_NATIVE_API_KEY=
# CCRB_NATIVE_OAUTH_TOKEN=
# CCRB_PROXY_URL=http://127.0.0.1:8080
# CCRB_CA_FILE=/absolute/path/to/ca.pem

# 可选前置选择，留空时删除整行，不使用空字符串。配置变更后重启。
# CCRB_NATIVE_BASE_URL=https://your-endpoint.example
# CCRB_MODEL_OVERRIDE=your-model
# strict 为默认；接入本地 Base URL 的原版 CC 客户端时显式选择 local_base_url。
CCRB_NATIVE_INGRESS_POLICY=strict
# 按需验证：默认 off，由官方 CC 直接对外发送。
# verify 需要另行 bun run build:tls-verifier，仅支持固定原版 293、HTTPS、关闭遥测。
CCRB_TLS_CAPTURE=off

CCRB_HOST=127.0.0.1
CCRB_PORT=8787
CCRB_LOG_MODE=debug
CCRB_CAPTURE_BYTES=1048576
CCRB_LOG_BYTES=536870912
CCRB_RETAIN_DAYS=7
CCRB_DEBUG_RETAIN_DAYS=3
# 0 表示不附加请求总时限，由前置取消或服务关闭收口。
CCRB_TIMEOUT_MS=0

# 缓存策略：preserve 保留原布局；sub2api 对未自主管理消息断点的请求选点，重启生效。
CCRB_CACHE_POLICY=preserve

# 第一方原生遥测：默认 off；显式 on 后后台发送官方事件，重启生效。
CCRB_TELEMETRY=off

# 页面预览可直接 bun run start --demo，无须提供以上程序与凭据。

# 池 Messages 验证为独立测试入口，不由生产 readConfig 读取。
# 在权限 0600 的独立文件填写以下两项，通过 test:pool --live --pool-env 显式读取。
# CCRB_TEST_POOL_BASE_URL=https://pool.example/v1
# CCRB_TEST_POOL_API_KEY=
# 模型固定 deepseek-flash；首次真实验收最多三次、max_tokens≤128，首错停止。
