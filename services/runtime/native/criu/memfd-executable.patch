+/** 接入明确命名的共享执行体。@param inode 快照inode。@param fd 输出句柄。@return 1已接入，0无外部资源，-1拒绝。 */
+static int inherit_executable_memfd(struct memfd_restore_inode *inode, int *fd)
+{
+	MemfdInodeEntry *mie = inode->mie;
+	struct memfd_restore_inode *other;
+	struct stat info;
+	char resource[PATH_MAX];
+	int seals;
+	const unsigned int required = F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL;
+
+	if (snprintf(resource, sizeof(resource), "ccrb-executable:%s", mie->name) >= sizeof(resource))
+		return -1;
+	*fd = inherit_fd_lookup_id(resource);
+	if (*fd < 0)
+		return 0;
+
+	/* 名称不是身份，拒绝快照中同名的其他inode。 */
+	list_for_each_entry(other, &memfd_inodes, list) {
+		if (other != inode && !strcmp(other->mie->name, mie->name))
+			goto reject;
+	}
+	seals = fcntl(*fd, F_GET_SEALS);
+	if (strcmp(mie->name, "ccrb-native-runtime") || fstat(*fd, &info) < 0 || seals < 0 ||
+	    !S_ISREG(info.st_mode) || !is_memfd(info.st_dev) || info.st_nlink ||
+	    info.st_size != mie->size || info.st_uid || info.st_gid || (info.st_mode & 07777) != 0555 ||
+	    mie->uid || mie->gid || !mie->has_mode || (mie->mode & 07777) != 0555 ||
+	    seals != mie->seals || (seals & required) != required || mie->has_hugetlb_flag ||
+	    (fcntl(*fd, F_GETFL) & O_ACCMODE) != O_RDONLY)
+		goto reject;
+
+	/* 已封存背板不再填充、改权或加seal，私有写页仍沿原恢复规则处理。 */
+	inode->inherited_executable = true;
+	return 1;
+reject:
+	pr_err("Shared executable memfd identity mismatch\n");
+	close(*fd);
+	*fd = -1;
+	return -1;
+}
+
