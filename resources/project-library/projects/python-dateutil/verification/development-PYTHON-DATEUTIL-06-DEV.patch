+# 缓存复发规则与规则集可持久化并重建独立运行状态
+
+路线07：版本化序列化规则定义与缓存开关，锁/迭代器和运行缓存独立重建；包含排除规则、部分/完整缓存、deepcopy和旧无缓存dict兼容，不承诺活动迭代位置。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/src/dateutil/rrule.py
+++ b/library/src/dateutil/rrule.py
@@ -92,6 +92,31 @@
 
 
 class rrulebase(object):
+    def __getstate__(self):
+        """只保存规则定义和缓存策略。@return 版本化状态，不含线程锁、生成器或消费位置。"""
+        state=dict(self.__dict__)
+        enabled=state.get("_cache") is not None
+        for name in ("_cache","_cache_lock","_cache_gen","_cache_complete","_len"):
+            state.pop(name,None)
+        return (1,state,enabled)
+
+    def __setstate__(self,state):
+        """重建独立运行缓存。@param state 新版本状态或旧无缓存dict。@return None。"""
+        if isinstance(state,dict):
+            values=dict(state)
+            enabled=values.get("_cache") is not None
+            for name in ("_cache","_cache_lock","_cache_gen","_cache_complete","_len"):
+                values.pop(name,None)
+        else:
+            version,values,enabled=state
+            if version!=1:raise ValueError("未知rrule序列化版本")
+        self.__dict__.update(values)
+        self._cache=[] if enabled else None
+        if enabled:self._cache_lock=_thread.allocate_lock()
+        self._cache_complete=False
+        self._len=None
+        if enabled:self._invalidate_cache()
+
     def __init__(self, cache=False):
         if cache:
             self._cache = []
