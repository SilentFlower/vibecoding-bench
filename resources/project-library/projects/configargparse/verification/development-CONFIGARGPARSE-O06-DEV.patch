+class MappedJSONConfigFileParser(JSONConfigFileParser):
+    """把明确的JSON键路径映射为现有参数名，不隐式拆点。
+
+    :param paths: 由非空字符串元组到扁平配置键的映射。
+    :param unknown: error或ignore，控制未映射叶值。
+    :param duplicates: 沿用严格JSON重复键政策。
+    :return: 继承JSON真实解码与标量转换的解析器。
+    """
+
+    def __init__(self, paths, *, unknown='error', duplicates='error'):
+        """冻结明确映射并拒绝重复目标与前缀冲突。@return None。"""
+        super().__init__(duplicates=duplicates)
+        if unknown not in ('error', 'ignore'):
+            raise ValueError('未知叶值政策错误')
+        self.unknown = unknown
+        self.paths = dict(paths)
+        destinations = set()
+        for path, destination in self.paths.items():
+            if not isinstance(path, tuple) or not path or any(not isinstance(part, str) or not part for part in path):
+                raise ValueError('键路径必须为非空字符串元组')
+            if not isinstance(destination, str) or not destination or destination in destinations:
+                raise ValueError('目标配置键必须非空且唯一')
+            destinations.add(destination)
+        paths = list(self.paths)
+        if any(left != right and right[:len(left)] == left for left in paths for right in paths):
+            raise ValueError('映射不能同时指向对象与其子路径')
+
+    def parse(self, stream):
+        """按字面键路径提取值，标量仍交给真实Action转换。@return 有序扁平映射。"""
+        source = self._load_object(stream)
+        result = OrderedDict()
+        used = set()
+        for path, destination in self.paths.items():
+            current = source
+            for part in path:
+                if not isinstance(current, dict):
+                    raise ConfigFileParserException('映射路径中的对象被标量替代')
+                if part not in current:
+                    break
+                current = current[part]
+            else:
+                result[destination] = self.convert_value(current)
+                used.add(path)
+        def inspect(value, path):
+            if path in used:
+                return
+            if isinstance(value, dict) and value:
+                for key, child in value.items():
+                    inspect(child, path + (key,))
+            elif self.unknown == 'error' and path:
+                raise ConfigFileParserException('存在未映射JSON键路径：%s' % (path,))
+        inspect(source, ())
+        return result
+
+    def serialize(self, items):
+        """按反向映射构造嵌套对象，拒绝未知扁平键。@return JSON文本。"""
+        reverse = {destination: path for path, destination in self.paths.items()}
+        result = {}
+        for key, value in items.items():
+            if key not in reverse:
+                raise ConfigFileParserException('输出含未映射字段')
+            self.convert_value(value)
+            current = result
+            path = reverse[key]
+            for part in path[:-1]:
+                current = current.setdefault(part, {})
+            current[path[-1]] = value
+        return json.dumps(result, ensure_ascii=False, allow_nan=False) + '\n'
 
 
