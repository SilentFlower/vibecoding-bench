+class DispatchConfigFileParser(ConfigFileParser):
+    """按应用预声明扩展名选择真实解析器，不猜测内容或导入模块。
+
+    :param parsers: 扩展名到ConfigFileParser实例或无参类的映射。
+    :param fallback: 无扩展名或未知扩展名时显式使用的解析器。
+    :param output_format: 序列化时明确选定的注册扩展名。
+    :return: 独立的分派解析器。
+    """
+
+    def __init__(self, parsers, *, fallback=None, output_format=None):
+        """验证注册表，重复规范扩展名失败。@return None。"""
+        def instance(value):
+            if isinstance(value, type) and issubclass(value, ConfigFileParser):
+                value = value()
+            if not isinstance(value, ConfigFileParser):
+                raise TypeError('分派目标必须是配置解析器')
+            return value
+        self.parsers = {}
+        for suffix, parser in parsers.items():
+            if not isinstance(suffix, str) or not suffix.startswith('.') or len(suffix) < 2 or '/' in suffix or '\\' in suffix:
+                raise ValueError('必须使用带点的字面扩展名')
+            suffix = suffix.lower()
+            if suffix in self.parsers:
+                raise ValueError('重复扩展名')
+            self.parsers[suffix] = instance(parser)
+        self.fallback = None if fallback is None else instance(fallback)
+        self.output_format = None if output_format is None else output_format.lower()
+        if self.output_format is not None and self.output_format not in self.parsers:
+            raise ValueError('输出格式未注册')
+
+    def get_syntax_description(self):
+        """返回预声明格式，不访问输入。@return 描述。"""
+        return 'Explicit extension dispatch: ' + ', '.join(self.parsers)
+
+    def parse(self, stream):
+        """按源名扩展名一次分派，流只由选中解析器消费。
+
+        :param stream: 可选name的文件流，不要求seek。
+        :return: 选中解析器返回的真实配置映射。
+        """
+        name = getattr(stream, 'name', None)
+        suffix = os.path.splitext(os.fsdecode(name))[1].lower() if isinstance(name, (str, bytes, os.PathLike)) else ''
+        parser = self.parsers.get(suffix, self.fallback)
+        if parser is None:
+            raise ConfigFileParserException('未注册的配置扩展名：%s' % suffix)
+        return parser.parse(stream)
+
+    def serialize(self, items):
+        """仅按显式输出格式序列化，不用输入猜测输出。@return 配置文本。"""
+        if self.output_format is None:
+            raise ConfigFileParserException('序列化必须显式声明output_format')
+        return self.parsers[self.output_format].serialize(items)
 
 
