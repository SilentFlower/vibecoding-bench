+class ParseResult:
+    """保存一次解析完成后的独立快照，不保留Action对象。
+
+    :param namespace: 本次解析得到的命名空间。
+    :param sources: 不含Action的来源记录。
+    :param unknown: 本次未识别命令行列表。
+    :return: 与后续解析及返回副本隔离的结果。
+    """
+
+    def __init__(self, namespace, sources, unknown):
+        """深复制本次结果。@return None。"""
+        from copy import deepcopy
+        self._namespace = deepcopy(namespace)
+        self._sources = deepcopy(sources)
+        self._unknown = tuple(unknown)
+
+    @property
+    def namespace(self):
+        """取独立命名空间副本，调用者修改不写回快照。@return Namespace。"""
+        from copy import deepcopy
+        return deepcopy(self._namespace)
+
+    @property
+    def sources(self):
+        """取不共享嵌套值的来源副本。@return dict。"""
+        from copy import deepcopy
+        return deepcopy(self._sources)
+
+    @property
+    def unknown(self):
+        """取原顺序不可变未知项。@return tuple。"""
+        return self._unknown
+
