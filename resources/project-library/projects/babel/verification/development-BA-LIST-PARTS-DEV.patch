+def format_list_to_parts(lst, style='standard', locale=None):
+    """返回可单独样式化的列表元素及连接文字。@param lst 字符串序列。
+    @param style CLDR列表样式。@param locale 区域。@return type/value/index分段。
+    """
+    from string import Formatter
+
+    items = list(lst)
+    if any(not isinstance(item, str) for item in items):
+        raise TypeError('列表元素必须是字符串')
+    if not items:
+        return []
+    result = [{'type': 'element', 'value': items[0], 'index': 0}]
+    if len(items) == 1:
+        return result
+    resolved = Locale.parse(locale or _DEFAULT_LOCALE)
+    patterns = _resolve_list_style(resolved, style)
+
+    def combine(pattern, left, right):
+        combined = []
+        # 直接解释CLDR占位符，不向用户文本注入可能碰撞的哨兵。
+        for literal, field, spec, conversion in Formatter().parse(pattern):
+            if literal:
+                combined.append({'type': 'literal', 'value': literal, 'index': None})
+            if field is not None:
+                if field not in ('0', '1') or spec or conversion:
+                    raise ValueError('不支持的列表模板')
+                combined.extend(left if field == '0' else right)
+        return combined
+
+    if len(items) == 2 and '2' in patterns:
+        return combine(patterns['2'], result, [{'type': 'element', 'value': items[1], 'index': 1}])
+    result = combine(patterns['start'], result, [{'type': 'element', 'value': items[1], 'index': 1}])
+    for index, item in enumerate(items[2:-1], 2):
+        result = combine(patterns['middle'], result, [{'type': 'element', 'value': item, 'index': index}])
+    return combine(patterns['end'], result, [{'type': 'element', 'value': items[-1], 'index': len(items)-1}])
+
+
