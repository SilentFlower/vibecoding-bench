+def parse_currency(string, currency, locale=None, *, strict=True, numbering_system='latn'):
+    """解析指定币种的区域化金额。@param string 完整文本。@param currency 显式币种。
+    @param locale 区域。@param strict 是否要求格式器规范表示。@param numbering_system 编号系统。
+    @return Decimal金额，不自动猜币种。
+    """
+    validate_currency(currency)
+    resolved = Locale.parse(locale or LC_NUMERIC)
+    if not isinstance(string, str):
+        raise TypeError('金额文本必须是字符串')
+    symbol = get_currency_symbol(currency, resolved)
+    # 只支持真实标准／会计模板的前后缀，拒绝正文中任意剥离货币字符。
+    for kind in ('standard', 'accounting'):
+        pattern = resolved.currency_formats.get(kind)
+        if pattern is None:
+            continue
+        for sign, prefix, suffix in zip((1, -1), pattern.prefix, pattern.suffix):
+            prefix = prefix.replace('¤¤', currency).replace('¤', symbol).replace("'", '')
+            suffix = suffix.replace('¤¤', currency).replace('¤', symbol).replace("'", '')
+            for old, new in ((symbol, currency),):
+                variants = ((prefix, suffix), (prefix.replace(old, new), suffix.replace(old, new)))
+                for before, after in variants:
+                    if not string.startswith(before) or not string.endswith(after):
+                        continue
+                    end = len(string) - len(after) if after else len(string)
+                    body = string[len(before):end]
+                    if not body or body[0] in '+-' or any(c in body for c in '()'):
+                        continue
+                    try:
+                        value = parse_decimal(body, locale=resolved, strict=strict, numbering_system=numbering_system) * sign
+                    except NumberFormatError:
+                        continue
+                    if not value.is_finite():
+                        continue
+                    if strict:
+                        expected = format_currency(value, currency, locale=resolved, format_type=kind, numbering_system=numbering_system)
+                        if string not in (expected, expected.replace(symbol, currency)):
+                            continue
+                    return value
+    raise NumberFormatError('文本不是指定币种的完整金额')
+
