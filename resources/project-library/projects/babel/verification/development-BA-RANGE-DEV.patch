+def format_number_range(start, end, *, currency=None, locale=None, collapse=True, **options):
+    """格式化有限有序数值区间。@param start 下界。@param end 上界。
+    @param currency 同币种代码或None。@param locale 区域。@param collapse 是否合并显示相等端点。
+    @param options 传给原数字／金额格式器的选项。@return 区域化完整端点区间。
+    """
+    left, right = decimal.Decimal(str(start)), decimal.Decimal(str(end))
+    if not left.is_finite() or not right.is_finite() or left > right:
+        raise ValueError('区间端点必须有限且有序')
+    resolved = Locale.parse(locale or LC_NUMERIC)
+    if currency is None:
+        first = format_decimal(left, locale=resolved, **options)
+        last = format_decimal(right, locale=resolved, **options)
+    else:
+        validate_currency(currency)
+        first = format_currency(left, currency, locale=resolved, **options)
+        last = format_currency(right, currency, locale=resolved, **options)
+    if collapse and first == last:
+        return first
+    pattern = resolved.interval_formats.get(None, '{0}–{1}')
+    # 一次替换防止用户自定义前后缀中的占位文字被二次解释。
+    import re
+    return re.sub(r'\{([01])\}', lambda match: (first, last)[int(match.group(1))], pattern)
 
 
