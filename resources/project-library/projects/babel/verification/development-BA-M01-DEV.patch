+def format_datetime_to_parts(
+    datetime: _Instant = None,
+    format: str = 'yyyy-MM-dd',
+    tzinfo: datetime.tzinfo | None = None,
+    locale: Locale | str | None = None,
+) -> list[dict[str, str | None]]:
+    """将显式 LDML 模式格式化为可独立样式化的有序字段。
+
+    :param datetime: 与 format_datetime 相同的日期时间或时间戳；None 使用当前时刻。
+    :param format: 显式 LDML 模式；预定义格式名不在本接口范围内。
+    :param tzinfo: 显示时采用的目标时区。
+    :param locale: Locale 对象或区域标识，默认采用 LC_TIME。
+    :return: 含 type、field、value 的新列表；连接 value 等于原字符串接口。
+    """
+    if not isinstance(format, str):
+        raise TypeError('format must be an explicit LDML pattern string')
+    if format in ('full', 'long', 'medium', 'short'):
+        raise ValueError('format must be an explicit LDML pattern')
+    # 先复用原模式校验，避免分段接口悄悄接受原接口拒绝的字段宽度。
+    parse_pattern(format)
+    instant = _ensure_datetime_tzinfo(_get_datetime(datetime), tzinfo)
+    formatter = DateTimeFormat(instant, Locale.parse(locale or LC_TIME))
+    parts = []
+    for token_type, token_value in tokenize_pattern(format):
+        if token_type == 'chars':
+            parts.append({'type': 'literal', 'field': None, 'value': token_value})
+        else:
+            char, count = token_value
+            field = char * count
+            parts.append({'type': char, 'field': field, 'value': str(formatter[field])})
+    return parts
 
 
