+"""显式严格安全加载，不改变默认后值覆盖政策。"""
+from yaml.loader import SafeLoader
+from yaml.nodes import MappingNode
+from yaml.constructor import ConstructorError
+
+
+class StrictSafeLoader(SafeLoader):
+    """拒绝同一映射显式重复键，merge继承不当作本地重复。"""
+    def construct_mapping(self,node,deep=False):
+        """先验证显式键再交原合并构造。@param node 映射节点。@param deep 深构造。@return 标准dict。"""
+        if isinstance(node,MappingNode):
+            seen={}
+            for key_node,value_node in node.value:
+                if key_node.tag=="tag:yaml.org,2002:merge":continue
+                key=self.construct_object(key_node,deep=True)
+                try:
+                    if key in seen:
+                        raise ConstructorError("first explicit key",seen[key],"duplicate explicit mapping key",key_node.start_mark)
+                    seen[key]=key_node.start_mark
+                except TypeError as error:
+                    raise ConstructorError("while constructing a mapping",node.start_mark,"found unhashable key",key_node.start_mark) from error
+        return super().construct_mapping(node,deep=deep)
+
+
+def strict_load(stream):
+    """使用明确严格loader。@param stream YAML输入。@return 安全构造结果。"""
+    from yaml import load
+    return load(stream,Loader=StrictSafeLoader)
