+def sessionize(iterable,key,gap):
+    """按事件时间间隙分会话。@param iterable 有序事件流。@param key 时间提取。@param gap 非负间隙。@return 完整事件列表的惰性会话流。"""
+    if gap<gap-gap:raise ValueError("gap不能为负")
+    current=[];previous=None;started=False
+    for item in iterable:
+        timestamp=key(item)
+        if started:
+            if timestamp<previous:raise ValueError("事件时间倒序")
+            if timestamp-previous>gap:
+                yield current
+                current=[]
+        current.append(item);previous=timestamp;started=True
+    if current:yield current
