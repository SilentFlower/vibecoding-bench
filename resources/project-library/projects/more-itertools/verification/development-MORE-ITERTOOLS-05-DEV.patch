+def interleave_weighted(*iterables,weights):
+    """按整数配额轮流消费各源。@param iterables 输入源。@param weights 每轮正整数项数。@return 确定次序流，耗尽源退出。"""
+    import operator
+    weights=tuple(weights)
+    if len(weights)!=len(iterables):raise ValueError("weights数量错误")
+    normalized=[]
+    for weight in weights:
+        if isinstance(weight,bool):raise TypeError("weight不能为bool")
+        weight=operator.index(weight)
+        if weight<=0:raise ValueError("weight必须为正")
+        normalized.append(weight)
+    active=[(iter(source),weight) for source,weight in zip(iterables,normalized)]
+    while active:
+        remaining=[]
+        for iterator,weight in active:
+            for _ in range(weight):
+                try:item=next(iterator)
+                except StopIteration:break
+                yield item
+            else:
+                remaining.append((iterator,weight))
+        active=remaining
