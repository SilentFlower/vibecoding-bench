+    @staticmethod
+    def _validate_component_boundaries(data: str | bytes) -> None:
+        """在构造模型和写入时区缓存前验证整个输入的组件边界。
+
+        :param data: 实际iCalendar文本或字节；沿用原内容行展开规则。
+        :return: None；孤立、错配或未结束的组件抛出ValueError。
+        """
+        stack: list[str] = []
+        for line in Contentlines.from_ical(data):
+            if not line:
+                continue
+            try:
+                name, _params, value = line.parts()
+            except ValueError:
+                # 属性损坏仍由原解析器按组件ignore_exceptions处理。
+                continue
+            marker = name.upper()
+            if marker == "BEGIN":
+                if not value:
+                    raise ValueError("BEGIN组件名称不能为空")
+                stack.append(value.upper())
+            elif marker == "END":
+                if not stack:
+                    raise ValueError(f"END:{value}没有对应BEGIN")
+                expected = stack[-1]
+                if value.upper() != expected:
+                    raise ValueError(f"END:{value}与当前BEGIN:{expected}不匹配")
+                stack.pop()
+        if stack:
+            raise ValueError(f"BEGIN:{stack[-1]}缺少END")
 
