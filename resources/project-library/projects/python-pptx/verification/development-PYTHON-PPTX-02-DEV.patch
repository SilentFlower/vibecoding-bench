+"""页面切换代理，契约来自仓内pml.xsd，不启动播放。"""
+from copy import deepcopy
+from pptx.oxml.ns import qn
+from pptx.oxml.xmlchemy import OxmlElement
+
+
+class SlideTransition:
+    """编辑既有Slide的p:transition。@param element 当前幻灯片XML。@return 轻量代理。"""
+    def __init__(self,element):
+        """保存同一元素。@param element CT_Slide。@return None。"""
+        self.element=element
+
+    @property
+    def configuration(self):
+        """读取当前真实设置，不伪装已知未知效果。@return dict或None。"""
+        node=self.element.find(qn("p:transition"))
+        if node is None:return None
+        effects=[child for child in node if child.tag not in (qn("p:sndAc"),qn("p:extLst"))]
+        effect=effects[0].tag.rsplit("}",1)[-1] if effects else None
+        return {"effect":effect,"direction":effects[0].get("dir") if effects else None,"speed":node.get("spd","fast"),"advance_on_click":node.get("advClick","true") not in ("0","false"),"advance_after_ms":int(node.get("advTm")) if node.get("advTm") is not None else None}
+
+    def configure(self,effect,*,direction=None,speed="med",advance_on_click=True,advance_after_ms=None):
+        """整体验证后提交已知效果。@param effect fade/push/wipe。@param direction push/wipe的l/r/u/d。@param speed slow/med/fast。@param advance_on_click 点击前进。@param advance_after_ms 定时毫秒或None。@return 同一代理。"""
+        if effect not in ("fade","push","wipe") or speed not in ("slow","med","fast"):raise ValueError("未知效果/速度")
+        if effect=="fade" and direction is not None:raise ValueError("fade不支持direction")
+        if effect!="fade" and direction not in (None,"l","r","u","d"):raise ValueError("未知方向")
+        if type(advance_on_click) is not bool:raise TypeError("advance_on_click必须为bool")
+        if advance_after_ms is not None and (type(advance_after_ms) is not int or not 0<=advance_after_ms<=4294967295):raise ValueError("advance_after_ms须unsignedInt")
+        old=self.element.find(qn("p:transition"))
+        if old is not None:
+            unknown=[child for child in old if child.tag not in tuple(qn("p:"+name) for name in ("fade","push","wipe","sndAc","extLst"))]
+            if unknown:raise ValueError("当前未知效果仅支持显式clear后替换")
+        node=OxmlElement("p:transition")
+        if old is not None:
+            node.attrib.update(old.attrib)
+        node.set("spd",speed);node.set("advClick","1" if advance_on_click else "0")
+        if advance_after_ms is None:node.attrib.pop("advTm",None)
+        else:node.set("advTm",str(advance_after_ms))
+        child=OxmlElement("p:"+effect)
+        if effect!="fade":child.set("dir",direction or "l")
+        node.append(child)
+        if old is not None:
+            for child in old:
+                if child.tag in (qn("p:sndAc"),qn("p:extLst")):node.append(deepcopy(child))
+            self.element.replace(old,node)
+        else:self.element.insert_element_before(node,"p:timing","p:extLst")
+        return self
+
+    def clear(self):
+        """显式移除整个切换配置。@return None。"""
+        node=self.element.find(qn("p:transition"))
+        if node is not None:self.element.remove(node)
