+def _itercat_occurrence(sources, missing, header):
+    its = [iter(t) for t in sources]
+    hdrs = []
+    for it in its:
+        try:
+            hdrs.append(list(next(it)))
+        except StopIteration:
+            hdrs.append([])
+
+    if header is None:
+        outhdr=list(hdrs[0]) if hdrs else []
+        for hdr in hdrs[1:]:
+            for index,name in enumerate(hdr):
+                if hdr[:index+1].count(name)>outhdr.count(name):
+                    outhdr.append(name)
+    else:
+        outhdr=list(header)
+    yield tuple(outhdr)
+    for hdr,it in zip(hdrs,its):
+        # 字段身份包含出现次序，不能让重复字段都回查第一个索引。
+        mapping=[]
+        for position,name in enumerate(outhdr):
+            occurrence=outhdr[:position].count(name)
+            matches=[index for index,value in enumerate(hdr) if value==name]
+            mapping.append(matches[occurrence] if occurrence<len(matches) else None)
+        for row in it:
+            yield tuple(row[index] if index is not None and index<len(row) else missing for index in mapping)
 
 
