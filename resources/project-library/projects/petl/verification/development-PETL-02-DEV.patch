@@ -570,3 +570,30 @@
 
 
 Table.interpolateall = interpolateall
+
+
+def convert_report(table,converters,errorvalue=None):
+    """一次消费生成转换表和不含原值的问题表。@param table 单次或可重放源。@param converters 字段到callable映射。@param errorvalue 失败替代。@return (可重复table,可重复issues)。"""
+    mapping=dict(converters)
+    if any(not callable(function) for function in mapping.values()):raise TypeError("converters值必须可调用")
+    source=iter(table)
+    try:header=tuple(next(source))
+    except StopIteration:return (), (("row","field","error_type"),)
+    if len(set(header))!=len(header):raise ValueError("convert_report要求唯一字段名")
+    positions={field:header.index(field) for field in mapping}
+    output=[header];issues=[("row","field","error_type")]
+    for number,row in enumerate(source,1):
+        result=list(row)
+        for field,function in mapping.items():
+            index=positions[field]
+            try:
+                result[index]=function(result[index])
+            except Exception as error:
+                if index>=len(result):result.extend([errorvalue]*(index+1-len(result)))
+                else:result[index]=errorvalue
+                issues.append((number,field,type(error).__name__))
+        output.append(tuple(result))
+    return tuple(output),tuple(issues)
+
+
+Table.convert_report=convert_report
