+    def split(self, points, *, ownership='right'):
+        """按切点返回不会重新归并的有序区间分区。
+
+        :param points: 有限可迭代切点，重复和域外点忽略。
+        :param ownership: 切点归right或left分区。
+        :return: 同类原子区间组成的tuple；并集恰好等于原集。
+        """
+        if ownership not in ('right', 'left'):
+            raise ValueError('切点归属必须为right或left')
+        ordered = []
+        for point in sorted(points):
+            if not ordered or point != ordered[-1]:
+                ordered.append(point)
+        result = []
+        for atomic in self:
+            lower, left = atomic.lower, atomic.left
+            for point in ordered:
+                if atomic.lower < point < atomic.upper:
+                    right = Bound.OPEN if ownership == 'right' else Bound.CLOSED
+                    result.append(self.__class__.from_atomic(left, lower, point, right))
+                    lower = point
+                    left = Bound.CLOSED if ownership == 'right' else Bound.OPEN
+            result.append(self.__class__.from_atomic(left, lower, atomic.upper, atomic.right))
+        return tuple(part for part in result if not part.empty)
 
