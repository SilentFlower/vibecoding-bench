+    def coalesce(self, max_gap, metric=None, *, report=False):
+        """按显式容差近似填补空隙，精确集合代数保持不变。
+
+        :param max_gap: 非负距离容差，支持日期时长。
+        :param metric: 可选的两端点距离函数，默认后端点减前端点。
+        :param report: 是否同时返回被填补的真实空隙。
+        :return: 同类近似区间，或(区间, 空隙tuple)。
+        """
+        zero = max_gap - max_gap
+        if not max_gap >= zero:
+            raise ValueError('合并容差必须非负且不是NaN')
+        if metric is None:
+            metric = lambda lower, upper: upper - lower
+        pieces, gaps = [], []
+        for atomic in self:
+            if pieces:
+                previous = pieces[-1]
+                distance = metric(previous.upper, atomic.lower)
+                if distance < zero:
+                    raise ValueError('距离函数不可返回负值')
+                if distance <= max_gap:
+                    combined = self.__class__.from_atomic(previous.left, previous.lower, atomic.upper, atomic.right)
+                    gaps.extend(combined - (previous | atomic))
+                    pieces[-1] = combined
+                    continue
+            pieces.append(atomic)
+        result = self.__class__(*pieces)
+        return (result, tuple(gaps)) if report else result
 
