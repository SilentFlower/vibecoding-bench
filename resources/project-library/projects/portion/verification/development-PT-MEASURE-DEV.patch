+# 为真实区间增加显式业务度量聚合
+
+提供measure(metric, start=0)，按原子区间顺序调用一次业务度量并从显式单位元累加。业务回调可根据真实开闭端点计算整数数量或连续时长，也可拒绝无界区间；不擅自给任意端点做减法。空集不回调，保留Decimal和timedelta类型、子类和len片段数语义。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/portion/interval.py
+++ b/library/portion/interval.py
@@ -411,6 +411,20 @@
             except Exception:  # noqa
                 pass
         raise AttributeError
+
+    def measure(self, metric, *, start=0):
+        """以显式业务度量累加原子区间，保留原片段数语义。
+
+        :param metric: 接收单个原子区间的度量函数，可自行处理开闭及无穷。
+        :param start: 加法单位元，日期时长可传timedelta()。
+        :return: 从start依序累加各原子度量的结果。
+        """
+        if not callable(metric):
+            raise TypeError('区间度量必须可调用')
+        result = start
+        for atomic in self:
+            result = result + metric(atomic)
+        return result
 
     def __len__(self):
         return len(self._intervals)
--- a/library/tests/test_development_pt_measure_dev.py
