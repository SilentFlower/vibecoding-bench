+    def transform_values(self, function, *, pass_interval=False):
+        """返回经业务转换与筛选的新区间表，原表不变。
+
+        :param function: 接收值，或在pass_interval时接收值和整个存储区间。
+        :param pass_interval: 是否把复合存储区间作为第二参数。
+        :return: 同类新区间表；只有返回DROP身份哨兵才删除条目。
+        """
+        items = []
+        for interval, value in self.items():
+            result = function(value, interval) if pass_interval else function(value)
+            if result is not self.DROP:
+                items.append((interval, result))
+        return self.__class__(items)
 
