+    def affine(self, scale, offset=0):
+        """返回连续数轴区间的仿射像，不复用集合差运算。
+
+        :param scale: 有限实数比例；零映为单点。
+        :param offset: 有限偏移。
+        :return: 同类连续区间；负比例交换端点及开闭。
+        """
+        if scale != scale or offset != offset or scale in (-float('inf'), float('inf')) or offset in (-float('inf'), float('inf')):
+            raise ValueError('仿射参数必须有限且不是NaN')
+        if self.empty:
+            return self.__class__()
+        if isinstance(self, AbstractDiscreteInterval):
+            raise TypeError('离散区间的点像不保证仍为连续区间')
+        if scale == 0:
+            return self.__class__.from_atomic(Bound.CLOSED, offset, offset, Bound.CLOSED)
+        def endpoint(value):
+            """保持无穷方向。@param value 端点。@return 变换端点。"""
+            if value in (-inf, inf):
+                return value if scale > 0 else -value
+            return scale * value + offset
+        if scale > 0:
+            return self.apply(lambda atom: (atom.left, endpoint(atom.lower), endpoint(atom.upper), atom.right))
+        return self.apply(lambda atom: (atom.right, endpoint(atom.upper), endpoint(atom.lower), atom.left))
+
+    def translate(self, offset):
+        """平移连续区间。@param offset 偏移。@return 同类平移结果。"""
