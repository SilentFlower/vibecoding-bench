+
+路线09：独立ZonedTimeStamper明确tzinfo/ZoneInfo、ISO精度与注入aware时钟，真实瞬间转换并输出offset；拒绝naive/无效精度，原TimeStamper不动。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/src/structlog/_zoned_timestamp.py
+++ b/library/src/structlog/_zoned_timestamp.py
@@ -0,0 +1,19 @@
+import datetime as dt
+class ZonedTimeStamper:
+    """显式业务时区与精度的ISO处理器。@param zone tzinfo或ZoneInfo名称。@param timespec ISO精度。@param key 目标键。@param clock 注入aware时钟。@return 处理器。"""
+    def __init__(self,zone,*,timespec="microseconds",key="timestamp",clock=None):
+        """验证时间策略，不改变TimeStamper默认。@param zone 目标时区。@param timespec 秒/毫秒等。@param key 字段。@param clock 可调用或None。@return None。"""
+        if isinstance(zone,str):
+            from zoneinfo import ZoneInfo
+            zone=ZoneInfo(zone)
+        if not isinstance(zone,dt.tzinfo):raise TypeError("zone必须为tzinfo或时区名")
+        if timespec not in ("auto","hours","minutes","seconds","milliseconds","microseconds"):raise ValueError("未知timespec")
+        if clock is not None and not callable(clock):raise TypeError("clock必须可调用")
+        self.zone=zone;self.timespec=timespec;self.key=key;self.clock=clock
+
+    def __call__(self,logger,name,event_dict):
+        """只转换aware瞬间。@param logger 原logger。@param name 级别。@param event_dict 事件。@return 同一事件含ISO offset。"""
+        value=self.clock() if self.clock is not None else dt.datetime.now(dt.timezone.utc)
+        if not isinstance(value,dt.datetime) or value.tzinfo is None or value.utcoffset() is None:raise ValueError("clock必须返回aware datetime")
+        event_dict[self.key]=value.astimezone(self.zone).isoformat(timespec=self.timespec)
+        return event_dict
