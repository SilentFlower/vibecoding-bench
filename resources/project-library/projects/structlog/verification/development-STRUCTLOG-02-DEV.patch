@@ -303,19 +303,39 @@
     _errors: str
 
     def __init__(
-        self, encoding: str = "utf-8", errors: str = "replace"
+        self, encoding: str = "utf-8", errors: str = "replace", *, recursive=False, max_depth=32
     ) -> None:
         self._encoding = encoding
         self._errors = errors
+        if type(max_depth) is not int or max_depth<0:raise ValueError("max_depth必须为非负整数")
+        self.recursive=recursive
+        self.max_depth=max_depth
 
     def __call__(
         self, logger: WrappedLogger, name: str, event_dict: EventDict
     ) -> EventDict:
+        if self.recursive:
+            return self._decode(event_dict,0,set(),())
         for key, value in event_dict.items():
             if isinstance(value, bytes):
                 event_dict[key] = value.decode(self._encoding, self._errors)
 
         return event_dict
+
+
+    def _decode(self,value,depth,active,path):
+        """复制内建容器并按路径检测环/深度，不触发任意对象getter。"""
+        if isinstance(value,bytes):return value.decode(self._encoding,self._errors)
+        if type(value) not in (dict,list,tuple):return value
+        if depth>self.max_depth:raise ValueError("超过解码深度: "+repr(path))
+        if id(value) in active:raise ValueError("循环解码路径: "+repr(path))
+        active.add(id(value))
+        try:
+            if type(value) is dict:
+                return {key:self._decode(item,depth+1,active,path+(key,)) for key,item in value.items()}
+            result=[self._decode(item,depth+1,active,path+(index,)) for index,item in enumerate(value)]
+            return tuple(result) if type(value) is tuple else result
+        finally:active.remove(id(value))
 
 
