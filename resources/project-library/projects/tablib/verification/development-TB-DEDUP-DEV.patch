@@ -0,0 +1,20 @@
+"""以明确业务键去重并保留原行顺序和标签。"""
+from .projection import schema,key_token,copy_rows
+
+
+def deduplicate(dataset,by,*,keep='first'):
+    """按复合键去重。@param dataset 实际Dataset。@param by 字段名或非空字段序列。
+    @param keep first/last/False，False删除所有重复组。@return 独立静态Dataset。
+    """
+    headers=schema(dataset);names=[by] if isinstance(by,str) else list(by)
+    if not names or any(name not in headers for name in names) or len(set(names))!=len(names) or (keep is not False and keep not in ('first','last')):
+        raise ValueError('无效的去重键或保留策略')
+    positions=[headers.index(name) for name in names];keys=[];counts={};first={};last={}
+    for index,row in enumerate(dataset._data):
+        key=key_token([row[position] for position in positions]);keys.append(key)
+        counts[key]=counts.get(key,0)+1;first.setdefault(key,index);last[key]=index
+    chosen=[]
+    for index,(row,key) in enumerate(zip(dataset._data,keys)):
+        if (keep=='first' and first[key]==index) or (keep=='last' and last[key]==index) or (keep is False and counts[key]==1):
+            chosen.append((row,row.tags))
+    return copy_rows(dataset,chosen,headers)
