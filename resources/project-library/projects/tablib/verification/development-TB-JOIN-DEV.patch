+# 支持有预算的稳定多对多表格关联和明确空键策略
+
+实现稳定多对多关联，明确空键是否匹配、重名列后缀和完整外关联键回填。输出行预算防止笛卡尔展开失控，复制数据与标签，任何失败都不污染两份来源。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/tablib/joining.py
+++ b/library/src/tablib/joining.py
@@ -0,0 +1,50 @@
+"""以明确复合键执行有行数预算的表格关联。"""
+from .projection import schema,key_token,copy_rows
+
+
+def join(left,right,on,*,how='left',suffixes=('_left','_right'),nulls='never',max_rows=100000):
+    """稳定关联两份Dataset。@param left 左表。@param right 右表。@param on 同名复合键。
+    @param how inner/left/outer。@param suffixes 重名非键列后缀。@param nulls never或equal。
+    @param max_rows 输出行预算。@return 静态独立Dataset，多对多按左行再右行顺序展开。
+    """
+    lh=schema(left);rh=schema(right);names=[on] if isinstance(on,str) else list(on)
+    if not names or len(set(names))!=len(names) or any(name not in lh or name not in rh for name in names) or how not in ('inner','left','outer') or nulls not in ('never','equal') or type(max_rows) is not int or max_rows<1:
+        raise ValueError('无效表格关联合同')
+    if not isinstance(suffixes,(tuple,list)) or len(suffixes)!=2 or any(not isinstance(value,str) for value in suffixes):
+        raise ValueError('需要两个文本后缀')
+    right_columns=[(index,name) for index,name in enumerate(rh) if name not in names]
+    collisions=(set(lh)&set(rh))-set(names)
+    output=[name+suffixes[0] if name in collisions else name for name in lh]+[name+suffixes[1] if name in collisions else name for _,name in right_columns]
+    if len(set(output))!=len(output):
+        raise ValueError('关联输出列名冲突')
+    lp=[lh.index(name) for name in names];rp=[rh.index(name) for name in names]
+    def key(row,positions):
+        values=[row[position] for position in positions]
+        return None if nulls=='never' and any(value is None for value in values) else key_token(values)
+    index={}
+    for position,row in enumerate(right._data):
+        marker=key(row,rp)
+        if marker is not None:
+            index.setdefault(marker,[]).append((position,row))
+    rows=[];matched=set()
+    def append(values,tags):
+        if len(rows)>=max_rows:
+            raise ValueError('关联结果超过行数预算')
+        rows.append((values,tags))
+    for row in left._data:
+        marker=key(row,lp);matches=index.get(marker,[]) if marker is not None else []
+        if matches:
+            for position,other in matches:
+                matched.add(position)
+                tags=list(row.tags)+[tag for tag in other.tags if tag not in row.tags]
+                append(list(row)+[other[index] for index,_ in right_columns],tags)
+        elif how in ('left','outer'):
+            append(list(row)+[None]*len(right_columns),row.tags)
+    if how=='outer':
+        for position,row in enumerate(right._data):
+            if position not in matched:
+                values=[None]*len(lh)
+                for lpos,rpos in zip(lp,rp):
+                    values[lpos]=row[rpos]
+                append(values+[row[index] for index,_ in right_columns],row.tags)
+    return copy_rows(left,rows,output)
