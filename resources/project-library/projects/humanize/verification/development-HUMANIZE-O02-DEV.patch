+"""可嵌套且异步任务隔离的显式Humanize区域作用域。"""
+from humanize.i18n import _CONTEXT, _load_translation
+
+
+class LocaleScope:
+    """以ContextVar令牌恢复当前任务的区域，不修改线程活动选择。
+
+    :param locale: 请求locale。
+    :param path: 显式目录或默认目录。
+    :return: 支持with的单次活动实例；退出后可再次进入。
+    """
+    def __init__(self, locale, path=None):
+        """只保存声明，不提前激活。@return None。"""
+        self.locale, self.path, self._token = locale, path, None
+
+    def __enter__(self):
+        """成功加载后才切换本任务，拒绝同实例同时重复进入。@return 实际翻译。"""
+        if self._token is not None:
+            raise RuntimeError('同一LocaleScope不能重入')
+        selected = _load_translation(self.locale, self.path)
+        self._token = _CONTEXT.set(selected)
+        return selected[1]
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        """异常或取消路径也恢复外层任务上下文。@return False。"""
+        token, self._token = self._token, None
+        _CONTEXT.reset(token)
+        return False
+
+
+def locale_scope(locale, path=None):
+    """创建独立区域作用域，线程activate/deactivate仅在作用域外可见。
+
+    :param locale: 语言或None默认英语。
+    :param path: 可选本地消息目录。
+    :return: 新LocaleScope。
+    """
+    return LocaleScope(locale, path)
