+@pytest.mark.parametrize("fts_version", ["FTS4", "FTS5"])
+@pytest.mark.parametrize("create_triggers", [False, True])
+def test_finite_one_shot_columns_preserve_fts(fts_version, create_triggers):
+    """一次性列名在后续SQL仍可复用。@param fts_version 版本。@param create_triggers 触发器。@return None。"""
+    db = Database(memory=True)
+    table = db["oneshot"].insert({"id": 1, "body": "azure"}, pk="id")
+    assert table.enable_fts(iter(["body"]), fts_version=fts_version,
+                            create_triggers=create_triggers) is table
+    assert [row["id"] for row in table.search("azure")] == [1]
+    table.insert({"id": 2, "body": "violet"})
+    assert [row["id"] for row in table.search("violet")] == ([2] if create_triggers else [])
+    db.close()
