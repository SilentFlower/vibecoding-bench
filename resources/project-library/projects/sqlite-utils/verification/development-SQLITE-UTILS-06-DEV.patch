+    def export_csv(self,stream,*,columns=None,where=None,where_args=None,order_by=None,limit=None,offset=None,dialect="excel"):
+        """流式导出查询。@param stream 调用方文本流，不关闭。@param columns 可选列顺序。@param where SQL片段。@param where_args 绑定值。@param order_by 排序。@param limit 上限。@param offset 起点。@param dialect 标准CSV方言。@return 实际写出记录数，不含表头；NULL按CSV空字段。"""
+        import csv
+        available=self.columns_dict
+        selected=list(available) if columns is None else list(columns)
+        if not selected or len(set(selected))!=len(selected) or any(name not in available for name in selected):raise InvalidColumns(selected)
+        writer=csv.writer(stream,dialect=dialect)
