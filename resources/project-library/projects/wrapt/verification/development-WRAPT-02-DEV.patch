+# 无字典轻量实例以弱引用身份维护独立方法缓存
+
+路线02：weak_method_cache显式弱引用外置存储，id+weakref核同一实例，支持slots/不可hash且不缓存boundmethod强引用；计数/定点清理与GC真实证明，不支持弱引用明确拒绝，结果自行保活self除外。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/src/wrapt/weak_cache.py
+++ b/library/src/wrapt/weak_cache.py
@@ -0,0 +1,42 @@
+"""显式弱引用外置方法缓存，支持无__dict__与不可hash实例。"""
+from functools import lru_cache
+from threading import RLock
+from weakref import ref
+from .decorators import decorator
+from .weakrefs import WeakFunctionProxy
+
+def weak_method_cache(*,maxsize=128,typed=False):
+    """创建按实例身份的弱存储装饰器。@param maxsize 每实例容量。@param typed functools类型策略。@return 保descriptor绑定的装饰器；缓存结果/参数若自行持有self不承诺释放。"""
+    if maxsize is not None and (type(maxsize) is not int or maxsize<0):raise ValueError('maxsize无效')
+    def decorate(function):
+        entries={};lock=RLock()
+        def remove(identity,reference):
+            with lock:
+                item=entries.get(identity)
+                if item is not None and item[0] is reference:entries.pop(identity,None)
+        @decorator
+        def invoke(wrapped,instance,args,kwargs):
+            if instance is None or isinstance(instance,type):raise TypeError('仅支持已绑定实例方法')
+            identity=id(instance)
+            with lock:
+                item=entries.get(identity)
+                if item is None or item[0]() is not instance:
+                    reference=ref(instance,lambda value:remove(identity,value))
+                    cache=lru_cache(maxsize=maxsize,typed=typed)(WeakFunctionProxy(wrapped))
+                    entries[identity]=(reference,cache)
+                else:cache=item[1]
+            return cache(*args,**kwargs)
+        result=invoke(function)
+        def cache_count():
+            """查看活实例缓存数。@return int。"""
+            with lock:return len(entries)
+        def cache_clear(instance=None):
+            """清全部或某实例缓存。@param instance 可选真实实例。@return None。"""
+            with lock:
+                if instance is None:entries.clear()
+                else:
+                    item=entries.get(id(instance))
+                    if item is not None and item[0]() is instance:item[1].cache_clear()
+        result.cache_count=cache_count;result.cache_clear=cache_clear
+        return result
+    return decorate
--- a/library/tests/test_development_wrapt_02_dev.py
