+"""先验证日志，再在调用者明确提供的新机器上重放真实事件。"""
+from dataclasses import dataclass
+from .journal import loads_journal
+from .runner import MachineRunner
+from .snapshots import snapshot
+
+
+@dataclass(frozen=True)
+class ReplayResult:
+    """重放后的真实机器及实际事件结果。"""
+    machine: object
+    results: tuple
+
+
+def replay(factory,document,*,verify=True,max_records=10000):
+    """在工厂新实例上重放。@param factory 无参数新状态机工厂。@param document 固定JSON日志。
+    @param verify 是否逐条核对前后配置和值及状态。@param max_records 日志记录预算。
+    @return ReplayResult；不执行类名字符串，不承诺回滚外部回调副作用。
+    """
+    if not callable(factory) or type(verify) is not bool:
+        raise TypeError('需要明确工厂及布尔校验策略')
+    expected=loads_journal(document,max_records=max_records)
+    machine=factory();runner=MachineRunner(machine);results=[]
+    for step in expected:
+        before=snapshot(machine)
+        if verify and (before.states!=step.before.states or before.values!=step.before.values):
+            raise ValueError('重放前配置与日志不符，索引'+str(step.index))
+        actual=runner.dispatch(step.call,index=step.index,errors='collect')
+        if verify and (actual.status!=step.status or actual.after.states!=step.after.states or actual.after.values!=step.after.values):
+            raise ValueError('重放后配置与日志不符，索引'+str(step.index))
+        results.append(actual)
+    return ReplayResult(machine,tuple(results))
