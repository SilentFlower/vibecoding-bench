@@ -0,0 +1,53 @@
+"""在当前事件循环等待真实异步激活及每次事件完成。"""
+from copy import deepcopy
+from inspect import isawaitable
+from .exceptions import TransitionNotAllowed
+from .snapshots import snapshot
+from .runner import normalize_call,EventResult
+
+
+class AsyncMachineRunner:
+    """逐条等待事件完成，不创建隐藏线程或后台事件任务。"""
+    def __init__(self,machine):
+        """绑定真实状态机。@param machine 同步或异步StateChart。@return None。
+        """
+        snapshot(machine);self.machine=machine
+
+    async def dispatch(self,call,*,index=0,errors='raise'):
+        """激活并执行事件。@param call 明确事件。@param index 记录序号。
+        @param errors raise或collect。@return 完成后的EventResult。
+        """
+        if errors not in ('raise','collect'):
+            raise ValueError('无效事件错误策略')
+        call=normalize_call(call)
+        activated=self.machine.activate_initial_state()
+        if isawaitable(activated):
+            await activated
+        before=snapshot(self.machine)
+        try:
+            result=self.machine.send(call.event,*deepcopy(call.args),**deepcopy(call.kwargs))
+            if isawaitable(result):
+                result=await result
+        except TransitionNotAllowed as error:
+            if errors=='raise':
+                raise
+            return EventResult(index,call,'error',before,snapshot(self.machine),error=str(error))
+        return EventResult(index,call,'passed',before,snapshot(self.machine),result=result)
+
+    def run(self,calls,*,errors='raise'):
+        """串行消费同步或异步来源。@param calls 原事件流。@param errors 错误策略。
+        @return 异步结果迭代器，取消与来源／回调异常原样传播。
+        """
+        if errors not in ('raise','collect'):
+            raise ValueError('无效事件错误策略')
+        async def produce():
+            index=0
+            if hasattr(calls,'__aiter__'):
+                async for call in calls:
+                    yield await self.dispatch(call,index=index,errors=errors)
+                    index+=1
+            else:
+                for call in calls:
+                    yield await self.dispatch(call,index=index,errors=errors)
+                    index+=1
+        return produce()
