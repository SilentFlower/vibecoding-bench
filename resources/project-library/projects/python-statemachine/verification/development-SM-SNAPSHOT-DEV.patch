+"""只读捕获活动配置，不运行守卫或激活回调。"""
+import math
+from collections.abc import Mapping
+from dataclasses import dataclass
+from types import MappingProxyType
+from .statemachine import StateChart
+
+
+def freeze(value,active=None):
+    """冻结JSON兼容配置值。@param value 标准配置值。@param active 递归身份集合。
+    @return 不可变值，拒绝非有限数、循环和不支持对象。
+    """
+    if value is None or type(value) in (str,bool,int):
+        return value
+    if type(value) is float:
+        if not math.isfinite(value):
+            raise ValueError('状态值不能为非有限数')
+        return value
+    if not isinstance(value,(dict,list,tuple)):
+        raise TypeError('快照只支持JSON兼容状态值')
+    active=set() if active is None else active
+    if id(value) in active:
+        raise ValueError('状态值存在循环')
+    active.add(id(value))
+    try:
+        if isinstance(value,dict):
+            if any(not isinstance(key,str) for key in value):
+                raise TypeError('快照映射键必须为文本')
+            return MappingProxyType({key:freeze(item,active) for key,item in value.items()})
+        return tuple(freeze(item,active) for item in value)
+    finally:
+        active.remove(id(value))
+
+
+@dataclass(frozen=True)
+class StateSnapshot:
+    """按活动配置顺序保存状态ID、值和结构允许事件。"""
+    states: tuple
+    values: tuple
+    allowed_events: tuple
+
+
+def snapshot(machine):
+    """捕获实际活动状态。@param machine StateChart实例。@return 独立StateSnapshot。
+    允许事件只表示结构候选，不表示守卫已通过；异步初态不由此函数激活。
+    """
+    if not isinstance(machine,StateChart):
+        raise TypeError('需要真实状态机')
+    states=tuple(machine.configuration)
+    return StateSnapshot(tuple(state.id for state in states),tuple(freeze(state.value) for state in states),tuple(dict.fromkeys(str(event) for event in machine.allowed_events)))
