+"""同步逐事件调用真实状态机，保留原异常与实际前后配置。"""
+from collections.abc import Mapping
+from copy import deepcopy
+from dataclasses import dataclass
+from inspect import isawaitable,iscoroutine
+from .exceptions import TransitionNotAllowed
+from .snapshots import snapshot
+
+
+@dataclass(frozen=True)
+class EventCall:
+    """明确事件及用户回调参数；调度保留字段不能藏入kwargs。"""
+    event: str
+    args: tuple=()
+    kwargs: object=None
+
+
+@dataclass(frozen=True)
+class EventResult:
+    """一次真实事件调用的独立记录，不承诺回滚回调外部副作用。"""
+    index: int
+    call: EventCall
+    status: str
+    before: object
+    after: object
+    result: object=None
+    error: object=None
+
+
+def normalize_call(call):
+    """验证并隔离用户参数。@param call 事件文本或EventCall。@return 独立EventCall。
+    """
+    call=EventCall(call) if isinstance(call,str) else call
+    if not isinstance(call,EventCall) or not isinstance(call.event,str) or not call.event or not isinstance(call.args,tuple) or (call.kwargs is not None and not isinstance(call.kwargs,Mapping)):
+        raise ValueError('需要明确事件及参数')
+    kwargs=dict(call.kwargs or {})
+    if any(not isinstance(key,str) for key in kwargs) or set(kwargs)&{'delay','send_id','internal'}:
+        raise ValueError('批量即时执行不接受调度控制字段')
+    return EventCall(call.event,deepcopy(call.args),deepcopy(kwargs))
+
+
+class MachineRunner:
+    """对既有同步状态机执行即时外部事件。"""
+    def __init__(self,machine):
+        """绑定真实状态机。@param machine 已激活同步状态机。@return None。
+        """
+        snapshot(machine);self.machine=machine
+
+    def dispatch(self,call,*,index=0,errors='raise'):
+        """执行一条事件。@param call 事件及参数。@param index 记录序号。
+        @param errors raise或collect，仅收集TransitionNotAllowed。@return EventResult。
+        """
+        if errors not in ('raise','collect'):
+            raise ValueError('无效事件错误策略')
+        call=normalize_call(call);before=snapshot(self.machine)
+        try:
+            result=self.machine.send(call.event,*deepcopy(call.args),**deepcopy(call.kwargs))
+            if isawaitable(result):
+                if iscoroutine(result):
+                    result.close()
+                raise TypeError('异步状态机请使用AsyncMachineRunner')
+        except TransitionNotAllowed as error:
+            if errors=='raise':
+                raise
+            return EventResult(index,call,'error',before,snapshot(self.machine),error=str(error))
+        return EventResult(index,call,'passed',before,snapshot(self.machine),result=result)
+
+    def run(self,calls,*,errors='raise'):
+        """惰性顺序执行事件流。@param calls 输入事件。@param errors 错误策略。
+        @return 逐事件结果迭代器，来源错误原样传播。
+        """
+        if errors not in ('raise','collect'):
+            raise ValueError('无效事件错误策略')
+        iterator=iter(calls)
+        return (self.dispatch(call,index=index,errors=errors) for index,call in enumerate(iterator))
