+    def range(self, unit: str, amount: int = 1, *, closed="both", limit=None) -> Iterator[_T]:
+        """生成有限策略的锚点序列。@param unit 时间单位。@param amount 正整数步长。@param closed both/left/right/neither，左右为遍历首尾。@param limit 非负最大产出或None。@return 逐项迭代器。"""
+        amount=operator.index(amount)
+        if amount<=0:raise ValueError("amount必须大于0")
+        if closed not in ("both","left","right","neither"):raise ValueError("无效closed")
+        if unit not in ("years","months","weeks","days","hours","minutes","seconds","microseconds"):
+            raise ValueError("无效unit")
+        if limit is not None:
+            limit=operator.index(limit)
+            if limit<0:raise ValueError("limit不能为负")
+        method="subtract" if not self._absolute and self.invert else "add"
+        op=operator.ge if method=="subtract" else operator.le
+        current,end=self.start,self.end
+        index=0;emitted=0
+        while op(current,end):
+            if limit is not None and emitted>=limit:return
+            include=(index!=0 or closed in ("both","left")) and (current!=end or closed in ("both","right"))
+            if include:
+                yield current
+                emitted+=1
+            if current==end:return
+            index+=1
+            try:current=getattr(self.start,method)(**{unit:index*amount})
+            except OverflowError:return
 
