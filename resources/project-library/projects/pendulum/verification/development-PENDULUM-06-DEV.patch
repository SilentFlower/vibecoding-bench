+"""调用方提供离线假日的不可变工作日历。"""
+from dataclasses import dataclass
+from datetime import date,datetime,timedelta
+import operator
+
+
+@dataclass(frozen=True)
+class BusinessCalendar:
+    """离线日历。@param holidays date集合。@param weekend 0周一至6周日的休息日。@return 不可变策略。"""
+    holidays: frozenset = frozenset()
+    weekend: frozenset = frozenset((5,6))
+
+    def __post_init__(self):
+        """固定输入并拒绝无法推进的整周休息政策。@return None。"""
+        holidays=frozenset(self.holidays);weekend=frozenset(self.weekend)
+        if any(not isinstance(day,date) or isinstance(day,datetime) for day in holidays):raise TypeError("holidays需要date")
+        if any(type(day) is not int or not 0<=day<=6 for day in weekend) or len(weekend)==7:raise ValueError("无效weekend")
+        object.__setattr__(self,"holidays",holidays);object.__setattr__(self,"weekend",weekend)
+
+    def is_business_day(self,value):
+        """判断指定日期。@param value date或datetime。@return 是否工作日。"""
+        day=date(value.year,value.month,value.day)
+        return day.weekday() not in self.weekend and day not in self.holidays
+
+    def add_business_days(self,value,amount):
+        """跳过假日推进日历日。@param value 原日期时间。@param amount 有符号整数，零不滚动。@return 原类型业务日期。"""
+        amount=operator.index(amount)
+        if amount==0:return value
+        direction=1 if amount>0 else -1;remaining=abs(amount);current=value
+        while remaining:
+            current=current.add(days=direction) if hasattr(current,"add") else current+timedelta(days=direction)
+            if self.is_business_day(current):remaining-=1
+        return current
+
+    def count(self,start,end):
+        """计数半开[start,end)工作日。@param start 首日。@param end 末日。@return 有符号计数。"""
+        if start>end:return -self.count(end,start)
+        current=date(start.year,start.month,start.day);stop=date(end.year,end.month,end.day);total=0
+        while current<stop:
+            total+=self.is_business_day(current);current+=timedelta(days=1)
+        return total
+
+    def next_business_day(self,value,include_current=False):
+        """查找下一工作日。@param value 起点。@param include_current 可保留当前工作日。@return 日期时间。"""
+        if include_current and self.is_business_day(value):return value
+        return self.add_business_days(value,1)
