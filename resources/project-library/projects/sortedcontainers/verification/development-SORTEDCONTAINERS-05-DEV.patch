+"""先定位和收集，再按既有切片协议一次删除。"""
+
+
+def pop_range(container,minimum=None,maximum=None,inclusive=(True,True),reverse=False):
+    """取出区间。@param container 有序容器。@param minimum 下界或无界。@param maximum 上界或无界。@param inclusive 两个布尔。@param reverse 只反向返回。@return 原顺序值列表/映射item列表。"""
+    if len(inclusive)!=2 or any(type(flag) is not bool for flag in inclusive):raise ValueError("inclusive需要两个bool")
+    left=0 if minimum is None else (container.bisect_left(minimum) if inclusive[0] else container.bisect_right(minimum))
+    right=len(container) if maximum is None else (container.bisect_right(maximum) if inclusive[1] else container.bisect_left(maximum))
+    if right<left:right=left
+    if isinstance(container,dict):
+        keys=list(container.islice(left,right))
+        result=[(key,container[key]) for key in keys]
+        del container.keys()[left:right]
+    else:
+        result=list(container[left:right])
+        del container[left:right]
+    return result[::-1] if reverse else result
