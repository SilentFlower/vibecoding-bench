+# 对归一化业务列执行显式格式化回调再渲染
+
+报表需要按列展示金额、状态等业务值。先沿用原数据归一化，再用显式回调转换，分隔线及缺失的稀疏单元格不调用回调。业务行号稳定、输入不变，最后仍走原渲染选项，不引入全局注册表。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/tabulate/formatters.py
+++ b/library/tabulate/formatters.py
@@ -0,0 +1,28 @@
+"""在原数据归一化之后按列转换业务展示值。"""
+from tabulate import tabulate, _normalize_tabular_data, _is_separating_line
+
+
+def tabulate_with_formatters(data,headers=(),*,formatters=(),**options):
+    """按列格式化再渲染。@param data 原表数据。@param headers 原表头选项。
+    @param formatters callable(value,row_index,column_index)或None序列。@param options 原渲染选项。
+    @return 原格式器的结果；分隔线不调用回调，不修改输入，异常原样传播。
+    """
+    callbacks=tuple(formatters)
+    if any(callback is not None and not callable(callback) for callback in callbacks):
+        raise TypeError('列格式器必须可调用或None')
+    rows,normalized,padding=_normalize_tabular_data(data,headers,showindex='never')
+    width=max([len(normalized),*(len(row) for row in rows if not _is_separating_line(row))],default=0)
+    if len(callbacks)>width:
+        raise ValueError('格式器列数超过表宽')
+    result=[];row_index=0
+    for row in rows:
+        if _is_separating_line(row):
+            result.append(row)
+            continue
+        rendered=list(row)
+        for column,callback in enumerate(callbacks):
+            if callback is not None and column<len(rendered):
+                rendered[column]=callback(rendered[column],row_index,column)
+        result.append(rendered)
+        row_index+=1
+    return tabulate(result,headers=normalized,**options)
