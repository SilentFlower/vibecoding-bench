+"""显式三方JSON合并；数组作为不可分割业务值处理。"""
+from copy import deepcopy
+from dataclasses import dataclass
+from deepdiff.merge import json_equal, validate_json_tree
+
+
+@dataclass(frozen=True)
+class Merge3Result:
+    """输出合并值和独立冲突记录。
+
+    :param value: 无冲突值已合并，冲突位置保留base而不擅选一侧。
+    :param conflicts: 路径及base/left/right存在性和原始值快照。
+    :return: complete反映是否无冲突。
+    """
+    value: object
+    conflicts: tuple
+
+    @property
+    def complete(self):
+        """是否已无冲突完成。@return bool。"""
+        return not self.conflicts
+
+
+def merge3(base, left, right, *, arrays='atomic'):
+    """递归合并不相交字典变更，冲突不自动覆盖。
+
+    :param base: 共同基线JSON树。
+    :param left: 左侧修改后的树。
+    :param right: 右侧修改后的树。
+    :param arrays: 首版只支持显式atomic，避免数组索引移动误合并。
+    :return: Merge3Result，输入和冲突快照互不共享容器。
+    """
+    if arrays != 'atomic':
+        raise ValueError('只支持显式atomic数组政策')
+    for item in (base, left, right):
+        validate_json_tree(item)
+    missing = object()
+    conflicts = []
+    def equal(a, b):
+        if a is missing or b is missing:
+            return a is b
+        return json_equal(a, b)
+    def copy(value):
+        return missing if value is missing else deepcopy(value)
+    def describe(value):
+        return {'present': value is not missing, 'value': None if value is missing else deepcopy(value)}
+    def combine(original, a, b, path):
+        if equal(a, b):
+            return copy(a)
+        if equal(a, original):
+            return copy(b)
+        if equal(b, original):
+            return copy(a)
+        if isinstance(a, dict) and isinstance(b, dict) and (isinstance(original, dict) or original is missing):
+            original = {} if original is missing else original
+            result = {}
+            for key in dict.fromkeys([*original, *a, *b]):
+                value = combine(original.get(key, missing), a.get(key, missing), b.get(key, missing), path + (key,))
+                if value is not missing:
+                    result[key] = value
+            return result
+        conflicts.append({'path': list(path), 'base': describe(original), 'left': describe(a), 'right': describe(b)})
+        return copy(original)
+    result = combine(base, left, right, ())
+    return Merge3Result(None if result is missing else result, tuple(conflicts))
