--- a/library/deepdiff/reporting.py
+++ b/library/deepdiff/reporting.py
@@ -0,0 +1,64 @@
+"""保留差异类别及路径、仅在独立展示层遮蔽指定子树值。"""
+from functools import lru_cache
+import json
+from deepdiff.path import MULTI_WILDCARD, SINGLE_WILDCARD, parse_path
+from deepdiff.serialization import json_dumps
+
+
+def redacted_report(diff, *, redact_paths=(), mask='[已遮蔽]', left_label='left', right_label='right', default_mapping=None):
+    """从真实Diff生成JSON安全独立报告，绝不改变Delta输入。
+
+    :param diff: 实际DeepDiff，text/tree都转换为真实verbose_level=2视图。
+    :param redact_paths: 明确root路径，支持原路径组件通配符*和**；字面星号键不混淆。
+    :param mask: JSON标量占位符。
+    :param left_label: 独立展示标签，不写回内部old/new字段。
+    :param right_label: 另一侧唯一非空标签。
+    :param default_mapping: 仅处理未遮蔽值的原生JSON类型映射。
+    :return: schema、labels与changes组成的JSON安全新字典。
+    """
+    if not isinstance(left_label, str) or not isinstance(right_label, str) or not left_label.strip() or not right_label.strip() or left_label == right_label:
+        raise ValueError('展示标签必须非空且不同')
+    if not isinstance(mask, (str, int, float, bool, type(None))):
+        raise TypeError('占位符必须为JSON标量')
+    patterns = []
+    for path in redact_paths:
+        if not isinstance(path, str) or not (path == 'root' or path.startswith('root[') or path.startswith('root.')):
+            raise ValueError('遮蔽路径必须为明确root路径')
+        patterns.append(tuple(parse_path(path)))
+    def under(pattern, parts):
+        @lru_cache(None)
+        def match(i, j):
+            if i == len(pattern):
+                return True
+            if pattern[i] == MULTI_WILDCARD:
+                return match(i + 1, j) or (j < len(parts) and match(i, j + 1))
+            return j < len(parts) and (pattern[i] == SINGLE_WILDCARD or pattern[i] == parts[j]) and match(i + 1, j + 1)
+        return match(0, 0)
+    def masked(parts):
+        return any(under(pattern, tuple(parts)) for pattern in patterns)
+    def value(item, parts):
+        if masked(parts):
+            return mask
+        if isinstance(item, dict):
+            return {key: value(child, (*parts, key)) for key, child in item.items()}
+        if isinstance(item, (list, tuple)):
+            return [value(child, (*parts, index)) for index, child in enumerate(item)]
+        return item
+    allowed = {'values_changed', 'type_changes', 'dictionary_item_added', 'dictionary_item_removed',
+               'iterable_item_added', 'iterable_item_removed', 'iterable_item_moved', 'repetition_change'}
+    changes = {}
+    for category, records in diff.to_dict(verbose_level=2).items():
+        if category not in allowed or not isinstance(records, dict):
+            raise TypeError('展示遮蔽首版只支持具有明确JSON树路径的差异类别')
+        output = {}
+        for path, detail in records.items():
+            parts = tuple(parse_path(path))
+            if category in {'values_changed', 'type_changes', 'iterable_item_moved', 'repetition_change'}:
+                output[path] = {key: value(item, parts) if key in {'old_value', 'new_value', 'value'} else item
+                                for key, item in detail.items() if key != 'diff' or not patterns}
+            else:
+                output[path] = value(detail, parts)
+        changes[category] = output
+    result = {'schema': 1, 'labels': {'left': left_label, 'right': right_label}, 'changes': changes}
+    # 先遮蔽再交序列化器，受保护对象不能泄露到自定义类型转换函数。
+    return json.loads(json_dumps(result, default_mapping=default_mapping, force_use_builtin_json=True))
