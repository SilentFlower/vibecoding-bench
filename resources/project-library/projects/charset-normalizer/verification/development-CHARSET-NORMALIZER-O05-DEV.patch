+# 为原始字节和解码文字生成跨进程稳定摘要
+
+基于已冻结模型区分raw与text摘要域，固定长度hashlib摘要跨进程稳定。默认不合并Unicode形式且保留换行，归一化和文本编码须明确选择；相同文字不同编码的text摘要一致、raw摘要不同，原fingerprint不变。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/charset_normalizer/models.py
+++ b/library/src/charset_normalizer/models.py
@@ -250,6 +250,35 @@
             self._output_encoding = encoding
 
         return self._output_payload  # type: ignore
+
+    def stable_digest(self, *, mode='text', algorithm='sha256', normalization=None, text_encoding='utf-8'):
+        """从不可变原始或解码文字产生跨进程稳定摘要。
+
+        :param mode: raw或text。
+        :param algorithm: hashlib支持的固定长度摘要算法。
+        :param normalization: text可显式选NFC/NFD/NFKC/NFKD，默认不归一化。
+        :param text_encoding: text摘要的明确编码，默认UTF8。
+        :return: 十六进制稳定摘要，不改变原fingerprint。
+        """
+        from hashlib import new
+        from unicodedata import normalize
+        if mode not in ('raw', 'text'):
+            raise ValueError('未知摘要域')
+        if normalization not in (None, 'NFC', 'NFD', 'NFKC', 'NFKD'):
+            raise ValueError('未知Unicode归一化')
+        if mode == 'raw':
+            if normalization is not None:
+                raise ValueError('原始摘要不接受Unicode归一化')
+            payload = bytes(self.raw)
+        else:
+            text = str(self)
+            if normalization is not None:
+                text = normalize(normalization, text)
+            payload = text.encode(text_encoding, errors='strict')
+        digest = new(algorithm, payload)
+        if digest.digest_size == 0:
+            raise ValueError('摘要算法必须有固定输出长度')
+        return digest.hexdigest()
 
     @property
     def fingerprint(self) -> int:
