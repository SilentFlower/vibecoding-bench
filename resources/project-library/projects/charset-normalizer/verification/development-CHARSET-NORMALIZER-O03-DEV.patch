+    def transcode(self, encoding='utf_8', *, errors='strict', bom='codec'):
+        """用显式损失及BOM政策导出，旧output缓存和默认不变。
+
+        :param encoding: 目标codec。
+        :param errors: strict、replace或ignore。
+        :param bom: codec沿codec默认，strip移除一个BOM，add为UTF目标加一个BOM。
+        :return: output及不可表示码点数量、实际编码和BOM政策。
+        """
+        import codecs
+        if errors not in ('strict', 'replace', 'ignore') or bom not in ('codec', 'strip', 'add'):
+            raise ValueError('无效转码政策')
+        canonical = codecs.lookup(encoding).name
+        prefixes = {'utf-8': codecs.BOM_UTF8, 'utf-8-sig': codecs.BOM_UTF8,
+            'utf-16': codecs.BOM_UTF16, 'utf-16-le': codecs.BOM_UTF16_LE, 'utf-16-be': codecs.BOM_UTF16_BE,
+            'utf-32': codecs.BOM_UTF32, 'utf-32-le': codecs.BOM_UTF32_LE, 'utf-32-be': codecs.BOM_UTF32_BE}
+        prefix = prefixes.get(canonical)
+        if bom == 'add' and prefix is None:
+            raise ValueError('目标codec没有支持的BOM')
+        text = self._text_for_encoding(encoding)
+        encoded = text.encode(encoding, errors)
+        losses = 0
+        if errors != 'strict':
+            for character in text:
+                try:
+                    character.encode(encoding, 'strict')
+                except UnicodeEncodeError:
