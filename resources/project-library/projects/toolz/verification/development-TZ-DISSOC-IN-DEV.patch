+def dissoc_in(d, keys, factory=dict, *, strict=False, prune=False):
+    """复制受影响路径并删除嵌套叶子，不修改业务输入。
+
+    :param d: 原映射。
+    :param keys: 一次性或可重用的非空键路径。
+    :param factory: 各受影响分支的空映射工厂。
+    :param strict: 缺失路径是否抛KeyError。
+    :param prune: 是否逐级移除删除后为空的父映射。
+    :return: 新根映射，未修改分支保持引用。
+    """
+    path = tuple(keys)
+    if not path:
+        raise ValueError('删除路径不可为空')
+    parents = []
+    current = d
+    for index, key in enumerate(path):
+        if not isinstance(current, Mapping):
+            raise TypeError('删除路径的中间值必须为映射')
+        if key not in current:
+            if strict:
+                raise KeyError(path)
+            result = factory()
+            result.update(d)
+            return result
+        if index == len(path) - 1:
+            result = factory()
+            result.update(current)
+            del result[key]
+        else:
+            parents.append((current, key))
+            current = current[key]
+    for parent, key in reversed(parents):
+        copied = factory()
+        copied.update(parent)
+        if prune and not result:
+            del copied[key]
+        else:
+            copied[key] = result
+        result = copied
+    return result
--- a/library/toolz/tests/test_development_tz_dissoc_in_dev.py
+++ b/library/toolz/tests/test_development_tz_dissoc_in_dev.py
@@ -0,0 +1,33 @@
+"""嵌套删除仅复制修改路径并支持严格和清理政策。"""
+from collections import OrderedDict
+import pytest
+from toolz import dissoc_in
+from toolz.curried import dissoc_in as curried
+
+
+def test_delete_and_share_untouched():
+    """叶子删除保持兄弟和未修改分支引用。@return None。"""
+    original = {'account': {'secret': 1, 'name': 'x'}, 'other': {'value': 2}}
+    result = dissoc_in(original, ['account', 'secret'])
+    assert result == {'account': {'name': 'x'}, 'other': {'value': 2}}
+    assert original['account']['secret'] == 1
+    assert result['other'] is original['other']
+    assert result['account'] is not original['account']
+
+
+def test_missing_prune_and_factory():
+    """缺失路径、父节点清理和映射工厂均显式。@return None。"""
+    assert dissoc_in({'a': {'b': 1}}, ['a', 'b']) == {'a': {}}
+    assert dissoc_in({'a': {'b': 1}}, ['a', 'b'], prune=True) == {}
+    with pytest.raises(KeyError):
+        dissoc_in({}, ['a'], strict=True)
+    assert isinstance(dissoc_in({'a': 1}, ['a'], factory=OrderedDict), OrderedDict)
+
+
+def test_curried_and_invalid_paths():
+    """导出可组合，空路径和标量祖先不静默处理。@return None。"""
+    assert curried({'a': 1})(['a']) == {}
+    with pytest.raises(ValueError):
+        dissoc_in({}, [])
+    with pytest.raises(TypeError):
+        dissoc_in({'a': 1}, ['a', 'b'])
