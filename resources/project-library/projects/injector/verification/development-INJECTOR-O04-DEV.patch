 singleton = ScopeDecorator(SingletonScope)
 
 
+class ContextScope(Scope):
+    """必须显式进入、按线程/异步任务归属隔离的作用域。
+
+    :param injector: 实际容器，沿用Scope协议。
+    :return: 在enter上下文内复用实际实例的Scope。
+    """
+
+    def configure(self):
+        """创建本Scope实例专属ContextVar，不共享全局缓存。@return None。"""
+        from contextvars import ContextVar
+        self._current = ContextVar('injector_context_scope', default=None)
+
+    def _owner(self):
+        """防止子任务把继承的可变缓存当成自己所有。@return 线程/任务身份。"""
+        import asyncio
+        try:
+            task = asyncio.current_task()
+        except RuntimeError:
+            task = None
+        return threading.get_ident(), id(task) if task is not None else None
+
+    def enter(self):
+        """创建一次显式可嵌套作用域，不隐式关闭业务资源。@return contextmanager。"""
+        from contextlib import contextmanager
+        @contextmanager
+        def active():
+            token = self._current.set((self._owner(), {}))
+            try:
+                yield self
+            finally:
+                self._current.reset(token)
+        return active()
+
+    def get(self, key, provider):
+        """在本任务拥有的活动域内缓存成功构造，失败不登记。
+
+        :param key: 真实绑定键。
+        :param provider: 原生Provider。
+        :return: InstanceProvider；未进入或继承其他任务状态时明确失败。
+        """
+        selected = self._current.get()
+        if selected is None or selected[0] != self._owner():
+            raise RuntimeError('ContextScope需要本任务显式进入')
+        memory = selected[1]
+        if key not in memory:
+            memory[key] = InstanceProvider(provider.get(self.injector))
+        return memory[key]
+
+
+contextscope = ScopeDecorator(ContextScope)
+
+
 class ThreadLocalScope(Scope):
