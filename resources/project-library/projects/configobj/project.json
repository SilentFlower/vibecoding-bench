  "scenarios": [
    {
      "id": "CO-S01",
      "title": "类型转换与默认发布",
      "goal": "使用现有校验和copy选项生成有效配置",
      "default_entry": "normal",
      "entries": [
        {
          "id": "normal",
          "task_ids": [
            "CO-U01",
            "CO-C01"
          ]
        }
      ],
      "tasks": [
        {
          "id": "CO-U01",
          "kind": "understand",
          "goal": "解释configspec的真实类型转换与默认插入",
          "prompt": "Trace validation of the supplied service configuration. Give actual Python types/values for port, enabled and missing workers, and explain whether validation merely reports or also mutates successful values. Do not edit files.",
          "requires": [],
          "materials": [
            "materials/service.ini",
            "materials/service.configspec",
            "materials/default-policy.md"
          ],
          "allowed_paths": [],
          "outcomes": [
            "explained"
          ],
          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/CO-U01.rubric.json",
            "semantic": true,
            "native": "verification/CO-U01.native.json"
          },
          "branches": []
        },
        {
          "id": "CO-C01",
          "kind": "consult",
          "goal": "用已有copy选项把默认写入生成配置",
          "prompt": "Explain why a readable default workers value may be absent from write() output and whether the supplied generated-output requirement needs a library patch. Compare ordinary validate and copy=True with actual defaults state. No files may be changed.",
          "requires": [],
          "materials": [
            "materials/service.ini",
            "materials/service.configspec",
            "materials/default-policy.md"
          ],
          "allowed_paths": [],
          "outcomes": [
            "advice_no_code_change"
          ],
          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/CO-C01.rubric.json",
            "semantic": true,
            "native": "verification/CO-C01.native.json"
          },
          "branches": []
        }
      ]
    },
    {
