          "id": "CO-D01",
          "kind": "diagnose",
          "goal": "先取配置和校验调用再判断启动失败",
          "prompt": "Investigate the supplied startup-validation symptom. Request actual configuration, configspec, validator setup and validation call/result or an equivalent reproduction. Diagnose disclosed evidence only, and report the evidence limit if unavailable. Do not edit files.",
          "requires": [],
          "materials": [
            "materials/startup-symptom.md"
          ],
          "allowed_paths": [],
          "outcomes": [
            "diagnosed_no_code_change",
            "insufficient_information"
          ],
          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/CO-D01.rubric.json",
            "semantic": true
          },
          "branches": [
            {
              "id": "validation-evidence",
              "when": "The actual configuration, configspec, validator setup and validation call/result have not been disclosed, the conversation does not say they are unavailable, and the answer reasonably requests a sufficient reproduction.",
              "materials": [
                "disclosure/invalid.ini",
                "disclosure/service.configspec",
                "disclosure/startup-events.md"
              ]
            }
          ]
        },
        {
          "id": "CO-U02",
          "kind": "understand",
          "goal": "解释嵌套校验错误、缺失值与真值陷阱",
          "prompt": "Trace the supplied invalid configuration using preserve_errors=True and flatten_errors. Explain exact section/key paths, the difference between missing values and present invalid values, and why if result is an unsafe success test. Do not edit files.",
          "requires": [],
          "materials": [
            "materials/invalid.ini",
            "materials/service.configspec",
            "materials/error-events.md"
          ],
          "allowed_paths": [],
          "outcomes": [
            "explained"
          ],
          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/CO-U02.rubric.json",
            "semantic": true,
            "native": "verification/CO-U02.native.json"
          },
          "branches": []
        },
        {
          "id": "CO-P01",
          "kind": "plan",
          "goal": "规划完整校验和额外键拒绝后再发布",
          "prompt": "Plan the supplied startup publication and unknown-key policy using real ConfigObj APIs. Include mutated validated values/defaults, explicit success checks, extra-key timing and structured diagnostics. No implementation is authorized.",
          "requires": [],
          "materials": [
            "materials/startup-policy.md",
            "materials/service.ini",
            "materials/service.configspec",
            "materials/error-events.md"
          ],
          "allowed_paths": [],
          "outcomes": [
            "planned_without_library_change"
          ],
          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/CO-P01.rubric.json",
            "semantic": true,
            "native": "verification/CO-P01.native.json"
          },
          "branches": []
        }
      ]
    },
