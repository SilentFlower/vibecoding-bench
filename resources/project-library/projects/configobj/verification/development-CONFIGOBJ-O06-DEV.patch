+    def validated_reload(self, validator):
+        """从原文件重建并验证，只有全部成功才接管整棵配置。
+
+        :param validator: 本次显式提供的真实验证器，不缓存为隐式全局状态。
+        :return: validate_report报告；验证失败返回valid=False且保留旧树，IO/语法错误传播。
+        """
+        from copy import deepcopy
+        if not isinstance(self.filename, str):
+            raise ReloadError()
+        options = {key: getattr(self, key) for key in OPTION_DEFAULTS if key != 'configspec'}
+        options['configspec'] = deepcopy(self._original_configspec)
+        original_file_error = options['file_error']
+        options['file_error'] = True
+        candidate = self.__class__(self.filename, **options)
+        candidate.file_error = original_file_error
+        report = candidate.validate_report(validator, apply=True)
+        if not report['valid']:
+            return report
+        # 在完成所有IO和校验后替换存储；子树必须重新指向调用者保留的根身份。
+        def rebind(section, parent, depth, name):
+            section.parent, section.main = parent, self
+            section.depth, section.name = depth, name
+            section.__dict__.pop('_interpolation_engine', None)
+            for key in section.sections:
+                rebind(dict.__getitem__(section, key), section, depth + 1, key)
+        dict.clear(self)
+        dict.update(self, dict.items(candidate))
+        self.__dict__.clear()
+        self.__dict__.update(candidate.__dict__)
+        rebind(self, self, 0, self.name)
+        return report
+
