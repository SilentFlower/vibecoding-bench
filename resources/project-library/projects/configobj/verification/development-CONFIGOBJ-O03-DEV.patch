+    def write_atomic(self, filename=None):
+        """完整序列化后在同目录原子替换，不改变现有流write协议。
+
+        :param filename: 可选目标路径；默认使用self.filename。
+        :return: 发布后的绝对目标路径；不声称断电持久或跨文件事务。
+        """
+        from copy import deepcopy
+        from io import BytesIO
+        from pathlib import Path
+        import stat
+        import tempfile
+        destination = self.filename if filename is None else filename
+        if destination is None:
+            raise ValueError('原子发布需要明确文件名')
+        path = Path(destination).absolute()
+        if path.is_symlink():
+            raise ValueError('原子发布不跟随符号链接')
+        # 在打开临时文件之前序列化，编码或引号错误不能触碰目标。
+        buffer = BytesIO()
+        deepcopy(self).write(outfile=buffer)
+        payload = buffer.getvalue()
+        previous_mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
+        descriptor, temporary = tempfile.mkstemp(prefix='.' + path.name + '.', suffix='.tmp', dir=path.parent)
+        try:
+            with os.fdopen(descriptor, 'wb') as output:
+                output.write(payload)
+                output.flush()
+                os.fchmod(output.fileno(), previous_mode)
+            os.replace(temporary, path)
+        finally:
+            if os.path.exists(temporary):
+                os.unlink(temporary)
+        return path
+
