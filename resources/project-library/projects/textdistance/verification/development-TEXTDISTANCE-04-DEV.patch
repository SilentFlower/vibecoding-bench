+"""带权编辑距离，方向成本明确且不改变原单位成本算法。"""
+import math
+from .algorithms.edit_based import Levenshtein
+
+
+class WeightedLevenshtein:
+    """插入、删除、替换可用非负有限常数或回调。@param insertion 插入成本。@param deletion 删除成本。@param substitution 替换成本。@param qval 原生单位。@param test_func 相等谓词。"""
+    def __init__(self,insertion=1,deletion=1,substitution=1,qval=1,test_func=None):
+        """保存独立成本政策。@param insertion 插入。@param deletion 删除。@param substitution 替换。@param qval 单位。@param test_func 谓词。@return None。"""
+        self.insertion,self.deletion,self.substitution=insertion,deletion,substitution
+        self.preparer=Levenshtein(qval=qval,test_func=test_func,external=False)
+        for cost in (insertion,deletion,substitution):
+            if not callable(cost):self._cost(cost)
+
+    @staticmethod
+    def _cost(policy,*tokens):
+        """每次真实使用成本时检查，避免负权破坏DP。@param policy 常数或回调。@param tokens 单元。@return 非负成本。"""
+        value=policy(*tokens) if callable(policy) else policy
+        if isinstance(value,bool) or not isinstance(value,(int,float)) or not math.isfinite(value) or value<0:raise ValueError('成本必须非负且有限')
+        return value
+
+    def __call__(self,left,right):
+        """计算从left到right的最小总编辑成本。@param left 源。@param right 目标。@return 最小成本。"""
+        left,right=self.preparer._get_sequences(left,right)
+        previous=[0]
+        for token in right:previous.append(previous[-1]+self._cost(self.insertion,token))
+        for source in left:
+            current=[previous[0]+self._cost(self.deletion,source)]
+            for index,target in enumerate(right,1):
+                replace=0 if self.preparer.test_func(source,target) else self._cost(self.substitution,source,target)
+                current.append(min(previous[index]+self._cost(self.deletion,source),current[-1]+self._cost(self.insertion,target),previous[index-1]+replace))
+            previous=current
+        return previous[-1]
+
+    def distance(self,left,right):
+        """明确方向的距离别名。@param left 源。@param right 目标。@return 成本。"""
+        return self(left,right)
