+class IncrementalParser:
+    """显式生命周期的单文档增量解析，不启动线程或预消费后续块。"""
+    def __init__(self,encoding=None,*,process_namespaces=False,namespace_separator=':',disable_entities=True,process_comments=False,**kwargs):
+        """建立解析器。@param encoding 编码。@param kwargs 原handler选项及资源预算。
+        @param process_namespaces 是否展开命名空间。@param namespace_separator 分隔符。
+        @param disable_entities 是否禁用实体。@param process_comments 是否保留注释。@return None。
+        """
+        self._handler=_DictSAXHandler(namespace_separator=namespace_separator,**kwargs)
+        self._parser=expat.ParserCreate(encoding,namespace_separator if process_namespaces else None)
+        self._parser.ordered_attributes=True
+        self._parser.StartNamespaceDeclHandler=self._handler.startNamespaceDecl
+        self._parser.StartElementHandler=self._handler.startElement
+        self._parser.EndElementHandler=self._handler.endElement
+        self._parser.CharacterDataHandler=self._handler.characters
+        if process_comments:
+            self._parser.CommentHandler=self._handler.comments
+        self._parser.buffer_text=True
+        if disable_entities:
+            def forbidden(*args):
+                raise ValueError('entities are disabled')
+            self._parser.EntityDeclHandler=forbidden
+        self._kind=None
+        self._closed=False
+        self._failed=False
+
+    def feed(self,chunk):
+        """提交一个完整输入块。@param chunk 始终同类的bytes或str。@return None。
+        """
+        if self._closed or self._failed:
+            raise RuntimeError('解析器已结束或失败')
+        if type(chunk) not in (str,bytes) or self._kind is not None and type(chunk) is not self._kind:
+            raise TypeError('增量输入必须使用一致的bytes或str')
+        self._kind=type(chunk)
+        try:
+            self._parser.Parse(chunk,False)
+        except BaseException:
+            self._failed=True
+            raise
+
+    def close(self):
+        """完成XML文档。@return 原parse同款结果；成功后可重复读取，失败后不可复用。
+        """
+        if self._failed:
+            raise RuntimeError('失败解析器不能重新完成')
+        if not self._closed:
+            try:
+                self._parser.Parse('' if self._kind is str else b'',True)
+            except BaseException:
+                self._failed=True
+                raise
+            self._closed=True
+        return self._handler.item
 
 
