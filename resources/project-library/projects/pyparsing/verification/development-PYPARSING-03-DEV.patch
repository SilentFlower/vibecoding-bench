+"""地区数值按明确字符规则解析为精确Decimal，不读取宿主locale。"""
+import re
+from decimal import Decimal
+from .core import Regex
+
+def localized_decimal(*,decimal_separator='.',group_separator=None,group_size=3,max_fraction=None):
+    """构建数值语法。@param decimal_separator 小数点。@param group_separator 可选分组符。@param group_size 组宽。@param max_fraction 可选最大小数位。@return 真实ParserElement，结果为Decimal。"""
+    if not isinstance(decimal_separator,str) or len(decimal_separator)!=1 or decimal_separator.isdigit() or decimal_separator in '+-':raise ValueError('小数符无效')
+    if group_separator is not None and (not isinstance(group_separator,str) or len(group_separator)!=1 or group_separator==decimal_separator or group_separator.isdigit() or group_separator in '+-'):raise ValueError('分组符无效')
+    if type(group_size) is not int or group_size<1:raise ValueError('分组宽度无效')
+    if max_fraction is not None and (type(max_fraction) is not int or max_fraction<0):raise ValueError('小数位数无效')
+    integer=r'[0-9]+'
+    if group_separator is not None:
+        grouped=r'[0-9]{1,'+str(group_size)+'}(?:'+re.escape(group_separator)+r'[0-9]{'+str(group_size)+'})+'
+        integer='(?:'+grouped+'|'+integer+')'
+    fractional=r'[0-9]+' if max_fraction is None else r'[0-9]{1,'+str(max_fraction)+'}'
+    suffix='' if max_fraction==0 else '(?:'+re.escape(decimal_separator)+fractional+')?'
+    pattern='[+-]?'+integer+suffix
+    def convert(tokens):
+        """只转换已匹配文本。@return 精确Decimal。"""
+        text=tokens[0]
+        if group_separator is not None:text=text.replace(group_separator,'')
+        return Decimal(text.replace(decimal_separator,'.'))
+    return Regex(pattern).set_parse_action(convert)
