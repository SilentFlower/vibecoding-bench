+"""按CSV逻辑记录切片，保留原生读取和写出选项。"""
+from collections import deque
+from itertools import islice
+import agate
+from csvkit.cli import CSVKitUtility
+
+
+class CSVSlice(CSVKitUtility):
+    """对逻辑数据记录切片；不按物理换行拆坏带引号字段。"""
+    description = '按逻辑CSV记录选择区间或有界末尾，不改变字段内容。'
+    override_flags = ['L', 'I']
+
+    def add_arguments(self):
+        """注册切片参数，沿用原通用CSV选项。@return None。"""
+        self.argparser.add_argument('--start', type=int, default=0)
+        self.argparser.add_argument('--stop', type=int)
+        self.argparser.add_argument('--step', type=int, default=1)
+        self.argparser.add_argument('--tail', type=int)
+        self.argparser.set_defaults(columns=None)
+
+    def main(self):
+        """输出一份表头及被选中的完整逻辑记录。@return None。"""
+        if self.args.start < 0 or (self.args.stop is not None and self.args.stop < 0) or self.args.step < 1 or (self.args.tail is not None and self.args.tail < 0):
+            self.argparser.error('start/stop/tail必须非负，step必须大于零')
+        if self.args.tail is not None and (self.args.start != 0 or self.args.stop is not None or self.args.step != 1):
+            self.argparser.error('tail不能与区间参数组合')
+        rows, names, columns = self.get_rows_and_column_names_and_column_ids(**self.reader_kwargs)
+        writer = agate.csv.writer(self.output_file, **self.writer_kwargs)
+        if names:
+            writer.writerow(names)
+        if self.args.tail is None:
+            selected = islice(rows, self.args.start, self.args.stop, self.args.step)
+        elif self.args.tail == 0:
+            selected = ()
+        else:
+            selected = deque(rows, maxlen=self.args.tail)
+        writer.writerows(selected)
+
+
+def launch_new_instance():
+    """作为模块启动真实CSVKitUtility。@return None。"""
+    CSVSlice().run()
+
+
+if __name__ == '__main__':
+    launch_new_instance()
