+    def read_hashes(self,algorithms,*,chunk_size=8192,hex=True):
+        """一次读取计算多个定长摘要。@param algorithms 算法名序列。@param chunk_size 正整数。
+        @param hex 返回十六进制或原始字节。@return 算法名到摘要的保序映射，重复名称只算一次。
+        """
+        if isinstance(algorithms,str) or type(chunk_size) is not int or chunk_size<1 or type(hex) is not bool:
+            raise ValueError('摘要算法序列、块大小或输出类型无效')
+        names=tuple(dict.fromkeys(algorithms))
+        if not names:
+            raise ValueError('至少需要一个摘要算法')
+        digests={name:hashlib.new(name) for name in names}
+        if any(digest.digest_size==0 for digest in digests.values()):
+            raise ValueError('可变长度摘要需要独立长度协议，不适用于此接口')
+        with self.open('rb') as stream:
+            while True:
+                chunk=stream.read(chunk_size)
+                if not chunk:
+                    break
+                for digest in digests.values():
+                    digest.update(chunk)
+        return {name:digest.hexdigest() if hex else digest.digest() for name,digest in digests.items()}
+
