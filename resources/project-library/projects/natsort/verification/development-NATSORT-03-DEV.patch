+# 单次输入的稳定自然序前K与原索引选择
+
+路线15：只保存前K候选而不物化全输入；升降序和平手次序与natsorted一致，可返回原位置，零数量完全不消费输入。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/natsort/topk.py
+++ b/library/natsort/topk.py
@@ -0,0 +1,18 @@
+"""与全量自然排序一致的有界前K选择。"""
+from heapq import nlargest, nsmallest
+from natsort import natsort_keygen, ns
+
+
+def natural_topk(iterable, count, *, key=None, alg=ns.DEFAULT, reverse=False, indices=False):
+    """以O(K)选择存储返回稳定前K项。@param iterable 单次输入。@param count 数量。@param key 提取器。@param alg 原生算法。@param reverse 取降序。@param indices 返回原索引。@return 列表。"""
+    if type(count) is not int or count<0:
+        raise ValueError('数量必须是非负整数')
+    if count==0:
+        return []
+    natural=natsort_keygen(key=key,alg=alg)
+    decorated=enumerate(iterable)
+    if reverse:
+        selected=nlargest(count,decorated,key=lambda item:(natural(item[1]),-item[0]))
+    else:
+        selected=nsmallest(count,decorated,key=lambda item:(natural(item[1]),item[0]))
+    return [index if indices else value for index,value in selected]
--- a/library/tests/test_development_natsort_03_dev.py
