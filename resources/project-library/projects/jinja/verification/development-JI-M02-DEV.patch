+def test_async_map_explicit_none_regression(run_async_fn):
+    """真实异步渲染保留显式None和已有值。@param run_async_fn 两种上游执行器。@return None。"""
+    async def check():
+        env = Environment(enable_async=True)
+        captured = []
+        env.filters["capture_values"] = lambda values: captured.extend(values) or ""
+        template = env.from_string('{{ rows|map(attribute="field", default=none)|list|capture_values }}')
+        await template.render_async(rows=[{}, {"field": None}, {"field": False}, {"field": 0}, {"field": ""}])
+        assert captured == [None, None, False, 0, ""]
+        assert [type(value) for value in captured] == [type(None), type(None), bool, int, str]
+
+    run_async_fn(check)
