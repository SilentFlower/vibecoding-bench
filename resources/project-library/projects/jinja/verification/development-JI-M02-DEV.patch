+def test_urlencode_standard_mapping_regression():
+    """标准Mapping按items编码，同时保留重复pair和路径。@return None。"""
+    from collections import UserDict
+    from urllib.parse import parse_qsl
+    from jinja2.filters import do_urlencode
+
+    value = UserDict({"q": "A+1 & /", "中文": "值", "": ""})
+    assert parse_qsl(do_urlencode(value), keep_blank_values=True) == list(value.items())
+    assert do_urlencode([("q", "a"), ("q", "b")]) == "q=a&q=b"
+    assert do_urlencode("a/b c") == "a/b%20c"
+
+
+def test_map_explicit_none_regression():
+    """显式None与省略default区分且不替换已有假值。@return None。"""
+    from jinja2 import Undefined
+
+    env = Environment()
+    rows = [{}, {"field": None}, {"field": False}, {"field": 0}, {"field": ""}]
+    values = env.compile_expression("rows|map(attribute='field', default=none)|list")(rows=rows)
+    assert values == [None, None, False, 0, ""]
+    assert [type(value) for value in values] == [type(None), type(None), bool, int, str]
+    omitted = env.compile_expression("rows|map(attribute='field')|list", undefined_to_none=False)(rows=rows)
+    assert isinstance(omitted[0], Undefined)
