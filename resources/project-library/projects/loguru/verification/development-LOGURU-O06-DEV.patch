+class LazyValue:
+    """按单条日志事件惰性计算参数，不跨事件缓存业务值。
+
+    :param function: 无参业务计算函数。
+    :return: 可与普通格式化参数混用的公开包装器。
+    """
+    def __init__(self, function):
+        """验证函数，不提前求值。@return None。"""
+        if not callable(function):
+            raise TypeError('LazyValue需要可调用函数')
+        self.function = function
+
+
+class _EventLazy:
+    """一个事件内的求值单元，重复占位与多sink共享首次结果。"""
+    def __init__(self, source):
+        self.source = source
+        self.ready = False
+        self.value = None
+
+    def _value(self):
+        """仅首次实际读取时求值。@return 业务结果。"""
+        if not self.ready:
+            self.value = self.source.function()
+            self.ready = True
+        return self.value
+
+    def __format__(self, spec):
+        """沿标准format_spec格式化实际值。@return 字符串。"""
+        return format(self._value(), spec)
+
+    def __str__(self):
+        """支持标准!s转换。@return 字符串。"""
+        return str(self._value())
+
+    def __repr__(self):
+        """支持标准!r转换。@return repr字符串。"""
+        return repr(self._value())
+
+    def __getattr__(self, name):
+        """支持格式字段的属性访问。@return 实际属性。"""
+        return getattr(self._value(), name)
+
+    def __getitem__(self, key):
+        """支持格式字段的下标访问。@return 实际子项。"""
+        return self._value()[key]
+
 
