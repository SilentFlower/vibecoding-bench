+"""集中检查当前生成方法的实际源代码，不执行方法或导出闭包值。"""
+import inspect
+from types import MappingProxyType
+
+from ._make import fields
+
+
+def generated_sources(cls, names=None):
+    """查看实际生成方法。@param cls attrs类。@param names 可选方法名列表或元组。
+    @return 两层只读映射，含generated/status/source/filename/owner。
+    """
+    fields(cls)
+    if names is None:
+        names = sorted({name for owner in cls.__mro__ for name, value in owner.__dict__.items()
+            if hasattr(value, '__code__') and value.__code__.co_filename.startswith('<attrs generated ')})
+    if not isinstance(names, (list,tuple)) or any(not isinstance(name,str) for name in names):
+        raise TypeError('方法名必须是有限字符串序列')
+    if len(set(names)) != len(names):
+        raise ValueError('方法名不得重复')
+    result = {}
+    for name in names:
+        owner = next((base for base in cls.__mro__ if name in base.__dict__), None)
+        function = owner.__dict__[name] if owner is not None else None
+        if isinstance(function, (classmethod,staticmethod)):
+            function = function.__func__
+        code = getattr(function, '__code__', None)
+        filename = code.co_filename if code is not None else None
+        generated = filename is not None and filename.startswith('<attrs generated ')
+        source, status = None, 'missing' if owner is None else 'custom'
+        if generated:
+            try:
+                source = inspect.getsource(function)
+                status = 'available'
+            except (OSError,TypeError):
+                status = 'unavailable'
+        result[name] = MappingProxyType({'generated':generated,'status':status,'source':source,
+            'filename':filename,'owner':None if owner is None else owner.__module__ + '.' + owner.__qualname__})
+    return MappingProxyType(result)
