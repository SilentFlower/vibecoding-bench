+++ b/library/src/attr/validation.py
@@ -0,0 +1,44 @@
+"""显式收集独立字段的验证报告，不改变原fail-fast验证入口。"""
+from typing import NamedTuple
+
+from ._config import get_run_validators
+from ._make import Attribute, fields
+
+
+class ValidationIssue(NamedTuple):
+    """字段错误。@param field_name 真实字段名。@param attribute 原Attribute。@param error 原异常对象。"""
+    field_name: str
+    attribute: Attribute
+    error: Exception
+
+
+class MultiValidationError(ValueError):
+    """多字段验证错误。@param issues 保留顺序与原异常的报告。"""
+
+    def __init__(self, issues):
+        """保存独立报告。@param issues 字段错误序列。@return None。"""
+        self.issues = tuple(issues)
+        super().__init__('多个模型字段未通过验证')
+
+
+def validate_all(instance, *, raise_errors=False):
+    """收集每字段首次验证错误。@param instance attrs实例。@param raise_errors 是否聚合抛错。
+    @return 按声明顺序排列的ValidationIssue元组。
+    """
+    if type(raise_errors) is not bool:
+        raise TypeError('报告抛错模式必须是布尔值')
+    attributes = fields(type(instance))
+    if not get_run_validators():
+        return ()
+    issues = []
+    for attribute in attributes:
+        if attribute.validator is None:
+            continue
+        try:
+            attribute.validator(instance, attribute, getattr(instance, attribute.name))
+        except Exception as error:
+            # 组合验证器保留原fail-fast及一次消费语义，继续的是其他独立字段。
+            issues.append(ValidationIssue(attribute.name, attribute, error))
+    if issues and raise_errors:
+        raise MultiValidationError(issues)
+    return tuple(issues)
