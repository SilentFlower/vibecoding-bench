+"""按字段身份及目标初始化别名演化模型，不修改源实例。"""
+from ._make import fields
+
+
+def evolve_as(instance, target_class, **changes):
+    """演化为显式目标类。@param instance 原实例。@param target_class attrs目标类。
+    @param changes 目标初始化别名到新值。@return 经过目标标准构造和验证的新实例。
+    """
+    source_fields = {field.name: field for field in fields(type(instance)) if field.init}
+    target_fields = [field for field in fields(target_class) if field.init]
+    aliases = [field.alias for field in target_fields]
+    if len(set(aliases)) != len(aliases):
+        raise TypeError('目标初始化别名冲突')
+    if set(changes) - set(aliases):
+        raise TypeError('包含目标未声明的初始化参数')
+    common = set(source_fields) & {field.name for field in target_fields}
+    if not common and not (issubclass(target_class, type(instance)) or issubclass(type(instance), target_class)):
+        raise TypeError('不相关目标没有可演化的公共字段')
+    values = dict(changes)
+    for field in target_fields:
+        if field.alias not in values and field.name in common:
+            values[field.alias] = getattr(instance, field.name)
+    return target_class(**values)
