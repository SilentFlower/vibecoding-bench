+"""显式RST分段列表，复用真实表格节点及行内解析，不改普通冒号文本。"""
+import csv
+from docutils import nodes
+from docutils.parsers.rst import Directive, directives
+
+
+class SegmentedList(Directive):
+    """使用竖线CSV行与必需columns标题生成有语义的真实表格。
+
+    :param arguments: 可选表格标题。
+    :return: table节点及真实行内诊断列表。
+    """
+    optional_arguments = 1
+    final_argument_whitespace = True
+    option_spec = {'columns': directives.unchanged_required,
+                   'class': directives.class_option, 'name': directives.unchanged}
+    has_content = True
+
+    def run(self):
+        """验证列数后构造tgroup/thead/tbody及真实格式化单元格。@return 节点列表。"""
+        self.assert_has_content()
+        if 'columns' not in self.options:
+            raise self.error('segmented-list必须提供columns')
+        try:
+            headings = next(csv.reader([self.options['columns']], delimiter='|', skipinitialspace=True, strict=True))
+            records = list(csv.reader(self.content, delimiter='|', skipinitialspace=True, strict=True))
+        except (csv.Error, StopIteration) as error:
+            raise self.error('分段列表CSV语法错误: ' + str(error))
+        if not headings or any(not value.strip() for value in headings):
+            raise self.error('分段列表列标题不能为空')
+        records = [record for record in records if record]
+        if any(len(record) != len(headings) for record in records):
+            raise self.error('分段列表每行列数必须与columns一致')
+        table = nodes.table(classes=self.options.get('class', []))
+        table.source, table.line = self.state_machine.get_source_and_line(self.lineno)
+        self.add_name(table)
+        messages = []
+        if self.arguments:
+            text, more = self.state.inline_text(self.arguments[0], self.lineno)
+            table += nodes.title(self.arguments[0], '', *text);messages.extend(more)
+        group = nodes.tgroup(cols=len(headings));table += group
+        for unused in headings:group += nodes.colspec(colwidth=1)
+        head = nodes.thead();body = nodes.tbody();group += head;group += body
+        for index, record in enumerate([headings] + records):
+            row = nodes.row();(head if index == 0 else body).append(row)
+            for value in record:
+                entry = nodes.entry();row += entry
+                text, more = self.state.inline_text(value.strip(), self.content_offset + index + 1)
+                entry += nodes.paragraph(value, '', *text);messages.extend(more)
+        return [table] + messages
