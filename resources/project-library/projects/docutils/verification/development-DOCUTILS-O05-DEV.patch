+"""真实Docutils JSON writer，复用受约束版本化树交换合同。"""
+from docutils import writers
+from docutils.doctree_json import dumps
+
+
+class Writer(writers.Writer):
+    """发布标准doctree的JSON结构。@return schema=1文本。"""
+    supported=('json',)
+    def translate(self):
+        """序列化当前真实document，不执行任意属性对象。@return None。"""
+        self.output=dumps(self.document)
