+"""版本化标准doctree JSON交换，不使用pickle或从输入导入Python代码。"""
+import json
+import math
+from docutils import nodes
+from docutils.utils import new_document
+
+SUPPORTED = frozenset(('document section title subtitle paragraph emphasis strong literal literal_block reference target '
+    'bullet_list enumerated_list list_item block_quote attribution figure image caption table tgroup colspec thead tbody row entry '
+    'footnote label footnote_reference citation citation_reference rubric container transition note warning admonition field_list field '
+    'field_name field_body definition_list definition_list_item term definition classifier math math_block inline raw comment').split())
+
+
+def _json_value(value, depth=0):
+    """只允许明确JSON数据，拒绝任意Python属性或过深容器。@return 独立JSON值。"""
+    if depth > 64:
+        raise ValueError('属性容器过深')
+    if value is None or type(value) in (str,bool,int):return value
+    if type(value) is float and math.isfinite(value):return value
+    if type(value) in (list,tuple):return [_json_value(item,depth+1) for item in value]
+    if type(value) is dict and all(type(key) is str for key in value):return {key:_json_value(item,depth+1) for key,item in value.items()}
+    raise ValueError('属性包含非JSON数据')
+
+
+def to_data(document, *, max_depth=64, max_nodes=10000):
+    """编码允许的真实标准节点及来源，不读取settings/reporter任意对象。
+
+    :param document: 原doctree根。
+    :param max_depth: 最大节点深度。
+    :param max_nodes: 最大节点总数。
+    :return: schema=1及root结构，不改变原树。
+    """
+    if not isinstance(document,nodes.document):raise TypeError('根必须为document')
+    seen=set()
+    def encode(node,depth):
+        """按真实节点身份检测循环/共享及预算。@return 节点数据。"""
+        if depth>max_depth or len(seen)>=max_nodes or id(node) in seen:raise ValueError('doctree循环、共享或超预算')
+        seen.add(id(node))
+        if isinstance(node,nodes.Text):return {'node':'#text','text':node.astext()}
+        name=type(node).__name__
+        if name not in SUPPORTED:raise ValueError('不支持的节点: '+name)
+        return {'node':name,'rawsource':node.rawsource,'source':node.source,'line':node.line,
+                'attributes':_json_value(node.attributes),'children':[encode(child,depth+1) for child in node.children]}
+    return {'schema':1,'root':encode(document,0)}
+
+
+def from_data(data, *, settings=None, max_depth=64, max_nodes=10000):
+    """只从白名单结构创建标准节点，重建真实ID映射。
+
+    :param data: schema=1数据，不接受任意类名或额外节点字段。
+    :param settings: 调用方明确提供的原Docutils设置。
+    :return: 新document，节点/属性/来源与原输入脱离。
+    """
+    if type(data) is not dict or set(data)!={'schema','root'} or type(data['schema']) is not int or data['schema']!=1:raise ValueError('未知doctree JSON schema')
+    root=data['root'];count=0
+    if not isinstance(root,dict) or root.get('node')!='document':raise ValueError('根必须为document')
+    document=new_document(root.get('source') or '<json-doctree>',settings=settings)
+    def decode(item,depth):
+        """验证完整节点形状后使用已允许的标准构造函数。@return 新节点。"""
+        nonlocal count
+        count+=1
+        if depth>max_depth or count>max_nodes or type(item) is not dict:raise ValueError('doctree结构或预算错误')
+        name=item.get('node')
+        if name=='#text':
+            if set(item)!={'node','text'} or not isinstance(item['text'],str):raise ValueError('文本节点错误')
+            return nodes.Text(item['text'])
+        if name not in SUPPORTED or set(item)!={'node','rawsource','source','line','attributes','children'}:raise ValueError('未知或畸形标准节点')
+        if not isinstance(item['rawsource'],str) or item['source'] is not None and not isinstance(item['source'],str):raise ValueError('来源类型错误')
+        if item['line'] is not None and (isinstance(item['line'],bool) or not isinstance(item['line'],int) or item['line']<0):raise ValueError('来源行类型错误')
+        if type(item['attributes']) is not dict or type(item['children']) is not list:raise ValueError('节点属性或子节点错误')
+        attributes=_json_value(item['attributes'])
+        if name=='document':
+            if depth!=0:raise ValueError('document只能为根')
+            node=document;node.attributes=attributes
+        else:node=getattr(nodes,name)(rawsource=item['rawsource'],**attributes)
+        node.rawsource=item['rawsource'];node.source=item['source'];node.line=item['line'];node._document=document
+        for child in item['children']:node.append(decode(child,depth+1))
+        return node
+    decode(root,0)
+    document.ids.clear();document.nameids.clear()
+    for node in document.findall(nodes.Element):
+        for identifier in node.get('ids',[]):
+            if not isinstance(identifier,str) or identifier in document.ids:raise ValueError('重复或非法ID')
+            document.ids[identifier]=node
+        for name in node.get('names',[]):
+            if node.get('ids'):document.nameids[name]=node['ids'][0]
+    return document
+
+
+def dumps(document, **kwargs):
+    """编码为确定UTF8可读JSON文本。@param document 树。@return JSON字符串。"""
+    return json.dumps(to_data(document,**kwargs),ensure_ascii=False,sort_keys=True,separators=(',',':'),allow_nan=False)
+
+
+def loads(text, **kwargs):
+    """读取受约束JSON树。@param text JSON文本。@return 新document。"""
+    return from_data(json.loads(text),**kwargs)
