+    def query_page(self, cond=None, *, limit=100, after=None):
+        """按整数文档ID游标分页。@param cond 可选筛选查询。@param limit 1至1000。
+        @param after 上页最后ID或None。@return (独立Document列表,有后续时的最后ID或None)。
+        """
+        from copy import deepcopy
+
+        if type(limit) is not int or not 1 <= limit <= 1000:
+            raise ValueError('分页大小必须为1至1000的整数')
+        if after is not None and (type(after) is not int or after < 0):
+            raise ValueError('游标必须为非负整数或None')
+        if cond is not None and not callable(cond):
+            raise TypeError('筛选条件必须可调用')
+        rows = []
+        for doc_id, value in sorted((self.document_id_class(key), value) for key, value in self._read_table().items()):
+            if after is not None and doc_id <= after:
+                continue
+            document = self.document_class(deepcopy(value), doc_id)
+            if cond is None or cond(document):
+                rows.append(document)
+                if len(rows) > limit:
+                    return rows[:limit], rows[limit - 1].doc_id
+        return rows, None
 
