 from collections.abc import Callable, MutableMapping
 from typing import Any, Union
+
+
+def set_path(path, value, *, create=False):
+    """建立嵌套字段更新操作。@param path 字符串键序列。@param value 每文档独立深拷贝的新值。
+    @param create 是否创建缺失中间映射。@return 可交给Table.update的原地回调。
+    """
+    from copy import deepcopy
+    if isinstance(path, (str, bytes)):
+        raise TypeError('嵌套路径必须是键序列')
+    parts = tuple(path)
+    if not parts or any(not isinstance(part, str) for part in parts):
+        raise ValueError('嵌套路径必须包含字符串键')
+    frozen = deepcopy(value)
+    def transform(doc):
+        working = deepcopy(doc)
+        target = working
+        for part in parts[:-1]:
+            if part not in target:
+                if not create:
+                    raise KeyError(part)
+                target[part] = {}
+            target = target[part]
+            if not isinstance(target, MutableMapping):
+                raise TypeError('路径中间值必须是可变映射')
+        target[parts[-1]] = deepcopy(frozen)
+        doc.clear()
+        doc.update(working)
+    return transform
+
+
+def delete_path(path, *, missing_ok=False):
+    """建立嵌套删除操作。@param path 字符串键序列。@param missing_ok 是否忽略缺失。
+    @return Table.update回调；失败不修改本次文档。
+    """
+    from copy import deepcopy
+    if isinstance(path, (str, bytes)):
+        raise TypeError('嵌套路径必须是键序列')
+    parts = tuple(path)
+    if not parts or any(not isinstance(part, str) for part in parts):
+        raise ValueError('嵌套路径必须包含字符串键')
+    def transform(doc):
+        working, target = deepcopy(doc), None
+        target = working
+        try:
+            for part in parts[:-1]:
+                target = target[part]
+                if not isinstance(target, MutableMapping):
+                    raise TypeError('路径中间值必须是可变映射')
+            del target[parts[-1]]
+        except KeyError:
+            if missing_ok:
+                return
+            raise
+        doc.clear()
+        doc.update(working)
+    return transform
 
 
