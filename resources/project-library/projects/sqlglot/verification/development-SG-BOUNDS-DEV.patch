+# 对最终查询结果施加独立行数边界而保留内部LIMIT语义
+
+在查询外层限制最终结果，不能覆盖内部原有分页或只给UNION单侧加限制。零行上限合法，偏移与类型严格校验，使用真实语法树生成各方言，原AST不变。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/sqlglot/report_bounds.py
+++ b/library/sqlglot/report_bounds.py
@@ -0,0 +1,18 @@
+"""通过外层查询限制最终结果，不覆盖内部集合或已有分页。"""
+from . import exp
+from .report_inspection import query_copy
+
+
+def bounded_query(query,max_rows,*,offset=0,dialect=None):
+    """包装最终结果行数上限。@param query 原单查询。@param max_rows 非负整数上限。
+    @param offset 非负结果偏移。@param dialect 输入方言。@return 独立外层Select。
+    不承诺跨方言隐含顺序；调用者需要确定顺序时须在业务查询中显式排序。
+    """
+    if type(max_rows) is not int or max_rows<0 or type(offset) is not int or offset<0:
+        raise ValueError('行数和偏移必须为非负整数')
+    original=query_copy(query,dialect)
+    result=exp.Select(expressions=[exp.Star()]).from_(original.subquery(alias='__report_limit'))
+    result=result.limit(max_rows)
+    if offset:
+        result=result.offset(offset)
+    return result
