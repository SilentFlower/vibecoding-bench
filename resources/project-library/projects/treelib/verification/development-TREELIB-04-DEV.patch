+"""办公CSV节点交换，使用已验全量映射导入而非静默丢弃记录。"""
+import csv
+import io
+import json
+from .tree import Tree
+
+
+def read_csv(stream,tree_class=Tree,**tree_kwargs):
+    """读取id,parent,tag,data节点表。@param stream 文本流。@param tree_class 显式树类。@param tree_kwargs 构造参数。@return 完整新树。"""
+    reader=csv.DictReader(stream)
+    if reader.fieldnames!=['id','parent','tag','data']:raise ValueError('CSV列必须是id,parent,tag,data且顺序唯一')
+    rows={}
+    for row in reader:
+        if set(row)!={'id','parent','tag','data'} or any(value is None for value in row.values()):raise ValueError('CSV列数不匹配')
+        identity=row['id']
+        if not identity or identity in rows:raise ValueError('CSV标识为空或重复')
+        rows[identity]=row
+    # 复用前置完整图预检，乱序、离线环及孤儿不会被静默遗漏。
+    mapping={identity:(row['parent'] or None) for identity,row in rows.items()}
+    data={identity:json.loads(row['data']) for identity,row in rows.items()}
+    tree=tree_class.from_map(mapping,data_func=lambda identity:data[identity],**tree_kwargs)
+    for identity,row in rows.items():tree[identity].tag=row['tag']
+    return tree
+
+
+def write_csv(tree,stream):
+    """按原兄弟顺序输出全部节点，包括折叠后代。@param tree 完整树。@param stream 文本流。@return None。"""
+    writer=csv.writer(stream,lineterminator='\n');writer.writerow(['id','parent','tag','data'])
+    pending=[tree.root] if tree.root is not None else []
+    seen=set()
+    while pending:
+        identity=pending.pop()
+        if identity in seen:raise ValueError('树含重复关系或环')
+        seen.add(identity);node=tree[identity]
+        writer.writerow([identity,node.predecessor(tree.identifier) or '',node.tag,json.dumps(node.data,ensure_ascii=False,allow_nan=False)])
+        pending.extend(reversed(node.successors(tree.identifier)))
+    if len(seen)!=len(tree):raise ValueError('树含不可达节点')
