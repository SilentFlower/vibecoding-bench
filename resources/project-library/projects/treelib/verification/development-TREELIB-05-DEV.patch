@@ -0,0 +1,39 @@
+"""只读诊断当前tree_id下的真实结构，不自动修复业务存档。"""
+
+
+def validate_structure(tree):
+    """返回可定位的结构问题。@param tree 真实Tree。@return 稳定诊断字典列表。"""
+    findings=[]
+    def add(code,identity,related=None):
+        """记录结构证据。@param code 原因。@param identity 节点。@param related 相关标识。@return None。"""
+        findings.append({'code':code,'id':identity,'related':related})
+    if not tree.nodes:
+        if tree.root is not None:add('empty_root',tree.root)
+        return findings
+    if tree.root not in tree.nodes:add('missing_root',tree.root)
+    for identity,node in tree.nodes.items():
+        if identity!=node.identifier:add('index_identity',identity,node.identifier)
+        parent=node.predecessor(tree.identifier)
+        if identity==tree.root and parent is not None:add('root_parent',identity,parent)
+        elif identity!=tree.root:
+            if parent not in tree.nodes:add('missing_parent',identity,parent)
+            elif identity not in tree[parent].successors(tree.identifier):add('missing_backlink',identity,parent)
+        seen=set()
+        for child in node.successors(tree.identifier):
+            if child in seen:add('duplicate_child',identity,child)
+            seen.add(child)
+            if child not in tree.nodes:add('missing_child',identity,child)
+            elif tree[child].predecessor(tree.identifier)!=identity:add('child_parent_mismatch',identity,child)
+    visited=set();active=set()
+    # 显式入/出栈避免深树递归上限，同时能区分路径内环和普通已访问关系。
+    pending=[(tree.root,False)] if tree.root in tree.nodes else []
+    while pending:
+        identity,leaving=pending.pop()
+        if leaving:active.discard(identity);continue
+        if identity in active:add('cycle',identity);continue
+        if identity in visited or identity not in tree.nodes:continue
+        visited.add(identity);active.add(identity);pending.append((identity,True))
+        pending.extend((child,False) for child in reversed(tree[identity].successors(tree.identifier)))
+    for identity in tree.nodes:
+        if identity not in visited:add('unreachable',identity)
+    return findings
