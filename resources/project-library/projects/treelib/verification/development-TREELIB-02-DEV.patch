+    def update_node(self, nid, **attrs):
+        """预检冲突并以可回滚结构更新节点。@param nid 当前标识。@param attrs 节点属性。@return None。"""
+        node=self[nid]
+        destination=attrs.get('identifier',nid)
+        if destination is None:raise ValueError('标识不能为None')
+        try:hash(destination)
+        except TypeError as error:raise ValueError('标识必须可哈希') from error
+        if destination!=nid:
+            if destination in self._nodes:raise DuplicatedNodeIdError('标识已经存在: '+repr(destination))
+            contexts=set(node._predecessor)|set(node._successors)
