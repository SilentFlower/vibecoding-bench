+"""分类路径解析和两节点关系导航，不将显示tag当唯一身份。"""
+from .exceptions import NodeIDAbsentError
+
+
+def _parents(tree,identity):
+    """按当前树关系得到到根路径并拒绝断链。@param tree 树。@param identity 节点。@return 节点到根列表。"""
+    if identity not in tree.nodes:raise NodeIDAbsentError(identity)
+    path=[];seen=set();current=identity
+    while current is not None:
+        if current in seen or current not in tree.nodes:raise ValueError('父链损坏')
+        seen.add(current);path.append(current);current=tree[current].predecessor(tree.identifier)
+    if not path or path[-1]!=tree.root:raise ValueError('父链未到当前根')
+    return path
+
+
+def path_between(tree,source,target):
+    """返回从源到目标的有序标识，包括两端。@param tree 树。@param source 源。@param target 目标。@return 标识列表。"""
+    left,right=_parents(tree,source),_parents(tree,target)
+    shared=set(right);ancestor=next(identity for identity in left if identity in shared)
+    return left[:left.index(ancestor)+1]+list(reversed(right[:right.index(ancestor)]))
+
+
+def lowest_common_ancestor(tree,left,right):
+    """只依据当前树返回最近公共祖先。@param tree 树。@param left 节点。@param right 节点。@return 祖先标识。"""
+    left_path=_parents(tree,left);right_path=set(_parents(tree,right))
+    return next(identity for identity in left_path if identity in right_path)
+
+
+def resolve_path(tree,segments,start=None,all_matches=False):
+    """按字面tag段解析，默认含糊拒绝。@param tree 树。@param segments 字符串段序列。@param start 相对起点或None绝对含根tag。@param all_matches 是否返回全部。@return Node或Node列表或None。"""
+    if isinstance(segments,str):raise ValueError('请传路径段序列，不能猜分隔符或转义')
+    parts=list(segments)
+    if any(not isinstance(part,str) for part in parts):raise ValueError('路径段必须是字符串')
+    if start is None:
+        if tree.root is None:return [] if all_matches else None
+        if not parts or parts[0]!=tree[tree.root].tag:return [] if all_matches else None
+        identities=[tree.root];parts=parts[1:]
+    else:
+        _parents(tree,start);identities=[start]
+    for part in parts:
+        identities=[child for identity in identities for child in tree[identity].successors(tree.identifier) if tree[child].tag==part]
+    result=[tree[identity] for identity in identities]
+    if all_matches:return result
+    if len(result)>1:raise ValueError('路径有多个同名匹配，请显式请求全部')
+    return result[0] if result else None
