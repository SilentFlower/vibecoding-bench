+def _boolean_literal(value):
+    """兼容明确真假字面量，拒绝Python非空串真值陷阱。@param value 参数。@return bool。"""
+    normalized=value.lower()
+    if normalized in ('true','1'):return True
+    if normalized in ('false','0'):return False
+    raise argparse.ArgumentTypeError('布尔值必须是true/false/1/0')
+
+
