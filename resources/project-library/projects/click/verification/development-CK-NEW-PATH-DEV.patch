@@ -0,0 +1,5 @@
+# 让输出路径参数明确拒绝已有文件、目录及悬空链接
+
+导出命令应明确要求一个尚未占用的输出位置，已有文件、目录和悬空链接都不能被当成可写空位。保持原Path返回类型和解析选项，不创建或预留文件，也不承诺并发创建时的原子占用。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/click/newpath.py
+++ b/library/src/click/newpath.py
@@ -0,0 +1,30 @@
+"""明确要求输出目标尚不存在的参数类型。"""
+import os
+from .types import Path
+
+
+class NewPath(Path):
+    """仅校验未占用的目标路径，不创建或原子预留文件。"""
+    def __init__(self,**options):
+        """配置原Path检查选项。@param options 不含exists/allow_dash的Path选项。@return None。
+        """
+        if 'exists' in options or 'allow_dash' in options:
+            raise TypeError('NewPath固定要求未存在且不接受标准流占位符')
+        super().__init__(exists=False,allow_dash=False,**options)
+
+    def convert(self,value,param,ctx):
+        """拒绝现有文件、目录和悬空链接。@param value 输入路径。@param param 参数。
+        @param ctx 上下文。@return 原Path指定的路径类型，不写文件系统。
+        """
+        if value in ('-',b'-'):
+            self.fail('输出路径不能使用标准流占位符',param,ctx)
+        try:
+            occupied=os.path.lexists(value)
+        except (TypeError,ValueError):
+            self.fail('无效输出路径',param,ctx)
+        if occupied:
+            self.fail('输出路径已经存在',param,ctx)
+        result=super().convert(value,param,ctx)
+        if os.path.lexists(result):
+            self.fail('输出路径已经存在',param,ctx)
+        return result
