+# 按本次上下文生成真实选项并同步帮助与补全
+
+命令可用环境、账号或状态随上下文变化，动态选项在每次操作读取独立快照，转换、帮助和补全保持一致。返回原选项对象，不跨调用缓存，也不在无上下文的元数据查看时访问提供者。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/click/dynamic.py
+++ b/library/src/click/dynamic.py
@@ -0,0 +1,39 @@
+"""每次操作按当前上下文读取可用业务选项。"""
+from .types import ParamType, Choice
+
+
+class DynamicChoice(ParamType):
+    """不跨调用缓存选项的Choice适配器。"""
+    name='choice'
+    def __init__(self,provider,*,case_sensitive=True):
+        """建立动态类型。@param provider 接受Context或None并返回有限选项。
+        @param case_sensitive 是否区分大小写。@return None。
+        """
+        if not callable(provider) or type(case_sensitive) is not bool:
+            raise TypeError('动态选项需要可调用提供者及布尔大小写策略')
+        self.provider,self.case_sensitive=provider,case_sensitive
+
+    def _choice(self,ctx):
+        return Choice(tuple(self.provider(ctx)),case_sensitive=self.case_sensitive)
+
+    def convert(self,value,param,ctx):
+        """按本次快照转换。@param value 输入。@param param 参数。@param ctx 上下文。
+        @return 原提供者中的实际选项对象。
+        """
+        return self._choice(ctx).convert(value,param,ctx)
+
+    def get_metavar(self,param,ctx):
+        """格式化当前帮助占位符。@param param 参数。@param ctx 上下文。@return 文本。
+        """
+        return self._choice(ctx).get_metavar(param,ctx)
+
+    def shell_complete(self,ctx,param,incomplete):
+        """补全当前可用选项。@param ctx 上下文。@param param 参数。@param incomplete 前缀。
+        @return 原Choice补全项列表。
+        """
+        return self._choice(ctx).shell_complete(ctx,param,incomplete)
+
+    def to_info_dict(self):
+        """返回不提前调用外部提供者的类型信息。@return 信息映射。
+        """
+        return {**super().to_info_dict(),'dynamic':True,'case_sensitive':self.case_sensitive}
