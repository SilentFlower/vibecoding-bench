+    def _density_source(self, attrs):
+        """按显式像素密度选择当前img的srcset，不读取图片或网络。
+
+        :param attrs: 当前HTML图片属性。
+        :return: 选中的源字符串；未配置/不支持的data URL集合保留原src。
+        """
+        import math
+        target = self.image_density
+        fallback = attrs.get('src')
+        if target is None:
+            return fallback
+        if isinstance(target, bool) or not isinstance(target, (int, float)) or not math.isfinite(target) or target <= 0:
+            raise ValueError('image_density必须为有限正数')
+        value = attrs.get('srcset')
+        if not value or 'data:' in value.lower():
+            return fallback
+        candidates = []
+        seen = set()
+        for candidate in value.split(','):
+            parts = candidate.strip().split()
+            if len(parts) == 1:
+                source, density = parts[0], 1.0
+            elif len(parts) == 2 and re.fullmatch(r'(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)x', parts[1]):
+                source, density = parts[0], float(parts[1][:-1])
+            else:
+                raise ValueError('srcset仅支持明确的x密度描述符')
+            if not source or density <= 0 or not math.isfinite(density) or density in seen:
+                raise ValueError('srcset含无效或重复密度')
+            seen.add(density)
+            candidates.append((density, source))
+        candidates.sort(key=lambda item: item[0])
+        return next((source for density, source in candidates if density >= target), candidates[-1][1])
+
