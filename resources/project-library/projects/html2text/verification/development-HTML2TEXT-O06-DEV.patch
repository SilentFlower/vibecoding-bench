+    @classmethod
+    def from_options(cls, options, *, out=None, baseurl=''):
+        """按严格Options创建真实转换器，复用原构造及属性路径。
+
+        :param options: 已验证的不可变Options。
+        :param out: 原输出回调。
+        :param baseurl: 原文档资源基址。
+        :return: 独立转换器实例。
+        """
+        if not isinstance(options, Options):
+            raise TypeError('options必须为Options')
+        values = options.as_dict()
+        converter = cls(out=out, baseurl=baseurl, bodywidth=values.pop('body_width'))
+        for name, value in values.items():
+            setattr(converter, name, value)
+        return converter
 
