+class Options:
+    """严格且不可变的转换配置，作为原可变属性API的显式替代入口。
+
+    :param values: 通过from_mapping提供已声明配置，不记录未知属性。
+    :return: 可复用配置；既有converter属性赋值兼容保留。
+    """
+    __slots__ = ('_values',)
+    _defaults = {'body_width': config.BODY_WIDTH, 'ignore_links': config.IGNORE_ANCHORS,
+                 'ignore_images': config.IGNORE_IMAGES, 'images_to_alt': config.IMAGES_TO_ALT,
+                 'images_as_html': config.IMAGES_AS_HTML, 'images_with_size': config.IMAGES_WITH_SIZE,
+                 'single_line_break': config.SINGLE_LINE_BREAK, 'wrap_links': config.WRAP_LINKS,
+                 'wrap_list_items': config.WRAP_LIST_ITEMS}
+
+    def __init__(self, values):
+        """验证类型/组合并固定拷贝。@param values 配置映射。@return None。"""
+        from types import MappingProxyType
+        unknown = set(values) - set(self._defaults)
+        if unknown:
+            raise ValueError('未知配置键: ' + ', '.join(sorted(unknown)))
+        merged = dict(self._defaults)
+        merged.update(values)
+        width = merged['body_width']
+        if isinstance(width, bool) or not isinstance(width, int) or width < 0:
+            raise ValueError('body_width必须为非负整数')
+        if any(not isinstance(value, bool) for key, value in merged.items() if key != 'body_width'):
+            raise TypeError('开关配置必须为bool')
+        if sum(merged[key] for key in ('images_to_alt', 'images_as_html', 'images_with_size')) > 1:
+            raise ValueError('严格配置的图片呈现模式互斥')
+        if merged['single_line_break'] and width:
+            raise ValueError('single_line_break严格模式要求body_width=0')
+        object.__setattr__(self, '_values', MappingProxyType(merged))
+
+    def __setattr__(self, name, value):
+        """配置创建后拒绝所有写入。@return 永不返回。"""
+        raise AttributeError('Options不可变')
+
+    @classmethod
+    def from_mapping(cls, values):
+        """从映射读取独立严格配置。@param values 配置映射。@return Options。"""
+        from collections.abc import Mapping
+        if not isinstance(values, Mapping):
+            raise TypeError('配置必须为映射')
+        return cls(dict(values))
+
+    def as_dict(self):
+        """返回可独立修改的普通配置副本。@return 新字典。"""
+        return dict(self._values)
 
 
