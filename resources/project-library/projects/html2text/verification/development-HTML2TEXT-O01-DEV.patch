+    def _finish_inline_code(self):
+        """结束单个行内代码缓冲，按真实CommonMark分隔规则输出。@return None。"""
+        if self._inline_code_parts is None:
+            return
+        text = ''.join(self._inline_code_parts).replace('\r\n', ' ').replace('\r', ' ').replace('\n', ' ')
+        self._inline_code_parts = None
+        self._inline_code_depth = 0
+        self.code = False
+        if not text:
+            return
+        width = 1 + max((len(match.group()) for match in re.finditer(r'`+', text)), default=0)
+        delimiter = '`' * width
+        # 首尾反引号以及非全空格正文的双端空格都需padding，渲染后才不会被语法吞掉。
