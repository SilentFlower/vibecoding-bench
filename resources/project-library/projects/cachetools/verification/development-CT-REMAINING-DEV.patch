+    def remaining(self,key,*,time=None):
+        """只读剩余有效期。@param key 活跃键。@param time 显式同类时钟值或None。
+        @return 到期值减当前时钟；缺失或恰好到期时KeyError，不触碰LRU和物理条目。
+        """
+        now=self.timer() if time is None else time
+        try:
+            link=self.__links[key]
+        except KeyError:
+            raise KeyError(key) from None
+        if not now<link.expires:
+            raise KeyError(key)
+        return link.expires-now
 
