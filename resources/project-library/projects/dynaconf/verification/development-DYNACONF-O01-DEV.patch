+# 在真实文件加载前整体验证文本路径协议并拒绝非法参数
+
+对应路线01：load_file先整体验证str/文本PathLike/list/tuple并fspath规范化，非法参数任何silent都TypeError；None/空/模块名/glob旧可选路径保持，不任意str对象。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/dynaconf/base.py
+++ b/library/dynaconf/base.py
@@ -1320,7 +1320,25 @@
         :param validate: Should trigger validation?
         :param run_hooks: Should run collected hooks?
         """
-        files = ensure_a_list(path)
+        # 先整体规范化再产生任何加载副作用，silent不能吞程序参数类型错误。
+        if path is None:
+            files = []
+        elif isinstance(path, (str, os.PathLike)):
+            normalized = os.fspath(path)
+            if not isinstance(normalized, str):
+                raise TypeError('配置路径必须为文本路径')
+            files = ensure_a_list(normalized)
+        elif isinstance(path, (list, tuple)):
+            files = []
+            for item in path:
+                if not isinstance(item, (str, os.PathLike)):
+                    raise TypeError('路径序列只能包含str或PathLike')
+                normalized = os.fspath(item)
+                if not isinstance(normalized, str):
+                    raise TypeError('配置路径必须为文本路径')
+                files.append(normalized)
+        else:
+            raise TypeError('路径必须为str、PathLike或其有限list/tuple')
         if not files:  # a glob pattern may return empty
             return
 
