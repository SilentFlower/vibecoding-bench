+# 实现严格文本JSON Pointer和规范数组寻址
+
+提供真实JSON树寻址，严格区分字典字符串键与数组下标，正确处理空键、空根和转义。不接受坏转义、前导零、负数或URI片段，返回原值且不修改输入。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/simplejson/pointer.py
+++ b/library/simplejson/pointer.py
@@ -0,0 +1,45 @@
+"""严格处理JSON Pointer文本与数组下标。"""
+import re
+
+
+def tokens(pointer):
+    """解码RFC6901文本指针。@param pointer 空根指针或斜杠开头文本。@return 路径片段元组。
+    """
+    if not isinstance(pointer,str) or (pointer and not pointer.startswith('/')):
+        raise ValueError('需要JSON Pointer文本形式')
+    if not pointer:
+        return ()
+    result=[]
+    for token in pointer[1:].split('/'):
+        if re.search(r'~(?![01])',token):
+            raise ValueError('无效的指针转义')
+        result.append(token.replace('~1','/').replace('~0','~'))
+    return tuple(result)
+
+
+def index(token,length,*,append=False):
+    """校验规范数组下标。@param token 片段。@param length 长度。@param append 是否允许尾部。
+    @return 实际下标。
+    """
+    if append and token=='-':
+        return length
+    if not re.fullmatch(r'0|[1-9][0-9]*',token):
+        raise ValueError('数组下标必须为规范非负整数')
+    value=int(token)
+    if value>=length+(1 if append else 0):
+        raise IndexError('数组指针越界')
+    return value
+
+
+def resolve(document,pointer):
+    """按指针返回原对象。@param document JSON树。@param pointer 文本指针。@return 原值。
+    """
+    value=document
+    for token in tokens(pointer):
+        if isinstance(value,dict):
+            value=value[token]
+        elif isinstance(value,list):
+            value=value[index(token,len(value))]
+        else:
+            raise TypeError('不能穿越JSON标量')
+    return value
