+# 隔离复用转换器的本次配置及已绑定分派缓存
+
+对应路线18：一次转换复制配置容器并建立独立bound-method缓存，保留带必要参数的自定义子类和回调身份；既有convert不改，连续/并发/失败不泄漏基础或调用方选项。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/markdownify/__init__.py
+++ b/library/markdownify/__init__.py
@@ -221,6 +221,37 @@
     def convert(self, html):
         soup = BeautifulSoup(html, **self.options['bs4_options'])
         return self.convert_soup(soup)
+
+    def convert_with_options(self, html, **overrides):
+        """一次转换使用隔离配置和分派缓存，不重跑自定义构造函数。
+
+        :param html: 本次HTML文本。
+        :param overrides: 本次选项覆盖，容器复制但回调身份保持。
+        :return: 使用本次有效配置转换的Markdown文本。
+        """
+        from copy import copy
+        def copy_config(value):
+            """仅复制配置容器，opaque回调/业务对象不被deepcopy。@return 隔离配置值。"""
+            if isinstance(value, dict):
+                return {key: copy_config(item) for key, item in value.items()}
+            if isinstance(value, list):
+                return [copy_config(item) for item in value]
+            if isinstance(value, tuple):
+                return tuple(copy_config(item) for item in value)
+            if isinstance(value, set):
+                return {copy_config(item) for item in value}
+            return value
+        isolated = copy(self)
+        isolated.options = copy_config(self.options)
+        isolated.options.update(copy_config(overrides))
+        if isolated.options['strip'] is not None and isolated.options['convert'] is not None:
+            raise ValueError('不能同时指定strip和convert')
+        if not isinstance(isolated.options['bs4_options'], dict):
+            isolated.options['bs4_options'] = {'features': isolated.options['bs4_options']}
+        # 原cache含绑定到原实例的方法，复制会让本次选项实际失效，必须重新分派。
+        isolated.convert_fn_cache = {}
+        return isolated.convert(html)
+
 
     def convert_soup(self, soup):
         return self.process_tag(soup, parent_tags=set())
--- a/library/tests/test_development_markdownify_o06_dev.py
