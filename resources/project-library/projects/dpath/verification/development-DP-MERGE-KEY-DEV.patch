+# 按记录业务键对齐深合并并保持稳定顺序和输入隔离
+
+配置记录列表按业务ID对齐，而不是盲目追加。先校验两侧唯一、可哈希的类型敏感ID，保持原顺序，相同记录递归合并，新记录按覆盖层顺序追加，所有结果节点与输入隔离，不改变旧merge默认规则。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/dpath/keymerge.py
+++ b/library/dpath/keymerge.py
@@ -0,0 +1,35 @@
+"""按类型敏感业务键对齐记录列表，不共享输入可变节点。"""
+from collections.abc import Mapping
+from copy import deepcopy
+
+
+def merge_by_key(left,right,key):
+    """对齐合并记录。@param left 原记录序列。@param right 覆盖记录序列。
+    @param key 每条记录都必须具有的业务键字段。@return 新列表，保持左顺序并按右顺序追加新键。
+    """
+    left,right=list(left),list(right)
+    def identities(rows):
+        result=[];seen=set()
+        for row in rows:
+            if not isinstance(row,Mapping) or key not in row:
+                raise ValueError('记录缺少业务键')
+            identity=(type(row[key]),row[key])
+            hash(identity)
+            if identity in seen:
+                raise ValueError('同一输入中业务键重复')
+            seen.add(identity);result.append(identity)
+        return result
+    left_ids,right_ids=identities(left),identities(right)
+    result=deepcopy(left);positions={identity:index for index,identity in enumerate(left_ids)}
+    def combine(target,source):
+        for field,value in source.items():
+            if field in target and isinstance(target[field],dict) and isinstance(value,Mapping):
+                combine(target[field],value)
+            else:
+                target[field]=deepcopy(value)
+    for identity,row in zip(right_ids,right):
+        if identity in positions:
+            combine(result[positions[identity]],row)
+        else:
+            positions[identity]=len(result);result.append(deepcopy(row))
+    return result
