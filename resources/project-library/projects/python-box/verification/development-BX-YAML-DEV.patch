+def _yaml_native_data(value, memo=None):
+    """为YAML构造独立原生容器，保留共享引用并避免解冻源配置。
+
+    :param value: 原配置值。
+    :param memo: 本次序列化已转换的容器身份。
+    :return: YAML后端可处理的映射、序列或原标量。
+    """
+    if memo is None:
+        memo = {}
+    if not isinstance(value, (dict, list, tuple)):
+        return value
+    if id(value) in memo:
+        return memo[id(value)]
+    if isinstance(value, dict):
+        output = {}
+        memo[id(value)] = output
+        output.update((key, _yaml_native_data(item, memo)) for key, item in value.items())
+    else:
+        output = []
+        memo[id(value)] = output
+        output.extend(_yaml_native_data(item, memo) for item in value)
+    return output
 
 
