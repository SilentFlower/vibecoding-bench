+# 临时插件集合按作用域注册并在失败后精确清理自有对象
+
+路线12：临时插件集合完整预检后顺序注册，退出/正文异常/部分历史重放失败均逆序清理仍由本作用域持有的对象。前置身份能力避免误删相等既有插件，嵌套及同名后继替换正确；不承诺撤销外部副作用或正文新协议。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/src/pluggy/scoped.py
+++ b/library/src/pluggy/scoped.py
@@ -0,0 +1,27 @@
+"""作用域临时插件集合，只清理本作用域真正拥有的注册。"""
+from contextlib import contextmanager
+
+
+@contextmanager
+def temporary_plugins(manager,plugins):
+    """按顺序注册(name,plugin)并在退出时逆序清理。@param manager 真实PluginManager。@param plugins 显式名字和对象。@return 作用域内manager。"""
+    entries=list(plugins)
+    names=[];identities=set()
+    for name,plugin in entries:
+        if not isinstance(name,str) or not name or name in names or plugin is None:raise ValueError('临时插件名称或对象无效')
+        if id(plugin) in identities:raise ValueError('同对象不能重复临时注册')
+        if manager.has_plugin(name) or manager.is_blocked(name) or manager.is_registered(plugin):raise ValueError('临时插件与既有注册冲突')
+        names.append(name);identities.add(id(plugin))
+    owned=[]
+    try:
+        for name,plugin in entries:
+            # 即使historic replay在register中途失败，也尝试按对象身份清理它留下的本轮注册。
+            owned.append(plugin)
+            registered=manager.register(plugin,name)
+            if registered is None:raise ValueError('临时插件被管理器拒绝')
+        yield manager
+    finally:
+        for plugin in reversed(owned):
+            actual=manager.get_name(plugin)
+            if actual is not None and manager.get_plugin(actual) is plugin:
+                manager.unregister(plugin=plugin,name=actual)
