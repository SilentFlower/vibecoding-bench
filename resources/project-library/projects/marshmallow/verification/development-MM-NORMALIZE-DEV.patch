@@ -0,0 +1,24 @@
+"""在原生验证器之前完成明确的Unicode标准化。"""
+import unicodedata
+from .fields import String
+
+
+class NormalizedString(String):
+    """保留原字符串字段语义，显式选择标准化策略。"""
+    def __init__(self,*,form='NFC',strip=True,casefold=False,**kwargs):
+        """建立字段。@param form Unicode标准化形式或None。@param strip 是否裁边。
+        @param casefold 是否折叠大小写。@param kwargs 原字段选项。@return None。
+        """
+        if form not in (None,'NFC','NFD','NFKC','NFKD') or type(strip) is not bool or type(casefold) is not bool:
+            raise ValueError('无效的标准化策略')
+        self.form=form;self.strip=strip;self.casefold=casefold
+        super().__init__(**kwargs)
+
+    def _deserialize(self,value,attr,data,**kwargs):
+        text=super()._deserialize(value,attr,data,**kwargs)
+        if self.strip:
+            text=text.strip()
+        if self.casefold:
+            text=text.casefold()
+        # 大小写折叠可能产生组合字符，最后执行标准化保证返回值满足指定形式。
+        return unicodedata.normalize(self.form,text) if self.form is not None else text
