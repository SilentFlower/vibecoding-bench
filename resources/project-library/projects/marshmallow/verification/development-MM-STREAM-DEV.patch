+"""以原Schema逐记录加载，避免把整批输入物化。"""
+from copy import deepcopy
+from dataclasses import dataclass
+from .schema import Schema
+from .exceptions import ValidationError
+from .error_paths import flatten_errors
+
+
+@dataclass(frozen=True)
+class LoadResult:
+    """一条记录的载入结果；错误项不可变且不包含原输入。"""
+    index: int
+    status: str
+    data: object=None
+    errors: tuple=()
+    valid_data: object=None
+
+
+def iterload(schema,records,*,errors='raise',partial=None,unknown=None):
+    """惰性逐记录转换。@param schema 原Schema实例。@param records 输入迭代器。
+    @param errors raise或collect。@param partial 原部分加载参数。@param unknown 原未知字段策略。
+    @return collect时产出LoadResult，否则直接产出成功值；真实非校验异常仍传播。
+    """
+    if not isinstance(schema,Schema) or errors not in ('raise','collect'):
+        raise ValueError('需要Schema实例和有效错误策略')
+    iterator=iter(records)
+    def produce():
+        for index,record in enumerate(iterator):
+            try:
+                loaded=schema.load(record,many=False,partial=partial,unknown=unknown)
+            except ValidationError as error:
+                if errors=='raise':
+                    raise
+                yield LoadResult(index,'error',errors=flatten_errors(error),valid_data=deepcopy(error.valid_data))
+            else:
+                yield LoadResult(index,'passed',data=loaded) if errors=='collect' else loaded
+    return produce()
