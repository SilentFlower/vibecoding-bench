+"""在原List完成内层反序列化后验证业务唯一性。"""
+from .fields import List
+from .exceptions import ValidationError
+
+
+def _equal(left,right):
+    if isinstance(left,bool) or isinstance(right,bool):
+        return type(left) is type(right) and left==right
+    return left==right
+
+
+class UniqueList(List):
+    """支持可变键值及等值数字，布尔不与数字混淆。"""
+    def __init__(self,cls_or_instance,*,key=None,**kwargs):
+        """建立字段。@param cls_or_instance 原内层字段。@param key 可选去重键函数。
+        @param kwargs 原List选项。@return None。
+        """
+        if key is not None and not callable(key):
+            raise TypeError('唯一键必须可调用')
+        self.key=key
+        super().__init__(cls_or_instance,**kwargs)
+
+    def _deserialize(self,value,attr,data,**kwargs):
+        result=super()._deserialize(value,attr,data,**kwargs)
+        observed=[];errors={}
+        for index,item in enumerate(result):
+            marker=self.key(item) if self.key is not None else item
+            first=next((position for position,other in enumerate(observed) if _equal(marker,other)),None)
+            if first is not None:
+                errors[index]=['与索引'+str(first)+'重复']
+            observed.append(marker)
+        if errors:
+            raise ValidationError(errors,valid_data=result)
+        return result
