+    def validate_routes(self):
+        """只读审查可静态证明的路由覆盖、缺视图及签名不匹配。
+
+        :return: 结构化诊断列表，不执行视图或自定义converter，也不拒绝原注册行为。
+        """
+        from inspect import signature
+        diagnostics = []
+        previous = []
+        for rule in self.url_map.iter_rules():
+            if rule.build_only:
+                continue
+            methods = set(rule.methods or ()) - {'HEAD', 'OPTIONS'}
+            for other in previous:
+                overlap = methods & (set(other.methods or ()) - {'HEAD', 'OPTIONS'})
+                if overlap and (rule.rule, rule.host, rule.subdomain) == (other.rule, other.host, other.subdomain):
+                    diagnostics.append({'code': 'overlap', 'endpoint': rule.endpoint,
+                                        'other_endpoint': other.endpoint, 'rule': rule.rule, 'methods': sorted(overlap)})
+            previous.append(rule)
+            view = self.view_functions.get(rule.endpoint)
+            if view is None:
+                diagnostics.append({'code': 'missing_view', 'endpoint': rule.endpoint, 'rule': rule.rule})
+                continue
+            # preprocessors可消费或注入参数；此时不执行它们，也不把未知情况假报为签名错误。
+            if any(self.url_value_preprocessors.values()):
+                continue
+            try:
+                parameters = signature(view)
+            except (TypeError, ValueError):
+                continue
+            arguments = set(rule.arguments) | set(rule.defaults or ())
+            try:
+                parameters.bind(**dict.fromkeys(arguments, None))
+            except TypeError:
+                diagnostics.append({'code': 'view_signature', 'endpoint': rule.endpoint,
+                                    'rule': rule.rule, 'arguments': sorted(arguments)})
+        return diagnostics
+
