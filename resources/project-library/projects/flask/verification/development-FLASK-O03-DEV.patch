+    def validate(self, constraints):
+        """聚合配置必填、类型、枚举、范围及嵌套约束，不输出业务值。
+
+        :param constraints: 键到required/type/nullable/choices/minimum/maximum/properties规则的映射。
+        :return: 含path和code的错误列表；不隐式转换或修改配置。
+        """
+        errors = []
+        def inspect_rules(values, rules, prefix):
+            """按明确路径遍历规则，每项事实独立报告。@return None。"""
+            for key, rule in rules.items():
+                if not isinstance(key, str) or not isinstance(rule, dict):
+                    raise TypeError('约束必须为字符串键和规则映射')
+                unknown = set(rule) - {'required', 'type', 'nullable', 'choices', 'minimum', 'maximum', 'properties'}
+                if unknown:
+                    raise ValueError('未知配置约束')
+                path = prefix + [key]
+                if key not in values:
+                    if rule.get('required', False):
+                        errors.append({'path': path, 'code': 'required'})
+                    continue
+                value = values[key]
+                if value is None:
+                    if not rule.get('nullable', False):
+                        errors.append({'path': path, 'code': 'null'})
+                    continue
+                expected = rule.get('type')
+                if expected is not None:
+                    types = expected if isinstance(expected, tuple) else (expected,)
+                    if not types or not all(isinstance(item, type) for item in types):
+                        raise TypeError('type约束必须为类型或非空类型tuple')
+                    if not isinstance(value, types) or isinstance(value, bool) and bool not in types and any(item in (int, float) for item in types):
+                        errors.append({'path': path, 'code': 'type'})
+                        continue
+                if 'choices' in rule and value not in rule['choices']:
+                    errors.append({'path': path, 'code': 'choices'})
+                for name, comparison in [('minimum', lambda left, right: left < right), ('maximum', lambda left, right: left > right)]:
+                    if name in rule:
+                        try:
+                            invalid = comparison(value, rule[name])
+                        except TypeError:
+                            invalid = True
+                        if invalid:
+                            errors.append({'path': path, 'code': name})
+                if 'properties' in rule:
+                    if not isinstance(value, dict):
+                        errors.append({'path': path, 'code': 'object'})
+                    else:
+                        inspect_rules(value, rule['properties'], path)
+        inspect_rules(self, constraints, [])
+        return errors
 
