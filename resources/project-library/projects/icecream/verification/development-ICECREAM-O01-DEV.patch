--- a/library/docs/development-icecream-o01-dev.md
+++ b/library/docs/development-icecream-o01-dev.md
@@ -0,0 +1,5 @@
+# 调试展开实参时保留全部值且不重新求值来源
+
+对应路线01：AST展开节点与运行实参数量并非一一对应，保留可确定的普通前后缀，展开中间值按序标记，绝不二次求值/消费或让zip漏值。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/icecream/icecream.py
+++ b/library/icecream/icecream.py
@@ -375,9 +375,21 @@
         if callNode is not None:
             assert isinstance(callNode, ast.Call)
             source = cast(Source, Source.for_frame(callFrame))
-            sanitizedArgStrs = [
-                source.get_text_with_indentation(arg)
-                for arg in callNode.args]
+            nodes = callNode.args
+            stars = [index for index, node in enumerate(nodes) if isinstance(node, ast.Starred)]
+            if not stars:
+                sanitizedArgStrs = [source.get_text_with_indentation(arg) for arg in nodes]
+            else:
+                # 只确定首个展开前和最后展开后的普通实参；中间展开长度不能重新求值猜测。
+                first, last = stars[0], stars[-1]
+                suffix = len(nodes) - last - 1
+                middle = len(args) - first - suffix
+                sanitizedArgStrs = [source.get_text_with_indentation(node) for node in nodes[:first]]
+                sanitizedArgStrs += ['expanded[%d]' % index for index in range(max(0, middle))]
+                sanitizedArgStrs += [source.get_text_with_indentation(node) for node in nodes[last + 1:]]
+            if len(sanitizedArgStrs) != len(args):
+                # 极端运行时/AST不一致时保留所有值，不能用zip截断或错配来源。
+                sanitizedArgStrs = [Sentinel.absent] * len(args)
         else:
             warnings.warn(
                 NO_SOURCE_AVAILABLE_WARNING_MESSAGE,
--- a/library/tests/test_development_icecream_o01_dev.py
+++ b/library/tests/test_development_icecream_o01_dev.py
@@ -0,0 +1,28 @@
+"""展开实参值不能丢失或重新求值，安全普通前后缀仍可标注。"""
+from icecream import IceCreamDebugger
+
+def test_single_star_with_prefix_suffix_and_identity():
+    """展开加尾参保留全部值及返回身份。@return None。"""
+    output=[];debug=IceCreamDebugger(outputFunction=output.append);values=[101,202]
+    result=debug(9,*values,303)
+    assert result==(9,101,202,303) and all(str(value) in output[0] for value in result)
+    assert 'expanded[0]' in output[0] and 'expanded[1]' in output[0]
+
+def test_multiple_empty_stars_and_generator_consumed_once():
+    """多个展开间普通值不能误认来源，生成器不被二次消费。@return None。"""
+    output=[];debug=IceCreamDebugger(outputFunction=output.append);visited=[]
+    def values():
+        for value in [11,22]:visited.append(value);yield value
+    result=debug(*values(),33,*[],44)
+    assert result==(11,22,33,44) and visited==[11,22]
+    assert all(str(value) in output[-1] for value in result)
+    assert debug(*[],55)==55 and '55' in output[-1]
+
+def test_no_source_and_single_object_identity():
+    """源码不可用沿原fallback，单个对象身份保持。@return None。"""
+    import warnings
+    output=[];debug=IceCreamDebugger(outputFunction=output.append);obj=object()
+    assert debug(obj) is obj
+    with warnings.catch_warnings():
+        warnings.simplefilter('ignore');exec('debug(*[77,88],99)',{'debug':debug})
+    assert all(str(value) in output[-1] for value in [77,88,99])
