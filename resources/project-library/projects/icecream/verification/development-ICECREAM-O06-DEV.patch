@@ -0,0 +1,5 @@
+# 以归属句柄管理可撤销builtin安装和嵌套恢复
+
+对应路线20：新句柄记录旧值及安装归属，只有当前仍归自己才恢复/移除；相同对象嵌套和乱序关闭也不复活旧层，原install/uninstall保持。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/icecream/builtins.py
+++ b/library/icecream/builtins.py
@@ -27,3 +27,73 @@
 
 def uninstall(ic: str = 'ic') -> None:
     delattr(builtins, ic)
+
+
+_MANAGED_OWNERS = {}
+_MISSING = object()
+
+
+class BuiltinInstallation:
+    """有归属的显式builtin安装句柄，退出只撤销仍属于自己的值。
+
+    :param name: 合成或应用明确选择的合法非关键字标识符。
+    :param debugger: 将要安装的真实IceCreamDebugger。
+    :return: 已安装的可关闭/可with句柄，原install/uninstall保持。
+    """
+    def __init__(self, name, debugger):
+        """记录当前值和归属链，支持相同debugger的嵌套安装。@return None。"""
+        import keyword
+        if not isinstance(name, str) or not name.isidentifier() or keyword.iskeyword(name):
+            raise ValueError('builtin安装名必须为非关键字标识符')
+        if not isinstance(debugger, icecream.IceCreamDebugger):
+            raise TypeError('需要真实IceCreamDebugger')
+        self.name, self.debugger, self.closed = name, debugger, False
+        self.previous = getattr(builtins, name, _MISSING)
+        previous_owner = _MANAGED_OWNERS.get(name)
+        self.previous_owner = previous_owner if previous_owner is not None and self.previous is previous_owner.debugger else None
+        setattr(builtins, name, debugger)
+        _MANAGED_OWNERS[name] = self
+
+    def close(self):
+        """幂等撤销；外部替换保留，乱序关闭跳过已关闭的祖先层。@return None。"""
+        if self.closed:
+            return
+        self.closed = True
+        if _MANAGED_OWNERS.get(self.name) is not self:
+            return
+        if getattr(builtins, self.name, _MISSING) is not self.debugger:
+            _MANAGED_OWNERS.pop(self.name, None)
+            return
+        previous, owner = self.previous, self.previous_owner
+        while owner is not None and owner.closed:
+            previous, owner = owner.previous, owner.previous_owner
+        if previous is _MISSING:
+            if hasattr(builtins, self.name):
+                delattr(builtins, self.name)
+        else:
+            setattr(builtins, self.name, previous)
+        if owner is None:
+            _MANAGED_OWNERS.pop(self.name, None)
+        else:
+            _MANAGED_OWNERS[self.name] = owner
+
+    def __enter__(self):
+        """进入已安装句柄，不能重新启用已关闭句柄。@return self。"""
+        if self.closed:
+            raise RuntimeError('安装句柄已关闭')
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        """异常退出也按归属撤销，保留原异常。@return False。"""
+        self.close()
+        return False
+
+
+def managed_install(name='ic', debugger=None):
+    """显式安装并返回有归属句柄。
+
+    :param name: 目标builtin名字，不扫描或修改其他名字。
+    :param debugger: 默认使用原icecream.ic。
+    :return: BuiltinInstallation。
+    """
+    return BuiltinInstallation(name, icecream.ic if debugger is None else debugger)
