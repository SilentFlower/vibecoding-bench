+class DateHandlerRegistry:
+    """调用级不可变日期处理器集合，不改全局注册顺序。
+
+    :param handlers: 按优先级的自定义可调用处理器。
+    :param include_builtin: 是否在自定义处理器后冻结当前全局回退列表。
+    :return: 不可变注册集合。
+    """
+    __slots__ = ('handlers',)
+    def __init__(self, handlers=(), *, include_builtin=True):
+        """固定并按身份去重，拒绝非函数。@return None。"""
+        values = list(handlers) + (list(_date_handlers) if include_builtin else [])
+        if not all(callable(value) for value in values):
+            raise TypeError('日期处理器必须可调用')
+        unique = []
+        for value in values:
+            if not any(existing is value for existing in unique):
+                unique.append(value)
+        object.__setattr__(self, 'handlers', tuple(unique))
+    def __setattr__(self, name, value):
+        """拒绝注册集创建后的修改。@return 永不返回。"""
+        raise AttributeError('日期注册集不可变')
+
