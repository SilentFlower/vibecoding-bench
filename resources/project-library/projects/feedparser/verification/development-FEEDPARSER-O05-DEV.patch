+def merge_feeds(previous, incoming, *, partial=False):
+    """按明确身份合并本地结果，当前缺席不等于删除。
+
+    :param previous: 旧真实解析结果。
+    :param incoming: 本轮真实解析结果，当前条目优先按原顺序。
+    :param partial: True时同ID只覆盖本轮出现字段，False用本轮完整条目。
+    :return: result及added/updated/unchanged/retained身份清单，输入全部保持。
+    """
+    from copy import deepcopy
+    from .util import FeedParserDict
+    def indexed(items):
+        """同批身份重复必须明确拒绝，不能随机保留某一条。@return 身份映射及顺序。"""
+        result = {}
+        for item in items:
+            key = entry_identity(item)['value']
+            if key in result:
+                raise ValueError('同批订阅存在重复身份')
+            result[key] = item
+        return result
+    old = indexed(dict.get(previous, 'entries', []))
+    new = indexed(dict.get(incoming, 'entries', []))
+    changes = {name: [] for name in ('added', 'updated', 'unchanged', 'retained')}
+    entries = []
+    for key, item in new.items():
+        if key not in old:
+            merged = deepcopy(item)
+            changes['added'].append(key)
+        else:
+            if partial:
+                merged = deepcopy(old[key])
+                merged.update(deepcopy(dict(item)))
+            else:
+                merged = deepcopy(item)
+            changes['unchanged' if dict(merged) == dict(old[key]) else 'updated'].append(key)
+        entries.append(merged)
+    for key, item in old.items():
+        if key not in new:
+            entries.append(deepcopy(item))
+            changes['retained'].append(key)
+    result = FeedParserDict(deepcopy(dict(previous)))
+    result.update(deepcopy({key: value for key, value in dict(incoming).items() if key != 'entries'}))
+    result['entries'] = entries
+    return {'result': result, 'changes': changes}
--- a/library/tests/test_development_feedparser_o05_dev.py
