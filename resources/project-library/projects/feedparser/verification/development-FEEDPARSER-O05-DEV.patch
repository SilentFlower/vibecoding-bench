     encoded = json.dumps(normalize(chosen), sort_keys=True, separators=(',', ':'), ensure_ascii=False, allow_nan=False).encode('utf8')
     return {'value': 'sha256:' + hashlib.sha256(encoded).hexdigest(), 'source': 'fields',
             'reliable': False, 'fields': sorted(chosen)}
