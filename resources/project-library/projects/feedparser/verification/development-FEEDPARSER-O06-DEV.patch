+# 从真实跨格式条目选择可读正文并保留类型语言及来源
+
+对应路线18：按真实MIME/语言/顺序选择本地正文，兼容content列表及旧JSON单dict；无正文才回退summary，保留原值/类型/来源，有限HTML文字保块界限、不获取src或造摘要。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/feedparser/readers.py
+++ b/library/feedparser/readers.py
@@ -0,0 +1,63 @@
+"""在真实订阅字段中选择可读正文，保留来源与原值，不下载外部正文。"""
+from html.parser import HTMLParser
+import re
+
+
+def entry_text(entry, *, prefer=('text/plain', 'text/html', 'application/xhtml+xml'), languages=(), strip_html=True):
+    """按明确类型/语言优先级选择已提供的正文，缺正文返回None。
+
+    :param entry: 原解析条目，不修改其content/summary事实。
+    :param prefer: 支持的MIME按优先级排列，类型优先于语言。
+    :param languages: 每种MIME中的语言优先级，不猜语言。
+    :param strip_html: HTML选中后是否提取有限可读文字。
+    :return: text/value/type/language/source/index，或None。
+    """
+    supported = ('text/plain', 'text/html', 'application/xhtml+xml')
+    preference = tuple(prefer)
+    if not preference or any(value not in supported for value in preference) or len(set(preference)) != len(preference):
+        raise ValueError('正文类型偏好必须为非空唯一支持MIME序列')
+    language_order = tuple(languages)
+    content = dict.get(entry, 'content', [])
+    if isinstance(content, dict):
+        content = [content]
+    candidates = []
+    def add(value, source, index):
+        """只把已提供的非空文本纳入候选，src绝不触发获取。@return None。"""
+        if not isinstance(value, dict) or value.get('src'):
+            return
+        text = value.get('value')
+        mime = {'text': 'text/plain', 'html': 'text/html', 'xhtml': 'application/xhtml+xml'}.get(value.get('type'), value.get('type', 'text/plain'))
+        if not isinstance(text, str) or not text.strip() or mime not in preference:
+            return
+        language = value.get('language')
+        rank = language_order.index(language) if language in language_order else len(language_order)
+        candidates.append(((preference.index(mime), rank, index), {'value': text, 'type': mime,
+                           'language': language, 'source': source, 'index': index}))
+    for index, item in enumerate(content or []):
+        add(item, 'content', index)
+    if not candidates:
+        detail = dict.get(entry, 'summary_detail')
+        if isinstance(detail, dict):
+            add(detail, 'summary', 0)
+        elif isinstance(dict.get(entry, 'summary'), str):
+            add({'value': dict.get(entry, 'summary'), 'type': 'text/plain'}, 'summary', 0)
+    if not candidates:
+        return None
+    selected = min(candidates, key=lambda item: item[0])[1]
+    text = selected['value']
+    if strip_html and selected['type'] in ('text/html', 'application/xhtml+xml'):
+        class Reader(HTMLParser):
+            """有限文本提取器，保留块边界并跳过script/style内容，不宣称HTML清洗。"""
+            def __init__(self):
+                super().__init__(convert_charrefs=True);self.parts=[];self.quiet=[]
+            def handle_starttag(self, tag, attrs):
+                if tag in ('script', 'style'):self.quiet.append(tag)
+                if not self.quiet and tag in ('p','div','br','li','section','h1','h2','h3','tr'):self.parts.append('\n')
+            def handle_endtag(self, tag):
+                if self.quiet and self.quiet[-1]==tag:self.quiet.pop()
+                if not self.quiet and tag in ('p','div','li','section','h1','h2','h3','tr'):self.parts.append('\n')
+            def handle_data(self, value):
+                if not self.quiet:self.parts.append(value)
+        parser=Reader();parser.feed(text);parser.close()
+        text='\n'.join(re.sub(r'[ \t\r\f\v]+',' ',line).strip() for line in ''.join(parser.parts).split('\n') if line.strip())
+    return dict(selected, text=text)
--- a/library/tests/test_development_feedparser_o06_dev.py
+++ b/library/tests/test_development_feedparser_o06_dev.py
@@ -0,0 +1,27 @@
+"""可读正文选择保留真实来源，不造摘要或下载src。"""
+from feedparser.util import FeedParserDict
+import copy
+import pytest
+
+def test_type_language_priority_and_source_facts_are_retained():
+    """类型优先再语言，原正文与来源/原值一并返回且输入不变。@return None。"""
+    from feedparser.readers import entry_text
+    entry=FeedParserDict(content=[FeedParserDict(type='text/html',language='zh',value='<p>中文</p>'),FeedParserDict(type='text/plain',language='en',value='English'),FeedParserDict(type='text/plain',language='zh',value='中文纯文')])
+    before=copy.deepcopy(entry);actual=entry_text(entry,languages=['zh'])
+    assert actual=={'text':'中文纯文','value':'中文纯文','type':'text/plain','language':'zh','source':'content','index':2} and entry==before
+
+def test_html_text_blocks_entities_script_and_summary_fallback():
+    """有限HTML转文字保留块界限和实体，摘要只有无可用content时回退。@return None。"""
+    from feedparser.readers import entry_text
+    entry=FeedParserDict(content=FeedParserDict(type='html',value='<p>A &amp; B</p><script>secret</script><p>C<br>D</p>'),summary='fallback')
+    actual=entry_text(entry);assert actual['text']=='A & B\nC\nD' and actual['source']=='content'
+    assert entry_text(entry,strip_html=False)['text']==entry.content['value']
+    assert entry_text(FeedParserDict(summary='fallback'))['source']=='summary'
+
+def test_external_unknown_empty_and_title_only_never_fake_body():
+    """外部src/未知MIME/空白不冒充正文，只有标题返回None。@return None。"""
+    from feedparser.readers import entry_text
+    entry=FeedParserDict(content=[{'src':'https://do-not-fetch','type':'text/plain'},{'type':'unknown','value':'opaque'},{'type':'text/plain','value':'  '}],title='Title')
+    assert entry_text(entry) is None
+    with pytest.raises(ValueError):entry_text(entry,prefer=[])
+    with pytest.raises(ValueError):entry_text(entry,prefer=['application/octet-stream'])
