--- a/library/cssselect/batch.py
+++ b/library/cssselect/batch.py
@@ -0,0 +1,25 @@
+"""逐记录批量翻译，输入组和输入批次绝不混淆。"""
+from cssselect.parser import SelectorSyntaxError
+from cssselect.xpath import ExpressionError, GenericTranslator
+
+
+def translate_many(records, *, translator=None, prefix='descendant-or-self::', fail_fast=False):
+    """惰性按输入顺序翻译带业务标识的选择器。
+
+    :param records: (业务标识,完整CSS组)的可迭代序列，允许重复标识。
+    :param translator: 实际translator实例，默认GenericTranslator。
+    :param prefix: 转发给真实翻译器。
+    :param fail_fast: 原生语法/翻译错误是否立即传播。
+    :return: 逐记录结果迭代器，语法与不支持错误分阶段。
+    """
+    selected = GenericTranslator() if translator is None else translator
+    for identifier, css in records:
+        try:
+            xpath = selected.css_to_xpath(css, prefix=prefix)
+        except (SelectorSyntaxError, ExpressionError) as error:
+            if fail_fast:
+                raise
+            yield {'id': identifier, 'css': css, 'ok': False, 'xpath': None,
+                   'error': {'phase': 'parse' if isinstance(error, SelectorSyntaxError) else 'translate', 'kind': type(error).__name__}}
+        else:
+            yield {'id': identifier, 'css': css, 'ok': True, 'xpath': xpath, 'error': None}
