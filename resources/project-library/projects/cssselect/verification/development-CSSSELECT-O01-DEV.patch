--- a/library/cssselect/compiled.py
+++ b/library/cssselect/compiled.py
@@ -0,0 +1,44 @@
+"""不可变的选择器编译结果，不绑定文档或强制引入lxml。"""
+from dataclasses import dataclass
+from cssselect.parser import parse
+from cssselect.xpath import GenericTranslator, HTMLTranslator
+
+
+@dataclass(frozen=True)
+class CompiledSelector:
+    """保存一次完整选择器组的编译事实。
+
+    :param canonical: 按原分支顺序的规范CSS。
+    :param specificity: 各分支specificity，不能将组错误相加。
+    :param xpath: 可由调用方在任意树求值的XPath字符串。
+    :param mode: xml或html。
+    :param xhtml: HTML大小写政策。
+    :param prefix: 实际作用域前缀。
+    :return: 不持有可变语法树的冻结对象。
+    """
+    canonical: tuple[str, ...]
+    specificity: tuple[tuple[int, int, int], ...]
+    xpath: str
+    mode: str
+    xhtml: bool
+    prefix: str
+
+
+def compile_selector(css, *, mode='xml', xhtml=False, prefix='descendant-or-self::'):
+    """一次解析并保存每个真实分支的翻译事实。
+
+    :param css: 一个完整CSS选择器组，不手工按逗号拆分。
+    :param mode: xml或html。
+    :param xhtml: 仅html模式接受True。
+    :param prefix: 交给原生translator的前缀。
+    :return: CompiledSelector；原生语法或不支持错误照常传播。
+    """
+    if mode not in ('xml', 'html') or (mode == 'xml' and xhtml):
+        raise ValueError('无效文档模式')
+    if not isinstance(css, str) or not isinstance(prefix, str):
+        raise TypeError('选择器与前缀必须为文本')
+    translator = HTMLTranslator(xhtml=xhtml) if mode == 'html' else GenericTranslator()
+    selectors = parse(css)
+    paths = tuple(translator.selector_to_xpath(selector, prefix, translate_pseudo_elements=True) for selector in selectors)
+    return CompiledSelector(tuple(selector.canonical() for selector in selectors),
+        tuple(selector.specificity() for selector in selectors), ' | '.join(paths), mode, bool(xhtml), prefix)
