+"""展示拼写与PEP440比较键分离，不修改Version原有存储/pickle。"""
+from dataclasses import dataclass
+from functools import total_ordering
+from packaging.version import Version
+
+
+@total_ordering
+@dataclass(frozen=True,eq=False,init=False)
+class DisplayVersion:
+    """不可变展示版本。@param value 原始版本文本。@return 原文与标准Version组成的对象。"""
+    raw_version: str | None
+    version: Version
+
+    def __init__(self,value):
+        """校验并保留精确原文。@param value 原字符串。@return None。"""
+        if not isinstance(value,str):raise TypeError('value必须为str')
+        parsed=Version(value)
+        object.__setattr__(self,'raw_version',value)
+        object.__setattr__(self,'version',parsed)
+
+    @classmethod
+    def from_version(cls,value):
+        """已有标准版本没有原文。@param value Version。@return raw_version为None的包装。"""
+        if not isinstance(value,Version):raise TypeError('value必须为Version')
+        result=object.__new__(cls)
+        object.__setattr__(result,'raw_version',None)
+        object.__setattr__(result,'version',value)
+        return result
+
+    @property
+    def display(self):
+        """返回原文或规范回退。@return 用户展示文本。"""
+        return self.raw_version if self.raw_version is not None else str(self.version)
+
+    def __str__(self):
+        """保持标准规范化字符串。@return PEP440规范文本。"""
+        return str(self.version)
+
+    def __hash__(self):
+        """哈希只由标准版本决定。@return 标准版本hash。"""
+        return hash(self.version)
+
+    def __eq__(self,other):
+        """比较时忽略展示拼写。@param other 标准或展示版本。@return 相等或NotImplemented。"""
+        if isinstance(other,DisplayVersion):other=other.version
+        if not isinstance(other,Version):return NotImplemented
+        return self.version==other
+
+    def __lt__(self,other):
+        """排序只使用标准版本。@param other 标准或展示版本。@return 顺序或NotImplemented。"""
+        if isinstance(other,DisplayVersion):other=other.version
+        if not isinstance(other,Version):return NotImplemented
+        return self.version<other
