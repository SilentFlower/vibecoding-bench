+def build_wheel_filename(name,version,tags,build=()):
+    """从结构化值构造wheel名称。@param name 项目名。@param version 标准版本。@param tags 精确Tag集合。@param build 空或(非负整数,后缀)。@return 语义可逆文件名。"""
+    normalized=canonicalize_name(name,validate=True).replace("-","_")
+    parsed=version if isinstance(version,Version) else Version(version)
+    values=frozenset(tags)
+    if not values:raise InvalidWheelFilename("tags不能为空")
+    if any(not isinstance(tag,Tag) for tag in values):raise TypeError("tags必须为Tag")
+    if build:
+        if not isinstance(build,tuple) or len(build)!=2 or type(build[0]) is not int or build[0]<0 or not isinstance(build[1],str):
+            raise InvalidWheelFilename("无效build")
+        build_sql=f"-{build[0]}{build[1]}"
+    else:build_sql=""
+    components=[".".join(sorted({getattr(tag,key) for tag in values})) for key in ("interpreter","abi","platform")]
+    filename=f"{normalized}-{parsed}{build_sql}-"+"-".join(components)+".whl"
+    # 压缩标签表达笛卡尔积；非矩形集合不能通过扩大兼容面假装往返。
+    actual=parse_wheel_filename(filename,validate_order=True)
+    if actual[0]!=canonicalize_name(name) or actual[1]!=parsed or actual[2]!=build or actual[3]!=values:
+        raise InvalidWheelFilename("不能无损压缩该tag/build集合")
+    return filename
+
+
+def build_sdist_filename(name,version,extension=".tar.gz"):
+    """构造标准sdist名称。@param name 项目名。@param version 版本。@param extension tar.gz或zip。@return 可逆标准名称。"""
+    if extension not in (".tar.gz",".zip"):raise InvalidSdistFilename("无效extension")
+    normalized=canonicalize_name(name,validate=True).replace("-","_")
+    parsed=version if isinstance(version,Version) else Version(version)
+    return f"{normalized}-{parsed}{extension}"
 
 
