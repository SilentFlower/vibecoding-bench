+def parse_legacy_sdist_filename(filename,expected_name=None):
+    """审查旧连字符版本，绝不静默选一解。@param filename 历史归档名。@param expected_name 可选已知项目名。@return 无期望时候选tuple，有期望时唯一(name,Version)。"""
+    if filename.endswith(".tar.gz"):stem=filename[:-7]
+    elif filename.endswith(".zip"):stem=filename[:-4]
+    else:raise InvalidSdistFilename("不支持的extension")
+    expected=canonicalize_name(expected_name,validate=True) if expected_name is not None else None
+    candidates=[]
+    for index,char in enumerate(stem):
+        if char!="-":continue
+        try:
+            name=canonicalize_name(stem[:index],validate=True)
+            version=Version(stem[index+1:])
+        except (InvalidName,InvalidVersion):continue
+        item=(name,version)
+        if expected is not None and name!=expected:continue
+        if item not in candidates:candidates.append(item)
+    if not candidates:raise InvalidSdistFilename("没有合法切分")
+    if expected is None:return tuple(candidates)
+    if len(candidates)!=1:raise InvalidSdistFilename("已知名称仍有歧义")
+    return candidates[0]
