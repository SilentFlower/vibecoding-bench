+"""按节点身份保存后序子树聚合，不向节点写入结果。"""
+from collections.abc import Mapping
+
+
+class NodeResultMap(Mapping):
+    """按实际对象身份索引的只读聚合结果。"""
+
+    def __init__(self):
+        """建立独立结果。@return None。"""
+        self._values = {}
+
+    def __getitem__(self, node):
+        """按身份读取。@param node 原节点。@return 聚合结果。"""
+        value = self._values.get(id(node))
+        if value is None or value[0] is not node:
+            raise KeyError(node)
+        return value[1]
+
+    def __iter__(self):
+        """按后序完成顺序遍历实际节点。@return 节点迭代器。"""
+        return (item[0] for item in self._values.values())
+
+    def __len__(self):
+        """返回实际节点数。@return int。"""
+        return len(self._values)
+
+
+def fold_subtree(node, reducer):
+    """只读后序聚合。@param node 根。@param reducer 接收节点和有序子结果的回调。@return NodeResultMap。"""
+    if not callable(reducer):
+        raise TypeError('聚合器必须可调用')
+    result, active = NodeResultMap(), set()
+    stack = [(node, None)]
+    while stack:
+        current, children = stack.pop()
+        if children is None:
+            identity = id(current)
+            if identity in active or identity in result._values:
+                raise ValueError('子树包含环或重复节点身份')
+            active.add(identity)
+            children = tuple(current.children)
+            stack.append((current, children))
+            stack.extend((child, None) for child in reversed(children))
+        else:
+            value = reducer(current, tuple(result[child] for child in children))
+            result._values[id(current)] = (current, value)
+            active.remove(id(current))
+    return result
