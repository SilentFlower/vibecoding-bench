@@ -0,0 +1,26 @@
+"""无递归、进入退出成对的单遍树事件迭代。"""
+from .abstractiter import AbstractIter
+
+
+class EventIter(AbstractIter):
+    """树事件迭代器。@param node 根。@param filter_ 节点显示过滤。
+    @param stop 子树剪枝。@param maxlevel 含根层数上限。
+    """
+
+    @staticmethod
+    def _iter(children, filter_, stop, maxlevel):
+        stack = [(child, 0, False, False) for child in reversed(children)]
+        while stack:
+            node, depth, leaving, visible = stack.pop()
+            if leaving:
+                if visible:
+                    yield ('leave', node, depth)
+                continue
+            visible = bool(filter_(node))
+            if visible:
+                yield ('enter', node, depth)
+            # 缓存同一次过滤结果，状态型过滤器也不能让已消费完整序列失去配对。
+            stack.append((node, depth, True, visible))
+            if maxlevel is None or depth + 1 < maxlevel:
+                for child in reversed(AbstractIter._get_children(node.children, stop)):
+                    stack.append((child, depth + 1, False, False))
