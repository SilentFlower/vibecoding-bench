+"""按显式属性复制策略构造独立子树，不复制父链或跟随链接目标。"""
+from collections.abc import Mapping
+
+
+def clone_subtree(node, *, factory=None, copy_attributes=None):
+    """复制节点及其children。@param node 原子树。@param factory kwargs节点工厂，默认AnyNode。
+    @param copy_attributes 属性映射复制回调，默认浅复制。@return 独立且无父节点的副本根。
+    """
+    from anytree.node import AnyNode, LightNodeMixin, NodeMixin
+
+    if factory is None:
+        factory = AnyNode
+    if copy_attributes is None:
+        copy_attributes = dict
+    if not callable(factory) or not callable(copy_attributes):
+        raise TypeError('节点工厂和属性复制策略必须可调用')
+    structural = {'parent', 'children', '_NodeMixin__parent', '_NodeMixin__children',
+        '_LightNodeMixin__parent', '_LightNodeMixin__children'}
+    sources, source_ids, stack = [], set(), [(node, None)]
+    while stack:
+        current, parent = stack.pop()
+        if id(current) in source_ids:
+            raise ValueError('子树包含环或重复节点身份')
+        if not hasattr(current, '__dict__'):
+            raise TypeError('克隆需要显式字典属性节点')
+        source_ids.add(id(current))
+        index = len(sources)
+        attributes = {key: value for key, value in current.__dict__.items() if key not in structural}
+        sources.append((current, parent, attributes))
+        stack.extend((child, index) for child in reversed(current.children))
+    copies, copy_ids = [], set()
+    for current, parent, attributes in sources:
+        attributes = copy_attributes(dict(attributes))
+        if not isinstance(attributes, Mapping) or set(attributes) & structural:
+            raise ValueError('复制策略必须返回不含结构字段的属性映射')
+        copied = factory(**dict(attributes))
+        if (not isinstance(copied, (NodeMixin, LightNodeMixin)) or id(copied) in source_ids
+                or id(copied) in copy_ids or copied.parent is not None or copied.children):
+            raise ValueError('节点工厂必须返回独立的空子级节点')
+        copies.append(copied)
+        copy_ids.add(id(copied))
+    # 所有工厂结果先验证再组装，不能因为返回原节点而移动用户正在编辑的源树。
+    for copied, (_, parent, _) in zip(copies, sources):
+        if parent is not None:
+            copied.parent = copies[parent]
+    return copies[0]
