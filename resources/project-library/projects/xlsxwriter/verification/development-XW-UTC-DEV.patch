+# 为带时区报表时间提供显式UTC写入接口
+
+先按真实时刻转换UTC再写入Excel，不能直接丢弃偏移。明确处理无时区策略、微秒、夏令时fold与1904日期模式，沿用原写入状态和格式，不全局改变remove_timezone。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/xlsxwriter/utc.py
+++ b/library/xlsxwriter/utc.py
@@ -0,0 +1,22 @@
+"""将明确时区时间转换为Excel的无时区UTC值。"""
+from datetime import datetime,timezone
+
+
+def as_utc(value,*,naive='raise'):
+    """标准化实际时间。@param value datetime。@param naive raise或utc。
+    @return 无tzinfo的UTC datetime，不修改原值。
+    """
+    if not isinstance(value,datetime) or naive not in ('raise','utc'):
+        raise ValueError('需要datetime和明确的无时区策略')
+    if value.utcoffset() is None:
+        if naive=='raise':
+            raise ValueError('无时区时间必须显式采用utc策略')
+        return value.replace(tzinfo=None)
+    return value.astimezone(timezone.utc).replace(tzinfo=None)
+
+
+def write_utc(worksheet,row,col,value,cell_format=None,*,naive='raise'):
+    """写入UTC时间。@param worksheet 原工作表。@param row 行。@param col 列。
+    @param value 时间。@param cell_format 原格式。@param naive 无时区策略。@return 原write_datetime状态。
+    """
+    return worksheet.write_datetime(row,col,as_utc(value,naive=naive),cell_format)
