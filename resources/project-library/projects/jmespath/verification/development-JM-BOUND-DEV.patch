+# 绑定编译查询与独立选项快照并支持显式单次覆盖
+
+可复用查询绑定编译结果及选项容器快照，调用方随后改Options不影响默认行为。单次覆盖和显式None有区别，仍共享显式自定义函数实例，每次解释器独立，常量结果不能污染下次。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/jmespath/bound.py
+++ b/library/jmespath/bound.py
@@ -0,0 +1,36 @@
+"""将编译查询与独立求值选项快照绑定。"""
+from . import compile
+from .visitor import Options
+
+
+_UNSET=object()
+
+
+def _snapshot(options):
+    if options is None:
+        return None
+    if not isinstance(options,Options):
+        raise TypeError('绑定选项必须为Options或None')
+    return Options(dict_cls=options.dict_cls,custom_functions=options.custom_functions)
+
+
+class BoundExpression:
+    """只编译一次，逐次新建解释器；自定义函数实例仍由调用者共享。"""
+    def __init__(self,expression,options=None):
+        """绑定表达式。@param expression JMESPath文本。@param options 原求值选项。@return None。
+        """
+        self._options=_snapshot(options)
+        self._compiled=compile(expression)
+
+    @property
+    def expression(self):
+        """获取原表达式。@return 编译文本。
+        """
+        return self._compiled.expression
+
+    def search(self,data,options=_UNSET):
+        """求值。@param data 原输入。@param options 缺省沿用绑定，显式None使用标准默认。
+        @return 真实查询结果；字面量沿用已完成的独立结果合同。
+        """
+        selected=self._options if options is _UNSET else _snapshot(options)
+        return self._compiled.search(data,options=selected)
