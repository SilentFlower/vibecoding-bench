--- a/library/bidict/records.py
+++ b/library/bidict/records.py
@@ -0,0 +1,43 @@
+"""使用显式类型codec交换版本化双向映射记录。"""
+from bidict import bidict
+
+
+def to_records(mapping, *, encode_key, encode_value, codec='explicit-v1'):
+    """编码有序pair记录，不强制JSON对象键字符串化。
+
+    :param mapping: 真实双向映射。
+    :param encode_key: 调用者提供的键编码。
+    :param encode_value: 调用者提供的值编码。
+    :param codec: 明确约定的非空codec标识。
+    :return: 可由标准JSON承载的schema1记录对象。
+    """
+    if not isinstance(codec, str) or not codec:
+        raise ValueError('codec标识不可为空')
+    return {'schema': 1, 'codec': codec, 'pairs': [[encode_key(key), encode_value(value)] for key, value in mapping.items()]}
+
+
+def from_records(document, *, decode_key, decode_value, codec='explicit-v1', cls=bidict):
+    """解码并严格校验双向唯一性，不从数据导入任意类。
+
+    :param document: schema1记录对象。
+    :param decode_key: 调用者提供的键解码。
+    :param decode_value: 调用者提供的值解码。
+    :param codec: 本次允许的codec标识。
+    :param cls: 调用者显式传入的结果类。
+    :return: 完整合法双向映射，重复记录明确失败。
+    """
+    if not isinstance(document, dict) or set(document) != {'schema', 'codec', 'pairs'} or document['schema'] != 1 or document['codec'] != codec:
+        raise ValueError('记录schema或codec不匹配')
+    if not isinstance(document['pairs'], list):
+        raise ValueError('pairs必须为列表')
+    items, keys, values = [], set(), set()
+    for position, pair in enumerate(document['pairs'], 1):
+        if not isinstance(pair, (list, tuple)) or len(pair) != 2:
+            raise ValueError('第%d项不是键值对' % position)
+        key, value = decode_key(pair[0]), decode_value(pair[1])
+        if key in keys or value in values:
+            raise ValueError('解码后关系不唯一：第%d项' % position)
+        keys.add(key)
+        values.add(value)
+        items.append((key, value))
+    return cls(items)
