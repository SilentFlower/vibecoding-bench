+class MappingCast(object):
+    """显式解析键值配置或JSON对象，不改变Csv与Config行为。
+
+    :param key_cast: 每个键的转换函数。
+    :param value_cast: 每个值的可选转换函数，默认保留解析值。
+    :param format: pairs或json。
+    :param delimiter: pairs模式的单字符分隔符。
+    :param duplicate: 转换后重复键采用error或last。
+    """
+    def __init__(self, key_cast=text_type, value_cast=undefined, *, format='pairs', delimiter=',', duplicate='error'):
+        """保存显式解析政策。参数见类说明。@return None。"""
+        if format not in ('pairs', 'json') or duplicate not in ('error', 'last'):
+            raise ValueError('未知映射解析政策')
+        if not isinstance(delimiter, str) or len(delimiter) != 1:
+            raise ValueError('键值分隔符必须为单个字符')
+        self.key_cast, self.value_cast = key_cast, value_cast
+        self.format, self.delimiter, self.duplicate = format, delimiter, duplicate
+
+    def __call__(self, value):
+        """先独立解析，再按转换后的键检测冲突。
+
+        :param value: 配置字符串或None。
+        :return: 新字典；格式和重复键错误明确失败。
+        """
+        import json
+        from csv import reader
+        from io import StringIO
+        if value is None:
+            return {}
+        if self.format == 'json':
+            class Pairs(list):
+                """区分JSON对象与数组，保留重复键。"""
+            pairs = json.loads(value, object_pairs_hook=Pairs)
+            if not isinstance(pairs, Pairs):
+                raise ValueError('配置必须是JSON对象')
+            def native(item):
+                """恢复嵌套JSON对象。@param item 值。@return 原生值。"""
+                if isinstance(item, Pairs):
+                    return {k: native(v) for k, v in item}
+                if isinstance(item, list):
+                    return [native(v) for v in item]
+                return item
+            pairs = [(k, native(v)) for k, v in pairs]
+        else:
+            rows = list(reader(StringIO(value), delimiter=self.delimiter, strict=True))
+            if len(rows) > 1:
+                raise ValueError('配置只接受一条键值记录')
+            pairs = []
+            for index, item in enumerate(rows[0] if rows else []):
+                if '=' not in item:
+                    raise ValueError('配置项缺少等号：第%d项' % (index + 1))
+                key, item = item.split('=', 1)
+                pairs.append((key.strip(), item.strip()))
+        result = {}
+        for key, item in pairs:
+            if key == '':
+                raise ValueError('配置键不可为空')
+            key = self.key_cast(key)
+            if key in result and self.duplicate == 'error':
+                raise ValueError('配置存在重复键')
+            result[key] = item if isinstance(self.value_cast, Undefined) else self.value_cast(item)
+        return result
