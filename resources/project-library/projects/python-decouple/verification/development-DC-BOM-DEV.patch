+def _repository_lines(stream, encoding):
+    """只在文件第一行消费UTF-8首标记，保持原open编码参数兼容。
+
+    :param stream: 已按用户编码打开的文本流。
+    :param encoding: 原文件编码参数。
+    :return: 保留后续全部字符的逐行迭代器。
+    """
+    utf8 = encoding is not None and lookup(encoding).name in ('utf-8', 'utf-8-sig')
+    for index, line in enumerate(stream):
+        yield line[1:] if utf8 and index == 0 and line.startswith('\ufeff') else line
 
 
