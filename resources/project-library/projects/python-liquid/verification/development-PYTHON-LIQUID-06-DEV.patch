+"""本地模板项目命令，实际渲染且通过同目录原子替换交付输出。"""
+import argparse
+import json
+import os
+import sys
+import tempfile
+from pathlib import Path
+from .environment import Environment
+from .builtin.loaders.file_system_loader import FileSystemLoader
+from .undefined import StrictUndefined
+
+def main(argv=None):
+    """执行本地render命令。@param argv 明确参数或None。@return 0成功/2失败，不写半成品或覆盖源模板/数据。"""
+    parser=argparse.ArgumentParser(prog='liquid-project')
+    parser.add_argument('--root',required=True,type=Path);parser.add_argument('--template',required=True)
+    parser.add_argument('--data',required=True,type=Path);parser.add_argument('--output',required=True,type=Path)
+    args=parser.parse_args(argv);temporary=None
+    try:
+        root=args.root.resolve(strict=True);data_path=args.data.resolve(strict=True);output=args.output.resolve()
+        if not root.is_dir():raise ValueError('模板根不是目录')
+        name=Path(args.template)
+        if name.is_absolute() or '..' in name.parts:raise ValueError('模板名不能逃逸根目录')
+        source=(root/name).resolve(strict=True)
+        if not source.is_relative_to(root) or not source.is_file():raise ValueError('模板来源无效')
+        if output==data_path or output.is_relative_to(root):raise ValueError('输出不能覆盖数据或模板根内文件')
+        data=json.loads(data_path.read_text(encoding='utf-8'))
+        if not isinstance(data,dict):raise ValueError('JSON数据根必须为object')
+        env=Environment(loader=FileSystemLoader(root),undefined=StrictUndefined)
+        rendered=env.get_template(args.template).render(data)
+        # 先完成全部渲染，再同目录fsync+replace；失败清理临时文件，原输出保持。
+        descriptor,temporary=tempfile.mkstemp(prefix='.liquid-',dir=output.parent)
+        with os.fdopen(descriptor,'w',encoding='utf-8',newline='') as target:
+            target.write(rendered);target.flush();os.fsync(target.fileno())
+        os.replace(temporary,output);temporary=None;return 0
+    except Exception as error:
+        print(json.dumps({'status':'failed','error':type(error).__name__}),file=sys.stderr);return 2
+    finally:
+        if temporary is not None:Path(temporary).unlink(missing_ok=True)
+
+if __name__=='__main__':raise SystemExit(main())
