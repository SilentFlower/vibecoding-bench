+# 实现完整引擎克隆与可嵌套临时选项作用域
+
+克隆保留引擎子类型、自定义规则与选项但不共享可变状态。临时作用域支持嵌套及失败回滚，数量None可明确清除，作用域内新增规则也撤销，不承诺内部容器身份和并发隔离。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/inflect/scopes.py
+++ b/library/inflect/scopes.py
@@ -0,0 +1,37 @@
+"""隔离可变词形引擎并精确限定临时选项生命周期。"""
+from contextlib import contextmanager
+from copy import deepcopy
+from . import engine
+
+
+_UNSET=object()
+
+
+def clone(target):
+    """复制实际引擎及自定义规则。@param target 引擎实例。@return 独立同类型引擎。
+    """
+    if not isinstance(target,engine):
+        raise TypeError('需要inflect引擎')
+    return deepcopy(target)
+
+
+@contextmanager
+def temporary_options(target,*,classical=None,count=_UNSET,gender=None):
+    """临时变更并恢复全部引擎状态值。@param target 原引擎。@param classical 模式映射。
+    @param count 持久数量，None清除。@param gender 代词性别。@return 原引擎上下文。
+    不保证内部容器身份或并发隔离；作用域内规则修改同样撤销。
+    """
+    if not isinstance(target,engine):
+        raise TypeError('需要inflect引擎')
+    before=deepcopy(target.__dict__)
+    try:
+        if classical is not None:
+            target.classical(**classical)
+        if count is not _UNSET:
+            target.num(count)
+        if gender is not None:
+            target.gender(gender)
+        yield target
+    finally:
+        target.__dict__.clear()
+        target.__dict__.update(before)
