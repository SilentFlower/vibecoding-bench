+# 提供有限前瞻的英语列表文本流并明确两项和末项分隔
+
+为大型报表输出提供有限前瞻的连接器，不物化整个词项流。零项、两项与多项规则明确，可控制牛津逗号且保留空词项，消费节奏受下游控制；已输出流不承诺回滚。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/inflect/streams.py
+++ b/library/inflect/streams.py
@@ -0,0 +1,38 @@
+"""只保留有限前瞻的英语列表文本流。"""
+_END=object()
+
+
+def iter_join(words,*,sep=', ',pair=' and ',final=', and '):
+    """流式连接文本词项。@param words 文本迭代器，不接受裸字符串。
+    @param sep 中间分隔。@param pair 两项分隔。@param final 三项以上末项分隔。
+    @return 文本块迭代器，最多前瞻三项；输出开始后来源错误不会回滚。
+    """
+    if isinstance(words,(str,bytes)) or any(not isinstance(value,str) for value in (sep,pair,final)):
+        raise TypeError('需要词项迭代器和文本分隔符')
+    iterator=iter(words)
+    def take():
+        value=next(iterator,_END)
+        if value is not _END and not isinstance(value,str):
+            raise TypeError('每个词项必须为文本')
+        return value
+    def produce():
+        first=take()
+        if first is _END:
+            return
+        second=take()
+        if second is _END:
+            yield first
+            return
+        third=take()
+        if third is _END:
+            yield first;yield pair;yield second
+            return
+        yield first
+        current=second;following=third
+        while True:
+            yield sep;yield current
+            current=following;following=take()
+            if following is _END:
+                yield final;yield current
+                return
+    return produce()
