+    def _validate_compare_to(self, condition, field, value):
+        """声明式比较归一化后的兄弟或根字段。
+
+        :param condition: 字段路径、受控操作符及缺失政策。
+        :param field: 当前字段。
+        :param value: 实际值。
+        :return: None，失败保留原生字段路径。
+
+        The rule's arguments are validated against this schema:
+        {'type': 'dict', 'schema': {
+            'field': {'type': 'string', 'required': True},
+            'operator': {'type': 'string', 'required': True, 'allowed': ['lt','le','eq','ne','ge','gt']},
+            'missing': {'type': 'string', 'allowed': ['ignore','error']}}}
+        """
+        from operator import lt, le, eq, ne, ge, gt
+        name, other = self._lookup_field(condition['field'])
+        if name is None:
+            if condition.get('missing', 'error') == 'error':
+                self._error(field, '比较目标字段缺失')
+            return
+        operation = {'lt': lt, 'le': le, 'eq': eq, 'ne': ne, 'ge': ge, 'gt': gt}[condition['operator']]
+        try:
+            valid = bool(operation(value, other))
+        except (TypeError, ValueError):
+            self._error(field, '字段值不可比较')
+            return
+        if not valid:
+            self._error(field, '字段比较约束不满足')
