--- a/library/bibtexparser/keywords.py
+++ b/library/bibtexparser/keywords.py
@@ -0,0 +1,73 @@
+"""保护花括号和转义的关键词双向中间件。"""
+from bibtexparser.middlewares.middleware import BlockMiddleware
+
+
+def _split(value, delimiter, keep_empty):
+    """按括号深度拆分。@param value 文本。@param delimiter 分隔符。@param keep_empty 保留空项。@return 列表。"""
+    result, buffer, depth, escaped = [], [], 0, False
+    for character in value:
+        if escaped:
+            buffer.append(character)
+            escaped = False
+            continue
+        if character == '\\':
+            buffer.append(character)
+            escaped = True
+            continue
+        if character == '{':
+            depth += 1
+        elif character == '}':
+            depth -= 1
+            if depth < 0:
+                raise ValueError('关键词括号不平衡')
+        if character == delimiter and depth == 0:
+            item = ''.join(buffer).strip()
+            if item or keep_empty:
+                result.append(item)
+            buffer = []
+        else:
+            buffer.append(character)
+    if depth != 0:
+        raise ValueError('关键词括号不平衡')
+    item = ''.join(buffer).strip()
+    if item or keep_empty:
+        result.append(item)
+    return result
+
+
+class SplitKeywords(BlockMiddleware):
+    """显式拆分keywords，保留保护括号和反斜杠。
+
+    :param delimiter: 单字符分隔符。
+    :param keep_empty: 是否保留空项。
+    """
+    def __init__(self, *, delimiter=',', keep_empty=False):
+        """保存分隔政策。参数见类说明。@return None。"""
+        super().__init__(allow_inplace_modification=False)
+        if not isinstance(delimiter, str) or len(delimiter) != 1 or delimiter in '{}\\':
+            raise ValueError('关键词分隔符无效')
+        self.delimiter, self.keep_empty = delimiter, keep_empty
+
+    def transform_entry(self, entry, library):
+        """转换真实keywords字段。@param entry 条目。@param library 文献库。@return 条目。"""
+        field = entry.get('keywords')
+        if field is not None:
+            if not isinstance(field.value, str):
+                raise TypeError('拆分前keywords必须为字符串')
+            field.value = _split(field.value, self.delimiter, self.keep_empty)
+        return entry
+
+
+class MergeKeywords(SplitKeywords):
+    """把关键词列表写回可逆的受保护字符串。"""
+    def transform_entry(self, entry, library):
+        """合并真实列表，必要时保护含分隔符的项。@param entry 条目。@param library 文献库。@return 条目。"""
+        field = entry.get('keywords')
+        if field is not None:
+            if not isinstance(field.value, list) or any(not isinstance(value, str) for value in field.value):
+                raise TypeError('合并前keywords必须为字符串列表')
+            parts = []
+            for value in field.value:
+                parts.append('{' + value + '}' if len(_split(value, self.delimiter, True)) > 1 else value)
+            field.value = self.delimiter.join(parts)
+        return entry
--- a/library/docs/development-bibtexparser-o04-dev.md
