--- a/library/bibtexparser/pages.py
+++ b/library/bibtexparser/pages.py
@@ -0,0 +1,31 @@
+"""仅规范明确数字页码范围的可选中间件。"""
+import re
+from bibtexparser.middlewares.middleware import BlockMiddleware
+
+
+class NormalizePages(BlockMiddleware):
+    """把明确数字页码范围写成BibTeX双连字符，不猜测其他写法。"""
+    def __init__(self):
+        """固定不修改输入块。@return None。"""
+        super().__init__(allow_inplace_modification=False)
+
+    def transform_entry(self, entry, library):
+        """只处理pages字段并保存首次原值。
+
+        :param entry: 真实Entry。
+        :param library: 当前Library。
+        :return: 页码规范后的Entry。
+        """
+        field = entry.get('pages')
+        if field is None or not isinstance(field.value, str):
+            return entry
+        ranges = []
+        for value in field.value.split(','):
+            match = re.fullmatch(r'\s*(\d+)\s*(?:--?|[–—])\s*(\d+)\s*', value)
+            if match is None or int(match[1]) > int(match[2]):
+                return entry
+            ranges.append(match[1] + '--' + match[2])
+        if 'original_pages' not in entry.parser_metadata:
+            entry.set_parser_metadata('original_pages', field.value)
+        field.value = ', '.join(ranges)
+        return entry
--- a/library/docs/development-bibtexparser-o03-dev.md
+++ b/library/docs/development-bibtexparser-o03-dev.md
@@ -0,0 +1,5 @@
+# 仅对明确数字页码范围执行可追溯规范化
+
+仅规范完整可识别的升序数字页码范围，支持多范围及Unicode横线，保留数字原文和首次来源。电子页码、单页、罗马页、倒序和混杂未知格式整体保持；不改标题或默认解析栈。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/tests/test_development_bibtexparser_o03_dev.py
+++ b/library/tests/test_development_bibtexparser_o03_dev.py
@@ -0,0 +1,25 @@
+"""页码中间件不影响标题或电子页码。"""
+from bibtexparser import Library
+from bibtexparser.model import Entry, Field
+
+def test_numeric_ranges():
+    """普通连字符和Unicode范围归一。@return None。"""
+    from bibtexparser.pages import NormalizePages
+    source = Library([Entry('article', 'x', [Field('pages', '12-19, 23–24'), Field('title', 'a-b')])])
+    result = NormalizePages().transform(source)
+    assert result.entries[0]['pages'] == '12--19, 23--24'
+    assert result.entries[0]['title'] == 'a-b' and source.entries[0]['pages'] == '12-19, 23–24'
+
+def test_unknown_and_descending_preserved():
+    """电子页、罗马页和倒序不猜测修复。@return None。"""
+    from bibtexparser.pages import NormalizePages
+    for pages in ('e123', 'iv-v', '9-2', '', '12.5-13.5'):
+        assert NormalizePages().transform(Library([Entry('article', 'x', [Field('pages', pages)])])).entries[0]['pages'] == pages
+
+def test_idempotent_and_original():
+    """重复规范不改变首次原始页码记录。@return None。"""
+    from bibtexparser.pages import NormalizePages
+    result = NormalizePages().transform(Library([Entry('article', 'x', [Field('pages', '1—3')])]))
+    again = NormalizePages().transform(result)
+    assert again.entries[0]['pages'] == '1--3'
+    assert again.entries[0].parser_metadata['original_pages'] == '1—3'
