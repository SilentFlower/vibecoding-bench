          "max_turns": 4,
          "evaluation": {
            "version": 1,
            "rubric": "verification/BF-D01.rubric.json",
            "semantic": true
          },
          "branches": [
            {
              "id": "result-evidence",
              "when": "The target, decorator options and actual caller/event evidence have not been supplied or declared unavailable, and the answer reasonably requests sufficient evidence.",
              "materials": [
