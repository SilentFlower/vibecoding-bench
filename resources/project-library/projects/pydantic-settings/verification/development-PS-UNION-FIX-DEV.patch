+"""分段环境变量字典联合值的公开回归。"""
+import pytest
+from pydantic_settings import BaseSettings, SettingsConfigDict
+
+
+class UnionValue(BaseSettings):
+    """读取隔离业务环境中的字典联合值。@param config 字符串或列表配置。"""
+    model_config = SettingsConfigDict(env_prefix="CYCLE_", env_nested_delimiter="__", env_file=None, cli_parse_args=False)
+    config: dict[str, list[str] | str] = {}
+
+
+@pytest.mark.parametrize("raw, expected", [("[]", []), ('["茶", "咖啡"]', ["茶", "咖啡"]), ("plain", "plain")])
+def test_nested_union_value_uses_actual_type(monkeypatch, raw, expected):
+    """列表解码但普通文本保持原值。@param monkeypatch 环境隔离。@param raw 环境值。@param expected 预期值。@return None。"""
+    monkeypatch.setenv("CYCLE_CONFIG__ITEM", raw)
+    assert UnionValue().config == {"item": expected}
