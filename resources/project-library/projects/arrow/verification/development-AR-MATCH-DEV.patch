+    def parse_match(self, datetime_string, fmt, normalize_whitespace=False):
+        """提取最早有效日期并保留原文位置。@param datetime_string 原文本。@param fmt 格式或格式列表。
+        @param normalize_whitespace 是否归一空白。@return 不可变ParsedDateTimeMatch。
+        """
+        if not isinstance(datetime_string, str) or type(normalize_whitespace) is not bool:
+            raise TypeError('原文和归一开关类型不合法')
+        formats = [fmt] if isinstance(fmt, str) else fmt
+        if not isinstance(formats, list) or not formats or any(not isinstance(item, str) for item in formats):
+            raise TypeError('格式必须是非空格式或格式列表')
+        text, starts, ends = datetime_string, list(range(len(datetime_string))), list(range(1, len(datetime_string)+1))
+        if normalize_whitespace:
+            parts, starts, ends = [], [], []
+            for item in re.finditer(r"\s+|\S", datetime_string):
+                parts.append(' ' if item.group(0).isspace() else item.group(0))
+                starts.append(item.start())
+                ends.append(item.end())
+            text = ''.join(parts)
+        candidates = []
+        for index, selected in enumerate(formats):
+            tokens, pattern = self._generate_pattern_re(selected)
+            if not tokens:
+                continue
+            for match in pattern.finditer(text):
+                if match.start() == match.end():
+                    continue
+                try:
+                    value = self.parse_strict(match.group(0), selected)
+                except (ValueError, TypeError):
+                    continue
+                first, last = starts[match.start()], ends[match.end()-1]
+                record = ParsedDateTimeMatch(value, selected, (first,last), datetime_string[first:last],
+                    datetime_string[:first], datetime_string[last:], match.span())
+                candidates.append((first,index,record))
+                break
+        if not candidates:
+            raise ParserMatchError('原文中没有有效日期匹配')
+        return min(candidates, key=lambda item: (item[0],item[1]))[2]
