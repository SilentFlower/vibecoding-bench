+class stop_before_idle_budget(stop_base):
+    """下一次等待将达到累计等待预算时停止，不计函数执行时间。"""
+    def __init__(self,budget):
+        """设置等待预算。@param budget 非负有限秒数或timedelta。@return None。
+        """
+        import math
+        if isinstance(budget,bool):
+            raise ValueError('预算不能为布尔值')
+        self.budget=_utils.to_seconds(budget)
+        if not math.isfinite(self.budget) or self.budget < 0:
+            raise ValueError('预算必须非负有限')
+
+    def __call__(self,retry_state):
+        """检查实际已等待及拟等待。@param retry_state 原调用状态。@return 是否停止。
+        """
+        return retry_state.idle_for + retry_state.upcoming_sleep >= self.budget
+
