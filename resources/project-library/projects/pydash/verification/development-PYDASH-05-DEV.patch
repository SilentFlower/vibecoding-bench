+"""在独立JSON副本提交多路径变更，失败无半成品。"""
+from copy import deepcopy
+from pydash.json_pointer import get_pointer,set_pointer,pointer_tokens,_index
+
+
+def patch_paths(document,operations):
+    """原子应用set/remove/test。@param document JSON树。@param operations 有序操作映射。@return 独立结果；任何失败不修改来源。"""
+    candidate=deepcopy(document)
+    for operation in operations:
+        if not isinstance(operation,dict):raise TypeError('operation必须为dict')
+        kind=operation.get('op');path=operation.get('path')
+        tokens=pointer_tokens(path)
+        if kind=='set':
+            if 'value' not in operation:raise ValueError('set需要value')
+            candidate=set_pointer(candidate,path,deepcopy(operation['value']))
+        elif kind=='test':
+            if 'value' not in operation:raise ValueError('test需要value')
+            if get_pointer(candidate,path)!=operation['value']:raise ValueError('test失败')
+        elif kind=='remove':
+            if not tokens:raise ValueError('不能删除根')
+            parent=candidate
+            for token in tokens[:-1]:
+                if isinstance(parent,dict):parent=parent[token]
+                elif isinstance(parent,list):parent=parent[_index(token,len(parent))]
+                else:raise TypeError('路径经过非JSON容器')
+            if isinstance(parent,dict):del parent[tokens[-1]]
+            elif isinstance(parent,list):del parent[_index(tokens[-1],len(parent))]
+            else:raise TypeError('路径经过非JSON容器')
+        else:raise ValueError('未知操作')
+    return candidate
