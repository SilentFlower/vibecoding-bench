--- a/library/src/pydash/async_flow.py
+++ b/library/src/pydash/async_flow.py
@@ -0,0 +1,19 @@
+"""显式异步flow，不创建或接管调用方事件循环。"""
+from inspect import isawaitable
+
+
+def async_flow(*functions):
+    """组合同步与异步步骤。@param functions 首步接全部参数，后续接上步结果。@return 可await组合函数，空链返回单输入或None。"""
+    if any(not callable(function) for function in functions):raise TypeError('所有步骤必须可调用')
+    async def invoke(*args,**kwargs):
+        """依次执行并传播异常与取消。@param args 首步位置参数。@param kwargs 首步命名参数。@return 末步已完成值。"""
+        if not functions:
+            if kwargs or len(args)>1:raise TypeError('空链仅接受零或一个位置参数')
+            return args[0] if args else None
+        result=functions[0](*args,**kwargs)
+        if isawaitable(result):result=await result
+        for function in functions[1:]:
+            result=function(result)
+            if isawaitable(result):result=await result
+        return result
+    return invoke
