--- a/library/src/pydash/json_pointer.py
+++ b/library/src/pydash/json_pointer.py
@@ -0,0 +1,53 @@
+"""显式RFC6901路径，只访问JSON dict/list，不访问Python属性。"""
+import re
+
+
+
+def pointer_tokens(pointer):
+    """解码JSON Pointer。@param pointer 空根或斜杠路径。@return 不可变段序列。"""
+    if not isinstance(pointer,str):raise TypeError('pointer必须为字符串')
+    if pointer=='':return ()
+    if not pointer.startswith('/'):raise ValueError('pointer必须以/开始')
+    result=[]
+    for token in pointer[1:].split('/'):
+        if re.search(r'~(?![01])',token):raise ValueError('无效~转义')
+        result.append(token.replace('~1','/').replace('~0','~'))
+    return tuple(result)
+
+
+def _index(token,size,append=False):
+    """校验JSON数组索引，不能把负数或前导零解释为Python索引。"""
+    if append and token=='-':return size
+    if not re.fullmatch(r'0|[1-9][0-9]*',token):raise ValueError('无效数组索引')
+    index=int(token)
+    if index>=size:raise IndexError(index)
+    return index
+
+
+def get_pointer(document,pointer):
+    """按精确JSON路径读取。@param document JSON树。@param pointer 路径。@return 原值。"""
+    current=document
+    for token in pointer_tokens(pointer):
+        if isinstance(current,dict):current=current[token]
+        elif isinstance(current,list):current=current[_index(token,len(current))]
+        else:raise TypeError('路径经过非JSON容器')
+    return current
+
+
+def set_pointer(document,pointer,value):
+    """只写既有父容器。@param document JSON树。@param pointer 精确路径，末段-可追加。@param value 新值。@return 根对象，空路径返回替换值。"""
+    tokens=pointer_tokens(pointer)
+    if not tokens:return value
+    current=document
+    for token in tokens[:-1]:
+        if isinstance(current,dict):current=current[token]
+        elif isinstance(current,list):current=current[_index(token,len(current))]
+        else:raise TypeError('路径经过非JSON容器')
+    token=tokens[-1]
+    if isinstance(current,dict):current[token]=value
+    elif isinstance(current,list):
+        index=_index(token,len(current),append=True)
+        if index==len(current):current.append(value)
+        else:current[index]=value
+    else:raise TypeError('路径经过非JSON容器')
+    return document
--- a/library/tests/test_development_pydash_04_dev.py
