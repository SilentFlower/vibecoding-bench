--- a/library/chardet/details.py
+++ b/library/chardet/details.py
@@ -0,0 +1,29 @@
+"""明确区分原始检测标签与Python解码可用性。"""
+from codecs import lookup
+from chardet import detect
+
+
+def detect_details(data, *, names='legacy'):
+    """保留真实推断事实并选择标签表示，不虚构特殊字节序codec。
+
+    :param data: bytes或bytearray。
+    :param names: legacy保留原标签，python选择可用规范codec名。
+    :return: 原标签、所选标签、codec可用性及真实confidence/language。
+    """
+    if names not in ('legacy', 'python'):
+        raise ValueError('未知编码名称模式')
+    if not isinstance(data, (bytes, bytearray)):
+        raise TypeError('检测输入必须为bytes或bytearray')
+    result = dict(detect(bytes(data)))
+    raw = result['encoding']
+    codec = None
+    if raw is not None:
+        try:
+            codec = lookup(raw).name
+        except LookupError:
+            pass
+    result.update(raw_encoding=raw, python_codec=codec, codec_available=codec is not None,
+        status='empty-or-no-match' if raw is None else 'ready' if codec is not None else 'unsupported-codec')
+    if names == 'python':
+        result['encoding'] = codec
+    return result
