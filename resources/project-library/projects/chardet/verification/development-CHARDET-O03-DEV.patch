--- a/library/chardet/files.py
+++ b/library/chardet/files.py
@@ -0,0 +1,51 @@
+"""有界且保留调用者流位置的文件检测入口。"""
+from os import PathLike, fspath
+from chardet import UniversalDetector
+
+
+def detect_file(source, *, preserve_position=True, chunk_size=65536, max_bytes=None):
+    """按需读取路径或二进制流，并报告实际覆盖边界。
+
+    :param source: 文本/PathLike路径或调用者持有的二进制流。
+    :param preserve_position: 是否恢复调用者流位置，默认需seek/tell可用。
+    :param chunk_size: 正整数读取块大小。
+    :param max_bytes: 可选非负字节上限，零不读取。
+    :return: 检测result、read_bytes、eof与budget_exhausted；未到EOF不声称全文覆盖。
+    """
+    if not isinstance(chunk_size, int) or isinstance(chunk_size, bool) or chunk_size <= 0:
+        raise ValueError('块大小必须为正整数')
+    if max_bytes is not None and (not isinstance(max_bytes, int) or isinstance(max_bytes, bool) or max_bytes < 0):
+        raise ValueError('字节上限必须为非负整数')
+    owned = isinstance(source, (str, PathLike))
+    if not owned and not hasattr(source, 'read'):
+        raise TypeError('需要文件路径或二进制流')
+    if max_bytes == 0:
+        return {'result': dict(UniversalDetector().close()), 'read_bytes': 0, 'eof': False, 'budget_exhausted': True}
+    stream = open(fspath(source), 'rb') if owned else source
+    offset = None
+    try:
+        if not owned and preserve_position:
+            try:
+                offset = stream.tell()
+                stream.seek(offset)
+            except (AttributeError, OSError) as error:
+                raise ValueError('保留位置需要可seek的流') from error
+        detector = UniversalDetector()
+        consumed, eof = 0, False
+        while not detector.done and (max_bytes is None or consumed < max_bytes):
+            limit = chunk_size if max_bytes is None else min(chunk_size, max_bytes - consumed)
+            chunk = stream.read(limit)
+            if not isinstance(chunk, (bytes, bytearray)):
+                raise TypeError('检测流必须返回字节')
+            if not chunk:
+                eof = True
+                break
+            consumed += len(chunk)
+            detector.feed(chunk)
+        return {'result': dict(detector.close()), 'read_bytes': consumed, 'eof': eof,
+            'budget_exhausted': max_bytes is not None and consumed >= max_bytes}
+    finally:
+        if owned:
+            stream.close()
+        elif offset is not None:
+            stream.seek(offset)
--- a/library/docs/development-chardet-o03-dev.md
