+# 为真实转换器配置精确Decimal字符串传输
+
+给单个真实转换器配置成对Decimal钩子，以字符串保持金额精度、指数及负零。拒绝二进制float、bool和坏文本，NaN/Infinity必须明确允许；嵌套记录可经既有JSON往返，其他实例和后注册用户钩子保持。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/cattrs/strategies/decimal.py
+++ b/library/src/cattrs/strategies/decimal.py
@@ -0,0 +1,27 @@
+"""显式使用十进制字符串传输精确金额。"""
+from decimal import Decimal, InvalidOperation
+
+
+def configure_decimal(converter, *, allow_special=False):
+    """给单个真实转换器配置成对Decimal钩子。
+
+    :param converter: BaseConverter/Converter或现有JSON/YAML预配置转换器。
+    :param allow_special: 是否明确允许NaN和Infinity。
+    :return: 同一转换器；不改变全局默认和其他实例。
+    """
+    def checked(value):
+        """校验精确值和特殊值政策。@param value Decimal。@return 同一值。"""
+        if not allow_special and not value.is_finite():
+            raise ValueError('十进制值必须有限')
+        return value
+    def structure(value, target):
+        """只从精确文本或整数结构。@param value 值。@param target 目标。@return Decimal。"""
+        if isinstance(value, bool) or not isinstance(value, (str, int, Decimal)):
+            raise TypeError('Decimal输入必须为精确文本或整数')
+        try:
+            return checked(Decimal(value))
+        except InvalidOperation as error:
+            raise ValueError('无效十进制文本') from error
+    converter.register_structure_hook(Decimal, structure)
+    converter.register_unstructure_hook(Decimal, lambda value: str(checked(value)))
+    return converter
--- a/library/tests/test_development_cattrs_o02_dev.py
