+"""缓存已完成异步结果，按事件循环隔离未完成任务。"""
+import asyncio
+import inspect
+import math
+from functools import wraps
+from time import monotonic
+from weakref import WeakKeyDictionary
+from funcy.calc import SkipMemory, _KWARGS_MARK
+
+
+def amemoize(function=None, *, ttl=None, key_func=None, clock=monotonic):
+    """对成功await值做循环隔离缓存，同键并发共享一个producer。
+
+    :param function: async函数，可省略以使用装饰器参数。
+    :param ttl: 可选非负有限秒数，零表示不保留完成值。
+    :param key_func: 复用Funcy调用键函数协议。
+    :param clock: TTL验证可注入的单调时钟。
+    :return: 有invalidate/invalidate_all/cache_info的async包装器。
+    """
+    if ttl is not None and (isinstance(ttl, bool) or not isinstance(ttl, (int, float)) or not math.isfinite(ttl) or ttl < 0):
+        raise ValueError('ttl必须为非负有限秒数')
+    if key_func is not None and not callable(key_func):
+        raise TypeError('key_func必须可调用')
+    def decorate(original):
+        if not inspect.iscoroutinefunction(original):
+            raise TypeError('amemoize只接受async函数')
+        states = WeakKeyDictionary()
+        def key(args, kwargs):
+            value = key_func(*args, **kwargs) if key_func else ((_KWARGS_MARK, args, frozenset(kwargs.items())) if kwargs else args)
+            hash(value)
+            return value
+        def state():
+            loop = asyncio.get_running_loop()
+            return states.setdefault(loop, {'values': {}, 'pending': {}, 'generation': 0, 'keys': {}})
+        def expire(selected):
+            now = clock()
+            for name, (value, until) in list(selected['values'].items()):
+                if until is not None and until <= now:
+                    selected['values'].pop(name, None)
+        @wraps(original)
+        async def wrapped(*args, **kwargs):
+            selected, name = state(), key(args, kwargs)
+            expire(selected)
+            if name in selected['values']:
+                return selected['values'][name][0]
+            task = selected['pending'].get(name)
+            if task is None:
+                generation = (selected['generation'], selected['keys'].get(name, 0))
+                async def produce():
+                    try:
+                        try:
+                            value = await original(*args, **kwargs)
+                        except SkipMemory as skip:
+                            return skip.args[0] if skip.args else None
+                        if generation == (selected['generation'], selected['keys'].get(name, 0)) and ttl != 0:
+                            selected['values'][name] = (value, None if ttl is None else clock() + ttl)
+                        return value
+                    finally:
+                        if selected['pending'].get(name) is asyncio.current_task():
+                            selected['pending'].pop(name, None)
+                task = asyncio.create_task(produce())
+                selected['pending'][name] = task
+                # 所有等待者取消后producer仍按明确政策运行，消费失败避免未取异常警告。
+                task.add_done_callback(lambda done: None if done.cancelled() else done.exception())
+            return await asyncio.shield(task)
+        def invalidate(*args, **kwargs):
+            name = key(args, kwargs)
+            for selected in list(states.values()):
+                selected['values'].pop(name, None)
+                selected['pending'].pop(name, None)
+                selected['keys'][name] = selected['keys'].get(name, 0) + 1
+        def invalidate_all():
+            for selected in list(states.values()):
+                selected['values'].clear()
+                selected['pending'].clear()
+                selected['generation'] += 1
+        def cache_info():
+            selected = state()
+            expire(selected)
+            return {'size': len(selected['values']), 'pending': len(selected['pending'])}
+        wrapped.invalidate, wrapped.invalidate_all, wrapped.cache_info = invalidate, invalidate_all, cache_info
+        return wrapped
+    return decorate if function is None else decorate(function)
+
+
+def acache(timeout, *, key_func=None, clock=monotonic):
+    """按明确TTL缓存已完成异步值。@param timeout 秒数。@return 装饰器。"""
+    return amemoize(ttl=timeout, key_func=key_func, clock=clock)
+
+
+amemoize.skip = acache.skip = SkipMemory
