+# 知识文档显式允许SSH与URN等URI自动链接策略
+
+路线05：新增显式启用的URI自动链接扩展，按实例白名单支持SSH/URN等完整URI，属性交由真实serializer转义，显示文本不二次行内解析。危险协议配置拒绝、代码内不展开、普通HTML及原链接兼容；不是整文HTML清洗器。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/library/markdown/extensions/uri_autolink.py
+++ b/library/markdown/extensions/uri_autolink.py
@@ -0,0 +1,43 @@
+"""显式scheme白名单的URI自动链接扩展，不替代HTML清洗器。"""
+import re
+import xml.etree.ElementTree as etree
+from . import Extension
+from ..inlinepatterns import InlineProcessor
+from ..util import AtomicString
+
+
+class UriInlineProcessor(InlineProcessor):
+    """只将允许的URI文本构成真实链接。@param pattern 模式。@param md Markdown。@param schemes 白名单。"""
+    def __init__(self,pattern,md,schemes):
+        """保存本实例独立政策。@param pattern 模式。@param md 转换器。@param schemes 白名单。@return None。"""
+        super().__init__(pattern,md);self.schemes=schemes
+
+    def handleMatch(self,match,data):
+        """建立由serializer转义的属性和字面显示文本。@param match 命中。@param data 行内文本。@return 元素与匹配范围。"""
+        value=match.group(1);scheme=value.split(':',1)[0].lower()
+        if scheme not in self.schemes:return None,None,None
+        element=etree.Element('a');element.set('href',value);element.text=AtomicString(value)
+        return element,match.start(0),match.end(0)
+
+
+class UriAutolinkExtension(Extension):
+    """可选URI自动链接。@param schemes 允许的scheme序列。"""
+    def __init__(self,**kwargs):
+        """验证白名单不允许主动脚本协议。@param kwargs 配置。@return None。"""
+        self.config={'schemes':[('http','https','ssh','urn'),'明确允许的scheme序列']}
+        super().__init__(**kwargs)
+        values=self.getConfig('schemes')
+        if isinstance(values,str):raise ValueError('schemes必须是序列')
+        normalized=frozenset(value.lower() for value in values)
+        if any(re.fullmatch(r'[a-z][a-z0-9+.-]*',value) is None for value in normalized) or normalized&{'javascript','vbscript','data'}:raise ValueError('URI scheme白名单不合法')
+        self.schemes=normalized
+
+    def extendMarkdown(self,md):
+        """注册在原始HTML前且代码片段后。@param md Markdown实例。@return None。"""
+        processor=UriInlineProcessor(r'<([a-zA-Z][a-zA-Z0-9+.-]*:[^<>\s]+)>',md,self.schemes)
+        md.inlinePatterns.register(processor,'markdown.extensions.uri_autolink',125)
+
+
+def makeExtension(**kwargs):
+    """创建独立扩展实例。@param kwargs 配置。@return UriAutolinkExtension。"""
+    return UriAutolinkExtension(**kwargs)
