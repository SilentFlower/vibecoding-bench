+"""显式编码和流所有权的文件转换入口，返回真实结构化结果。"""
+import io
+import os
+import stat
+import tempfile
+from pathlib import Path
+from .results import convert_document
+
+
+def convert_file(input,output=None,input_encoding='utf-8',output_encoding='utf-8',close_input=False,**options):
+    """转换路径或调用方流，不静默关闭外部对象。@param input 路径或可读流。@param output 路径/可写流/None。@param input_encoding 字节解码。@param output_encoding 输出编码。@param close_input 是否主动关闭调用方输入。@param options 真实转换选项。@return ConversionResult。"""
+    if type(close_input) is not bool:raise ValueError('close_input必须为bool')
+    owned=isinstance(input,(str,os.PathLike))
+    try:
+        if owned:raw=Path(input).read_bytes()
+        else:raw=input.read()
+        text=raw.decode(input_encoding) if isinstance(raw,bytes) else raw
+        if not isinstance(text,str):raise TypeError('输入流必须返回str或bytes')
+        result=convert_document(text,**options)
+        if output is None:return result
+        if not isinstance(output,(str,os.PathLike)):
+            payload=result.html.encode(output_encoding) if isinstance(output,(io.BufferedIOBase,io.RawIOBase)) else result.html
+            output.write(payload)
+            return result
+        # 先编码全部结果，失败时不截断目标路径；路径输出采用原子替换。
+        payload=result.html.encode(output_encoding);target=Path(output);info=target.lstat() if target.exists() or target.is_symlink() else None
+        if info is not None and not stat.S_ISREG(info.st_mode):raise ValueError('输出路径必须是普通文件')
+        temporary=None
+        try:
+            descriptor,temporary=tempfile.mkstemp(prefix='.'+target.name+'.',dir=target.parent)
+            with os.fdopen(descriptor,'wb') as destination:
+                if info is not None:os.fchmod(destination.fileno(),stat.S_IMODE(info.st_mode))
+                destination.write(payload);destination.flush();os.fsync(destination.fileno())
+            os.replace(temporary,target);temporary=None
+        finally:
+            if temporary is not None:os.unlink(temporary)
+        return result
+    finally:
+        if close_input and not owned:input.close()
