+        @param column_types 必须显式提供的列类型。@param kwargs 本次格式选项。@return 惰性字符串迭代器。
+        """
+        name=format_name or self._format_name
+        streaming=set(delimited_output_adapter.supported_formats+tsv_output_adapter.supported_formats+json_output_adapter.supported_formats)
+        if name not in streaming:
+            raise ValueError('该格式需要完整表格布局，不能逐行导出')
+        headers=tuple(headers)
+        if column_types is None:
+            raise ValueError('逐行导出必须明确列类型，避免隐式缓存整份数据')
+        column_types=tuple(column_types)
+        if len(column_types)!=len(headers):
