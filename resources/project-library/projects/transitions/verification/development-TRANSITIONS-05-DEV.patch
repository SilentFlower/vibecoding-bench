+    def dispatch_report(self, trigger, *args, collect_errors=True, **kwargs):
+        """同步多模型逐项分发。@param trigger 事件。@param args 事件位置参数。@param collect_errors 是否错误后继续。@param kwargs 事件命名参数。@return 按模型顺序的结果tuple。"""
+        import inspect
+
+        if self.has_queue:
+            raise ValueError("queued接收不能冒充最终结果")
+        models = tuple(self.models)
+        methods = [getattr(model, trigger) for model in models]
+        if any(inspect.iscoroutinefunction(method) for method in methods):
+            raise ValueError("异步事件须使用异步入口")
+        results = []
+        for index, (model, method) in enumerate(zip(models, methods)):
+            before = getattr(model, self.model_attribute)
+            try:
+                value = method(*args, **kwargs)
+            except Exception as error:
+                results.append(
+                    {
+                        "index": index,
+                        "model": model,
+                        "source": before,
+                        "dest": getattr(model, self.model_attribute),
+                        "status": "failed",
+                        "result": None,
+                        "error_type": type(error).__name__,
+                    }
+                )
+                if not collect_errors:
+                    break
+            else:
+                results.append(
+                    {
+                        "index": index,
+                        "model": model,
+                        "source": before,
+                        "dest": getattr(model, self.model_attribute),
+                        "status": "succeeded" if value else "rejected",
+                        "result": value,
+                        "error_type": None,
+                    }
+                )
+        return tuple(results)
+
