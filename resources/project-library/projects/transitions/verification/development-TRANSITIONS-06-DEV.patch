+    def explain_event(self, model, trigger, *args, **kwargs):
+        """显式执行同步平面规则诊断。@param model 绑定模型。@param trigger 事件。@param args 事件参数。@param kwargs 命名参数。@return 条件pass/fail/skipped/error与整体allowed，不执行迁移。"""
+        if self.has_queue:
+            raise ValueError("仅支持同步非排队规则诊断")
+        if not any(item is model for item in self.models):
+            raise ValueError("模型未绑定")
+        state = self.get_model_state(model)
+        event = self.events.get(trigger)
+        candidates = []
+        allowed = False
+        finished = False
+        for ordinal, transition in enumerate(
+            event.transitions.get(state.name, ()) if event is not None else ()
+        ):
+            row = {
+                "ordinal": ordinal,
+                "source": transition.source,
+                "dest": transition.dest,
+                "status": "skipped",
+                "conditions": [
+                    {
+                        "index": index,
+                        "target": condition.target,
+                        "status": "skipped",
+                        "error_type": None,
+                    }
+                    for index, condition in enumerate(transition.conditions)
+                ],
+                "error_type": None,
+            }
+            candidates.append(row)
+            if finished:
+                continue
+            data = EventData(state, event, self, model, args, kwargs)
+            data.transition = transition
+            try:
+                self.callbacks(self.prepare_event, data)
+                self.callbacks(transition.prepare, data)
+                row["status"] = "passed"
+                for condition, result in zip(transition.conditions, row["conditions"]):
+                    try:
+                        passed = condition.check(data)
+                    except Exception as error:
+                        result["status"] = "error"
+                        result["error_type"] = type(error).__name__
+                        raise
+                    result["status"] = "pass" if passed else "fail"
+                    if not passed:
+                        row["status"] = "failed"
+                        break
+            except Exception as error:
+                row["status"] = "error"
+                row["error_type"] = type(error).__name__
+                finished = True
+            else:
+                if row["status"] == "passed":
+                    allowed = True
+                    finished = True
+        return {
+            "trigger": trigger,
+            "state": state.name,
+            "allowed": allowed,
+            "candidates": candidates,
+        }
