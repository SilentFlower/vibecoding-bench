+    def preview_event(self, model, trigger):
+        """只读预览同步平面流程结构。@param model 已绑定模型。@param trigger 事件名。@return 候选路径与unknown可运行性，不执行任何规则。"""
+        if not any(item is model for item in self.models):
+            raise ValueError("模型未绑定")
+        state = self.get_model_state(model)
+        event = self.events.get(trigger)
+        if event is None:
+            return {
+                "trigger": trigger,
+                "state": state.name,
+                "candidates": [],
+                "runnable": "unknown",
+            }
+
+        def label(callback):
+            return (
+                callback
+                if isinstance(callback, string_types)
+                else "<callable:" + type(callback).__name__ + ">"
+            )
+
+        candidates = []
+        for ordinal, transition in enumerate(event.transitions.get(state.name, ())):
+            candidates.append(
+                {
+                    "ordinal": ordinal,
+                    "source": transition.source,
+                    "dest": transition.dest,
+                    "conditions": [
+                        {
+                            "index": index,
+                            "callback": label(condition.func),
+                            "target": condition.target,
+                        }
+                        for index, condition in enumerate(transition.conditions)
+                    ],
+                    "prepare": [label(callback) for callback in transition.prepare],
+                    "before": [label(callback) for callback in transition.before],
+                    "after": [label(callback) for callback in transition.after],
+                    "runnable": "unknown",
+                }
+            )
+        return {
+            "trigger": trigger,
+            "state": state.name,
+            "candidates": candidates,
+            "runnable": "unknown",
+        }
