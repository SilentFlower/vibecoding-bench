+++ b/library/src/werkzeug/request_id.py
@@ -0,0 +1,32 @@
+"""在真实WSGI生命周期中传递一个经过验证的请求标识。"""
+import re
+from uuid import uuid4
+
+
+_PATTERN=re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,63}')
+
+
+class RequestIdMiddleware:
+    """透明保留应用迭代器、write返回与关闭行为。"""
+    def __init__(self,app,*,factory=None):
+        """建立中间件。@param app 原WSGI应用。@param factory 可选标识生成函数。@return None。
+        """
+        if not callable(app) or (factory is not None and not callable(factory)):
+            raise TypeError('应用及标识工厂必须可调用')
+        self.app=app;self.factory=factory or (lambda:uuid4().hex)
+
+    def __call__(self,environ,start_response):
+        """执行一次请求。@param environ WSGI环境。@param start_response 原开始响应函数。
+        @return 原应用迭代器，不预读、不替换其close。
+        """
+        value=environ.get('HTTP_X_REQUEST_ID')
+        if not isinstance(value,str) or not _PATTERN.fullmatch(value):
+            value=self.factory()
+        if not isinstance(value,str) or not _PATTERN.fullmatch(value):
+            raise ValueError('生成的请求标识不满足合同')
+        environ['werkzeug.request_id']=value
+        def begin(status,headers,exc_info=None):
+            headers=[(key,item) for key,item in headers if key.lower()!='x-request-id']
+            headers.append(('X-Request-ID',value))
+            return start_response(status,headers,exc_info) if exc_info is not None else start_response(status,headers)
+        return self.app(environ,begin)
