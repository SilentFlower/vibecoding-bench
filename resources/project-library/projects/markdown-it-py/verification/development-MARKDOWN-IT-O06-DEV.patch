+    def _check_editable_child(self, node):
+        """在任何修改前拒绝叶节点容器、根移动及祖先循环。@return None。"""
+        if not (self.is_root or self.is_nested or self.token is not None and self.token.children is not None):
+            raise ValueError('叶节点不能拥有子节点')
+        if not isinstance(node, SyntaxTreeNode) or node.is_root:
+            raise ValueError('只能插入非根语法节点')
+        ancestor = self
+        while ancestor is not None:
+            if ancestor is node:
+                raise ValueError('语法树不能形成循环')
+            ancestor = ancestor.parent
+
+    def _sync_token_children(self):
+        """行内/图片Token持有原children，编辑树后必须同步实际渲染来源。@return None。"""
+        if self.token is not None:
+            self.token.children = [token for child in self.children for token in child.to_tokens()]
+
+    def insert_child(self, index, node):
+        """在原序列插入点移动或新增节点，同时维护双向归属。
+
+        :param index: 修改前0..len(children)的插入位置。
+        :param node: 非根节点，已有父节点时先安全移出。
+        :return: 插入节点本身。
+        """
+        self._check_editable_child(node)
+        if isinstance(index, bool) or not isinstance(index, int) or not 0 <= index <= len(self.children):
+            raise IndexError('子节点插入位置越界')
+        old_parent = node.parent
+        if old_parent is self:
+            old_index = self.children.index(node)
+            if old_index < index:
+                index -= 1
+        if old_parent is not None:
+            old_parent.remove_child(node)
+        self.children.insert(index, node)
+        node.parent = self
+        self._sync_token_children()
+        return node
+
+    def append_child(self, node):
+        """追加或移动节点到末尾。@param node 非根节点。@return 插入节点。"""
+        return self.insert_child(len(self.children), node)
+
+    def remove_child(self, node):
+        """移除直接子节点并解除父链。@param node 直接子节点。@return 被移除节点。"""
+        if node.parent is not self or node not in self.children:
+            raise ValueError('不是当前容器的直接子节点')
+        self.children.remove(node)
+        node.parent = None
+        self._sync_token_children()
+        return node
+
+    def replace_child(self, old, new):
+        """用新节点替换直接子节点，移动前完整检查循环。
+
+        :param old: 当前直接子节点。
+        :param new: 允许来自另一父节点的非根替代节点。
+        :return: 被移除的旧节点。
+        """
+        if old.parent is not self or old not in self.children:
+            raise ValueError('旧节点不是当前直接子节点')
+        self._check_editable_child(new)
+        if old is new:
+            return old
+        if new.parent is not None:
+            new.parent.remove_child(new)
+        index = self.children.index(old)
+        self.remove_child(old)
+        self.insert_child(index, new)
+        return old
 
