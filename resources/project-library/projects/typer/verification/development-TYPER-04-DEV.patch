+# 本地订单履约汇总重复SKU后全单验证并交付库存与凭据
+
+完整订单履约先按首次出现顺序汇总重复sku，正整数/未知商品/合计库存全单检查；一次生成新清单并给真实前后量凭据，空批次复制，任何坏行/不足整批不交付。
+
+交付包含真实实现、公开正反回归、兼容说明及完整冻结上游回归；不修改原始测试或控制配置。
--- a/app/inventory_fulfill.py
+++ b/app/inventory_fulfill.py
@@ -0,0 +1,30 @@
+"""订单履约先汇总重复SKU并全单检查，再交付扣减清单。"""
+import json
+from pathlib import Path
+from typing import Annotated
+import typer
+from inventory_store import load,save_catalog
+
+def register(app):
+    """注册fulfill命令。@param app 既有应用。@return None。"""
+    @app.command('fulfill')
+    def fulfill(source:Path,orders:Path,output:Annotated[Path,typer.Option('--output')]):
+        """完整履约一个本地订单批次。@param source 账面清单。@param orders sku/quantity数组。@param output 新清单。@return None，未知/不足/坏单全体拒绝。"""
+        try:
+            values=load(source);catalog={item['sku']:item for item in values};raw=json.loads(orders.read_text(encoding='utf-8'))
+            if not isinstance(raw,list):raise ValueError('订单须为数组')
+            totals={}
+            for item in raw:
+                if not isinstance(item,dict) or not isinstance(item.get('sku'),str) or type(item.get('quantity')) is not int or item['quantity']<=0:raise ValueError('订单sku/正整数quantity无效')
+                sku=item['sku']
+                if sku not in catalog:raise ValueError('订单含未知sku')
+                totals[sku]=totals.get(sku,0)+item['quantity']
+            receipt=[]
+            for sku,quantity in totals.items():
+                item=catalog[sku];before=item['quantity']
+                if quantity>before:raise ValueError('订单总量超过库存')
+                item['quantity']-=quantity;receipt.append({'sku':sku,'fulfilled':quantity,'before':before,'after':item['quantity']})
+            save_catalog(output,values,inputs=(source,orders))
+        except (OSError,UnicodeError,ValueError) as error:
+            typer.echo('履约失败：'+str(error),err=True);raise typer.Exit(1) from error
+        typer.echo(json.dumps({'orders':len(raw),'items':receipt},ensure_ascii=False))
