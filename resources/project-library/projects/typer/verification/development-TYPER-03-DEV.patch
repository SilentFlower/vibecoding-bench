+"""库存调账生成完整新清单，原账面文件只读。"""
+import json
+from pathlib import Path
+from typing import Annotated
+import typer
+from inventory_store import load,save_catalog
+
+def register(app):
+    """注册adjust命令。@param app 既有应用。@return None。"""
+    @app.command('adjust')
+    def adjust(source:Path,sku:Annotated[str,typer.Option('--sku')],delta:Annotated[int,typer.Option('--delta')],output:Annotated[Path,typer.Option('--output')]):
+        """按指定sku调账。@param source 原清单。@param sku 存在商品。@param delta 有符号整数变化。@param output 新清单。@return None，低于零/未知sku/坏清单不交付。"""
+        try:
+            values=load(source);item=next((item for item in values if item['sku']==sku),None)
+            if item is None:raise ValueError('未知sku')
+            before=item['quantity'];after=before+delta
+            if after<0:raise ValueError('库存不能小于零')
+            item['quantity']=after;save_catalog(output,values,inputs=(source,))
+        except (OSError,UnicodeError,ValueError) as error:
+            typer.echo('调账失败：'+str(error),err=True);raise typer.Exit(1) from error
+        typer.echo(json.dumps({'sku':sku,'before':before,'delta':delta,'after':after},ensure_ascii=False))
