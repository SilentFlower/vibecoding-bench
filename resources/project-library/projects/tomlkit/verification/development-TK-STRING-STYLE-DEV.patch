+    def replace_value(self, value, *, fallback=False):
+        """保留引号类型替换语义值。@param value 新字符串。@param fallback 不可表示时改用基本字符串。
+        @return 独立String与独立Trivia，不改变原节点。
+        """
+        if not isinstance(value,str) or type(fallback) is not bool:
+            raise TypeError('字符串值和fallback类型无效')
+        try:
+            result=type(self).from_raw(value,self.type)
+        except InvalidStringError:
+            if not fallback:
+                raise
+            target=StringType.MLB if self.type.is_multiline() else StringType.SLB
+            result=type(self).from_raw(value,target)
+        result._trivia=self.trivia.copy()
+        return result
+
