+def test_inline_dotted_last_leaf_retains_empty_parents() -> None:
+    """叶子删除必须保留仍存在的逻辑父表。@return None。"""
+    for source, path, expected in [
+        ('t = {a="", b.c=1, d=1}\n', ('b', 'c'), {"a": "", "b": {}, "d": 1}),
+        ('t = {b.c=1}\n', ('b', 'c'), {"b": {}}),
+        ('t = {b.c.d=1}\n', ('b', 'c', 'd'), {"b": {"c": {}}}),
+    ]:
+        doc = parse(source)
+        parent = doc["t"]
+        for part in path[:-1]:
+            parent = parent[part]
+        del parent[path[-1]]
+        assert doc.unwrap() == {"t": expected}
+        assert parse(doc.as_string()).unwrap() == {"t": expected}
