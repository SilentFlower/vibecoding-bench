+    def __imul__(self, count: Any) -> Array:
+        """同步原位重复。@param count 支持索引协议的计数。@return 原数组。"""
+        count = index(count)
+        if count <= 0:
+            self.clear()
+        elif count > 1:
+            # 快照避免迭代增长中的数组，并通过既有插入通道维护文本与索引。
+            original = tuple(self)
+            for _ in range(count - 1):
+                self.extend(original)
+        return self
