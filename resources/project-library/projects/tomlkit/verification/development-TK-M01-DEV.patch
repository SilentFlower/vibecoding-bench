+def test_array_inplace_repeat_preserves_binding_and_rendering() -> None:
+    """核原位重复、索引计数及后续编辑。@return None。"""
+    from operator import imul
+
+    for count in (0, -1, 1, 2, 3, False, True):
+        source = "a = [1, 2] # tail\n"
+        doc = parse(source)
+        array = doc["a"]
+        result = imul(array, count)
+        expected = [1, 2] * count
+        assert result is array is doc["a"]
+        assert array.unwrap() == expected
+        assert parse(doc.as_string()).unwrap()["a"] == expected
+        if count == 1:
+            assert doc.as_string() == source
+        array.append(9)
+        expected.append(9)
+        assert parse(doc.as_string()).unwrap()["a"] == expected
+
+
+def test_array_inplace_repeat_preserves_nested_references() -> None:
+    """重复可变元素沿 Python list 共享引用。@return None。"""
+    doc = parse("a = [[1]]\n")
+    array = doc["a"]
+    array *= 2
+    assert array[0] is array[1]
+    array[0].append(2)
+    assert parse(doc.as_string()).unwrap()["a"] == [[1, 2], [1, 2]]
