+# 单次原子替换配置中的多项更新与删除
+
+配置编辑器一次提交多项更新和删除，只进行一次原子替换。先校验并序列化全部输入，保留非目标原始字节，去掉目标重复定义，缺失项按顺序追加，正确转义多行、反斜杠与引号，继续保留文件权限和失败清理。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/src/dotenv/editing.py
+++ b/library/src/dotenv/editing.py
@@ -0,0 +1,44 @@
+"""单次原子替换多项配置，原始非目标记录逐字保留。"""
+import io
+from collections.abc import Mapping
+from .main import rewrite
+from .parser import parse_stream
+
+
+def update_keys(path, updates, *, remove=(), encoding='utf-8', follow_symlinks=False):
+    """原子批量编辑。@param path 文件。@param updates 合法键到字符串值的映射。
+    @param remove 删除键序列。@param encoding 编码。@param follow_symlinks 是否跟随符号链接。
+    @return 更新键及删除键元组；校验或序列化失败不打开目标。
+    """
+    if not isinstance(updates, Mapping):
+        raise TypeError('更新必须是映射')
+    updates, remove = dict(updates), tuple(dict.fromkeys(remove))
+    for key in (*updates, *remove):
+        if not isinstance(key, str) or not key or any(c in key for c in "\r\n\x00='\"# \t"):
+            raise ValueError('无效配置键')
+    if set(updates).intersection(remove):
+        raise ValueError('同一键不能同时更新与删除')
+    for value in updates.values():
+        if not isinstance(value, str) or '\x00' in value:
+            raise ValueError('配置值必须为无NUL字符串')
+    lines = {key: key + "='" + value.replace('\\', '\\\\').replace("'", "\\'") + "'\n" for key, value in updates.items()}
+    with rewrite(path, encoding=encoding, follow_symlinks=follow_symlinks) as (source, destination):
+        seen, ended = set(), True
+        for binding in parse_stream(source):
+            if binding.key in remove:
+                continue
+            if binding.key in updates:
+                if binding.key not in seen:
+                    destination.write(lines[binding.key])
+                    ended = True
+                    seen.add(binding.key)
+            else:
+                destination.write(binding.original.string)
+                if binding.original.string:
+                    ended = binding.original.string.endswith(('\n', '\r'))
+        for key in (key for key in updates if key not in seen):
+            if not ended:
+                destination.write('\n')
+            destination.write(lines[key])
+            ended = True
+    return tuple(updates), remove
