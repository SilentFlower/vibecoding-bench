+++ b/library/src/dotenv/validation.py
@@ -0,0 +1,45 @@
+"""严格读取配置而不操作进程环境。"""
+from dataclasses import dataclass
+from io import StringIO
+from types import MappingProxyType
+from .parser import parse_stream
+
+
+@dataclass(frozen=True)
+class ParsedConfig:
+    """已验证配置与末次定义的原始行号。"""
+    values: object
+    lines: object
+
+
+class ConfigValidationError(ValueError):
+    """只保存键和位置的错误，不泄漏配置值。"""
+    def __init__(self, issues):
+        """保存确定顺序的诊断。@param issues code/key/line。@return None。"""
+        self.issues = tuple(issues)
+        super().__init__('配置未通过验证：' + ', '.join(item[0] for item in self.issues))
+
+
+def parse_config(text, *, required=(), duplicates='error'):
+    """严格解析文本。@param text 配置文本。@param required 必须有值的键。
+    @param duplicates error或last。@return 只读ParsedConfig；失败不返回部分结果。
+    """
+    if not isinstance(text, str):
+        raise TypeError('配置必须是字符串')
+    if duplicates not in ('error', 'last'):
+        raise ValueError('未知重复键策略')
+    values, lines, issues = {}, {}, []
+    for binding in parse_stream(StringIO(text)):
+        if binding.error:
+            issues.append(('syntax', None, binding.original.line))
+        elif binding.key is not None:
+            if binding.key in values and duplicates == 'error':
+                issues.append(('duplicate', binding.key, binding.original.line))
+            values[binding.key] = binding.value
+            lines[binding.key] = binding.original.line
+    for key in dict.fromkeys(required):
+        if key not in values or values[key] is None:
+            issues.append(('required', key, lines.get(key)))
+    if issues:
+        raise ConfigValidationError(issues)
+    return ParsedConfig(MappingProxyType(values), MappingProxyType(lines))
