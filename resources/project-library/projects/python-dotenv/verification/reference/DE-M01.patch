+@pytest.mark.parametrize("newline", [b"\r\n", b"\n", b"\r"])
+def test_edit_preserves_non_target_newlines(tmp_path, newline):
+    """非目标记录保留原字节，目标行继续使用LF。@param tmp_path 临时目录。@param newline 原换行。@return None。"""
+    path = tmp_path / "synthetic.env"
+    untouched = b'# comment' + newline + b'KEEP="first' + newline + b'second"' + newline
+    path.write_bytes(untouched + b'COLOR=old' + newline)
+    assert dotenv.set_key(path, "COLOR", "new") == (True, "COLOR", "new")
+    assert path.read_bytes() == untouched + b"COLOR='new'\n"
+    assert dotenv.unset_key(path, "COLOR") == (True, "COLOR")
+    assert path.read_bytes() == untouched
