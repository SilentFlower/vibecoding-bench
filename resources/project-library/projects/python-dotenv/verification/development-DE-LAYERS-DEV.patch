+"""基于显式环境快照的分层配置接入。"""
+from dataclasses import dataclass
+from types import MappingProxyType
+from .validation import parse_config
+from .variables import parse_variables
+
+
+@dataclass(frozen=True)
+class LayeredValues:
+    """合并结果与每个最终键的层名、原始行。"""
+    values: object
+    origins: object
+
+
+def load_layers(sources, *, environment=None, override=True, interpolate=True):
+    """合并有限命名文本层。@param sources (唯一层名,文本)的可迭代对象。
+    @param environment 显式只读外部环境。@param override 配置是否优先于外部环境。
+    @param interpolate 是否按原变量语法展开。@return 只读LayeredValues，不修改任何输入。
+    """
+    sources = list(sources)
+    names = [name for name, text in sources]
+    if any(not isinstance(name, str) or not name for name in names) or len(names) != len(set(names)):
+        raise ValueError('层名必须非空且唯一')
+    parsed = [(name, parse_config(text, duplicates='last')) for name, text in sources]
+    external, values, origins = dict(environment or {}), {}, {}
+    for name, layer in parsed:
+        for key, value in layer.values.items():
+            if interpolate and value is not None:
+                scope = {**external, **values} if override else {**values, **external}
+                value = ''.join(atom.resolve(scope) for atom in parse_variables(value))
+            values[key] = value
+            origins[key] = (name, layer.lines[key])
+    return LayeredValues(MappingProxyType(values), MappingProxyType(origins))
