+"""按分层视图捕获脱离来源的不可变值。"""
+from datetime import date,datetime,time,timedelta
+from decimal import Decimal
+from pathlib import PurePath
+from types import MappingProxyType
+from .templates import REQUIRED
+
+
+def freeze(value,redactions=(),path=(),active=None):
+    """冻结标准配置树并按相对路径脱敏。@param value 配置树。@param redactions 敏感路径。
+    @param path 当前相对路径。@param active 递归身份集合。@return 不可变结果。
+    """
+    if any(path[:len(mark)]==mark for mark in redactions):
+        return 'REDACTED'
+    if type(value) in (type(None),bool,int,float,complex,str,bytes,date,datetime,time,timedelta,Decimal) or isinstance(value,PurePath):
+        return value
+    if not isinstance(value,(dict,list,tuple)):
+        raise TypeError('快照仅支持标准配置值')
+    active=set() if active is None else active
+    identity=id(value)
+    if identity in active:
+        raise ValueError('配置存在循环引用')
+    active.add(identity)
+    try:
+        if isinstance(value,dict):
+            output={}
+            for key,item in value.items():
+                if type(key) not in (str,int,float,bool,bytes,type(None)):
+                    raise TypeError('不支持的配置键')
+                output[key]=freeze(item,redactions,path+(key,),active)
+            return MappingProxyType(output)
+        return tuple(freeze(item,redactions,path+(index,),active) for index,item in enumerate(value))
+    finally:
+        active.remove(identity)
+
+
+def _capture(view,active):
+    value,_=view.first()
+    if not isinstance(value,(dict,list,tuple)):
+        return value
+    identity=id(value)
+    if identity in active:
+        raise ValueError('配置存在循环引用')
+    active.add(identity)
+    try:
+        if isinstance(value,dict):
+            return {key:_capture(child,active) for key,child in view.items()}
+        return [_capture(child,active) for child in view.sequence()]
+    finally:
+        active.remove(identity)
+
+
+def snapshot(view,template=REQUIRED,*,redact=False):
+    """捕获验证后配置。@param view 配置视图。@param template 可选原生模板。
+    @param redact 是否应用该视图相对敏感路径。@return 深层不可变快照。
+    """
+    marks=tuple(view.get_redactions()) if redact else ()
+    if () in marks:
+        return 'REDACTED'
+    value=_capture(view,set()) if template is REQUIRED else view.get(template)
+    return freeze(value,marks)
