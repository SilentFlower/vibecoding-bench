+"""公开稳定的真实HTML词法迭代适配，不把词法输出冒充修复后的DOM。"""
+from copy import deepcopy
+from ._tokenizer import HTMLTokenizer
+from .constants import tokenTypes
+
+
+class TokenLimitError(ValueError):
+    """公开词法token预算耗尽，此前产出明确只是部分结果。"""
+
+
+def iter_tokens(source, *, include_errors=True, max_tokens=None, **stream_options):
+    """从真实内部tokenizer惰性产出命名类型、独立字段及明确的结束检查点。
+
+    :param source: HTML文本、字节或调用方拥有的流。
+    :param include_errors: 是否产出ParseError词法诊断。
+    :param max_tokens: 非负整数输出上限，None不限，超限抛TokenLimitError。
+    :param stream_options: 原输入流编码选项，如override_encoding。
+    :return: 独立Token字典迭代器，position为token产出时的行/列检查点，不伪称精确起始span。
+    """
+    if max_tokens is not None and (isinstance(max_tokens, bool) or not isinstance(max_tokens, int) or max_tokens < 0):
+        raise ValueError('max_tokens必须为非负整数或None')
+    names = {value: name for name, value in tokenTypes.items()}
+    tokenizer = HTMLTokenizer(source, **stream_options)
+    produced = 0
+    for token in tokenizer:
+        name = names[token['type']]
+        if name == 'ParseError' and not include_errors:
+            continue
+        if max_tokens is not None and produced >= max_tokens:
+            raise TokenLimitError('词法token预算耗尽，结果未完成')
+        copied = deepcopy(token)
+        copied['type'] = name
+        copied['position'] = tuple(tokenizer.stream.position())
+        produced += 1
+        yield copied
