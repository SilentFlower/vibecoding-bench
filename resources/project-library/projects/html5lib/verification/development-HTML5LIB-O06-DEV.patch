+# 从真实HTML树收集原始URI并按首个base稳定解析及分组
+
+对应路线16：真实walker收集href/src/poster/action及普通srcset，首base优先按urljoin解析、保原URI和重复分组；空/片段/未知scheme明确、data集合标未解析，不联网或猜路径。
+
+公开回归与完整冻结上游回归都必须通过；不更改固定测试、依赖或测试控制。
--- a/library/html5lib/links.py
+++ b/library/html5lib/links.py
@@ -0,0 +1,63 @@
+"""实际HTML树中的离线资源/超链接清单，保留原URI及基准解析分组。"""
+import math
+import re
+from urllib.parse import urljoin
+from .treewalkers import getTreeWalker
+from .constants import namespaces
+
+
+def collect_links(tree, *, treewalker='etree', document_url=''):
+    """按首个非空base href与实际元素属性列出URI，不下载或猜文件路径。
+
+    :param tree: 原解析树。
+    :param treewalker: 后端walker名称。
+    :param document_url: 文档来源基准URL，空值明确保留相对引用。
+    :return: base_url、links明细及按resolved稳定分组的groups。
+    """
+    if not isinstance(document_url, str):
+        raise TypeError('document_url必须为字符串')
+    tokens = list(getTreeWalker(treewalker)(tree))
+    base = document_url
+    for token in tokens:
+        if token['type'] in ('StartTag','EmptyTag') and token.get('namespace') in (None,namespaces['html']) and token.get('name')=='base':
+            value=token['data'].get((None,'href'))
+            if value:
+                base=urljoin(document_url,value);break
+    selected={'a':('href',),'area':('href',),'link':('href',),'img':('src',),'script':('src',),
+              'iframe':('src',),'audio':('src',),'video':('src','poster'),'source':('src',),'form':('action',)}
+    rows=[]
+    for index,token in enumerate(tokens):
+        if token['type'] not in ('StartTag','EmptyTag') or token.get('namespace') not in (None,namespaces['html']):
+            continue
+        name=token['name'];attrs=token['data']
+        for attribute in selected.get(name,()):
+            if (None,attribute) in attrs:
+                raw=attrs[(None,attribute)]
+                rows.append({'element':name,'attribute':attribute,'raw':raw,
+                             'resolved':urljoin(base,raw) if raw else '', 'token_index':index,'descriptor':None,'status':'parsed'})
+        if name in ('img','source') and (None,'srcset') in attrs:
+            raw=attrs[(None,'srcset')]
+            if 'data:' in raw.lower():
+                rows.append({'element':name,'attribute':'srcset','raw':raw,'resolved':None,
+                             'token_index':index,'descriptor':None,'status':'unparsed_data_srcset'})
+            else:
+                for candidate in raw.split(','):
+                    parts=candidate.strip().split()
+                    if not parts:continue
+                    valid=len(parts)==1
+                    if len(parts)==2:
+                        descriptor=parts[1]
+                        if re.fullmatch(r'(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?x',descriptor):
+                            density=float(descriptor[:-1])
+                            valid=math.isfinite(density) and density>0
+                        elif re.fullmatch(r'[0-9]+w',descriptor):
+                            valid=int(descriptor[:-1])>0
+                    rows.append({'element':name,'attribute':'srcset','raw':parts[0] if valid else candidate,
+                                 'resolved':urljoin(base,parts[0]) if valid else None,'token_index':index,
+                                 'descriptor':parts[1] if valid and len(parts)==2 else None,
+                                 'status':'parsed' if valid else 'unparsed_srcset'})
+    grouped={}
+    for index,row in enumerate(rows):
+        if row['resolved'] is not None:
+            grouped.setdefault(row['resolved'],[]).append(index)
+    return {'base_url':base,'links':rows,'groups':[{'resolved':value,'indexes':indexes} for value,indexes in grouped.items()]}
--- a/library/tests/test_development_html5lib_o06_dev.py
