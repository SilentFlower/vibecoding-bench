--- a/library/constraint/cardinality.py
+++ b/library/constraint/cardinality.py
@@ -0,0 +1,39 @@
+"""多值分别限定出现次数的全局基数约束。"""
+from .constraints import Constraint
+
+
+class GlobalCardinality(Constraint):
+    """按每个值规定最小/最大出现数。@param value_bounds 值到(min,max)。@param closed 未列值是否禁止。"""
+    def __init__(self,value_bounds,closed=True):
+        """复制并检查计数范围。@param value_bounds 计数映射。@param closed 闭集政策。@return None。"""
+        if type(closed) is not bool:raise ValueError('closed必须为bool')
+        self.bounds={}
+        for value,pair in value_bounds.items():
+            minimum,maximum=pair
+            if type(minimum) is not int or type(maximum) is not int or not 0<=minimum<=maximum:raise ValueError('出现次数必须为有效非负整数范围')
+            self.bounds[value]=(minimum,maximum)
+        self.closed=closed
+
+    def _possible(self,variables,domains,assignments):
+        """仅按已赋值和仍可支持计数进行必要条件检查。@param variables 变量。@param domains 域。@param assignments 赋值。@return 是否可能。"""
+        if len(set(variables))!=len(variables):raise ValueError('基数约束不能重复列出变量')
+        assigned=[assignments[variable] for variable in variables if variable in assignments]
+        missing=[variable for variable in variables if variable not in assignments]
+        if self.closed and any(value not in self.bounds for value in assigned):return False
+        if self.closed and any(not any(value in self.bounds for value in domains[variable]) for variable in missing):return False
+        for value,(minimum,maximum) in self.bounds.items():
+            count=assigned.count(value)
+            possible=count+sum(value in domains[variable] for variable in missing)
+            if count>maximum or possible<minimum:return False
+        return True
+
+    def __call__(self,variables,domains,assignments,forwardcheck=False):
+        """安全前向删去已无计数可行性的值。@param variables 变量。@param domains 域。@param assignments 赋值。@param forwardcheck 是否删域。@return 是否仍可能。"""
+        if not self._possible(variables,domains,assignments):return False
+        if forwardcheck:
+            for variable in variables:
+                if variable not in assignments:
+                    for value in domains[variable][:]:
+                        if not self._possible(variables,domains,{**assignments,variable:value}):domains[variable].hideValue(value)
+                    if not domains[variable]:return False
+        return True
