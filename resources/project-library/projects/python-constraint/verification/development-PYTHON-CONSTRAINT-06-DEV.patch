--- a/library/constraint/optimization.py
+++ b/library/constraint/optimization.py
@@ -0,0 +1,35 @@
+"""显式方向的本地最优解枚举，预算停止不冒称已证最优。"""
+import math
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class OptimizationResult:
+    """本轮最好方案与证明状态。@param solution 最好方案。@param score 目标值。@param examined 已评估解数。@param complete 是否穷尽。@param reason 终止原因。"""
+    solution: object
+    score: object
+    examined: int
+    complete: bool
+    reason: str
+
+
+def optimize(problem,objective,direction='min',max_solutions=None):
+    """使用真实求解迭代器寻找最好方案。@param problem 原模型。@param objective 对赋值的有限数值函数。@param direction min/max。@param max_solutions 可选非负评估预算。@return OptimizationResult。"""
+    if direction not in ('min','max'):raise ValueError('未知优化方向')
+    if max_solutions is not None and (type(max_solutions) is not int or max_solutions<0):raise ValueError('预算必须非负整数')
+    if max_solutions==0:return OptimizationResult(None,None,0,False,'budget')
+    iterator=iter(problem.getSolutionIter())
+    best=None;best_score=None;count=0
+    try:
+        for solution in iterator:
+            # 防止目标函数修改当前求解器的赋值对象，历史保存也用独立dict。
+            score=objective(dict(solution))
+            if isinstance(score,bool) or not isinstance(score,(int,float)) or not math.isfinite(score):raise ValueError('目标值必须为有限数字')
+            count+=1
+            if best is None or (score<best_score if direction=='min' else score>best_score):
+                best=dict(solution);best_score=score
+            if max_solutions is not None and count>=max_solutions:return OptimizationResult(best,best_score,count,False,'budget')
+        return OptimizationResult(best,best_score,count,True,'optimal' if best is not None else 'unsatisfiable')
+    finally:
+        close=getattr(iterator,'close',None)
+        if close is not None:close()
