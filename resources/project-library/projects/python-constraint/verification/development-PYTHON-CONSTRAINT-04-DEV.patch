+"""业务允许/禁止元组表约束，显式列顺序与候选域支持。"""
+import copy
+from .constraints import Constraint
+
+
+class AllowedTuples(Constraint):
+    """只允许表中组合。@param rows 组合行迭代器。@param max_rows 表预算。"""
+    def __init__(self,rows,max_rows=10000):
+        """复制表且限制规模。@param rows 原表。@param max_rows 正整数。@return None。"""
+        if type(max_rows) is not int or max_rows<1:raise ValueError('表预算必须为正整数')
+        self.rows=[]
+        for index,row in enumerate(rows):
+            if index>=max_rows:raise ValueError('元组表超过预算')
+            current=tuple(copy.deepcopy(tuple(row)))
+            if self.rows and len(current)!=len(self.rows[0]):raise ValueError('元组表列数不一致')
+            if current not in self.rows:self.rows.append(current)
+
+    def _shape(self,variables):
+        """校验显式列顺序。@param variables 变量序列。@return None。"""
+        if len(set(variables))!=len(variables):raise ValueError('元组表不允许重复变量')
+        if self.rows and len(self.rows[0])!=len(variables):raise ValueError('变量数量与表列不符')
+
+    def preProcess(self,variables,domains,constraints,vconstraints):
+        """沿用原生单变量预处理协议。@param variables 列。@param domains 域。@param constraints 本轮约束。@param vconstraints 索引。@return None。"""
+        self._shape(variables)
+        super().preProcess(variables,domains,constraints,vconstraints)
+
+    def __call__(self,variables,domains,assignments,forwardcheck=False):
+        """保守筛选仍有全行支持的候选值。@param variables 列。@param domains 当前域。@param assignments 已赋值。@param forwardcheck 是否删域。@return 是否仍有支持。"""
+        self._shape(variables)
+        supported=[row for row in self.rows if all((row[index]==assignments[variable]) if variable in assignments else row[index] in domains[variable] for index,variable in enumerate(variables))]
+        if not supported:return False
+        if forwardcheck:
+            for index,variable in enumerate(variables):
+                if variable not in assignments:
+                    for value in domains[variable][:]:
+                        if not any(row[index]==value for row in supported):domains[variable].hideValue(value)
+                    if not domains[variable]:return False
+        return True
+
+
+class ForbiddenTuples(AllowedTuples):
+    """禁止明确完整组合，未列组合保持合法。@param rows 禁止行。@param max_rows 表预算。"""
+    def __call__(self,variables,domains,assignments,forwardcheck=False):
+        """完整匹配才拒绝，单个剩余变量可安全前向检查。@param variables 列。@param domains 域。@param assignments 已赋值。@param forwardcheck 是否删域。@return 是否仍可满足。"""
+        self._shape(variables)
+        missing=[variable for variable in variables if variable not in assignments]
+        if not missing:return tuple(assignments[variable] for variable in variables) not in self.rows
+        if forwardcheck and len(missing)==1:
+            variable=missing[0]
+            for value in domains[variable][:]:
+                trial={**assignments,variable:value}
+                if tuple(trial[item] for item in variables) in self.rows:domains[variable].hideValue(value)
+            return bool(domains[variable])
+        return True
