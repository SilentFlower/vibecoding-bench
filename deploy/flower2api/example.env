V3_DEPLOYMENT_ID=local
V3_DATA_ROOT=/srv/vibebench-v3-local
V3_HOST_PORT=18080
V3_BIND_ADDRESS=127.0.0.1
V3_CONTROL_IMAGE=vibebench-v3-control:RELEASE
V3_ACCOUNT_IMAGE=vibebench-v3-account:RELEASE
V3_RELEASE_MANIFEST=/absolute/path/to/release.json
V3_ADMIN_PASSWORD=
V3_INTERNAL_TOKEN=
V3_SESSION_SECRET=
V3_MAX_ACTIVE_ACCOUNTS=1
V3_ACCOUNT_CPUS=2
V3_ACCOUNT_MEMORY=4g
# 额外 swap 上限；0 保持旧行为。美国起步配置：MEMORY=1536m，SWAP=2048m。
V3_ACCOUNT_SWAP=0
# 启用账号 native293 时显式设置，例如标准并发 3：2432m；总 RAM 需同时容纳 network 与 CLI。
V3_NATIVE_SENDER_MEMORY=
# 原生热模板恢复，1 显式启用；需配套支持协议 1 的已签名内核与更高 sender 预算。
V3_NATIVE_CRIU=0
V3_NATIVE_PREWARM_ACCOUNT_ID=
# 有效发行公钥为所有 native293 账号开启在线内核管理；值为 Ed25519 原始 32 字节的小写十六进制。
V3_NATIVE_RELEASE_PUBLIC_KEY=
# 账号 RAM 之外预留的运维余量，默认 256 MiB；可按宿主负载提高。
V3_MEMORY_HEADROOM_BYTES=268435456
V3_CLI_VERSION=2.1.293
